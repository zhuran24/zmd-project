        "after_change": [
          "knowledge.check",
          "docsystem.doctor"
        ],
        "review_policy": {
          "at_phase_boundary": true,
          "max_interval_days": 60
        },
        "section_refs": [
          "project-manual"
        ]
      },
      "rationale": "Roadmap says what remains and how it exits; CURRENT and ledgers say what is true now."
    },
