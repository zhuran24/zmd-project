{
  "schema_version": "zmd_doc_policy_v1",
  "policy_id": "docs.project_manual",
  "description": "Explicit lifecycle and responsibility contracts for every depth-1 project-manual page.",
  "defaults": {
    "document_class": "unmanaged",
    "authority_role": "none",
    "mutation": "direct",
    "context_level": "L0",
    "purpose": "No project-manual responsibility has been declared. Add an explicit rule before adding Markdown here.",
    "volatile_facts": "not_applicable",
    "invariant_refs": [
      "DOC-INV-012"
    ],
    "after_change": [
      "docsystem.doctor"
    ],
    "review_policy": {
      "at_phase_boundary": false,
      "max_interval_days": null
    },
    "section_refs": []
  },
  "rules": [
    {
      "id": "manual_historical_snapshots",
      "match": {
        "paths": [
          "03_paradigm_death_baseline.md",
          "07_historical_review.md",
          "08_phase_1_2_plan.md",
          "09_phase_1_3_plan.md",
          "10_phase_1_5_plan.md",
          "13_schedule_estimate.md",
          "20_skip_directions.md",
          "25_autonomy_campaign_plan_20260720.md",
          "p1_2_supervisor_detailed_design.md",
          "p1_2_supervisor_redesign_draft.md",
          "soundness_gap_roadmap.md"
        ]
      },
      "set": {
        "document_class": "historical_evidence",
        "authority_role": "evidence_only",
        "mutation": "immutable",
        "context_level": "L0",
        "purpose": "Closed phase plan, dated design, retired-direction baseline or historical snapshot retained as evidence.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-002",
          "DOC-INV-012"
        ],
        "review_policy": {
          "at_phase_boundary": false,
          "max_interval_days": null
        },
        "section_refs": [
          "project-manual"
        ]
      },
      "rationale": "These documents record an earlier state and must not be synchronized to CURRENT."
    },
    {
      "id": "manual_chronology",
      "match": {
        "path": "HISTORY.md"
      },
      "set": {
        "document_class": "historical_evidence",
        "authority_role": "evidence_only",
        "mutation": "append_only",
        "context_level": "L0",
        "purpose": "Append-only chronology and historical navigation; old entries retain their time meaning.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-002",
          "DOC-INV-012"
        ],
        "review_policy": {
          "at_phase_boundary": true,
          "max_interval_days": null
        },
        "section_refs": [
          "project-manual",
          "history-archive"
        ]
      },
      "rationale": "Chronology grows by dated append, never by rewriting earlier narrative to match the present."
    },
    {
      "id": "manual_story_chronology",
      "match": {
        "path": "22_project_journey_plain_language.md"
      },
      "set": {
        "document_class": "historical_evidence",
        "authority_role": "evidence_only",
        "mutation": "governed",
        "context_level": "L0",
        "purpose": "Historical story chronology whose dated chapters remain append-only while its title, narrative cutoff and self-identification header stay maintainable.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-002",
          "DOC-INV-012"
        ],
        "review_policy": {
          "at_phase_boundary": true,
          "max_interval_days": null
        },
        "section_refs": [
          "project-manual",
          "history-archive"
        ]
      },
      "rationale": "The file's own maintenance convention requires the narrative cutoff to advance after major milestones, and the owner's 2026-08-21 naming instruction requires the maintained title and self-identification; prior chapters still change only through appended corrections."
    },
    {
      "id": "manual_compatibility_redirects",
      "match": {
        "paths": [
          "00_master_roadmap.md",
          "05_open_questions.md",
          "06_current_status.md",
          "21_glossary.md",
          "27_status_dashboard.md"
        ]
      },
      "set": {
        "document_class": "generated_projection",
        "authority_role": "projection_only",
        "mutation": "generator_only",
        "context_level": "L0",
        "purpose": "Generated compatibility redirects to unique current, future, terminology or open-question successors.",
        "volatile_facts": "forbidden",
        "invariant_refs": [
          "DOC-INV-001",
          "DOC-INV-004",
          "DOC-INV-013",
          "DOC-INV-014"
        ],
        "after_change": [
          "docsystem.render_guidance",
          "docsystem.doctor"
        ],
        "review_policy": {
          "at_phase_boundary": true,
          "max_interval_days": null
        },
        "source_paths": [
          "data/repository_governance/document_system/entrypoints.json",
          "devtools/docctl.py"
        ],
        "generator_action": "docsystem.render_entrypoints",
        "adr_refs": [
          "DOC-ADR-010"
        ],
        "section_refs": [
          "project-manual"
        ]
      },
      "rationale": "Old numbered paths remain stable, but their bodies are generated from the single entrypoint registry."
    },
