      "id": "future_only_roadmap",
      "match": {
        "path": "ROADMAP.md"
      },
      "set": {
        "document_class": "living",
        "authority_role": "current_guidance",
        "mutation": "direct",
        "context_level": "L0",
        "purpose": "Future-only roadmap with dependencies and exit evidence, excluding current-state copies.",
        "volatile_facts": "forbidden",
        "invariant_refs": [
          "DOC-INV-001",
          "DOC-INV-007",
          "DOC-INV-012",
          "DOC-INV-014"
