{
  "schema_version": "zmd_doc_policy_v1",
  "policy_id": "docs",
  "description": "Explicit contracts for depth-1 documentation; subdirectories provide their own policies.",
  "defaults": {
    "document_class": "unmanaged",
    "authority_role": "none",
    "mutation": "direct",
    "context_level": "L0",
    "purpose": "No depth-1 docs responsibility has been declared. Add an explicit rule before adding Markdown here.",
    "volatile_facts": "not_applicable",
    "invariant_refs": [
      "DOC-INV-012"
    ],
    "after_change": [
      "docsystem.doctor"
    ],
    "review_policy": {
      "at_phase_boundary": false,
      "max_interval_days": null
    },
    "section_refs": []
  },
  "rules": [
    {
      "id": "current_projection",
      "match": {
        "path": "CURRENT.md"
      },
      "set": {
        "document_class": "generated_projection",
        "authority_role": "projection_only",
        "mutation": "generator_only",
        "context_level": "L1",
        "purpose": "Unique human-readable current-state projection.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-001",
          "DOC-INV-004",
          "DOC-INV-014"
        ],
        "source_paths": [
          "data/knowledge/current_state.json",
          "data/knowledge/claims.jsonl",
          "data/knowledge/decisions.jsonl",
          "data/knowledge/dossiers.json",
          "devtools/build_knowledge_docs.py"
        ],
        "generator_action": "knowledge.build",
        "after_change": [
          "knowledge.check",
          "docsystem.doctor"
        ],
        "section_refs": [
          "knowledge"
        ]
      },
      "rationale": "CURRENT is rebuilt from machine authorities and stable ledgers; direct edits create a second mutable truth."
    },
    {
