+def _env_bool_enabled(name: str, *, default: bool = False) -> bool:
+    raw_value = os.environ.get(name)
+    if raw_value is None or str(raw_value).strip() == "":
+        return bool(default)
+    normalized = str(raw_value).strip().lower()
+    if normalized in {"1", "true", "on", "yes", "y"}:
+        return True
+    if normalized in {"0", "false", "off", "no", "n"}:
+        return False
+    raise ValueError(
+        f"Unsupported {name}: {raw_value!r}; expected a boolean token."
+    )
+
+
+def _master_witness_preflight_enabled() -> bool:
+    return _env_bool_enabled(EXACT_MASTER_WITNESS_PREFLIGHT_ENV, default=False)
+
+
+def _master_witness_preflight_seconds(master_seconds: float) -> float:
+    raw_value = os.environ.get(EXACT_MASTER_WITNESS_PREFLIGHT_SECONDS_ENV)
+    if raw_value is None or str(raw_value).strip() == "":
+        return max(0.0, min(float(master_seconds), 30.0))
+    try:
+        value = max(0.0, float(str(raw_value).strip()))
+    except ValueError:
+        raise ValueError(
+            f"Unsupported {EXACT_MASTER_WITNESS_PREFLIGHT_SECONDS_ENV}: "
+            f"{raw_value!r}; expected a non-negative number."
+        ) from None
+    if value <= 0.0:
+        return max(0.0, float(master_seconds))
+    return max(0.0, min(float(master_seconds), value))
+
+
+def _master_witness_preflight_max_anchors() -> int:
+    raw_value = os.environ.get(EXACT_MASTER_WITNESS_PREFLIGHT_MAX_ANCHORS_ENV)
