+"""Regression tests for the witness-only master preflight lane."""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+from typing import Any, Mapping, Optional
+
+from ortools.sat.python import cp_model
+
+from src.models.cut_manager import CutManager
+from src.search.benders_loop import LBBDController
+
+
+class _FakeWitnessMaster:
+    def __init__(self, *, accepted: bool) -> None:
+        self.accepted = bool(accepted)
+        self.build_stats: dict[str, Any] = {"search_guidance": {"profile": "fake"}}
+        self.validation_calls: list[dict[str, Any]] = []
+
+    def candidate_witness_compatible_ghost_anchors(
+        self,
+        solution_hint: Mapping[str, int],
+        *,
+        max_anchors: int = 0,
+    ) -> dict[str, Any]:
+        return {
+            "supported": True,
+            "complete_hint": True,
+            "reason": "complete",
+            "ghost_anchor_total_count": 3,
+            "compatible_anchor_count": 1,
+            "compatible_anchor_indices": [7],
+            "compatible_anchor_indices_truncated": False,
+            "first_compatible_ghost_anchor_idx": 7,
+            "mandatory_hint_pose_count": len(solution_hint),
+            "mandatory_hint_occupied_cell_count": len(solution_hint),
+            "missing_hint_count": 0,
+            "missing_pose_tuple_count": 0,
+        }
+
+    def _validate_coordinate_forced_hint(
+        self,
+        *,
+        solution_hint: Mapping[str, int],
+        ghost_anchor_hint_idx: Optional[int],
+        time_limit_seconds: float,
+        require_complete: bool,
+        solver_parameter_profile: Mapping[str, Any],
+        install_solution: bool,
+    ) -> dict[str, Any]:
+        self.validation_calls.append(
+            {
+                "solution_hint": dict(solution_hint),
+                "ghost_anchor_hint_idx": ghost_anchor_hint_idx,
+                "time_limit_seconds": float(time_limit_seconds),
+                "require_complete": bool(require_complete),
+                "solver_parameter_profile": dict(solver_parameter_profile),
+                "install_solution": bool(install_solution),
+            }
+        )
+        return {
+            "attempted": True,
+            "status": "FEASIBLE" if self.accepted else "INFEASIBLE",
+            "accepted": self.accepted,
+            "reason": "accepted" if self.accepted else "infeasible",
+            "wall_time": 0.01,
+            "branches": 0,
+            "conflicts": 0,
+            "solution_extraction_status": "ok" if self.accepted else "not_feasible",
+        }
+
+
+def _controller(tmp_path: Path, master: _FakeWitnessMaster) -> LBBDController:
+    return LBBDController(
+        master,  # type: ignore[arg-type]
+        CutManager(tmp_path / "cuts", solve_mode="certified_exact"),
+        tmp_path,
+        "certified_exact",
+        master_seconds=10.0,
+    )
+
+
+def test_witness_preflight_accepts_only_positive_certificate(
+    monkeypatch,
+    tmp_path,
+) -> None:
+    monkeypatch.setenv("EXACT_MASTER_WITNESS_PREFLIGHT", "1")
+    master = _FakeWitnessMaster(accepted=True)
+    controller = _controller(tmp_path, master)
+
+    status = controller._run_master_witness_preflight(
+        solution_hint={"mandatory_a": 1},
+        iteration=1,
+        master_deadline=time.perf_counter() + 10.0,
+    )
+
+    assert status == cp_model.FEASIBLE
+    assert master.validation_calls[0]["install_solution"] is True
+    assert controller._master_witness_preflight["accepted"] is True
+    assert controller._master_witness_preflight["accepted_anchor_idx"] == 7
+
+
+def test_witness_preflight_fail_closed_when_forced_clone_rejects(
+    monkeypatch,
+    tmp_path,
+) -> None:
+    monkeypatch.setenv("EXACT_MASTER_WITNESS_PREFLIGHT", "1")
+    master = _FakeWitnessMaster(accepted=False)
+    controller = _controller(tmp_path, master)
+
+    status = controller._run_master_witness_preflight(
+        solution_hint={"mandatory_a": 1},
+        iteration=1,
+        master_deadline=time.perf_counter() + 10.0,
+    )
+
+    assert status is None
+    assert controller._master_witness_preflight["accepted"] is False
+    assert controller._master_witness_preflight["status"] != "INFEASIBLE"
+    assert master.validation_calls[0]["install_solution"] is True
