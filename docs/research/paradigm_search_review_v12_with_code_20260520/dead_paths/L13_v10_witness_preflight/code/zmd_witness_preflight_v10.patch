+    def candidate_witness_compatible_ghost_anchors(
+        self,
+        solution_hint: Mapping[str, int],
+        *,
+        max_anchors: int = 0,
+    ) -> Dict[str, Any]:
+        """Find ghost anchors compatible with a complete mandatory witness hint.
+
+        This is a cheap witness-only reducer for the v9 bottleneck: when a full
+        mandatory placement witness is already available, the expensive
+        mandatory placement search tree can be collapsed to fixed equalities in
+        a cloned validation solve.  The payload intentionally never proves a
+        parent candidate infeasible; it only supplies candidate ghost anchors for
+        a later positive-certificate preflight.
+        """
+
+        if not self._built:
+            self.build()
+
+        anchor_limit = max(0, int(max_anchors))
+        payload: Dict[str, Any] = {
+            "supported": False,
+            "complete_hint": False,
+            "reason": "not_evaluated",
+            "mandatory_hint_pose_count": 0,
+            "mandatory_hint_occupied_cell_count": 0,
+            "missing_hint_count": 0,
+            "missing_pose_tuple_count": 0,
+            "extra_mandatory_hint_count": 0,
+            "unknown_hint_count": 0,
+            "optional_hint_count": 0,
+            "ghost_anchor_total_count": int(len(self.u_vars)),
+            "compatible_anchor_count": 0,
+            "compatible_anchor_indices": [],
+            "compatible_anchor_indices_truncated": False,
+            "first_compatible_ghost_anchor_idx": None,
+        }
+        if not self.exact_mode or self._coordinate_delegate is None:
+            payload["reason"] = "coordinate_delegate_unavailable"
+            self.build_stats["candidate_witness_compatible_ghost_anchors"] = dict(
+                payload
+            )
+            return payload
+        if not self.ghost_rect or not self._ghost_domains or not self.u_vars:
+            payload["reason"] = "ghost_rect_unavailable"
+            self.build_stats["candidate_witness_compatible_ghost_anchors"] = dict(
+                payload
+            )
+            return payload
+
+        delegate = self._coordinate_delegate
+        grouped_hints: DefaultDict[str, List[int]] = defaultdict(list)
+        optional_hint_count = 0
+        unknown_hint_count = 0
+        for raw_solution_id, raw_pose_idx in dict(solution_hint or {}).items():
+            solution_id = str(raw_solution_id)
+            try:
+                pose_idx = int(raw_pose_idx)
+            except (TypeError, ValueError):
+                unknown_hint_count += 1
+                continue
+            if solution_id in self._group_id_by_instance:
+                grouped_hints[str(self._group_id_by_instance[solution_id])].append(
+                    pose_idx
+                )
+                continue
+            if self._infer_optional_template_from_solution_id(solution_id) is not None:
+                optional_hint_count += 1
+                continue
+            unknown_hint_count += 1
+
+        mandatory_hint_pose_count = 0
+        missing_hint_count = 0
+        missing_pose_tuple_count = 0
+        extra_mandatory_hint_count = 0
+        occupied_cells: Set[Tuple[int, int]] = set()
+        for group in self._mandatory_groups:
+            group_id = str(group["group_id"])
+            tpl = str(group["facility_type"])
+            required_count = int(len(delegate.mandatory_slots.get(group_id, [])))
+            if required_count <= 0:
+                required_count = int(len(list(group.get("instance_ids", []))))
+            pose_indices = sorted(
+                grouped_hints.get(group_id, []),
+                key=lambda pose_idx: self._pose_sort_key(tpl, int(pose_idx)),
+            )
+            if len(pose_indices) < required_count:
+                missing_hint_count += int(required_count - len(pose_indices))
+            if len(pose_indices) > required_count:
+                extra_mandatory_hint_count += int(len(pose_indices) - required_count)
+            for pose_idx in pose_indices[:required_count]:
+                pose_tuple = delegate._template_pose_tuple_by_idx.get(tpl, {}).get(
+                    int(pose_idx)
+                )
+                if pose_tuple is None:
+                    missing_pose_tuple_count += 1
+                    continue
+                mandatory_hint_pose_count += 1
+                occupied_cells.update(self._pose_cells(tpl, int(pose_idx)))
+
+        complete_hint = bool(
+            missing_hint_count == 0
+            and missing_pose_tuple_count == 0
+            and mandatory_hint_pose_count
+        )
+        payload.update(
+            {
+                "supported": True,
+                "complete_hint": bool(complete_hint),
+                "reason": "complete" if complete_hint else "incomplete_hint",
+                "mandatory_hint_pose_count": int(mandatory_hint_pose_count),
+                "mandatory_hint_occupied_cell_count": int(len(occupied_cells)),
+                "missing_hint_count": int(missing_hint_count),
+                "missing_pose_tuple_count": int(missing_pose_tuple_count),
+                "extra_mandatory_hint_count": int(extra_mandatory_hint_count),
+                "unknown_hint_count": int(unknown_hint_count),
+                "optional_hint_count": int(optional_hint_count),
+            }
+        )
+        if not complete_hint:
+            self.build_stats["candidate_witness_compatible_ghost_anchors"] = dict(
+                payload
+            )
+            return payload
+
+        compatible_anchor_indices: List[int] = []
+        compatible_anchor_count = 0
+        first_compatible_anchor_idx: Optional[int] = None
+        for rect_idx in self._ordered_ghost_anchor_indices():
+            domain = self._ghost_domains[int(rect_idx)]
+            ghost_cells = {
+                (int(cell[0]), int(cell[1]))
+                for cell in list(domain.get("cells", []))
+            }
+            if ghost_cells & occupied_cells:
+                continue
+            compatible_anchor_count += 1
+            if first_compatible_anchor_idx is None:
+                first_compatible_anchor_idx = int(rect_idx)
+            if anchor_limit <= 0 or len(compatible_anchor_indices) < anchor_limit:
+                compatible_anchor_indices.append(int(rect_idx))
+
+        payload.update(
+            {
+                "compatible_anchor_count": int(compatible_anchor_count),
+                "compatible_anchor_indices": list(compatible_anchor_indices),
+                "compatible_anchor_indices_truncated": bool(
+                    anchor_limit > 0 and compatible_anchor_count > anchor_limit
+                ),
+                "first_compatible_ghost_anchor_idx": first_compatible_anchor_idx,
+                "reason": "complete"
+                if compatible_anchor_count > 0
+                else "no_compatible_ghost_anchor",
+            }
+        )
+        self.build_stats["candidate_witness_compatible_ghost_anchors"] = dict(
+            payload
+        )
+        return payload
+
