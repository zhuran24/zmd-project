+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from src.models.cut_manager import RUN_STATUS_INFEASIBLE, RUN_STATUS_UNKNOWN
+import src.search.benders_loop as bl
+
+
+def test_anchor_sliced_manifest_cap_returns_unknown_then_resumes(
+    monkeypatch,
+    tmp_path,
+) -> None:
+    project_root = tmp_path
+    session = SimpleNamespace(
+        project_root=project_root,
+        solve_mode="certified_exact",
+        master_search_profile="exact_coordinate_guided_branching_v4",
+        rules={"globals": {"grid": {"width": 3, "height": 1}}},
+        artifact_hashes={},
+    )
+    calls: list[str] = []
+
+    def fake_run_benders_for_ghost_rect(**kwargs):  # type: ignore[no-untyped-def]
+        calls.append(bl.os.environ.get(bl.EXACT_MASTER_GHOST_ANCHOR_FILTER_ENV, ""))
+        fake_run_benders_for_ghost_rect.last_run_metadata = {
+            "proof_summary": {
+                "mode": "certified_exact",
+                "master_status": "INFEASIBLE",
+            },
+            "exact_safe_cuts": [],
+            "loaded_exact_safe_cut_count": 0,
+            "generated_exact_safe_cut_count": 0,
+        }
+        return RUN_STATUS_INFEASIBLE, None
+
+    fake_run_benders_for_ghost_rect.last_run_metadata = {}
+    monkeypatch.setattr(bl, "run_benders_for_ghost_rect", fake_run_benders_for_ghost_rect)
+    monkeypatch.setenv(bl.EXACT_MASTER_GHOST_ANCHOR_SLICE_MAX_ANCHORS_ENV, "2")
+    monkeypatch.setenv(
+        bl.EXACT_MASTER_GHOST_ANCHOR_SLICE_MANIFEST_PATH_ENV,
+        str(tmp_path / "manifests"),
+    )
+
+    status, solution = bl._run_anchor_sliced_benders_for_ghost_rect(
+        ghost_w=1,
+        ghost_h=1,
+        candidate_key="1x1",
+        max_iterations=1,
+        project_root=project_root,
+        solve_mode="certified_exact",
+        master_seconds=10.0,
+        binding_seconds=10.0,
+        routing_seconds=10.0,
+        flow_seconds=10.0,
+        campaign=None,
+        session=session,
+        preloaded_exact_safe_cuts=None,
+        master_search_profile="exact_coordinate_guided_branching_v4",
+        disable_master_warm_start=False,
+        heartbeat_callback=None,
+        epsilon_stage=None,
+    )
+
+    assert status == RUN_STATUS_UNKNOWN
+    assert solution is None
+    assert calls == ["0,0", "1,0"]
+    assert bl.EXACT_MASTER_GHOST_ANCHOR_FILTER_ENV not in bl.os.environ
+
+    calls.clear()
+    monkeypatch.delenv(bl.EXACT_MASTER_GHOST_ANCHOR_SLICE_MAX_ANCHORS_ENV, raising=False)
+    status, solution = bl._run_anchor_sliced_benders_for_ghost_rect(
+        ghost_w=1,
+        ghost_h=1,
+        candidate_key="1x1",
+        max_iterations=1,
+        project_root=project_root,
+        solve_mode="certified_exact",
+        master_seconds=10.0,
+        binding_seconds=10.0,
+        routing_seconds=10.0,
+        flow_seconds=10.0,
+        campaign=None,
+        session=session,
+        preloaded_exact_safe_cuts=None,
+        master_search_profile="exact_coordinate_guided_branching_v4",
+        disable_master_warm_start=False,
+        heartbeat_callback=None,
+        epsilon_stage=None,
+    )
+
+    assert status == RUN_STATUS_INFEASIBLE
+    assert solution is None
+    assert calls == ["2,0"]
+    metadata = dict(fake_run_benders_for_ghost_rect.last_run_metadata)
+    slicing_summary = dict(metadata["proof_summary"]["anchor_slicing"])
+    assert slicing_summary["complete_partition"] is True
+    assert slicing_summary["infeasible_anchor_count"] == 3
