+            slice_routing_seconds = float(routing_seconds)
+            slice_flow_seconds = float(flow_seconds)
+            if remaining_seconds is not None:
+                slice_master_seconds = min(slice_master_seconds, remaining_seconds)
+                slice_binding_seconds = min(slice_binding_seconds, remaining_seconds)
+                slice_routing_seconds = min(slice_routing_seconds, remaining_seconds)
+                slice_flow_seconds = min(slice_flow_seconds, remaining_seconds)
+            status, solution = run_benders_for_ghost_rect(
+                ghost_w=int(ghost_w),
+                ghost_h=int(ghost_h),
+                max_iterations=max_iterations,
+                project_root=project_root,
+                solve_mode=solve_mode,
+                master_seconds=slice_master_seconds,
+                binding_seconds=slice_binding_seconds,
+                routing_seconds=slice_routing_seconds,
+                flow_seconds=slice_flow_seconds,
+                campaign=campaign,
+                session=exact_session,
+                preloaded_exact_safe_cuts=preloaded_exact_safe_cuts,
+                master_search_profile=master_search_profile,
+                disable_master_warm_start=disable_master_warm_start,
