+
+        evaluated_this_run += 1
+        run_metadata = dict(getattr(run_benders_for_ghost_rect, "last_run_metadata", {}) or {})
+        proof_summary = dict(run_metadata.get("proof_summary", {}))
+        entry: Dict[str, Any] = {
+            "original_anchor_idx": int(original_anchor_idx),
+            "anchor": {"x": int(anchor_x), "y": int(anchor_y)},
+            "status": str(status),
+            "terminal": _anchor_slice_status_is_terminal(str(status)),
+            "elapsed_seconds": max(0.0, time.perf_counter() - slice_started),
