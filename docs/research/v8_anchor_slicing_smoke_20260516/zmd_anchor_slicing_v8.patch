+def test_ghost_anchor_filter_preserves_original_anchor_indices() -> None:
+    requested = {(1, 0), (3, 0)}
+    model = _build_minimal_ghost_model(grid_width=5, ghost_anchor_filter=requested)
+    model.build()
+
+    assert list(model.u_vars) == [0, 1]
+    assert [int(domain["original_anchor_idx"]) for domain in model._ghost_domains] == [1, 3]
+    assert [int(domain["local_anchor_idx"]) for domain in model._ghost_domains] == [0, 1]
+    assert tuple(model.build_stats["ghost_rect"]["filtered_original_anchor_indices"]) == (1, 3)
+    assert model.build_stats["ghost_rect"]["total_unfiltered_placements"] == 5
+
+
+def test_condition_lit_resolver_accepts_original_index_in_sliced_overlay() -> None:
+    from src.search.benders_loop import _resolve_condition_lits_from_condition_set
+
+    model = _build_minimal_ghost_model(grid_width=5, ghost_anchor_filter={(3, 0)})
+    model.build()
+
+    resolved, ok = _resolve_condition_lits_from_condition_set(
+        model,
+        {"ghost_anchor::(3,0)": 3},
+    )
+    assert ok is True
+    assert resolved == [model.u_vars[0]]
+
+
+def test_condition_lit_resolver_rejects_wrong_original_index() -> None:
+    from src.search.benders_loop import _resolve_condition_lits_from_condition_set
+
+    model = _build_minimal_ghost_model(grid_width=5, ghost_anchor_filter={(3, 0)})
+    model.build()
+
+    resolved, ok = _resolve_condition_lits_from_condition_set(
+        model,
+        {"ghost_anchor::(3,0)": 2},
+    )
+    assert ok is False
+    assert resolved == []
