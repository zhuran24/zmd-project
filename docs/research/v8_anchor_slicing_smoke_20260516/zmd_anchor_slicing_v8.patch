+    grid_h = int(grid["height"])
+    anchors = _canonical_anchor_slice_entries(
+        grid_w=grid_w,
+        grid_h=grid_h,
+        ghost_w=int(ghost_w),
+        ghost_h=int(ghost_h),
+    )
