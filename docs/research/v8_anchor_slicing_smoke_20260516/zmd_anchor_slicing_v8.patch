+def _truthy_env_value(raw_value: Optional[str]) -> bool:
+    if raw_value is None:
+        return False
+    return str(raw_value).strip() not in {"", "0", "false", "False", "no", "No"}
+
+
+def _anchor_slicing_requested() -> bool:
+    return _truthy_env_value(os.environ.get(EXACT_MASTER_GHOST_ANCHOR_SLICE_MODE_ENV)) or (
+        _truthy_env_value(os.environ.get(EXACT_MASTER_GHOST_ANCHOR_SLICE_ALIAS_ENV))
+    )
+
+
+def _anchor_slice_internal_active() -> bool:
+    return _truthy_env_value(os.environ.get(_EXACT_MASTER_GHOST_ANCHOR_SLICE_INTERNAL_ENV))
+
+
+def _anchor_slice_resume_enabled() -> bool:
+    raw_value = os.environ.get(EXACT_MASTER_GHOST_ANCHOR_SLICE_RESUME_ENV)
+    if raw_value is None:
+        return True
+    return _truthy_env_value(raw_value)
+
+
+def _anchor_slice_max_anchors() -> int:
+    raw_value = os.environ.get(EXACT_MASTER_GHOST_ANCHOR_SLICE_MAX_ANCHORS_ENV)
+    if raw_value is None or str(raw_value).strip() == "":
+        return 0
+    try:
+        return max(0, int(str(raw_value).strip()))
+    except ValueError:
+        raise ValueError(
+            f"Unsupported {EXACT_MASTER_GHOST_ANCHOR_SLICE_MAX_ANCHORS_ENV}: "
+            f"{raw_value!r}; expected a non-negative integer."
+        ) from None
+
+
+def _anchor_slice_candidate_seconds(default_seconds: float) -> float:
+    raw_value = os.environ.get(EXACT_MASTER_GHOST_ANCHOR_SLICE_CANDIDATE_SECONDS_ENV)
+    if raw_value is None or str(raw_value).strip() == "":
+        return max(0.0, float(default_seconds))
+    try:
+        return max(0.0, float(str(raw_value).strip()))
+    except ValueError:
+        raise ValueError(
+            f"Unsupported {EXACT_MASTER_GHOST_ANCHOR_SLICE_CANDIDATE_SECONDS_ENV}: "
+            f"{raw_value!r}; expected a non-negative number."
+        ) from None
+
+
+def _anchor_slice_manifest_path(project_root: Path, candidate_key: str) -> Path:
+    raw_value = os.environ.get(EXACT_MASTER_GHOST_ANCHOR_SLICE_MANIFEST_PATH_ENV)
+    if raw_value is not None and str(raw_value).strip():
+        configured = Path(str(raw_value).strip()).expanduser()
+        if configured.suffix.lower() == ".json":
+            return configured
+        return configured / f"{candidate_key}.json"
+    return (
+        project_root
+        / "data"
+        / "checkpoints"
+        / "anchor_slice_manifests"
+        / f"{candidate_key}.json"
+    )
+
+
+def _canonical_anchor_slice_entries(
+    *,
+    grid_w: int,
+    grid_h: int,
+    ghost_w: int,
+    ghost_h: int,
+) -> List[Dict[str, Any]]:
+    entries: List[Dict[str, Any]] = []
+    original_anchor_idx = 0
+    for anchor_x in range(max(0, int(grid_w) - int(ghost_w) + 1)):
+        for anchor_y in range(max(0, int(grid_h) - int(ghost_h) + 1)):
+            entries.append(
+                {
+                    "original_anchor_idx": int(original_anchor_idx),
+                    "anchor": {"x": int(anchor_x), "y": int(anchor_y)},
+                }
+            )
+            original_anchor_idx += 1
+    return entries
+
+
+def _anchor_slice_manifest_signature(
+    *,
+    candidate_key: str,
+    ghost_w: int,
+    ghost_h: int,
+    grid_w: int,
+    grid_h: int,
+    artifact_hashes: Mapping[str, Any],
+    master_search_profile: str,
+    total_anchor_count: int,
+) -> Dict[str, Any]:
+    return {
+        "schema_version": 1,
+        "candidate_key": str(candidate_key),
+        "ghost_rect": {"w": int(ghost_w), "h": int(ghost_h)},
+        "grid": {"width": int(grid_w), "height": int(grid_h)},
+        "artifact_hashes": {str(k): str(v) for k, v in sorted(artifact_hashes.items())},
+        "master_search_profile": str(master_search_profile),
+        "total_anchor_count": int(total_anchor_count),
+    }
+
+
+def _new_anchor_slice_manifest(signature: Mapping[str, Any]) -> Dict[str, Any]:
+    return {
+        "schema_version": 1,
+        "kind": "ghost_anchor_slice_manifest",
+        "signature": dict(signature),
+        "created_at": now_iso(),
+        "updated_at": now_iso(),
+        "anchors": {},
+    }
+
+
+def _anchor_slice_status_is_terminal(status: str) -> bool:
+    return str(status) in {RUN_STATUS_CERTIFIED, RUN_STATUS_INFEASIBLE}
+
+
+def _anchor_slice_status_closes_infeasible_partition(status: str) -> bool:
+    return str(status) == RUN_STATUS_INFEASIBLE
+
+
+def _anchor_slice_entry_is_valid_for_domain(
+    entry: Mapping[str, Any],
+    *,
+    anchors_by_idx: Mapping[int, Mapping[str, Any]],
+) -> bool:
+    try:
+        original_anchor_idx = int(entry.get("original_anchor_idx"))
+    except (TypeError, ValueError):
+        return False
+    domain = anchors_by_idx.get(original_anchor_idx)
+    if domain is None:
+        return False
+    expected_anchor = dict(domain.get("anchor", {}))
+    actual_anchor = dict(entry.get("anchor", {}))
+    try:
+        if int(actual_anchor.get("x")) != int(expected_anchor.get("x")):
+            return False
+        if int(actual_anchor.get("y")) != int(expected_anchor.get("y")):
+            return False
+    except (TypeError, ValueError):
+        return False
+    status = str(entry.get("status", ""))
+    terminal = bool(entry.get("terminal", False))
+    if terminal != _anchor_slice_status_is_terminal(status):
+        return False
+    if status == RUN_STATUS_CERTIFIED and not isinstance(entry.get("solution"), Mapping):
+        return False
