+def _load_anchor_slice_manifest(
+    manifest_path: Path,
+    *,
+    signature: Mapping[str, Any],
+    anchors_by_idx: Mapping[int, Mapping[str, Any]],
+) -> Dict[str, Any]:
+    if not _anchor_slice_resume_enabled() or not manifest_path.exists():
+        return _new_anchor_slice_manifest(signature)
+    try:
+        raw_manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return _new_anchor_slice_manifest(signature)
+    if not isinstance(raw_manifest, Mapping):
+        return _new_anchor_slice_manifest(signature)
+    if dict(raw_manifest.get("signature", {})) != dict(signature):
+        return _new_anchor_slice_manifest(signature)
+    entries_obj = raw_manifest.get("anchors", {})
+    raw_entries = dict(entries_obj) if isinstance(entries_obj, Mapping) else {}
+    filtered_entries: Dict[str, Dict[str, Any]] = {}
+    for key, raw_entry in raw_entries.items():
+        if not isinstance(raw_entry, Mapping):
+            continue
+        entry = dict(raw_entry)
+        if _anchor_slice_entry_is_valid_for_domain(entry, anchors_by_idx=anchors_by_idx):
+            filtered_entries[str(key)] = entry
+    manifest = dict(raw_manifest)
+    manifest["signature"] = dict(signature)
+    manifest["anchors"] = filtered_entries
+    manifest.setdefault("schema_version", 1)
+    manifest.setdefault("kind", "ghost_anchor_slice_manifest")
+    manifest.setdefault("created_at", now_iso())
+    manifest["updated_at"] = now_iso()
+    return manifest
+
+
+def _save_anchor_slice_manifest(manifest_path: Path, manifest: Mapping[str, Any]) -> None:
+    manifest_path.parent.mkdir(parents=True, exist_ok=True)
+    payload = dict(manifest)
+    payload["updated_at"] = now_iso()
+    tmp_path = manifest_path.with_suffix(f"{manifest_path.suffix}.tmp.{os.getpid()}")
+    tmp_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True), encoding="utf-8")
+    os.replace(tmp_path, manifest_path)
+
+
+def _anchor_slice_cuts_from_entries(entries: Mapping[str, Mapping[str, Any]]) -> List[BendersCut]:
+    cuts: List[BendersCut] = []
+    for entry in entries.values():
+        raw_cuts = entry.get("exact_safe_cuts", [])
+        if not isinstance(raw_cuts, list):
+            continue
+        for raw_cut in raw_cuts:
+            if not isinstance(raw_cut, Mapping):
+                continue
+            try:
+                cuts.append(BendersCut.from_dict(dict(raw_cut)))
+            except Exception:
+                continue
+    return cuts
+
+
+def _anchor_sliced_parent_proof_summary(
+    *,
+    status: str,
+    candidate_key: str,
+    ghost_w: int,
+    ghost_h: int,
+    total_anchor_count: int,
+    entries: Mapping[str, Mapping[str, Any]],
+    evaluated_this_run: int,
+    truncated_by_env_cap: bool,
+    truncated_by_time_budget: bool,
+    manifest_path: Path,
+    master_search_profile: str,
+    selected_entry: Optional[Mapping[str, Any]] = None,
+) -> Dict[str, Any]:
+    terminal_entries = [entry for entry in entries.values() if bool(entry.get("terminal", False))]
+    infeasible_entries = [
+        entry
+        for entry in terminal_entries
+        if _anchor_slice_status_closes_infeasible_partition(str(entry.get("status", "")))
+    ]
+    certified_entries = [
+        entry for entry in terminal_entries if str(entry.get("status", "")) == RUN_STATUS_CERTIFIED
+    ]
+    nonterminal_count = max(0, int(total_anchor_count) - len(terminal_entries))
+    anchor_slicing = {
+        "enabled": True,
+        "candidate_key": str(candidate_key),
+        "ghost_rect": {"w": int(ghost_w), "h": int(ghost_h)},
+        "total_anchor_count": int(total_anchor_count),
+        "terminal_anchor_count": int(len(terminal_entries)),
+        "infeasible_anchor_count": int(len(infeasible_entries)),
+        "certified_anchor_count": int(len(certified_entries)),
+        "nonterminal_anchor_count": int(nonterminal_count),
+        "complete_partition": int(len(terminal_entries)) == int(total_anchor_count),
+        "evaluated_this_run": int(evaluated_this_run),
+        "truncated_by_env_cap": bool(truncated_by_env_cap),
+        "truncated_by_time_budget": bool(truncated_by_time_budget),
+        "manifest_path": str(manifest_path),
+        "master_search_profile": str(master_search_profile),
+    }
+    if selected_entry is not None:
+        anchor_slicing["selected_anchor_idx"] = int(selected_entry.get("original_anchor_idx", -1))
+        anchor_slicing["selected_anchor"] = dict(selected_entry.get("anchor", {}))
+
+    inherited: Dict[str, Any] = {}
+    if selected_entry is not None and isinstance(selected_entry.get("proof_summary"), Mapping):
+        inherited = dict(selected_entry.get("proof_summary", {}))
+    summary: Dict[str, Any] = {
+        **inherited,
+        "mode": "certified_exact",
+        "benders_iterations": int(inherited.get("benders_iterations", 0)),
+        "master_status": str(inherited.get("master_status", status)),
+        "diagnostic_flow_status": str(inherited.get("diagnostic_flow_status", "NOT_RUN")),
+        "enumerated_bindings": int(inherited.get("enumerated_bindings", 0)),
+        "routing_attempts": int(inherited.get("routing_attempts", 0)),
+        "master_search_profile": str(master_search_profile),
+        "anchor_slicing": anchor_slicing,
+    }
+    return summary
