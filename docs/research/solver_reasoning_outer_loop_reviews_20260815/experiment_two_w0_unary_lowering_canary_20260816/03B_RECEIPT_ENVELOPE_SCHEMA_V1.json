{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zmd_w0_unary_canary_receipt_envelope_v1",
  "title": "W0 unary-lowering canary receipt envelope v1",
  "type": "object",
  "required": [
    "result_kind",
    "outcome",
    "subject_identity",
    "verified_scope",
    "authority_basis",
    "granted_effects",
    "non_implications",
    "contract_identity"
  ],
  "properties": {
    "result_kind": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "subject_identity": {
      "type": "object",
      "minProperties": 1
    },
    "verified_scope": {
      "type": "object",
      "minProperties": 1
    },
    "authority_basis": {
      "type": "object",
      "required": [
        "authority_class",
        "source_paths"
      ],
      "properties": {
        "authority_class": {
          "const": "research_only_non_authorizing"
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "granted_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "non_implications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contract_identity": {
      "type": "object",
      "required": [
        "protocol_freeze_commit",
        "prelaunch_revision_commit",
        "manifest_path",
        "receipt_schema_path"
      ],
      "properties": {
        "protocol_freeze_commit": {
          "const": "57a17a7672cf879fc39e0e67a044590a85cb47a2"
        },
        "prelaunch_revision_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_path": {
          "const": "docs/research/solver_reasoning_outer_loop_reviews_20260815/experiment_two_w0_unary_lowering_canary_20260816/03_CANARY_MANIFEST.json"
        },
        "receipt_schema_path": {
          "const": "docs/research/solver_reasoning_outer_loop_reviews_20260815/experiment_two_w0_unary_lowering_canary_20260816/03B_RECEIPT_ENVELOPE_SCHEMA_V1.json"
        },
        "judgment_id": {
          "const": "J-W0-GHOST-FRONT-BOUNDARY-041-V1"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
