+#!/usr/bin/env python3
+"""
+Tick-level sandbox for attacking the P2.0 fluid throughput abstraction.
+
+The instances are deliberately tiny.  Each one carries an explicit fluid
+witness; the checker verifies the T1-T6-shaped equalities/capacities on that
+witness, while the simulator executes a deterministic finite-buffer tick model.
+
+Run:
+    python experiments/p2_0_discrete_counterexamples.py --json
+    python experiments/p2_0_discrete_counterexamples.py --dump-instances
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import json
+from collections import defaultdict
+from dataclasses import dataclass, field
+from typing import Any, Optional
+
+EPS = 1e-9
+
+
+def _rates() -> dict[str, float]:
+    return defaultdict(float)  # type: ignore[return-value]
+
+
+def add_rate(dst: dict[str, float], commodity: str, amount: float) -> None:
+    dst[commodity] = dst.get(commodity, 0.0) + float(amount)
+
+
+def parse_rate_key(key: str) -> tuple[str, str, str, str]:
+    """Parse 'src:out->dst:in'."""
+    left, right = key.split("->", 1)
+    src, out_port = left.split(":", 1)
+    dst, in_port = right.split(":", 1)
+    return src, out_port, dst, in_port
+
+
+@dataclass
+class World:
+    components: dict[str, "Component"]
+    order: list[str]
+    connections: dict[tuple[str, str], tuple[str, str]]
+    tick: int = 0
+    warmup: int = 0
+    sink_counts: dict[str, dict[str, int]] = field(default_factory=lambda: defaultdict(lambda: defaultdict(int)))
+    machine_outputs: dict[str, dict[str, int]] = field(default_factory=lambda: defaultdict(lambda: defaultdict(int)))
+    machine_starts: dict[str, int] = field(default_factory=lambda: defaultdict(int))
+
+    def in_measurement_window(self) -> bool:
+        return self.tick >= self.warmup
+
+    def emit_to(self, src: str, out_port: str, item: str) -> bool:
+        dst_ref = self.connections.get((src, out_port))
+        if dst_ref is None:
+            return False
+        dst, in_port = dst_ref
+        return self.components[dst].accept(in_port, item, self)
+
+    def run(self, ticks: int, warmup: int) -> dict[str, Any]:
+        self.warmup = warmup
+        for t in range(ticks):
+            self.tick = t
+            for cid in self.order:
+                self.components[cid].emit(self)
+            for cid in self.order:
+                self.components[cid].update(self)
+        denom = max(1, ticks - warmup)
+        return {
+            "ticks": ticks,
+            "warmup": warmup,
+            "sink_rates": {
+                sid: {k: v / denom for k, v in sorted(counts.items())}
+                for sid, counts in sorted(self.sink_counts.items())
+            },
+            "machine_output_rates": {
+                mid: {k: v / denom for k, v in sorted(counts.items())}
+                for mid, counts in sorted(self.machine_outputs.items())
+            },
+            "machine_start_rates": {
+                mid: v / denom for mid, v in sorted(self.machine_starts.items())
+            },
+        }
+
+
+class Component:
+    def __init__(self, cid: str, cfg: dict[str, Any]) -> None:
+        self.id = cid
+        self.cfg = cfg
+
+    def accept(self, in_port: str, item: str, world: World) -> bool:
+        raise NotImplementedError
+
+    def emit(self, world: World) -> None:
+        return None
+
+    def update(self, world: World) -> None:
+        return None
+
+
+class Source(Component):
+    def __init__(self, cid: str, cfg: dict[str, Any]) -> None:
+        super().__init__(cid, cfg)
+        self.pending: Optional[str] = None
+        self.acc = float(cfg.get("initial_accumulator", 0.0))
+        self.phase = int(cfg.get("initial_phase", 0))
+
+    def accept(self, in_port: str, item: str, world: World) -> bool:
+        return False
+
+    def emit(self, world: World) -> None:
+        if self.pending is not None and world.emit_to(self.id, "out", self.pending):
+            self.pending = None
+
+    def update(self, world: World) -> None:
+        if self.pending is not None:
+            return
+        if "pattern" in self.cfg:
+            pattern = self.cfg["pattern"]
+            token = pattern[self.phase % len(pattern)]
+            self.phase += 1
+            if token is not None:
+                self.pending = str(token)
+            return
+        rate = float(self.cfg.get("rate", 1.0))
+        self.acc += rate
+        if self.acc + EPS >= 1.0:
+            self.acc -= 1.0
+            self.pending = str(self.cfg["commodity"])
+
+
+class Sink(Component):
+    def accept(self, in_port: str, item: str, world: World) -> bool:
+        accepts = self.cfg.get("accepts", "*")
+        if accepts != "*" and item not in set(accepts):
+            return False
+        if world.in_measurement_window():
+            world.sink_counts[self.id][item] += 1
+        return True
+
+
+class Belt(Component):
+    def __init__(self, cid: str, cfg: dict[str, Any]) -> None:
+        super().__init__(cid, cfg)
+        n = int(cfg.get("length", 1))
+        if n < 1:
+            raise ValueError(f"belt {cid!r} length must be >= 1")
+        initial = list(cfg.get("initial_cells", []))
+        self.cells: list[Optional[str]] = [None] * n
+        for i, token in enumerate(initial[:n]):
+            self.cells[i] = None if token is None else str(token)
+
+    def accept(self, in_port: str, item: str, world: World) -> bool:
+        if self.cells[0] is None:
+            self.cells[0] = item
+            return True
+        return False
+
+    def emit(self, world: World) -> None:
+        last = len(self.cells) - 1
+        item = self.cells[last]
+        if item is not None and world.emit_to(self.id, "out", item):
+            self.cells[last] = None
+
+    def update(self, world: World) -> None:
+        for i in range(len(self.cells) - 2, -1, -1):
+            if self.cells[i] is not None and self.cells[i + 1] is None:
+                self.cells[i + 1] = self.cells[i]
+                self.cells[i] = None
+
+
+class Merger(Component):
+    def __init__(self, cid: str, cfg: dict[str, Any]) -> None:
+        super().__init__(cid, cfg)
+        self.ports = list(cfg.get("input_ports", ["in0", "in1"]))
+        self.inputs: dict[str, Optional[str]] = {p: None for p in self.ports}
+        self.out_item: Optional[str] = None
+        self.rr_idx = int(cfg.get("initial_rr_index", 0)) % len(self.ports)
+
+    def accept(self, in_port: str, item: str, world: World) -> bool:
+        if in_port not in self.inputs:
+            return False
+        if self.inputs[in_port] is None:
+            self.inputs[in_port] = item
+            return True
+        return False
+
+    def emit(self, world: World) -> None:
+        if self.out_item is not None and world.emit_to(self.id, "out", self.out_item):
+            self.out_item = None
+
+    def update(self, world: World) -> None:
+        if self.out_item is not None:
+            return
+        policy = self.cfg.get("policy", "round_robin")
+        chosen: Optional[int] = None
+        if policy == "fixed_priority":
+            for i, port in enumerate(self.ports):
+                if self.inputs[port] is not None:
+                    chosen = i
+                    break
+        elif policy == "round_robin":
+            for offset in range(len(self.ports)):
+                i = (self.rr_idx + offset) % len(self.ports)
+                if self.inputs[self.ports[i]] is not None:
+                    chosen = i
+                    break
+        else:
+            raise ValueError(f"unknown merger policy: {policy}")
+        if chosen is not None:
+            port = self.ports[chosen]
+            self.out_item = self.inputs[port]
+            self.inputs[port] = None
+            if policy == "round_robin":
+                self.rr_idx = (chosen + 1) % len(self.ports)
+
+
+class Splitter(Component):
+    def __init__(self, cid: str, cfg: dict[str, Any]) -> None:
+        super().__init__(cid, cfg)
+        self.ports = list(cfg.get("output_ports", ["out0", "out1"]))
+        self.in_item: Optional[str] = None
+        self.next_idx = int(cfg.get("initial_rr_index", 0)) % len(self.ports)
+
+    def accept(self, in_port: str, item: str, world: World) -> bool:
+        if in_port != "in":
+            return False
+        if self.in_item is None:
+            self.in_item = item
+            return True
+        return False
+
+    def update(self, world: World) -> None:
+        if self.in_item is None:
+            return
+        mode = self.cfg.get("mode", "type_blind")
+        blocked = self.cfg.get("blocked", "skip")
+        item = self.in_item
+        if mode == "filter":
+            fmap = self.cfg.get("filter", {})
+            if item not in fmap:
+                return
+            candidates = [str(fmap[item])]
+        elif mode == "type_blind":
+            if blocked == "wait":
+                candidates = [self.ports[self.next_idx]]
+            elif blocked == "skip":
+                candidates = [self.ports[(self.next_idx + j) % len(self.ports)] for j in range(len(self.ports))]
+            else:
+                raise ValueError(f"unknown splitter blocked policy: {blocked}")
+        else:
+            raise ValueError(f"unknown splitter mode: {mode}")
+
+        for port in candidates:
+            if world.emit_to(self.id, port, item):
+                self.in_item = None
+                if port in self.ports:
+                    self.next_idx = (self.ports.index(port) + 1) % len(self.ports)
+                return
+
+
+class Machine(Component):
+    def __init__(self, cid: str, cfg: dict[str, Any]) -> None:
+        super().__init__(cid, cfg)
+        self.inputs = {str(k): int(v) for k, v in cfg.get("inputs", {}).items()}
+        self.outputs = {str(k): int(v) for k, v in cfg.get("outputs", {}).items()}
+        self.tpc = int(cfg.get("ticks_per_cycle", 1))
+        self.input_capacity = {
+            str(k): int(v)
+            for k, v in cfg.get("input_capacity", self.inputs).items()
+        }
+        self.input_buf = {k: 0 for k in self.inputs}
+        for k, v in cfg.get("initial_inputs", {}).items():
+            if k not in self.input_buf:
+                raise ValueError(f"machine {cid} initial input for non-required commodity {k}")
+            self.input_buf[k] = int(v)
+        self.output_capacity = int(cfg.get("output_capacity", max(1, sum(self.outputs.values()))))
+        self.output_queue: list[str] = list(cfg.get("initial_outputs", []))
+        self.remaining = 0
+        self.completed_pending: list[str] = []
+
+    def accept(self, in_port: str, item: str, world: World) -> bool:
+        if item not in self.inputs:
+            return False
+        if self.input_buf[item] < self.input_capacity.get(item, self.inputs[item]):
+            self.input_buf[item] += 1
+            return True
+        return False
+
+    def emit(self, world: World) -> None:
+        if self.output_queue and world.emit_to(self.id, "out", self.output_queue[0]):
+            self.output_queue.pop(0)
+
+    def _make_outputs(self) -> list[str]:
+        out: list[str] = []
+        for commodity, count in self.outputs.items():
+            out.extend([commodity] * count)
+        return out
+
+    def _flush_completed(self, world: World) -> bool:
+        if not self.completed_pending:
+            return True
+        if len(self.output_queue) + len(self.completed_pending) > self.output_capacity:
+            return False
+        self.output_queue.extend(self.completed_pending)
+        if world.in_measurement_window():
+            for item in self.completed_pending:
+                world.machine_outputs[self.id][item] += 1
+        self.completed_pending = []
+        return True
+
+    def update(self, world: World) -> None:
+        if self.completed_pending:
+            if not self._flush_completed(world):
+                return
+        if self.remaining > 0:
+            self.remaining -= 1
+            if self.remaining == 0:
+                self.completed_pending = self._make_outputs()
+                if not self._flush_completed(world):
+                    return
+        if self.remaining == 0 and not self.completed_pending:
+            if all(self.input_buf.get(k, 0) >= need for k, need in self.inputs.items()):
+                for k, need in self.inputs.items():
+                    self.input_buf[k] -= need
+                self.remaining = self.tpc
+                if world.in_measurement_window():
+                    world.machine_starts[self.id] += 1
+
+
+COMPONENT_TYPES = {
+    "source": Source,
+    "sink": Sink,
+    "belt": Belt,
+    "merger": Merger,
+    "splitter": Splitter,
+    "machine": Machine,
+}
+
+
+def build_world(instance: dict[str, Any], profile: str = "default") -> World:
+    cfg = copy.deepcopy(instance)
+    if profile == "permissive":
+        for c in cfg["components"].values():
+            if c["type"] == "merger":
+                c["policy"] = "round_robin"
+            elif c["type"] == "splitter":
+                c["mode"] = "filter"
+                c["blocked"] = "skip"
+    elif profile != "default":
+        raise ValueError(f"unknown profile {profile!r}")
+
+    components: dict[str, Component] = {}
+    order = list(cfg.get("order", cfg["components"].keys()))
+    for cid in order:
+        ccfg = cfg["components"][cid]
+        cls = COMPONENT_TYPES[ccfg["type"]]
+        components[cid] = cls(cid, ccfg)
+    connections: dict[tuple[str, str], tuple[str, str]] = {}
+    for edge in cfg["connections"]:
+        src, out_port, dst, in_port = parse_rate_key(edge)
+        connections[(src, out_port)] = (dst, in_port)
+    return World(components=components, order=order, connections=connections)
+
+
+def check_fluid_witness(instance: dict[str, Any]) -> dict[str, Any]:
+    edge_rates: dict[str, dict[str, float]] = instance.get("fluid_witness", {}).get("edge_rates", {})
+    u: dict[str, float] = instance.get("fluid_witness", {}).get("machine_utilization", {})
+    components = instance["components"]
+    connections = set(instance["connections"])
+    errors: list[str] = []
+    incoming: dict[str, dict[str, float]] = defaultdict(_rates)
+    outgoing: dict[str, dict[str, float]] = defaultdict(_rates)
+
+    for key, rates in edge_rates.items():
+        if key not in connections:
+            errors.append(f"fluid witness mentions non-instance edge {key}")
+            continue
+        src, _out, dst, _in = parse_rate_key(key)
+        total = sum(float(x) for x in rates.values())
+        if total > 1.0 + EPS:
+            errors.append(f"edge {key} aggregate rate {total:.6f} exceeds port/belt cap 1")
+        for k, v in rates.items():
+            add_rate(outgoing[src], str(k), float(v))
+            add_rate(incoming[dst], str(k), float(v))
+
+    for key in connections:
+        if key not in edge_rates:
+            # Zero-rate edges are allowed but must be explicit enough for audit.
+            edge_rates.setdefault(key, {})
+
+    for cid, ccfg in components.items():
+        ctype = ccfg["type"]
+        in_rates = incoming[cid]
+        out_rates = outgoing[cid]
+        in_total = sum(in_rates.values())
+        out_total = sum(out_rates.values())
+
+        if ctype == "source":
+            cap = float(ccfg.get("source_cap", 1.0))
+            if out_total > cap + EPS:
+                errors.append(f"source {cid} out rate {out_total:.6f} exceeds cap {cap}")
+        elif ctype == "sink":
+            pass
+        elif ctype in {"belt", "splitter", "merger"}:
+            if max(in_total, out_total) > 1.0 + EPS:
+                errors.append(f"{ctype} {cid} aggregate throughput exceeds cap 1")
+            keys = set(in_rates) | set(out_rates)
+            for k in keys:
+                if abs(in_rates.get(k, 0.0) - out_rates.get(k, 0.0)) > 1e-7:
+                    errors.append(
+                        f"conservation fails at {ctype} {cid} for {k}: "
+                        f"in {in_rates.get(k, 0.0):.6f}, out {out_rates.get(k, 0.0):.6f}"
+                    )
+        elif ctype == "machine":
+            util = float(u.get(cid, 0.0))
+            if not (0.0 - EPS <= util <= 1.0 + EPS):
+                errors.append(f"machine {cid} utilization {util} outside [0,1]")
+            tpc = float(ccfg.get("ticks_per_cycle", 1))
+            for k, need in ccfg.get("inputs", {}).items():
+                expected = util * float(need) / tpc
+                got = in_rates.get(k, 0.0)
+                if abs(got - expected) > 1e-7:
+                    errors.append(f"machine {cid} input {k}: got {got:.6f}, expected {expected:.6f}")
+            for k, amount in ccfg.get("outputs", {}).items():
+                expected = util * float(amount) / tpc
+                got = out_rates.get(k, 0.0)
+                if abs(got - expected) > 1e-7:
+                    errors.append(f"machine {cid} output {k}: got {got:.6f}, expected {expected:.6f}")
+        else:
+            errors.append(f"unknown component type in fluid checker: {ctype}")
+
+    for sink_id, demands in instance.get("targets", {}).items():
+        for k, target in demands.items():
+            got = incoming[sink_id].get(k, 0.0)
+            if got + EPS < float(target):
+                errors.append(f"target {sink_id}.{k}: got {got:.6f}, target {float(target):.6f}")
+    for mid, demands in instance.get("machine_output_targets", {}).items():
+        util = float(u.get(mid, 0.0))
+        ccfg = components[mid]
+        tpc = float(ccfg.get("ticks_per_cycle", 1))
+        for k, target in demands.items():
+            expected = util * float(ccfg.get("outputs", {}).get(k, 0.0)) / tpc
+            if expected + EPS < float(target):
+                errors.append(f"machine target {mid}.{k}: got {expected:.6f}, target {float(target):.6f}")
+
+    return {"feasible": not errors, "errors": errors}
+
+
+def target_rates_from_sim(instance: dict[str, Any], sim: dict[str, Any]) -> dict[str, dict[str, float]]:
+    measured: dict[str, dict[str, float]] = {}
+    for sink_id, demands in instance.get("targets", {}).items():
+        measured[f"sink:{sink_id}"] = {
+            k: sim.get("sink_rates", {}).get(sink_id, {}).get(k, 0.0)
+            for k in demands
+        }
+    for mid, demands in instance.get("machine_output_targets", {}).items():
+        measured[f"machine:{mid}"] = {
+            k: sim.get("machine_output_rates", {}).get(mid, {}).get(k, 0.0)
+            for k in demands
+        }
+    return measured
+
+
+def target_gaps(instance: dict[str, Any], sim: dict[str, Any]) -> dict[str, dict[str, float]]:
+    gaps: dict[str, dict[str, float]] = {}
+    for sink_id, demands in instance.get("targets", {}).items():
+        label = f"sink:{sink_id}"
+        gaps[label] = {}
+        for k, target in demands.items():
+            actual = sim.get("sink_rates", {}).get(sink_id, {}).get(k, 0.0)
+            gaps[label][k] = float(target) - actual
+    for mid, demands in instance.get("machine_output_targets", {}).items():
+        label = f"machine:{mid}"
+        gaps[label] = {}
+        for k, target in demands.items():
+            actual = sim.get("machine_output_rates", {}).get(mid, {}).get(k, 0.0)
+            gaps[label][k] = float(target) - actual
+    return gaps
+
+
+def has_shortfall(gaps: dict[str, dict[str, float]], tolerance: float = 0.02) -> bool:
+    return any(v > tolerance for group in gaps.values() for v in group.values())
+
+
+def run_instance(instance: dict[str, Any], profile: str, ticks: int, warmup: int) -> dict[str, Any]:
+    fluid = check_fluid_witness(copy.deepcopy(instance))
+    world = build_world(instance, profile=profile)
+    sim = world.run(ticks=ticks, warmup=warmup)
+    gaps = target_gaps(instance, sim)
+    return {
+        "profile": profile,
+        "fluid": fluid,
+        "sim": sim,
+        "measured_targets": target_rates_from_sim(instance, sim),
+        "target_gaps": gaps,
+        "fluid_feasible_discrete_shortfall": bool(fluid["feasible"] and has_shortfall(gaps)),
+    }
+
+
+def edge(src: str, out_port: str, dst: str, in_port: str) -> str:
+    return f"{src}:{out_port}->{dst}:{in_port}"
