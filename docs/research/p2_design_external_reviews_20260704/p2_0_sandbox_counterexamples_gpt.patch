+## 反例目录
+
+### CE1_merger_fixed_priority_starves_low_branch
+
+结构族：two nominal half-rate commodities share one merger then split apart。
+判定：**A2 merger fairness violation**。
+
+实例 JSON：
+
+```json
+{
+  "components": {
+    "merge": {
+      "input_ports": [
+        "in0",
+        "in1"
+      ],
+      "policy": "fixed_priority",
+      "type": "merger"
+    },
+    "sink_a": {
+      "accepts": "*",
+      "type": "sink"
+    },
+    "sink_b": {
+      "accepts": "*",
+      "type": "sink"
+    },
+    "split": {
+      "blocked": "skip",
+      "filter": {
+        "A": "out0",
+        "B": "out1"
+      },
+      "mode": "filter",
+      "type": "splitter"
+    },
+    "src_a": {
+      "commodity": "A",
+      "rate": 1.0,
+      "type": "source"
+    },
+    "src_b": {
+      "commodity": "B",
+      "rate": 1.0,
+      "type": "source"
+    }
+  },
+  "connections": [
+    "src_a:out->merge:in0",
+    "src_b:out->merge:in1",
+    "merge:out->split:in",
+    "split:out0->sink_a:in",
+    "split:out1->sink_b:in"
+  ],
+  "fluid_witness": {
+    "edge_rates": {
+      "merge:out->split:in": {
+        "A": 0.5,
+        "B": 0.5
+      },
+      "split:out0->sink_a:in": {
+        "A": 0.5
+      },
+      "split:out1->sink_b:in": {
+        "B": 0.5
+      },
+      "src_a:out->merge:in0": {
+        "A": 0.5
+      },
+      "src_b:out->merge:in1": {
+        "B": 0.5
+      }
+    },
+    "machine_utilization": {}
+  },
+  "machine_output_targets": {},
+  "name": "CE1_merger_fixed_priority_starves_low_branch",
+  "targets": {
+    "sink_a": {
+      "A": 0.5
+    },
+    "sink_b": {
+      "B": 0.5
+    }
