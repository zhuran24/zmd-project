+def run_all(ticks: int, warmup: int) -> dict[str, Any]:
+    results = []
+    permissive_remaining = 0
+    default_counterexamples = 0
+    for case in CASES:
+        default = run_instance(case, "default", ticks=ticks, warmup=warmup)
+        permissive = run_instance(case, "permissive", ticks=ticks, warmup=warmup)
+        if default["fluid_feasible_discrete_shortfall"]:
+            default_counterexamples += 1
+        if permissive["fluid_feasible_discrete_shortfall"]:
+            permissive_remaining += 1
+        results.append(
+            {
+                "name": case["name"],
+                "family": case["family"],
+                "classification": case["classification"],
+                "assumptions": case.get("assumptions", []),
