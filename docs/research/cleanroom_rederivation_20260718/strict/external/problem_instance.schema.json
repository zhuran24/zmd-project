          "type": "integer"
        },
        "generic_raw_output_terminals": {
          "minimum": 0,
          "type": "integer"
        },
        "manufacturing_input_terminals": {
          "minimum": 0,
          "type": "integer"
        },
        "manufacturing_instance_count": {
          "minimum": 0,
          "type": "integer"
        },
        "manufacturing_output_terminals": {
          "minimum": 0,
          "type": "integer"
        },
        "operation_group_count": {
          "minimum": 0,
          "type": "integer"
        },
        "required_body_area": {
          "minimum": 0,
          "type": "integer"
        },
        "required_instance_count": {
          "minimum": 0,
          "type": "integer"
        },
        "total_active_terminals": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "commodity_count",
        "operation_group_count",
        "manufacturing_instance_count",
        "required_instance_count",
        "required_body_area",
        "manufacturing_input_terminals",
        "manufacturing_output_terminals",
        "generic_raw_output_terminals",
        "generic_final_input_terminals",
        "total_active_terminals"
      ],
      "type": "object"
    }
