                    "additionalProperties": false,
                    "properties": {
                      "body_cell": {
                        "$ref": "#/$defs/coordinate"
                      },
                      "direction": {
                        "enum": [
                          "N",
                          "E",
                          "S",
                          "W"
                        ]
                      },
                      "id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "input",
                          "output"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "body_cell",
                      "direction"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "id",
                "body",
                "ports"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "placement_rule": {
            "enum": [
              "any_body_in_grid",
              "matching_map_boundary"
            ]
          },
          "requires_power": {
            "type": "boolean"
          }
        },
        "required": [
          "requires_power",
          "placement_rule",
          "modes"
        ],
        "type": "object"
      },
      "type": "object"
    },
