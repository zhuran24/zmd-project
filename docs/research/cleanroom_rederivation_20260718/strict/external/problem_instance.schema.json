  "required": [
    "schema_version",
    "benchmark_id",
    "coordinate_system",
    "grid",
    "objective",
    "commodities",
    "facility_templates",
    "operation_groups",
    "required_instances",
    "generic_requirements",
    "repeatable_auxiliaries",
    "routing",
    "power",
    "sentinels"
  ],
  "title": "Factory Layout Optimality Benchmark Instance",
  "type": "object"
}
