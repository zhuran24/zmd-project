          "additionalProperties": false,
          "properties": {
            "x_max_offset": {
              "const": 6
            },
            "x_min_offset": {
              "const": -5
            },
            "y_max_offset": {
              "const": 6
            },
            "y_min_offset": {
              "const": -5
            }
          },
          "required": [
            "x_min_offset",
            "x_max_offset",
            "y_min_offset",
            "y_max_offset"
          ],
          "type": "object"
        },
        "pole_template": {
          "const": "power_pole"
        },
        "required_rule": {
          "const": "at_least_one_body_cell_covered"
        }
      },
      "required": [
        "pole_template",
        "coverage_from_pole_anchor",
        "required_rule"
      ],
      "type": "object"
    },
    "repeatable_auxiliaries": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "required_instances": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "operation": {
            "minLength": 1,
            "type": "string"
          },
          "template": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "template",
          "operation"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "routing": {
      "additionalProperties": false,
      "properties": {
        "compatible_terminals_share_component": {
          "const": true
        },
        "component_cells_must_avoid_bodies": {
          "const": true
        },
        "component_kinds": {
          "const": [
            "straight",
            "turn",
            "cross",
            "splitter",
            "merger"
          ]
        },
        "connectivity": {
          "const": "each_active_output_reaches_an_active_input_and_each_active_input_is_reached_per_commodity"
        },
        "crossing": {
          "const": "two_perpendicular_straight_channels_without_transfer"
        },
        "multi_commodity_sharing": {
          "const": true
        },
        "terminal_input_requires_component_output": {
          "const": "opposite_terminal_direction"
        },
        "terminal_output_requires_component_input": {
          "const": "opposite_terminal_direction"
        },
        "throughput_in_scope": {
          "const": false
        }
