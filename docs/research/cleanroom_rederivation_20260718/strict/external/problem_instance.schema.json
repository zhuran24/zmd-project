{
  "$defs": {
    "coordinate": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    }
  },
  "$id": "https://example.invalid/factory-layout-optimality-benchmark-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "const": "factory_layout_optimality_benchmark_v1"
    },
    "commodities": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "coordinate_system": {
      "additionalProperties": false,
      "properties": {
        "directions": {
          "const": [
            "N",
            "E",
            "S",
            "W"
          ]
        },
        "indexing": {
          "const": "zero_based"
        },
        "origin": {
          "const": "southwest"
        },
        "x_positive": {
          "const": "east"
        },
        "y_positive": {
          "const": "north"
        }
      },
      "required": [
        "origin",
        "indexing",
        "x_positive",
        "y_positive",
        "directions"
      ],
      "type": "object"
    },
    "facility_templates": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "modes": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "body": {
                  "additionalProperties": false,
                  "properties": {
                    "height": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "width": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "width",
                    "height"
                  ],
                  "type": "object"
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
