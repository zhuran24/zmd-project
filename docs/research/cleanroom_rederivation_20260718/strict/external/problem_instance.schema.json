                "propertyNames": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "object"
              },
              "outputs": {
                "additionalProperties": {
                  "minimum": 1,
                  "type": "integer"
                },
                "propertyNames": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "object"
              }
            },
            "required": [
              "inputs",
              "outputs"
            ],
            "type": "object"
          },
          "template": {
            "minLength": 1,
            "type": "string"
          }
