{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory-layout-solution-witness-v1.schema.json",
  "title": "Factory Layout Concrete Witness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_digest",
    "required_placements",
    "optional_placements",
    "route_components",
    "claimed_objective"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "instance_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "required_placements": {"type": "array", "items": {"$ref": "#/$defs/placement"}},
    "optional_placements": {"type": "array", "items": {"$ref": "#/$defs/placement"}},
    "route_components": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/non_cross_component"},
          {"$ref": "#/$defs/cross_component"}
        ]
      }
    },
    "claimed_objective": {"$ref": "#/$defs/objective"}
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "template", "mode", "anchor", "port_bindings"],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1},
        "template": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "anchor": {"$ref": "#/$defs/coordinate"},
        "port_bindings": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"type": ["string", "null"]}
        }
      }
    },
    "direction_array": {
      "type": "array",
      "items": {"enum": ["N", "E", "S", "W"]},
      "uniqueItems": true
    },
    "commodity_array": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "non_cross_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell", "kind", "inputs", "outputs", "commodities"],
      "properties": {
        "cell": {"$ref": "#/$defs/coordinate"},
        "kind": {"enum": ["straight", "turn", "splitter", "merger"]},
        "inputs": {"$ref": "#/$defs/direction_array"},
        "outputs": {"$ref": "#/$defs/direction_array"},
        "commodities": {"$ref": "#/$defs/commodity_array"}
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "commodities"],
      "properties": {
        "inputs": {"$ref": "#/$defs/direction_array"},
        "outputs": {"$ref": "#/$defs/direction_array"},
        "commodities": {"$ref": "#/$defs/commodity_array"}
      }
    },
    "cross_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell", "kind", "channels"],
      "properties": {
        "cell": {"$ref": "#/$defs/coordinate"},
        "kind": {"const": "cross"},
        "channels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/channel"}
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rectangle", "area", "min_side"],
      "properties": {
        "rectangle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "integer"},
            "y": {"type": "integer"},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "area": {"type": "integer", "minimum": 0},
        "min_side": {"type": "integer", "minimum": 0}
      }
    }
  }
}
