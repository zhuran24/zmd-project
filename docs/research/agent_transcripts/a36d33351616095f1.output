{"parentUuid":"bf7db22f-d7e6-4f0f-861e-8fd1a868f6a5","isSidechain":true,"promptId":"a8f1a005-6197-4ac8-b6c3-3f7619cec3c7","agentId":"a36d33351616095f1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014VmSAuKZab8TvkDAudEnwA","type":"tool_result","content":"1\t\"\"\"\n2\tPose-level commodity-to-port-cell binding helpers.\n3\t\n4\tThis module turns an operation-level port profile plus a concrete pose into a\n5\tfinite domain of legal commodity assignments on that pose's physical port cells.\n6\tIt does not solve the global binding problem yet; it only exposes the exact\n7\tper-instance combinatorial domain for operations whose commodities are already\n8\tfixed.\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\tfrom itertools import combinations, product\n14\tfrom typing import Any, Dict, Iterable, List, Mapping, Sequence, Tuple\n15\t\n16\tfrom src.preprocess.operation_profiles import get_operation_port_profile\n17\t\n18\tPortCell = Dict[str, Any]\n19\tSideBinding = List[PortCell]\n20\tBindingDomain = List[Dict[str, SideBinding]]\n21\tSideBindingPattern = Tuple[Tuple[int, str], ...]\n22\tBindingPattern = Tuple[SideBindingPattern, SideBindingPattern]\n23\tPoseBindingCacheKey = Tuple[\n24\t    str,\n25\t    Tuple[Tuple[int, int, str], ...],\n26\t    Tuple[Tuple[int, int, str], ...],\n27\t]\n28\t_POSE_LEVEL_BINDING_CACHE: Dict[PoseBindingCacheKey, Tuple[BindingPattern, ...]] = {}\n29\t\n30\t\n31\tdef supports_exact_pose_level_binding(operation_type: str) -> bool:\n32\t    profile = get_operation_port_profile(operation_type)\n33\t    return profile.generic_input_slots == 0 and profile.generic_output_slots == 0\n34\t\n35\t\n36\tdef clear_pose_level_binding_domain_cache() -> None:\n37\t    _POSE_LEVEL_BINDING_CACHE.clear()\n38\t\n39\t\n40\tdef enumerate_pose_level_port_bindings_with_cache_info(\n41\t    operation_type: str,\n42\t    pose: Mapping[str, Any],\n43\t) -> Tuple[BindingDomain, bool]:\n44\t    profile = get_operation_port_profile(operation_type)\n45\t    if profile.generic_input_slots or profile.generic_output_slots:\n46\t        raise ValueError(\n47\t            f\"{operation_type} still has generic hub slots; exact pose-level binding \"\n48\t            \"must be decided by a higher-level assignment model.\"\n49\t        )\n50\t\n51\t    ordered_input_cells = _ordered_port_cells(pose.get(\"input_port_cells\", []))\n52\t    ordered_output_cells = _ordered_port_cells(pose.get(\"output_port_cells\", []))\n53\t    cache_key = _pose_binding_cache_key(operation_type, ordered_input_cells, ordered_output_cells)\n54\t\n55\t    patterns = _POSE_LEVEL_BINDING_CACHE.get(cache_key)\n56\t    cache_hit = patterns is not None\n57\t    if patterns is None:\n58\t        input_patterns = _enumerate_side_binding_patterns(\n59\t            len(ordered_input_cells),\n60\t            profile.input_slots,\n61\t            port_type=\"input\",\n62\t        )\n63\t        output_patterns = _enumerate_side_binding_patterns(\n64\t            len(ordered_output_cells),\n65\t            profile.output_slots,\n66\t            port_type=\"output\",\n67\t        )\n68\t        patterns = tuple(product(input_patterns, output_patterns))\n69\t        _POSE_LEVEL_BINDING_CACHE[cache_key] = patterns\n70\t\n71\t    bindings: BindingDomain = []\n72\t    for input_pattern, output_pattern in patterns:\n73\t        input_ports = _materialize_side_binding(\n74\t            ordered_input_cells,\n75\t            input_pattern,\n76\t            port_type=\"input\",\n77\t        )\n78\t        output_ports = _materialize_side_binding(\n79\t            ordered_output_cells,\n80\t            output_pattern,"}]},"uuid":"05f4db29-08c4-41f9-889c-052093412a1a","timestamp":"2026-05-09T18:04:09.311Z","sourceToolAssistantUUID":"bf7db22f-d7e6-4f0f-861e-8fd1a868f6a5","userType":"external","entrypoint":"cli","cwd":"/home/zhuran24/claude-pj/zmd","sessionId":"7db7f276-a2bf-4762-b9b8-bb35f8cf3fb9","version":"2.1.138","gitBranch":"master","slu