benders_max_iter=int(benders_max_iter),\n108\t                disable_master_warm_start=bool(disable_master_warm_start),\n109\t                preloaded_exact_safe_cuts=tuple(dict(raw_cut) for raw_cut in raw_cuts),\n110\t            )\n111\t        )\n112\t    return tasks\n113\t\n114\t\n115\tdef _rss_bytes(process: psutil.Process) -> int:\n116\t    try:\n117\t        return int(process.memory_info().rss)\n118\t    except Exception:\n119\t        return 0\n120\t\n121\t\n122\tdef _worker_entry(\n123\t    *,\n124\t    worker_index: int,\n125\t    project_root: str,\n126\t    solve_mode: str,\n127\t    master_search_profile: str,\n128\t    task_queue: Any,\n129\t    result_queue: Any,\n130\t) -> None:\n131\t    # Phase 3C P1 #11 (PT-style portfolio): when EXACT_MASTER_RANDOM_SEED_BASE\n132\t    # is set in the parent process, dispatch per-worker random_seed = base +\n133\t    # worker_index. The master CpSolver (master_model.py) will then read\n134\t    # EXACT_MASTER_RANDOM_SEED at solve time and override its default seed,\n135\t    # giving each of the N processes a different CP-SAT search trajectory.\n136\t    # Default (env unset): no override → CP-SAT default seed → today's\n137\t    # behavior unchanged.\n138\t    seed_base_env = os.environ.get(\"EXACT_MASTER_RANDOM_SEED_BASE\")\n139\t    if seed_base_env:\n140\t        try:\n141\t            os.environ[\"EXACT_MASTER_RANDOM_SEED\"] = str(int(seed_base_env) + int(worker_index))\n142\t        except ValueError:\n143\t            pass\n144\t\n145\t    process = psutil.Process(os.getpid())\n146\t    peak_rss_bytes = _rss_bytes(process)\n147\t    priority_info = apply_process_priority_if_configured()\n148\t    try:\n149\t        session = create_exact_search_session(\n150\t            Path(project_root),\n151\t            solve_mode=solve_mode,\n152\t            master_search_profile=master_search_profile,\n153\t        )\n154\t        peak_rss_bytes = max(peak_rss_bytes, _rss_bytes(process))\n155\t        result_queue.put(\n156\t            {\n157\t                \"message_type\": \"READY\",\n158\t                \"worker_index\": int(worker_index),\n159\t                \"core_build_seconds\": float(session.core_build_seconds),\n160\t                \"peak_rss_bytes\": int(peak_rss_bytes),\n161\t                \"process_priority\": dict(priority_info),\n162\t            }\n163\t        )\n164\t    except Exception as exc:\n165\t        result_queue.put(\n166\t            {\n167\t                \"message_type\": \"STARTUP_ERROR\",\n168\t                \"worker_index\": int(worker_index),\n169\t                \"error\": f\"{type(exc).__name__}: {exc}\",\n170\t                \"process_priority\": dict(priority_info),\n171\t            }\n172\t        )\n173\t        return\n174\t\n175\t    while True:\n176\t        task = task_queue.get()\n177\t        if task is None:\n178\t            return\n179\t        started = time.perf_counter()\n180\t        peak_rss_bytes = max(peak_rss_bytes, _rss_bytes(process))\n181\t        try:\n182\t            _area, ghost_w, ghost_h = task.candidate\n183\t\n184\t            def _emit_worker_heartbeat(payload: Mapping[str, Any]) -> None:\n185\t                result_queue.put(\n186\t                    {\n187\t                        \"message_type\": \"HEARTBEAT\",\n188\t                        \"worker_index\": int(worker_index),\n189\t                        \"dispatch_seq\": int(task.dispatch_seq),\n190\t                        \"attempt_index\": int(task.attempt_index),\n191\t                        \"candidate\": (\n192\t                            int(task.candidate[0]),\n193\t                            int(task.candidate[1]),\n194\t                            int(task.candidate[2]),\n195\t                        ),\n196\t                        \"candidate_key\": task.candidate_key,\n197\t                        \"payload\": dict(payload),\n198\t                    }\n199\t                )\n200\t\n201\t            status, solutio