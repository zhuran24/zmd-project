\t            \"empty_binding_domain_instances\": [],\n141\t            \"binding_domain_cache_hits\": 0,\n142\t            \"binding_domain_cache_misses\": 0,\n143\t            \"binding_domain_reused_instances\": [],\n144\t            \"required_generic_outputs\": dict(self.required_generic_outputs),\n145\t            \"required_generic_inputs\": dict(self.required_generic_inputs),\n146\t        }\n147\t\n148\t        self.binding_domains: Dict[str, List[Dict[str, List[Dict[str, Any]]]]] = {}\n149\t        self.binding_vars: Dict[str, Dict[int, Any]] = {}\n150\t        self.fixed_binding_choice: Dict[str, int] = {}\n151\t        self.empty_binding_domain_instances: List[Dict[str, Any]] = []\n152\t        self.generic_output_slots: List[Dict[str, Any]] = []\n153\t        self.generic_output_vars: Dict[str, Dict[str, Any]] = {}\n154\t        self.generic_input_slots: List[Dict[str, Any]] = []\n155\t        self.generic_input_vars: Dict[str, Dict[str, Any]] = {}\n156\t        self.binding_domain_cache_hits = 0\n157\t        self.binding_domain_cache_misses = 0\n158\t        self.binding_domain_reused_instances: List[str] = []\n159\t\n160\t        self._materialize_pose_optional_instances()\n161\t\n162\t    def _materialize_pose_optional_instances(self) -> None:\n163\t        synthesized: List[str] = []\n164\t        missing: List[str] = []\n165\t\n166\t        for instance_id, sol in self.placement_solution.items():\n167\t            if instance_id in self.instances_by_id:\n168\t                continue\n169\t\n170\t            facility_type = str(sol.get(\"facility_type\", \"\"))\n171\t            operation_type = POSE_OPTIONAL_OPERATION_BY_TEMPLATE.get(facility_type)\n172\t            if operation_type is None and instance_id.startswith(\"pose_optional::\"):\n173\t                _, inferred_tpl, *_rest = instance_id.split(\"::\")\n174\t                operation_type = POSE_OPTIONAL_OPERATION_BY_TEMPLATE.get(inferred_tpl)\n175\t                if operation_type is not None:\n176\t                    facility_type = inferred_tpl\n177\t\n178\t            if operation_type is None:\n179\t                missing.append(instance_id)\n180\t                continue\n181\t\n182\t            self.instances_by_id[instance_id] = {\n183\t                \"instance_id\": instance_id,\n184\t                \"facility_type\": facility_type,\n185\t                \"operation_type\": operation_type,\n186\t                \"is_mandatory\": False,\n187\t                \"bound_type\": str(sol.get(\"bound_type\", \"exact_pose_optional\")),\n188\t                \"solve_mode\": str(sol.get(\"solve_mode\", \"unknown\")),\n189\t            }\n190\t            synthesized.append(instance_id)\n191\t\n192\t        self._conflict_summary[\"synthesized_instances\"] = synthesized\n193\t        self._conflict_summary[\"missing_instance_ids\"] = missing\n194\t\n195\t    def build(self) -> None:\n196\t        self._build_fixed_operation_domains()\n197\t        self._build_generic_input_domains()\n198\t        self._build_generic_output_domains()\n199\t        self._add_generic_input_requirements()\n200\t        self._add_generic_output_requirements()\n201\t        if self.empty_binding_domain_instances:\n202\t            self.model.Add(0 == 1)\n203\t        self._add_search_guidance()\n204\t        self._conflict_summary[\"generic_output_slot_count\"] = len(self.generic_output_slots)\n205\t        self._conflict_summary[\"generic_input_slot_count\"] = len(self.generic_input_slots)\n206\t\n207\t    def _resolve_instance(self, instance_id: str) -> Optional[Dict[str, Any]]:\n208\t        inst = self.instances_by_id.get(instance_id)\n209\t        if inst is not None:\n210\t            return inst\n211\t        self._conflict_summary.setdefault(\"missing_instance_ids\", []).append(instance_id)\n212\t        return None\n213\t\n214\t    def _resolve_pose(self, facility_type: str, pose_idx: int) -> Dict[str, Any]:\n215\t        pool = self.facility_pools.get(facility_type, [])\n216\t        if pose_idx < 0 or pose_idx >= len(pool):\n217\t            raise IndexError(\n218\t                f\"Pose index（位姿索引） out of range（越界）: {facility_type}[{pose_idx}]\"\n219\t            )\n220\t        return pool[pose_idx]\n221\t\n222\t    def _build_fixed_operation_domains(self) -> None:\n223\t        for instance_id, sol in self.placement_solution.items():\n224\t            inst = self._resolve_instance(instance_id)\n225\t            if not inst:\n226\t                continue\n227\t\n228\t            operation_type = str(inst.get(\"operation_type\", \"\"))\n229\t            if not operation_type or not supports_exact_pose_level_binding(operation_type):\n230\t                continue\n231\t\n232\t            tpl = str(sol[\"facility_type\"])\n233\t            pose = self._resolve_pose(tpl, int(sol[\"pose_idx\"]))\n234\t            domains, cache_hit = enumerate_pose_level_port_bindings_with_cache_info(\n235\t                operation_type,\n236\t                pose,\n237\t            )\n238\t            if cache_hit:\n239\t                self.binding_domain_cache_hits += 1\n240\t                self.binding_domain_reused_instances.append(instance_id)\n241\t            else:\n242\t                self.binding_domain_cache_misses += 1\n243\t            if not domains:\n244\t                empty_domain = {\n245\t                    \"instance_id\": instance_id,\n246\t                    \"facility_type\": tpl,\n247\t                    \"operation_type\": operation_type,\n248\t                    \"pose_idx\": int(sol[\"pose_idx\"]),\n249\t                    \"pose_id\": str(pose.get(\"pose_id\", \"\")),\n250\t                }\n251\t                self.empty_binding_domain_instances.append(empty_domain)\n252\t                self._conflict_summary[\"binding_domains\"][instance_id] = 0\n253\t                continue\n254\t\n255\t            self.binding_domains[instance_id] = domains\n256\t            self._conflict_summary[\"binding_domains\"][instance_id] = len(domains)\n257\t            if len(domains) == 1:\n258\t                self.fixed_binding_choice[instance_id] = 0\n259\t                continue\n260\t\n261\t            self.binding_vars[instance_id] = {}\n262\t            for idx in range(len(domains)):\n263\t                self.binding_vars[instance_id][idx] = self.model.NewBoolVar(\n264\t                    f\"bind_{instance_id}_{idx}\"\n265\t                )\n266\t            self.model.AddExactlyOne(list(self.binding_vars[instance_id].values()))\n267\t        self._conflict_summary[\"binding_domain_cache_hits\"] = int(self.binding_domain_cache_hits)\n268\t        self._conflict_summary[\"binding_domain_cache_misses\"] = int(self.binding_domain_cache_misses)\n269\t        self._conflict_summary[\"binding_domain_reused_instances\"] = list(\n270\t            self.binding_domain_reused_instances\n271\t        )\n272\t\n273\t    def _build_generic_output_domains(self) -> None:\n274\t        generic_commodities = sorted(self.required_generic_outputs.keys())\n275\t        if not generic_commodities:\n276\t            return\n277\t\n278\t        for instance_id, sol in self.placement_solution.items():\n279\t            inst = self._resolve_instance(instance_id)\n280\t            if not inst:\n281\t                continue\n282\t            operation_type = str(inst.get(\"operation_type\", \"\"))\n283\t            if operation_type not in {\"boundary_io\", \"protocol_core\"}:\n284\t                continue\n285\t\n286\t            tpl = str(sol[\"facility_type\"])\n287\t            pose = self._resolve_pose(tpl, int(sol[\"pose_idx\"]))\n288\t            for local_idx, port in enumerate(pose.get(\"output_port_cells\", [])):\n289\t                slot_id = f\"{instance_id}:out:{local_idx}\"\n290\t                slot = {\n291\t                    \"slot_id\": slot_id,\n292\t                    \"instance_id\": instance_id,\n293\t                    \"x\": int(port[\"x\"]),\n294\t         