{"parentUuid":"8c557722-1c38-40da-9671-f9411d5c1606","isSidechain":true,"promptId":"e4eec46c-71ba-49bc-9c29-ae4f56a40e97","agentId":"a3f5ff65abb3f99fa","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011fSvdCTkJXrkGpKE8BFVYk","type":"tool_result","content":"1\t\"\"\"\n2\tExact port-binding subproblem（精确端口绑定子问题）.\n3\t\n4\t职责：\n5\t1. 对固定摆放解选择 exact pose-level binding（精确位姿级端口绑定）。\n6\t2. 从预处理工件 generic_io_requirements.json（通用 I/O 需求工件）读取默认需求，\n7\t   不再在模型内部长期硬编码默认值。\n8\t3. 识别 pose_optional::...（位姿级可选设施）合成实例，尤其是\n9\t   protocol_storage_box（协议储存箱）与 power_pole（供电桩）。\n10\t4. 输出可持久化的 conflict summary（冲突摘要），供 exact campaign（精确战役）写盘。\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport json\n16\tfrom pathlib import Path\n17\tfrom typing import Any, Dict, List, Mapping, Optional, Sequence\n18\t\n19\tfrom ortools.sat.python import cp_model\n20\t\n21\tfrom src.models.cp_sat_worker_config import (\n22\t    DEFAULT_BINDING_CP_SAT_WORKERS,\n23\t    resolve_cp_sat_worker_count,\n24\t)\n25\tfrom src.models._cpsat_compat import search_branching_name\n26\tfrom src.models.port_binding import (\n27\t    enumerate_pose_level_port_bindings_with_cache_info,\n28\t    supports_exact_pose_level_binding,\n29\t)\n30\t\n31\tPROJECT_ROOT = Path(__file__).resolve().parent.parent.parent\n32\tGENERIC_IO_REQUIREMENTS_PATH = (\n33\t    PROJECT_ROOT / \"data\" / \"preprocessed\" / \"generic_io_requirements.json\"\n34\t)\n35\t\n36\tPOSE_OPTIONAL_OPERATION_BY_TEMPLATE = {\n37\t    \"protocol_storage_box\": \"wireless_sink\",\n38\t    \"power_pole\": \"power_supply\",\n39\t}\n40\t\n41\t\n42\t\n43\tdef load_generic_io_requirements(\n44\t    *,\n45\t    project_root: Optional[Path] = None,\n46\t    path: Optional[Path] = None,\n47\t) -> Dict[str, Dict[str, int]]:\n48\t    \"\"\"Load generic I/O requirements（加载通用 I/O 需求）.\n49\t\n50\t    Returns:\n51\t        {\n52\t            \"required_generic_outputs\": {...},\n53\t            \"required_generic_inputs\": {...},\n54\t        }\n55\t    \"\"\"\n56\t\n57\t    if path is None:\n58\t        root = project_root or PROJECT_ROOT\n59\t        path = root / \"data\" / \"preprocessed\" / \"generic_io_requirements.json\"\n60\t\n61\t    if not path.exists():\n62\t        raise FileNotFoundError(\n63\t            f\"Missing generic_io_requirements artifact（缺少通用 I/O 需求工件）: {path}\"\n64\t        )\n65\t\n66\t    payload = json.loads(path.read_text(encoding=\"utf-8\"))\n67\t    return {\n68\t        \"required_generic_outputs\": {\n69\t            str(k): int(v)\n70\t            for k, v in dict(payload.get(\"required_generic_outputs\", {})).items()\n71\t        },\n72\t        \"required_generic_inputs\": {\n73\t            str(k): int(v)\n74\t            for k, v in dict(payload.get(\"required_generic_inputs\", {})).items()\n75\t        },\n76\t    }\n77\t\n78\t\n79\tclass PortBindingModel:\n80\t    \"\"\"CP-SAT model（CP-SAT 模型）for exact port binding（精确端口绑定）.\"\"\"\n81\t\n82\t    def __init__(\n83\t        self,\n84\t        placement_solution: Mapping[str, Mapping[str, Any]],\n85\t        facility_pools: Mapping[str, List[Dict[str, Any]]],\n86\t        instances: Sequence[Mapping[str, Any]],\n87\t        required_generic_outputs: Optional[Mapping[str, int]] = None,\n88\t        required_generic_inputs: Optional[Mapping[str, int]] = None,\n89\t        project_root: Optional[Path] = None,\n90\t        io_requirements_path: Optional[Path] = None,\n91\t    ):\n92\t        self.project_root = project_root or PROJECT_ROOT\n93\t        self.io_requirements_path = io_requirements_path\n94\t        self.placement_solution = {\n95\t            str(instance_id): dict(sol)\n96\t            for instance_id, sol in placement_solution.items()\n97\t        }\n98\t        self.facility_pools = {tpl: list(pool) for tpl, pool in facility_pools.items()}\n99\t        self.instances_by_id = {\n100\t            str(inst[\"instance_id\"]): dict(inst)"}]},"uuid":"dbaa8eb6-a5f1-4221-a0c7-cab34dc5d589","timesta