 self.generic_input_vars[slot_id] = {}\n334\t                for commodity in slot_commodities:\n335\t                    self.generic_input_vars[slot_id][commodity] = self.model.NewBoolVar(\n336\t                        f\"slot_{slot_id}_{commodity}\"\n337\t                    )\n338\t                self.model.AddExactlyOne(list(self.generic_input_vars[slot_id].values()))\n339\t\n340\t    def _add_generic_input_requirements(self) -> None:\n341\t        for commodity, required in self.required_generic_inputs.items():\n342\t            vars_for_commodity = [\n343\t                commodity_vars[commodity]\n344\t                for commodity_vars in self.generic_input_vars.values()\n345\t                if commodity in commodity_vars\n346\t            ]\n347\t            if required == 0:\n348\t                for var in vars_for_commodity:\n349\t                    self.model.Add(var == 0)\n350\t                continue\n351\t            self.model.Add(sum(vars_for_commodity) == required)\n352\t\n353\t    def _add_generic_output_requirements(self) -> None:\n354\t        for commodity, required in self.required_generic_outputs.items():\n355\t            vars_for_commodity = [\n356\t                commodity_vars[commodity]\n357\t                for commodity_vars in self.generic_output_vars.values()\n358\t                if commodity in commodity_vars\n359\t            ]\n360\t            if required == 0:\n361\t                for var in vars_for_commodity:\n362\t                    self.model.Add(var == 0)\n363\t                continue\n364\t            self.model.Add(sum(vars_for_commodity) == required)\n365\t\n366\t    def _ordered_generic_slot_commodities(\n367\t        self,\n368\t        commodity_vars: Mapping[str, Any],\n369\t    ) -> List[str]:\n370\t        return sorted(\n371\t            commodity_vars,\n372\t            key=lambda commodity: (\n373\t                str(commodity) == \"__unused__\",\n374\t                str(commodity),\n375\t            ),\n376\t        )\n377\t\n378\t    def _add_search_guidance(self) -> None:\n379\t        binding_literals = 0\n380\t        generic_input_literals = 0\n381\t        generic_output_literals = 0\n382\t\n383\t        for instance_id in sorted(self.binding_vars):\n384\t            ordered_vars = [\n385\t                self.binding_vars[instance_id][idx]\n386\t                for idx in sorted(self.binding_vars[instance_id])\n387\t            ]\n388\t            if not ordered_vars:\n389\t                continue\n390\t            self.model.AddDecisionStrategy(\n391\t                ordered_vars,\n392\t                cp_model.CHOOSE_FIRST,\n393\t                cp_model.SELECT_MAX_VALUE,\n394\t            )\n395\t            binding_literals += len(ordered_vars)\n396\t\n397\t        for slot_id in sorted(self.generic_input_vars):\n398\t            ordered_vars = [\n399\t                self.generic_input_vars[slot_id][commodity]\n400\t                for commodity in self._ordered_generic_slot_commodities(\n401\t                    self.generic_input_vars[slot_id]\n402\t                )\n403\t            ]\n404\t            if not ordered_vars:\n405\t                continue\n406\t            self.model.AddDecisionStrategy(\n407\t                ordered_vars,\n408\t                cp_model.CHOOSE_FIRST,\n409\t                cp_model.SELECT_MAX_VALUE,\n410\t            )\n411\t            generic_input_literals += len(ordered_vars)\n412\t\n413\t        for slot_id in sorted(self.generic_output_vars):\n414\t            ordered_vars = [\n415\t                self.generic_output_vars[slot_id][commodity]\n416\t                for commodity in self._ordered_generic_slot_commodities(\n417\t                    self.generic_output_vars[slot_id]\n418\t                )\n419\t            ]\n420\t            if not ordered_vars:\n421\t                continue\n422\t            self.model.AddDecisionStrategy(\n423\t                ordered_vars,\n424\t                cp_model.CHOOSE_FIRST,\n425\t                cp_model.SELECT_MAX_VALUE,\n426\t            )\n427\t            generic_output_literals += len(ordered_vars)\n428\t\n429\t        self._conflict_summary[\"search_guidance\"] = {\n430\t            \"applied\": bool(\n431\t                binding_literals or generic_input_literals or generic_output_literals\n432\t            ),\n433\t            \"profile\": \"exact_binding_guided_branching_v1\",\n434\t            \"search_branching\": \"FIXED_SEARCH\",\n435\t            \"binding_literals\": int(binding_literals),\n436\t            \"generic_input_literals\": int(generic_input_literals),\n437\t            \"generic_output_literals\": int(generic_output_literals),\n438\t        }\n439\t\n440\t    def solve(self, time_limit_seconds: float = 30.0) -> str:\n441\t        solver = cp_model.CpSolver()\n442\t        solver.parameters.max_time_in_seconds = float(time_limit_seconds)\n443\t        solver.parameters.num_workers = resolve_cp_sat_worker_count(\n444\t            env_name=\"EXACT_BINDING_CP_SAT_WORKERS\",\n445\t            default=DEFAULT_BINDING_CP_SAT_WORKERS,\n446\t        )\n447\t        solver.parameters.search_branching = cp_model.FIXED_SEARCH\n448\t        solver.parameters.symmetry_level = max(int(solver.parameters.symmetry_level), 3)\n449\t        solver.parameters.cp_model_probing_level = max(\n450\t            int(solver.parameters.cp_model_probing_level),\n451\t            3,\n452\t        )\n453\t        status = solver.Solve(self.model)\n454\t        self._solver = solver\n455\t        self._status = status\n456\t\n457\t        self._conflict_summary[\"solver_status\"] = solver.StatusName(status)\n458\t        self._conflict_summary[\"wall_time\"] = solver.WallTime()\n459\t        self._conflict_summary[\"search_profile\"] = str(\n460\t            self._conflict_summary.get(\"search_guidance\", {}).get(\n461\t                \"profile\",\n462\t                \"exact_binding_guided_branching_v1\",\n463\t            )\n464\t        )\n465\t        self._conflict_summary[\"search_branching\"] = search_branching_name(\n466\t            solver.parameters.search_branching\n467\t        )\n468\t\n469\t        if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):\n470\t            return \"FEASIBLE\"\n471\t        if status == cp_model.INFEASIBLE:\n472\t            return \"INFEASIBLE\"\n473\t        return \"TIMEOUT\"\n474\t\n475\t    def extract_selection(self) -> Dict[str, Any]:\n476\t        if self._status not in (cp_model.OPTIMAL, cp_model.FEASIBLE):\n477\t            return {}\n478\t\n479\t        selection = {\n480\t            \"binding_choice\": {},\n481\t            \"generic_inputs\": {},\n482\t            \"generic_outputs\": {},\n483\t        }\n484\t\n485\t        for instance_id, choice in self.fixed_binding_choice.items():\n486\t            selection[\"binding_choice\"][instance_id] = choice\n487\t\n488\t        for instance_id, vars_by_idx in self.binding_vars.items():\n489\t            for idx, var in vars_by_idx.items():\n490\t                if self._solver is not None and self._solver.Value(var) == 1:\n491\t                    selection[\"binding_choice\"][instance_id] = idx\n492\t                    break\n493\t\n494\t        for slot in self.generic_input_slots:\n495\t            slot_id = slot[\"slot_id\"]\n496\t            for commodity, var in self.generic_input_vars[slot_id].items():\n497\t                if self._solver is not None and self._solver.Value(var) == 1:\n498\t                    selection[\"generic_inputs\"][slot_id] = commodity\n499\t                    break"}]},"uuid":"d0534f02-0246-4307-b0d2-9e44ee46b7e7","timestamp":"2026-05-08T01:52:41.411Z","sourceToolAssistantUUID":"d9d2fb1e-980d-4eb5-8a82-d61dc418a092","userType":"external","entrypoint":"cli","cwd":"D:\\claude pj\\zmd","sessionId":"7db7f276-a2bf-4762-b9b8-bb35f8cf3fb9","version":"2.1.128","gitBranch":"master","slug":"squishy-zooming-sphinx"}
