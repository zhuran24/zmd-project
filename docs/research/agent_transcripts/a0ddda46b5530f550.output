{"parentUuid":"cbc69860-cb06-44f7-be77-500a863c5406","isSidechain":true,"promptId":"56e72661-9c70-4718-ac89-40d9fd2179ff","agentId":"a0ddda46b5530f550","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015oYiCMovMteCetr7gvNUPw","type":"tool_result","content":"1\t\"\"\"\n2\tExact campaign state manager（精确战役状态管理器）.\n3\t\n4\t职责：\n5\t1. 计算 certified exact（严格认证精确）输入工件哈希。\n6\t2. 管理最长 168 小时级 campaign state（战役状态）持久化。\n7\t3. 只有在 schema / mode / artifact hash / required fields 一致时才允许恢复。\n8\t4. 为每个候选空地保存 strictly valid evidence（严格有效证据）与 exact-safe cuts（精确安全 cuts）。\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\timport calendar\n14\timport hashlib\n15\timport json\n16\timport os\n17\timport tempfile\n18\timport time\n19\tfrom dataclasses import dataclass\n20\tfrom pathlib import Path\n21\tfrom typing import Any, Dict, Mapping, Optional, Tuple\n22\t\n23\tDEFAULT_CAMPAIGN_FILENAME = \"exact_campaign_state.json\"\n24\tCAMPAIGN_SCHEMA_VERSION = 3\n25\tPROOF_SUMMARY_SCHEMA_VERSION = 1\n26\tVALID_CANDIDATE_STATUSES = {\n27\t    \"RUNNING\",\n28\t    \"CERTIFIED\",\n29\t    \"INFEASIBLE\",\n30\t    \"UNKNOWN\",\n31\t    \"UNPROVEN\",\n32\t}\n33\tREQUIRED_STATE_FIELDS = {\n34\t    \"schema_version\",\n35\t    \"solve_mode\",\n36\t    \"campaign_hours\",\n37\t    \"created_at\",\n38\t    \"updated_at\",\n39\t    \"artifact_hashes\",\n40\t    \"proof_summary_schema_version\",\n41\t    \"reset_reason\",\n42\t    \"final_result\",\n43\t    \"final_status\",\n44\t    \"last_stop_reason\",\n45\t    \"candidates\",\n46\t}\n47\tREQUIRED_CANDIDATE_FIELDS = {\n48\t    \"ghost_rect\",\n49\t    \"attempts\",\n50\t    \"started_at\",\n51\t    \"updated_at\",\n52\t    \"finished_at\",\n53\t    \"status\",\n54\t    \"proof_summary\",\n55\t    \"exact_safe_cuts\",\n56\t    \"loaded_exact_safe_cut_count\",\n57\t    \"generated_exact_safe_cut_count\",\n58\t}\n59\t\n60\tEXACT_HASH_FILES = {\n61\t    \"mandatory_exact_instances\": \"data/preprocessed/mandatory_exact_instances.json\",\n62\t    \"candidate_placements\": \"data/preprocessed/candidate_placements.json\",\n63\t    \"canonical_rules\": \"rules/canonical_rules.json\",\n64\t    \"generic_io_requirements\": \"data/preprocessed/generic_io_requirements.json\",\n65\t}\n66\t\n67\t\n68\tdef now_ts() -> float:\n69\t    return time.time()\n70\t\n71\t\n72\tdef now_iso() -> str:\n73\t    return time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime(now_ts()))\n74\t\n75\t\n76\tdef iso_to_ts(iso_text: str) -> float:\n77\t    try:\n78\t        return float(calendar.timegm(time.strptime(iso_text, \"%Y-%m-%dT%H:%M:%SZ\")))\n79\t    except Exception:\n80\t        return now_ts()\n81\t\n82\t\n83\tdef sha256_file(path: Path) -> str:\n84\t    if not path.exists():\n85\t        raise FileNotFoundError(path)\n86\t    digest = hashlib.sha256()\n87\t    with path.open(\"rb\") as fh:\n88\t        while True:\n89\t            chunk = fh.read(1024 * 1024)\n90\t            if not chunk:\n91\t                break\n92\t            digest.update(chunk)\n93\t    return digest.hexdigest()\n94\t\n95\t\n96\tdef compute_exact_artifact_hashes(project_root: Path) -> Dict[str, str]:\n97\t    hashes: Dict[str, str] = {}\n98\t    for key, relative_path in EXACT_HASH_FILES.items():\n99\t        hashes[key] = sha256_file(project_root / relative_path)\n100\t    return hashes\n101\t\n102\t\n103\tdef candidate_key(ghost_w: int, ghost_h: int) -> str:\n104\t    return f\"{ghost_w}x{ghost_h}\"\n105\t\n106\t\n107\tdef _candidate_objective_from_rect(ghost_w: int, ghost_h: int) -> Tuple[int, int]:\n108\t    return (int(ghost_w) * int(ghost_h), min(int(ghost_w), int(ghost_h)))\n109\t\n110\t\n111\tdef _final_result_objective(result: Mapping[str, Any]) -> Tuple[int, int]:\n112\t    ghost_rect = result.get(\"ghost_rect\")\n113\t    if not isinstance(ghost_rect, Mapping):\n114\t        return (0, 0)\n115\t    try:\n116\t        ghost_w = int(ghost_rect.get(\"w\", 0))\n117\t        ghost_h = int(ghost_rect.get(\"h\", 0))\n118\t    except Exception:\n119\t        return (0, 0)\n120\t    return _candidate_objective_from_rect(ghost_w, ghost_h)\n121\t\n122\t\n123\tdef _has_certified_final_result(state: Mapping[str, Any]) -> bool:\n124\t    return isinstance(state.get(\"final_result\"), Mapping)\n125\t\n126\t\n127\tdef _fsync_directory(path: Path) -> None:\n128\t    try:\n129\t        dir_fd = os.open(str(path), os.O_RDONLY)\n130\t    except Exception:\n131\t        return\n132\t    try:\n133\t        os.fsync(dir_fd)\n134\t    except Exception:\n135\t        pass\n136\t    finally:\n137\t        os.close(dir_fd)\n138\t\n139\t\n140\tdef atomic_write_json(path: Path, payload: Mapping[str, Any]) -> None:\n141\t    path.parent.mkdir(parents=True, exist_ok=True)\n142\t    fd, raw_tmp_path = tempfile.mkstemp(\n143\t        prefix=f\".{path.name}.tmp-\",\n144\t        suffix=\".json\",\n145\t        dir=str(path.parent),\n146\t    )\n147\t    tmp_path = Path(raw_tmp_path)\n148\t    try:\n149\t        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as handle:\n150\t            json.dump(payload, handle, indent=2, ensure_ascii=False)\n151\t            handle.flush()\n152\t            os.fsync(handle.fileno())\n153\t        os.replace(str(tmp_path), str(path))\n154\t        _fsync_directory(path.parent)\n155\t    finally:\n156\t        if tmp_path.exists():\n157\t            try:\n158\t                tmp_path.unlink()\n159\t            except Exception:\n160\t                pass\n161\t\n162\t\n163\tdef _candidate_defaults(ghost_w: int, ghost_h: int) -> Dict[str, Any]:\n164\t    return {\n165\t        \"ghost_rect\": {\"w\": int(ghost_w), \"h\": int(ghost_h), \"area\": int(ghost_w) * int(ghost_h)},\n166\t        \"attempts\": 0,\n167\t        \"started_at\": None,\n168\t        \"updated_at\": None,\n169\t        \"finished_at\": None,\n170\t        \"status\": \"UNKNOWN\",\n171\t        \"proof_summary\": {},\n172\t        \"exact_safe_cuts\": [],\n173\t        \"loaded_exact_safe_cut_count\": 0,\n174\t        \"generated_exact_safe_cut_count\": 0,\n175\t    }\n176\t\n177\t\n178\tdef _build_initial_state(\n179\t    *,\n180\t    current_hashes: Mapping[str, str],\n181\t    campaign_hours: float,\n182\t    reset_reason: Optional[str],\n183\t) -> Dict[str, Any]:\n184\t    timestamp = now_iso()\n185\t    return {\n186\t        \"schema_version\": CAMPAIGN_SCHEMA_VERSION,\n187\t        \"solve_mode\": \"certified_exact\",\n188\t        \"campaign_hours\": float(campaign_hours),\n189\t        \"created_at\": timestamp,\n190\t        \"updated_at\": timestamp,\n191\t        \"artifact_hashes\": {str(k): str(v) for k, v in current_hashes.items()},\n192\t        \"proof_summary_schema_version\": PROOF_SUMMARY_SCHEMA_VERSION,\n193\t        \"reset_reason\": reset_reason,\n194\t        \"final_result\": None,\n195\t        \"final_status\": None,\n196\t        \"last_stop_reason\": None,\n197\t        \"candidates\": {},\n198\t    }\n199\t\n200\t\n201\tdef _validate_candidate_record(record_key: str, record: Mapping[str, Any]) -> Optional[str]:\n202\t    missing = sorted(REQUIRED_CANDIDATE_FIELDS.difference(record.keys()))\n203\t    if missing:\n204\t        return f\"candidate_missing_field:{record_key}:{missing[0]}\"\n205\t\n206\t    ghost_rect = record.get(\"ghost_rect\")\n207\t    if not isinstance(ghost_rect, Mapping):\n208\t        return f\"candidate_invalid_ghost_rect:{record_key}\"\n209\t    for field in (\"w\", \"h\", \"area\"):\n210\t        if field not in ghost_rect:\n211\t            return f\"candidate_missing_ghost_rect_field:{record_key}:{field}\"\n212\t\n213\t    try:\n214\t        int(record.get(\"attempts\", 0))\n215\t        int(record.get(\"loaded_exact_safe_cut_count\", 0))\n216\t        int(record.get(\"generated_exact_safe_cut_count\", 0))\n217\t    except Exception:\n218\t        return f\"candidate_invalid_count:{record_key}\"\n219\t\n220\t    status = str(record.get(\"status\", \"\"))\n221\t    if status not in VALID_CANDIDATE_STATUSES:\n222\t        return f\"candidate_invalid_status:{record_key}:{status}\"\n223\t\n224\t    if not isinstance(record.get(\"proof_summary\"), Mapping):\n225\t        return f\"candidate_invalid_proof_summary:{record_key}\"\n226\t    if not isinstance(record.get(\"exact_safe_cuts\"), list):\n227\t        return f\"candidate_invalid_exact_safe_cuts:{record_key}\"\n228\t\n229\t    for field in (\"started_at\", \"updated_at\"):\n230\t        if record.get(field) is None:\n231\t            return f\"candidate_missing_timestamp:{record_key}:{field}\"\n232\t    if status == \"RUNNING\" and record.get(\"finished_at\") is not None:\n233\t        return f\"candidate_running_has_finished_at:{record_key}\"\n234\t    if status != \"RUNNING\" and record.get(\"finished_at\") is None:\n235\t        return f\"candidate_terminal_missing_finished_at:{record_key}\"\n236\t    return None\n237\t\n238\t\n239\tdef _validate_resume_state(\n240\t    state: Mapping[str, Any],\n241\t    *,\n242\t    current_hashes: Mapping[str, str],\n243\t) -> Optional[str]:\n244\t    missing = sorted(REQUIRED_STATE_FIELDS.difference(state.keys()))\n245\t    if missing:\n246\t        return f\"missing_state_field:{missing[0]}\"\n247\t    if int(state.get(\"schema_version\", -1)) != CAMPAIGN_SCHEMA_VERSION:\n248\t        return \"schema_version_mismatch\"\n249\t    if str(state.get(\"solve_mode\")) != \"certified_exact\":\n250\t        return \"solve_mode_mismatch\"\n251\t    if int(state.get(\"proof_summary_schema_version\", -1)) != PROOF_SUMMARY_SCHEMA_VERSION:\n252\t        return \"proof_summary_schema_version_mismatch\"\n253\t    if not isinstance(state.get(\"artifact_hashes\"), Mapping):\n254\t        return \"artifact_hashes_invalid\"\n255\t    if dict(state.get(\"artifact_hashes\", {})) != dict(current_hashes):\n256\t        return \"artifact_hash_mismatch\"\n257\t    if not isinstance(state.get(\"candidates\"), Mapping):\n258\t        return \"candidates_invalid\"\n259\t    if state.get(\"last_stop_reason\") is not None:\n260\t        stop_reason = state.get(\"last_stop_reason\")\n261\t        if not isinstance(stop_reason, Mapping) or \"reason\" not in stop_reason:\n262\t            return \"last_stop_reason_invalid\"\n263\t    final_result = state.get(\"final_result\")\n264\t    final_status = state.get(\"final_status\")\n265\t    if final_result is not None and not isinstance(final_result, Mapping):\n266\t        return \"final_result_invalid\"\n267\t    if final_status is not None and not isinstance(final_status, str):\n268\t        return \"final_status_invalid\"\n269\t    if final_result is not None and final_status != \"CERTIFIED\":\n270\t        return \"final_status_mismatch\"\n271\t\n272\t    for record_key, record in dict(state.get(\"candidates\", {})).items():\n273\t        if not isinstance(record, Mapping):\n274\t            return f\"candidate_invalid:{record_key}\"\n275\t        reason = _validate_candidate_record(str(record_key), record)\n276\t        if reason is not None:\n277\t            return reason\n278\t    return None\n279\t\n280\t\n281\tdef validate_exact_campaign_resume_state(\n282\t    state: Mapping[str, Any],\n283\t    current_hashes: Mapping[str, str],\n284\t) -> Optional[str]:\n285\t    return _validate_resume_state(state, current_hashes=current_hashes)\n286\t\n287\t\n288\t@dataclass\n289\tclass ExactCampaign:\n290\t    project_root: Path\n291\t    path: Path\n292\t    state: Dict[str, Any]\n293\t    resumed: bool\n294\t    compatible_hashes: bool\n295\t\n296\t    @classmethod\n297\t    def load_or_create(\n298\t        cls,\n299\t        project_root: Path,\n300\t        campaign_hours: float = 168.0,\n301\t        resume: bool = False,\n302\t        filename: str = DEFAULT_CAMPAIGN_FILENAME,\n303\t    ) -> \"ExactCampaign\":\n304\t        checkpoints_dir = project_root / \"data\" / \"checkpoints\"\n305\t        checkpoints_dir.mkdir(parents=True, exist_ok=True)\n306\t        path = checkpoints_dir / filename\n307\t        current_hashes = compute_exact_artifact_hashes(project_root)\n308\t\n309\t        reset_reason: Optional[str] = None\n310\t        if resume and path.exists():\n311\t            try:\n312\t                loaded_state = json.loads(path.read_text(encoding=\"utf-8\"))\n313\t            except Exception:\n314\t                reset_reason = \"state_json_invalid\"\n315\t            else:\n316\t                if isinstance(loaded_state, Mapping):\n317\t                    reset_reason = _validate_resume_state(\n318\t                        loaded_state,\n319\t                        current_hashes=current_hashes,\n320\t                    )\n321\t                    if reset_reason is None:\n322\t                        state = dict(loaded_state)\n323\t                        state[\"updated_at\"] = now_iso()\n324\t                        state[\"reset_reason\"] = None\n325\t                        # Allow extending campaign budget on resume\n326\t                        if campaign_hours > float(state.get(\"campaign_hours\", 0)):\n327\t                            state[\"campaign_hours\"] = float(campaign_hours)\n328\t                        # Clear time-budget-exhausted stop so campaign can continue\n329\t                        stop = state.get(\"last_stop_reason\")\n330\t                        if (\n331\t                            isinstance(stop, Mapping)\n332\t                            and stop.get(\"reason\") == \"campaign_time_budget_exhausted\"\n333\t                        ):\n334\t                            state[\"last_stop_reason\"] = None\n335\t                            state[\"final_status\"] = None\n336\t                        return cls(\n337\t                            project_root=project_root,\n338\t                            path=path,\n339\t                            state=state,\n340\t                            resumed=True,\n341\t                            compatible_hashes=True,\n342\t                        )\n343\t                else:\n344\t                    reset_reason = \"state_payload_invalid\"\n345\t\n346\t        state = _build_initial_state(\n347\t            current_hashes=current_hashes,\n348\t            campaign_hours=campaign_hours,\n349\t            reset_reason=reset_reason,\n350\t        )\n351\t        return cls(\n352\t            project_root=project_root,\n353\t            path=path,\n354\t            state=state,\n355\t            resumed=False,\n356\t            compatible_hashes=(reset_reason is None),\n357\t        )\n358\t\n359\t    @property\n360\t    def artifact_hashes(self) -> Dict[str, str]:\n361\t        return dict(self.state.get(\"artifact_hashes\", {}))\n362\t\n363\t    @property\n364\t    def campaign_hours(self) -> float:\n365\t        return float(self.state.get(\"campaign_hours\", 168.0))\n366\t\n367\t    @property\n368\t    def reset_reason(self) -> Optional[str]:\n369\t        value = self.state.get(\"reset_reason\")\n370\t        return None if value is None else str(value)\n371\t\n372\t    def remaining_seconds(self) -> float:\n373\t        created_at = str(self.state.get(\"created_at\", now_iso()))\n374\t        elapsed = max(0.0, now_ts() - iso_to_ts(created_at))\n375\t        return max(0.0, self.campaign_hours * 3600.0 - elapsed)\n376\t\n377\t    def is_compatible_with_current_hashes(self) -> bool:\n378\t        return self.state.get(\"artifact_hashes\") == compute_exact_artifact_hashes(self.project_root)\n379\t\n380\t    def get_candidate_record(self, ghost_w: int, ghost_h: int) -> Optional[Dict[str, Any]]:\n381\t        record = self.state.get(\"candidates\", {}).get(candidate_key(ghost_w, ghost_h))\n382\t        return dict(record) if isinstance(record, dict) else None\n383\t\n384\t    def get_candidate_cuts(self, ghost_w: int, ghost_h: int) -> list[Dict[str, Any]]:\n385\t        record = self.get_candidate_record(ghost_w, ghost_h) or {}\n386\t        return list(record.get(\"exact_safe_cuts\", []))\n387\t\n388\t    def mark_candidate_started(self, ghost_w: int, ghost_h: int) -> None:\n389\t        key = candidate_key(ghost_w, ghost_h)\n390\t        candidates = self.state.setdefault(\"candidates\", {})\n391\t        existing = candidates.get(key, {})\n392\t        record = _candidate_defaults(ghost_w, ghost_h)\n393\t        if isinstance(existing, Mapping):\n394\t            record.update(dict(existing))\n395\t\n396\t        timestamp = now_iso()\n397\t        record[\"status\"] = \"RUNNING\"\n398\t        record[\"attempts\"] = int(record.get(\"attempts\", 0)) + 1\n399\t        record[\"started_at\"] = timestamp\n400\t        record[\"updated_at\"] = timestamp\n401\t        record[\"finished_at\"] = None\n402\t\n403\t        candidates[key] = record\n404\t        self.state[\"last_stop_reason\"] = None\n405\t        if self.state.get(\"final_result\") is None:\n406\t            self.state[\"final_status\"] = None\n407\t        self.state[\"updated_at\"] = timestamp\n408\t\n409\t    def mark_candidate_result(\n410\t        self,\n411\t        ghost_w: int,\n412\t        ghost_h: int,\n413\t        status: str,\n414\t        *,\n415\t        exact_safe_cuts: Optional[list[Mapping[str, Any]]] = None,\n416\t        solution: Optional[Mapping[str, Any]] = None,\n417\t        proof_summary: Optional[Mapping[str, Any]] = None,\n418\t        loaded_exact_safe_cut_count: Optional[int] = None,\n419\t        generated_exact_safe_cut_count: Optional[int] = None,\n420\t    ) -> None:\n421\t        key = candidate_key(ghost_w, ghost_h)\n422\t        candidates = self.state.setdefault(\"candidates\", {})\n423\t        existing = candidates.get(key, {})\n424\t        record = _candidate_defaults(ghost_w, ghost_h)\n425\t        if isinstance(existing, Mapping):\n426\t            record.update(dict(existing))\n427\t\n428\t        timestamp = now_iso()\n429\t        record[\"status\"] = str(status)\n430\t        record[\"updated_at\"] = timestamp\n431\t        record[\"finished_at\"] = timestamp\n432\t        if record.get(\"started_at\") is None:\n433\t            record[\"started_at\"] = timestamp\n434\t        record[\"proof_summary\"] = dict(proof_summary or {})\n435\t\n436\t        if exact_safe_cuts is not None:\n437\t            record[\"exact_safe_cuts\"] = [dict(cut) for cut in exact_safe_cuts]\n438\t        else:\n439\t            record[\"exact_safe_cuts\"] = list(record.get(\"exact_safe_cuts\", []))\n440\t\n441\t        if loaded_exact_safe_cut_count is not None:\n442\t            record[\"loaded_exact_safe_cut_count\"] = int(loaded_exact_safe_cut_count)\n443\t        else:\n444\t            record[\"loaded_exact_safe_cut_count\"] = int(record.get(\"loaded_exact_safe_cut_count\", 0))\n445\t\n446\t        if generated_exact_safe_cut_count is not None:\n447\t            record[\"generated_exact_safe_cut_count\"] = int(generated_exact_safe_cut_count)\n448\t        else:\n449\t            record[\"generated_exact_safe_cut_count\"] = int(\n450\t                record.get(\"generated_exact_safe_cut_count\", 0)\n451\t            )\n452\t\n453\t        if solution is not None and status == \"CERTIFIED\":\n454\t            record[\"solution\"] = dict(solution)\n455\t            candidate_result = {\n456\t                \"ghost_rect\": {\"w\": ghost_w, \"h\": ghost_h, \"area\": ghost_w * ghost_h},\n457\t                \"placement_solution\": dict(solution),\n458\t                \"search_status\": status,\n459\t                \"search_stats\": {\n460\t                    \"campaign_resumed\": self.resumed,\n461\t                    \"timestamp\": timestamp,\n462\t                },\n463\t            }\n464\t            existing_result = self.state.get(\"final_result\")\n465\t            if not isinstance(existing_result, Mapping) or _candidate_objective_from_rect(\n466\t                ghost_w,\n467\t                ghost_h,\n468\t            ) >= _final_result_objective(existing_result):\n469\t                self.state[\"final_result\"] = candidate_result\n470\t                self.state[\"final_status\"] = \"CERTIFIED\"\n471\t                self.state[\"last_stop_reason\"] = None\n472\t        elif status != \"CERTIFIED\":\n473\t            record.pop(\"solution\", None)\n474\t\n475\t        candidates[key] = record\n476\t        self.state[\"updated_at\"] = timestamp\n477\t\n478\t    def update_candidate_running_proof_summary(\n479\t        self,\n480\t        ghost_w: int,\n481\t        ghost_h: int,\n482\t        proof_summary: Mapping[str, Any],\n483\t    ) -> None:\n484\t        key = candidate_key(ghost_w, ghost_h)\n485\t        candidates = self.state.setdefault(\"candidates\", {})\n486\t        existing = candidates.get(key, {})\n487\t        record = _candidate_defaults(ghost_w, ghost_h)\n488\t        if isinstance(existing, Mapping):\n489\t            record.update(dict(existing))\n490\t\n491\t        if str(record.get(\"status\")) != \"RUNNING\":\n492\t            return\n493\t\n494\t        timestamp = now_iso()\n495\t        existing_summary = record.get(\"proof_summary\")\n496\t        merged_summary = dict(existing_summary) if isinstance(existing_summary, Mapping) else {}\n497\t        merged_summary.update(dict(proof_summary or {}))\n498\t        record[\"proof_summary\"] = merged_summary\n499\t        record[\"updated_at\"] = timestamp\n500\t        candidates[key] = record\n501\t        self.state[\"updated_at\"] = timestamp\n502\t\n503\t    def mark_campaign_stopped(self, reason: str, status: Optional[str] = None) -> None:\n504\t        timestamp = now_iso()\n505\t        stop_record = {\n506\t            \"reason\": str(reason),\n507\t            \"status\": None if status is None else str(status),\n508\t            \"updated_at\": timestamp,\n509\t        }\n510\t        self.state[\"last_stop_reason\"] = stop_record\n511\t        if status is not None:\n512\t            if _has_certified_final_result(self.state) and str(status) != \"CERTIFIED\":\n513\t                self.state[\"final_status\"] = \"CERTIFIED\"\n514\t        