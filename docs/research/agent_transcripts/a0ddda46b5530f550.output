  build_phase3b_anchor119_guard_runtime_state,\n53\t    build_phase3b_anchor119_guard_runtime_decision,\n54\t)\n55\tfrom src.search.phase3b_anchor119_guarded_precheck_runtime import (\n56\t    evaluate_phase3b_anchor119_guarded_precheck_advisory,\n57\t)\n58\tfrom src.search.exact_campaign import ExactCampaign, compute_exact_artifact_hashes, now_iso\n59\t\n60\tPROJECT_ROOT = Path(__file__).resolve().parent.parent.parent\n61\tEXACT_REQUIRED_ARTIFACTS = {\n62\t    \"mandatory_exact_instances\": \"data/preprocessed/mandatory_exact_instances.json\",\n63\t    \"candidate_placements\": \"data/preprocessed/candidate_placements.json\",\n64\t    \"generic_io_requirements\": \"data/preprocessed/generic_io_requirements.json\",\n65\t    \"canonical_rules\": \"rules/canonical_rules.json\",\n66\t}\n67\t\n68\t_EXACT_INTERNAL_STATUS_MASTER_CUT_ADDED_CONTINUE = \"master_cut_added_continue\"\n69\t_CERTIFIED_SOLVE_MODES = {\"certified_exact\", \"exploratory\"}\n70\t_CampaignHeartbeatCallback = Callable[[Mapping[str, Any]], None]\n71\t_PRE_MASTER_MANDATORY_RECTANGLE_PRECHECK_MAX_ANCHORS = 32\n72\t_PRE_MASTER_MANDATORY_RECTANGLE_PRECHECK_MAX_ANCHORS_ENV = (\n73\t    \"EXACT_PRE_MASTER_MANDATORY_RECTANGLE_PRECHECK_MAX_ANCHORS\"\n74\t)\n75\t_PRE_MASTER_COORDINATE_VALIDATION_PRECHECK_MAX_ANCHORS = 0\n76\t_PRE_MASTER_COORDINATE_VALIDATION_PRECHECK_MAX_ANCHORS_ENV = (\n77\t    \"EXACT_PRE_MASTER_COORDINATE_VALIDATION_PRECHECK_MAX_ANCHORS\"\n78\t)\n79\t_PRE_MASTER_COORDINATE_VALIDATION_PRECHECK_SECONDS = 2.0\n80\t_PRE_MASTER_COORDINATE_VALIDATION_PRECHECK_SECONDS_ENV = (\n81\t    \"EXACT_PRE_MASTER_COORDINATE_VALIDATION_PRECHECK_SECONDS\"\n82\t)\n83\tEXACT_MASTER_CP_SAT_LOG_HEARTBEAT_LINES_ENV = (\n84\t    \"EXACT_MASTER_CP_SAT_LOG_HEARTBEAT_LINES\"\n85\t)\n86\tEXACT_MASTER_CP_SAT_LOG_HEARTBEAT_MAX_CHARS_ENV = (\n87\t    \"EXACT_MASTER_CP_SAT_LOG_HEARTBEAT_MAX_CHARS\"\n88\t)\n89\t\n90\t\n91\tdef _normalize_solve_mode(\n92\t    solve_mode: Optional[str] = None,\n93\t    certification_mode: Optional[bool] = None,\n94\t) -> str:\n95\t    if certification_mode is not None:\n96\t        return \"certified_exact\" if certification_mode else \"exploratory\"\n97\t    if solve_mode is None:\n98\t        return \"certified_exact\"\n99\t    if solve_mode not in {\"certified_exact\", \"exploratory\"}:\n100\t        raise ValueError(f\"Unsupported solve mode: {solve_mode}\")\n101\t    return solve_mode\n102\t\n103\t\n104\tdef _maybe_attach_anchor119_row_domain_guard_advisory(\n105\t    master_candidate_precheck_payload: Dict[str, Any],\n106\t    *,\n107\t    project_root: Path,\n108\t    ghost_w: int,\n109\t    ghost_h: int,\n110\t) -> None:\n111\t    advisory = evaluate_phase3b_anchor119_guarded_precheck_advisory(\n112\t        project_root=project_root,\n113\t        ghost_w=int(ghost_w),\n114\t        ghost_h=int(ghost_h),\n115\t        anchor_idx=PHASE3B_ANCHOR119_ANCHOR_IDX,\n116\t    )\n117\t    if not bool(advisory.get(\"enabled\", False)):\n118\t        return\n119\t    proof_summary = advisory.get(\"proof_summary\")\n120\t    if not isinstance(proof_summary, Mapping):\n121\t        return\n122\t    guard_payload = proof_summary.get(\"anchor119_mixed_lane_guarded_precheck\")\n123\t    if not isinstance(guard_payload, Mapping):\n124\t        return\n125\t    runtime_decision = build_phase3b_anchor119_guard_runtime_decision(\n126\t        requested_state=guard_payload.get(\"requested_state\"),\n127\t        effective_state=guard_payload.get(\"effective_state\"),\n128\t        runtime_activation_allowed=bool(\n129\t            guard_payload.get(\"runtime_activation_allowed\", False)\n130\t        ),\n131\t        would_trigger=bool(advisory.get(\"would_trigger\", False)),\n132\t        triggered=bool(advisory.get(\"triggered\", False)),\n133\t        reason=advisory.get(\"reason\"),\n134\t        runtime_enablement_blockers=list(\n135\t            guard_payload.get(\"runtime_enablement_blockers\", [])\n136\t        )\n137\t        if isinstance(guard_payload.get(\"runtime_enablement_blockers\"), list)\n138\t        else [],\n139\t    )\n140\t    master_candidate_precheck_payload[\"anchor119_row_domain_guard_advisory\"] = {\n141\t        \"enabled\": True,\n142\t        \"would_trigger\": bool(advisory.get(\"would_trigger\", False)),\n143\t        \"triggered\": bool(advisory.get(\"triggered\", False)),\n144\t        \"reason\": advisory.get(\"reason\"),\n145\t        \"runtime_decision\": runtime_decision,\n146\t        **dict(guard_payload),\n147\t    }\n148\t    if bool(runtime_decision.get(\"apply_runtime_elimination\", False)):\n149\t        master_candidate_precheck_payload.update(\n150\t            {\n151\t                \"triggered\": True,\n152\t                \"precheck_reason\": \"anchor119_row_domain_runtime_guard\",\n153\t                \"master_solve_skipped\": True,\n154\t                \"supported\": True,\n155\t                \"considered_anchor_count\": 1,\n156\t                \"screened_infeasible_anchor_count\": 1,\n157\t                \"screen_pass_anchor_count\": 0,\n158\t                \"max_packable_min\": None,\n159\t                \"max_packable_max\": None,\n160\t                \"first_infeasible_anchor_idx\": int(PHASE3B_ANCHOR119_ANCHOR_IDX),\n161\t                \"first_infeasible_anchor_max_packable\": None,\n162\t                \"triggered_group_id\": None,\n163\t                \"triggered_group_facility_type\": None,\n164\t                \"triggered_group_operation_type\": None,\n165\t                \"triggered_group_required_count\": 0,\n166\t            }\n167\t        )\n168\t\n169\t\n170\tdef _maybe_attach_anchor119_row_domain_guard_advisory_to_proof_summary(\n171\t    proof_summary: Dict[str, Any],\n172\t    *,\n173\t    project_root: Path,\n174\t    ghost_w: int,\n175\t    ghost_h: int,\n176\t) -> None:\n177\t    master_candidate_precheck = proof_summary.get(\"master_candidate_precheck\")\n178\t    if isinstance(master_candidate_precheck, Mapping):\n179\t        master_candidate_precheck_payload = dict(master_candidate_precheck)\n180\t    else:\n181\t        master_candidate_precheck_payload = {\n182\t            \"triggered\": False,\n183\t            \"precheck_reason\": None,\n184\t            \"master_solve_skipped\": False,\n185\t        }\n186\t    _maybe_attach_anchor119_row_domain_guard_advisory(\n187\t        master_candidate_precheck_payload,\n188\t        project_root=project_root,\n189\t        ghost_w=ghost_w,\n190\t        ghost_h=ghost_h,\n191\t    )\n192\t    if \"anchor119_row_domain_guard_advisory\" in master_candidate_precheck_payload:\n193\t        proof_summary[\"master_candidate_precheck\"] = master_candidate_precheck_payload\n194\t\n195\t\n196\tdef _copy_anchor119_row_domain_guard_advisory_from_proof_summary(\n197\t    master_candidate_precheck_payload: Dict[str, Any],\n198\t    *,\n199\t    proof_summary: Mapping[str, Any],\n200\t) -> bool:\n201\t    source_precheck = proof_summary.get(\"master_candidate_precheck\")\n202\t    if not isinstance(source_precheck, Mapping):\n203\t        return False\n204\t    advisory = source_precheck.get(\"anchor119_row_domain_guard_advisory\")\n205\t    if not isinstance(advisory, Mapping):\n206\t        return False\n207\t    master_candidate_precheck_payload[\"anchor119_row_domain_guard_advisory\"] = dict(advisory)\n208\t    return True\n209\t\n210\t\n211\tdef _maybe_build_anchor119_row_domain_runtime_precheck_result(\n212\t    *,\n213\t    project_root: Path,\n214\t    ghost_w: int,\n215\t    ghost_h: int,\n216\t    master_search_profile: str,\n217\t    mandatory_support_diagnostics_summary: Mapping[str, Any],\n218\t    default_boundary_port_precheck: Mapping[str, Any],\n219\t    exact_session: \"ExactSearchSession\",\n220\t) -> Optional[Dict[str, Any]]:\n221\t    runtime_state = build_phase3b_anchor119_guard_runtime_state()\n222\t    if not bool(runtime_state.get(\"runtime_requested\", False)):\n223\t        return None\n224\t    proof_summary = _merge_reuse_metadata(\n225\t        {\n226\t            \"mode\": \"certified_exact\",\n227\t            \"benders_iterations\": 0,\n228\t            \"master_status\": \"INFEASIBLE\",\n229\t            \"diagnostic_flow_status\": \"NOT_RUN\",\n230\t            \"enumerated_bindings\": 0,\n231\t            \"routing_attempts\": 0,\n232\t            \"used_greedy_hint\": False,\n233\t            \"greedy_hint_instances\": 0,\n234\t            \"master_hinted_literals\": 0,\n235\t            \"master_search_profile\": str(master_search_profile),\n236\t            \"master_boundary_port_feasibility\": (\n237\t                _compact_exact_candidate_boundary_port_feasibility(\n238\t                    default_boundary_port_precheck\n239\t                )\n240\t            ),\n241\t            \"master_mandatory_group_prechecks\": (\n242\t                _default_exact_candidate_skipped_mandatory_group_prechecks(\n243\t                    skipped_due_to_upstream_precheck=False\n244\t                )\n245\t            ),\n246\t            \"master_mandatory_support_diagnostics\": dict(\n247\t                mandatory_support_diagnostics_summary\n248\t            ),\n249\t            \"master_candidate_precheck\": {\n250\t                \"triggered\": False,\n251\t                \"precheck_reason\": None,\n252\t                \"master_solve_skipped\": False,\n253\t                \"supported\": True,\n254\t                \"considered_anchor_count\": 0,\n255\t                \"screened_infeasible_anchor_count\": 0,\n256\t                \"screen_pass_anchor_count\": 0,\n257\t                \"max_packable_min\": None,\n258\t                \"max_packable_max\": None,\n259\t                \"first_infeasible_anchor_idx\": None,\n260\t                \"first_infeasible_anchor_max_packable\": None,\n261\t                \"triggered_group_id\": None,\n262\t                \"triggered_group_facility_type\": None,\n263\t                \"triggered_group_operation_type\": None,\n264\t                \"triggered_group_required_count\": 0,\n265\t            },\n266\t        },\n267\t        used_exact_core_reuse=True,\n268\t        core_build_seconds=float(exact_session.core_build_seconds),\n269\t        overlay_build_seconds=0.0,\n270\t        ghost_constraint_seconds=0.0,\n271\t        cut_replay_seconds=0.0,\n272\t    )\n273\t    _maybe_attach_anchor119_row_domain_guard_advisory_to_proof_summary(\n274\t        proof_summary,\n275\t        project_root=project_root,\n276\t        ghost_w=int(ghost_w),\n277\t        ghost_h=int(ghost_h),\n278\t    )\n279\t    master_candidate_precheck = proof_summary.get(\"master_candidate_precheck\", {})\n280\t    if not isinstance(master_candidate_precheck, Mapping):\n281\t        return None\n282\t    advisory = master_candidate_precheck.get(\"anchor119_row_domain_guard_advisory\")\n283\t    if not isinstance(advisory, Mapping):\n284\t        return None\n285\t    runtime_decision = advisory.get(\"runtime_decision\")\n286\t    if not isinstance(runtime_decision, Mapping):\n287\t        return None\n288\t    if not bool(runtime_decision.get(\"apply_runtime_elimination\", False)):\n289\t        return None\n290\t    return {\n291\t        \"triggered\": True,\n292\t        \"status\": RUN_STATUS_INFEASIBLE,\n293\t        \"proof_summary\": proof_summary,\n294\t        \"boundary_port_precheck\": dict(default_boundary_port_precheck),\n295\t    }\n296\t\n297\t\n298\tdef _pre_master_mandatory_rectangle_precheck_max_anchors() -> int:\n299\t    raw_value = os.environ.get(_PRE_MASTER_MANDATORY_RECTANGLE_PRECHECK_MAX_ANCHORS_ENV)\n300\t    if raw_value is None or str(raw_value).strip() == \"\":"}]},"uuid":"bfe137e8-6beb-424d-99e9-96af92de8e3d","timestamp":"2026-05-07T20:06:35.783Z","sourceToolAssistantUUID":"2e9044d9-86a7-428c-9a86-6bd672b4d241","userType":"external","entrypoint":"cli","cwd":"D:\\claude pj\\zmd","sessionId":"7db7f276-a2bf-4762-b9b8-bb35f8cf3fb9","version":"2.1.128","gitBranch":"master","slug":"squishy-zooming-sphin