{"parentUuid":"f535e0b7-c8ef-413a-8745-67158d3ae379","isSidechain":true,"promptId":"56e72661-9c70-4718-ac89-40d9fd2179ff","agentId":"a0ddda46b5530f550","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MPsYeXXA93LXt3Qeg4gQox","type":"tool_result","content":"1\t\"\"\"\n2\tBenders loop entrypoint（Benders 循环入口）.\n3\t\n4\t职责：\n5\t1. certified_exact（严格认证精确）与 exploratory（探索）模式切换。\n6\t2. exploratory 路径继续沿用 flow-driven 协同求解。\n7\t3. certified_exact 路径改为 flow 仅作诊断，binding/routing 给正式证据。\n8\t4. exact 路径只使用 safe static occupied-area lower bound。\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\timport copy\n14\timport json\n15\tfrom collections import defaultdict\n16\tfrom dataclasses import dataclass\n17\timport os\n18\tfrom pathlib import Path\n19\timport time\n20\tfrom typing import Any, Callable, Dict, Iterable, List, Mapping, Optional, Sequence, Set, Tuple\n21\t\n22\tfrom ortools.sat.python import cp_model\n23\t\n24\tfrom src.models.binding_subproblem import PortBindingModel\n25\tfrom src.models.cut_manager import (\n26\t    BendersCut,\n27\t    CutManager,\n28\t    RUN_STATUS_CERTIFIED,\n29\t    RUN_STATUS_INFEASIBLE,\n30\t    RUN_STATUS_UNKNOWN,\n31\t    RUN_STATUS_UNPROVEN,\n32\t)\n33\tfrom src.models.flow_subproblem import FlowSubproblem, build_flow_network\n34\tfrom src.models.master_model import (\n35\t    DEFAULT_EXACT_COORDINATE_MASTER_SEARCH_PROFILE,\n36\t    EXACT_WARM_START_FAILED_ANCHOR_SAMPLE_LIMIT,\n37\t    EXACT_WARM_START_FAILED_ANCHOR_SAMPLE_LIMIT_ENV,\n38\t    ExactMasterCore,\n39\t    MasterPlacementModel,\n40\t    infer_certified_optional_lower_bounds,\n41\t    load_generic_io_requirements_artifact,\n42\t    load_project_data,\n43\t)\n44\tfrom src.models.routing_subproblem import (\n45\t    RoutingGrid,\n46\t    RoutingPlacementCore,\n47\t    RoutingSubproblem,\n48\t    run_exact_routing_precheck,\n49\t)\n50\tfrom src.search.phase3b_anchor119_guard_controls import (\n51\t    PHASE3B_ANCHOR119_ANCHOR_IDX,\n52\t  