onal[bool] = None,\n94\t) -> str:\n95\t    if certification_mode is not None:\n96\t        return \"certified_exact\" if certification_mode else \"exploratory\"\n97\t    if solve_mode is None:\n98\t        return \"certified_exact\"\n99\t    if solve_mode not in {\"certified_exact\", \"exploratory\"}:\n100\t        raise ValueError(f\"Unsupported solve mode: {solve_mode}\")\n101\t    return solve_mode\n102\t\n103\t\n104\tdef _maybe_attach_anchor119_row_domain_guard_advisory(\n105\t    master_candidate_precheck_payload: Dict[str, Any],\n106\t    *,\n107\t    project_root: Path,\n108\t    ghost_w: int,\n109\t    ghost_h: int,\n110\t) -> None:\n111\t    advisory = evaluate_phase3b_anchor119_guarded_precheck_advisory(\n112\t        project_root=project_root,\n113\t        ghost_w=int(ghost_w),\n114\t        ghost_h=int(ghost_h),\n115\t        anchor_idx=PHASE3B_ANCHOR119_ANCHOR_IDX,\n116\t    )\n117\t    if not bool(advisory.get(\"enabled\", False)):\n118\t        return\n119\t    proof_summary = advisory.get(\"proof_summary\")\n120\t    if not isinstance(proof_summary, Mapping):\n121\t        return\n122\t    guard_payload = proof_summary.get(\"anchor119_mixed_lane_guarded_precheck\")\n123\t    if not isinstance(guard_payload, Mapping):\n124\t        return\n125\t    runtime_decision = build_phase3b_anchor119_guard_runtime_decision(\n126\t        requested_state=guard_payload.get(\"requested_state\"),\n127\t        effective_state=guard_payload.get(\"effective_state\"),\n128\t        runtime_activation_allowed=bool(\n129\t            guard_payload.get(\"runtime_activation_allowed\", False)\n130\t        ),\n131\t        would_trigger=bool(advisory.get(\"would_trigger\", False)),\n132\t        triggered=bool(advisory.get(\"triggered\", False)),\n133\t        reason=advisory.get(\"reason\"),\n134\t        runtime_enablement_blockers=list(\n135\t            guard_payload.get(\"runtime_enablement_blockers\", [])\n136\t        )\n137\t        if isinstance(guard_payload.get