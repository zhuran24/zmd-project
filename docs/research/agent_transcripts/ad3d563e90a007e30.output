 Tuple[int, int]\n193\t\n194\t\n195\tdef evaluate_same_x_strip_fixed_ghost_capacity_conflict(\n196\t    owner: Any,\n197\t    *,\n198\t    solution_hint: Mapping[str, int],\n199\t    ghost_anchor_hint_idx: Optional[int],\n200\t    force_fields: Sequence[str] = (\"x\", \"y\", \"mode\"),\n201\t    force_equality_keys: Optional[Collection[str]] = None,\n202\t) -> Dict[str, Any]:\n203\t    \"\"\"Conservative pre-solver certificate for fixed-ghost same-x strip overloads.\"\"\"\n204\t\n205\t    try:\n206\t        forced_fields = {str(field) for field in force_fields}\n207\t        if \"x\" not in forced_fields:\n208\t            return _same_x_capacity_skip(\"x_not_forced\")\n209\t        if ghost_anchor_hint_idx is None:\n210\t            return _same_x_capacity_skip(\"ghost_anchor_hint_unavailable\")\n211\t        delegate = getattr(owner, \"_coordinate_delegate\", None)\n212\t        if delegate is None:\n213\t            return _same_x_capacity_skip(\"coordinate_delegate_unavailable\")\n214\t        ghost_rect = tuple(int(v) for v in (getattr(owner, \"ghost_rect\", None) or ()))\n215\t        if len(ghost_rect) != 2:\n216\t            return _same_x_capacity_skip(\"ghost_rect_unavailable\")\n217\t        ghost_w, ghost_h = int(ghost_rect[0]), int(ghost_rect[1])\n218\t        if ghost_w <= 0 or ghost_h <= 0:\n219\t            return _same_x_capacity_skip(\"ghost_rect_invalid\")\n220\t        ghost_domains = list(getattr(owner, \"_ghost_domains\", []))\n221\t        anchor_idx = int(ghost_anchor_hint_idx)\n222\t        if not (0 <= anchor_idx < len(ghost_domains)):\n223\t            return _same_x_capacity_skip(\"ghost_anchor_domain_unavailable\")\n224\t        domain = ghost_domains[anchor_idx]\n225\t        anchor = dict(domain.get(\"anchor\", {})) if isinstance(domain, Mapping) else {}\n226\t        if \"x\" not in anchor or \"y\" not in anchor:\n227\t            return _same_x_capacity_skip(\"ghost_anchor_missing_xy\")\n228\t        ghost_x, ghost_y = int(anchor[\"x\"]), int(anchor[\"y\"])\n229\t        grid_w, grid_h = int(getattr(owner, \"grid_w\", 0)), int(getattr(owner, \"grid_h\", 0))\n230\t        if grid_w <= 0 or grid_h <= 0:\n231\t            return _same_x_capacity_skip(\"grid_unavailable\")\n232\t        if ghost_x < 0 or ghost_y < 0 or ghost_x + ghost_w > grid_w or ghost_y + ghost_h > grid_h:\n233\t            return _same_x_capacity_skip(\"ghost_outside_grid\")\n234\t\n235\t        selected_keys = (\n236\t            None\n237\t            if force_equality_keys is None\n238\t            else {str(key) for key in force_equality_keys}\n239\t        )\n240\t        grouped_hints: DefaultDict[str, List[int]] = defaultdict(list)\n241\t        optional_hints: DefaultDict[str, List[int]] = defaultdict(list)\n242\t        for solution_id, pose_idx in dict(solution_hint or {}).items():\n243\t            solution_id = str(solution_id)\n244\t            pose_idx = int(pose_idx)\n245\t            group_by_instance = getattr(owner, \"_group_id_by_instance\", {})\n246\t            if solution_id in group_by_instance:\n247\t                grouped_hints[str(group_by_instance[solution_id])].append(pose_idx)\n248\t                continue\n249\t            infer_optional = getattr(owner, \"_infer_optional_template_from_solution_id\", None)\n250\t            tpl = infer_optional(solution_id) if callable(infer_optional) else None\n251\t            if tpl is not None:\n252\t                optional_hints[str(tpl)].append(pose_idx)\n253\t\n254\t        buckets: Dict[Tuple[str, int, int], Dict[str, Any]] = {}\n255\t        skipped_slots: List[Dict[str, Any]] = []\n256\t        force_labels: List[Dict[str, Any]] = []\n257\t\n258\t        def _pose_sort_key(tpl: str, pose_idx: int) -> Any:\n259\t            sorter = getattr(owner, \"_pose_sort_key\", None)\n260\t            if callable(sorter):\n261\t                return sorter(str(tpl), int(pose_idx))\n262\t            return int(pose_idx)\n263\t\n264\t        def _record_slot(\n265\t            *,\n266\t            slot: Any,\n267\t            tpl: str,\n268\t            pose_idx: int,\n269\t            group_id: str,\n270\t            solution_id: str,\n271\t            slot_key: str,\n272\t            slot_index: int,\n273\t        ) -> None:\n274\t            pose_tuple = getattr(delegate, \"_template_pose_tuple_by_idx\", {}).get(str(tpl), {}).get(int(pose_idx))\n275\t            if pose_tuple is None:\n276\t                skipped_slots.append(\n277\t                    {\n278\t                        \"reason\": \"missing_pose_tuple\",\n279\t                        \"group_id\": str(group_id),\n280\t                        \"slot_index\": int(slot_index),\n281\t                        \"pose_index\": int(pose_idx),\n282\t                    }\n283\t                )\n284\t                return\n285\t            x_val, _y_val, _mode_id = pose_tuple\n286\t            stable_key = _same_x_capacity_stable_key(\n287\t                group_id=str(group_id),\n288\t                solution_id=str(solution_id),\n289\t                slot_key=str(slot_key),\n290\t                slot_index=int(slot_index),\n291\t                pose_idx=int(pose_idx),\n292\t                field=\"x\",\n293\t            )\n294\t            selected = selected_keys is None or stable_key in selected_keys\n295\t            label = {\n296\t                \"stable_key\": stable_key,\n297\t                \"group_id\": str(group_id),\n298\t                \"solution_id\": str(solution_id),\n299\t                \"slot_key\": str(slot_key),\n300\t                \"slot_index\": int(slot_index),\n301\t                \"template\": str(tpl),\n302\t                \"pose_index\": int(pose_idx),\n303\t                \"field\": \"x\",\n304\t                \"forced_value\": int(x_val),\n305\t                \"selected\": bool(selected),\n306\t            }\n307\t            force_labels.append(dict(label))\n308\t            if not selected:\n309\t                return\n310\t            dims = tuple(getattr(slot, \"dims\", ()) or ())\n311\t            if len(dims) != 2:\n312\t                skipped_slots.append({**label, \"reason\": \"slot_dims_unavailable\"})\n313\t                return\n314\t            slot_w, slot_h = int(dims[0]), int(dims[1])\n315\t            if slot_w <= 0 or slot_h <= 0:\n316\t                skipped_slots.append({**label, \"reason\": \"slot_dims_invalid\"})\n317\t                return\n318\t            x_start = int(x_val)\n319\t            x_end = int(x_start + slot_w)\n320\t            if not _same_x_capacity_intervals_overlap(x_start, x_end, ghost_x, ghost_x + ghost_w):\n321\t                return\n322\t            bucket_key = (str(group_id), int(x_start), int(x_end))\n323\t            bucket = buckets.setdefault(\n324\t                bucket_key,\n325\t                {\n326\t                    \"group_id\": str(group_id),\n327\t                    \"x_interval\": {\"start\": int(x_start), \"end\": int(x_end)},\n328\t                    \"slot_heights\": set(),\n329\t                    \"forced_slots\": [],\n330\t                },\n331\t            )\n332\t            bucket[\"slot_heights\"].add(int(slot_h))\n333\t            bucket[\"forced_slots\"].append(dict(label) | {\"slot_width\": int(slot_w), \"slot_height\": int(slot_h)})\n334\t\n335\t        for group in list(getattr(owner, \"_mandatory_groups\", [])):\n336\t            group_id = str(group[\"group_id\"])\n337\t            tpl = str(group[\"facility_type\"])\n338\t            slot_specs = list(getattr(delegate, \"mandatory_slots\", {}).get(group_id, []))\n339\t            solution_ids = [str(item) for item in list(group.get(\"instance_ids\", []))]\n340\t            pose_indices = sorted(grouped_hints.get(group_id, []), key=lambda pose_idx: _pose_sort_key(tpl, int(pose_idx)))\n341\t            for slot_index, (slot, pose_idx) in enumerate(zip(slot_specs, pose_indices)):\n342\t                solution_id = (\n343\t                    solution_ids[int(slot_index)]\n344\t                    if int(slot_index) < len(solution_ids)\n345\t                    else f\"{group_id}::{slot_index}\"\n346\t                )\n347\t                _record_slot(\n348\t                    slot=slot,\n349\t                    tpl=tpl,\n350\t                    pose_idx=int(pose_idx),\n351\t                    group_id=group_id,\n352\t                    solution_id=solution_id,\n353\t                    slot_key=str(slot_index),\n354\t                    slot_index=int(slot_index),\n355\t                )\n356\t\n357\t        for tpl, slot_specs in getattr(delegate, \"required_optional_slots\", {}).items():\n358\t            pose_indices = sorted(optional_hints.get(str(tpl), []), key=lambda pose_idx: _pose_sort_key(str(tpl), int(pose_idx)))\n359\t            for slot_index, (slot, pose_idx) in enumerate(zip(list(slot_specs), pose_indices)):\n360\t                _record_slot(\n361\t                    slot=slot,\n362\t                    tpl=str(tpl),\n363\t                    pose_idx=int(pose_idx),\n364\t                    group_id=f\"optional::{tpl}\",\n365\t                    solution_id=f\"optional::{tpl}::{slot_index}\",\n366\t                    slot_key=str(slot_index),\n367\t                    slot_index=int(slot_index),\n368\t                )\n369\t\n370\t        evaluated_buckets: List[Dict[str, Any]] = []\n371\t        skipped_buckets: List[Dict[str, Any]] = []\n372\t        first_conflict: Optional[Dict[str, Any]] = None\n373\t        for raw_bucket in buckets.values():\n374\t            heights = sorted(int(h) for h in raw_bucket.get(\"slot_heights\", set()))\n375\t            forced_slots = list(raw_bucket.get(\"forced_slots\", []))\n376\t            if len(heights) != 1:\n377\t                skipped_buckets.append(\n378\t                    {\n379\t                        \"group_id\": raw_bucket.get(\"group_id\"),\n380\t                        \"x_interval\": dict(raw_bucket.get(\"x_interval\", {})),\n381\t                        \"reason\": \"mixed_slot_heights\",\n382\t                        \"slot_heights\": heights,\n383\t                        \"forced_count\": int(len(forced_slots)),\n384\t                    }\n385\t                )\n386\t                continue\n387\t            slot_h = int(heights[0])\n388\t            lower_capacity = max(0, int(ghost_y)) // slot_h\n389\t            upper_capacity = max(0, int(grid_h) - int(ghost_y + ghost_h)) // slot_h\n390\t            capacity = int(lower_capacity + upper_capacity)\n391\t            forced_count = int(len(forced_slots))\n392\t            bucket_payload = {\n393\t                \"group_id\": raw_bucket.get(\"group_id\"),\n394\t                \"x_interval\": dict(raw_bucket.get(\"x_interval\", {})),"}]},"uuid":"f761c169-fc58-4859-90c9-afcd0893d856","timestamp":"2026-05-07T21:00:53.189Z","sourceToolAssistantUUID":"a055228d-bfb5-4d6c-9a0b-6f253dca8513","userType":"external","entrypoint":"cli","cwd":"D:\\claude pj\\zmd","sessionId":"7db7f276-a2bf-4762-b9b8-bb35f8cf3fb9","version":"2.1.128","gitBranch":"master","slug":"squishy-zooming-sphinx"}
