 = []\\n2352\\t                for region_index, region in enumerate(bucket_regions.get(bucket_id, [])):\\n2353\\t                    region_lit = self.model.NewBoolVar(\\n2354\\t                        f\\\"region__{slot.key}__{bucket_id}__{region_index}\\\"\\n2355\\t                    )\\n2356\\t                    self._add_region_constraints(slot, region, region_lit)\\n2357\\t                    bucket_region_lits.append(region_lit)\\n2358\\t                    all_region_lits.append(region_lit)\\n2359\\t                if bucket_region_lits:\\n2360\\t                    # P0 #6 改造 3 (sum-channel): bucket_lit ∈ {0,1} so the\\n2361\\t                    # paired half-reify (==1 if lit, ==0 if not lit) is\\n2362\\t                    # mathematically equivalent to a single channeling.\\n2363\\t                    self.model.Add(sum(bucket_region_lits) == bucket_lit)\\n2364\\t                else:\\n2365\\t                    self.model.Add(bucket_lit == 0)\\n2366\\t\\n2367\\t            if all_region_lits:\\n2368\\t                self.model.AddExactlyOne(all_region_lits)\\n2369\\t            else:\\n2370\\t                self.model.Add(0 == 1)\\n2371\\t\\n2372\\t    def _create_optional_signature_slot_vars(\\n2373\\t        self,\\n2374\\t        slot_specs: Sequence[CoordinateSlotSpec],\\n2375\\t        *,\\n2376\\t        bucket_defs: Sequence[Mapping[str, Any]],\\n2377\\t        bucket_regions: Mapping[str, List[SignatureRegion]],\\n2378\\t        membership_store: Dict[str, List[cp_model.IntVar]],\\n2379\\t        membership_prefix: str,\\n2380\\t    ) -> None:\\n2381\\t        if not bucket_defs:\\n2382\\t            example_key = str(slot_specs[0].key) if slot_specs else membership_prefix\\n2383\\t            raise ValueError(\\n2384\\t                \\\"Missing optional signature bucket definitions for coordinate-exact slot \\\"\\n2385\\t                f\\\"set: {example_key}\\\"\\n2386\\t            )\\n2387\\t        bucket_id_to_int = {str(bucket[\\