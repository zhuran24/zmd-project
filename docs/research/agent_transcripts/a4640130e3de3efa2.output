lot.active)\\n2663\\t        stats[\\\"linear_guard_constraint_count\\\"] = int(\\n2664\\t            stats.get(\\\"linear_guard_constraint_count\\\", 0)\\n2665\\t        ) + 1\\n2666\\t        shape_counts = dict(stats.get(\\\"shape_counts\\\", {}) or {})\\n2667\\t        for family_id, lit_var in sorted(family_lits_by_int.items()):\\n2668\\t            rows = rows_by_family.get(int(family_id), [])\\n2669\\t            if not rows:\\n2670\\t                continue\\n2671\\t            payload = add_family_shell_guard_constraints(\\n2672\\t                self.model,\\n2673\\t                lit_var=lit_var,\\n2674\\t                d_lo_var=d_lo,\\n2675\\t                d_hi_var=d_hi,\\n2676\\t                rows=rows,\\n2677\\t            )\\n2678\\t            shape_kind = str(payload.get(\\\"shape\\\", {}).get(\\\"kind\\\", \\\"unknown\\\"))\\n2679\\t            shape_counts[shape_kind] = int(shape_counts.get(shape_kind, 0)) + 1\\n2680\\t            stats[\\\"family_lit_count\\\"] = int(stats.get(\\\"family_lit_count\\\", 0)) + 1\\n2681\\t            stats[\\\"linear_guard_constraint_count\\\"] = int(\\n2682\\t                stats.get(\\\"linear_guard_constraint_count\\\", 0)\\n2683\\t            ) + int(payload.get(\\\"linear_constraint_count\\\", 0))\\n2684\\t            stats[\\\"fallback_table_constraint_count\\\"] = int(\\n2685\\t                stats.get(\\\"fallback_table_constraint_count\\\", 0)\\n2686\\t            ) + int(payload.get(\\\"fallback_table_constraint_count\\\", 0))\\n2687\\t            stats[\\\"fallback_table_row_count\\\"] = int(\\n2688\\t                stats.get(\\\"fallback_table_row_count\\\", 0)\\n2689\\t            ) + int(payload.get(\\\"fallback_table_row_count\\\", 0))\\n2690\\t        stats[\\\"shape_counts\\\"] = dict(sorted(shape_counts.items()))\\n2691\\t\\n2692\\t    def _add_power_pole_shell_pair_index_lookup_constraints(\\n2693\\t        self,\\n2694\\t        *,\\n2695\\t        slot: CoordinateSlotSpec,\\n2696\\t   