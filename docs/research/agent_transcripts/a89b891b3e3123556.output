r commodity in self.commodities\n571\t        }\n572\t        self._commodity_component_cells: Dict[str, Set[Tuple[int, int]]] = {\n573\t            commodity: set() for commodity in self.commodities\n574\t        }\n575\t\n576\t        self._source_port_fronts: Dict[Tuple[int, int, str, str], int] = defaultdict(int)\n577\t        self._sink_port_fronts: Dict[Tuple[int, int, str, str], int] = defaultdict(int)\n578\t        self._index_port_fronts()\n579\t        self._patterns_by_layer = {\n580\t            layer: list(self._iter_state_patterns(layer))\n581\t            for layer in LAYERS\n582\t        }\n583\t        self._pattern_count_per_cell = sum(len(patterns) for patterns in self._patterns_by_layer.values())\n584\t\n585\t    @classmethod\n586\t    def from_placement_core(\n587\t        cls,\n588\t        placement_core: RoutingPlacementCore,\n589\t        port_specs: Sequence[Mapping[str, Any]],\n590\t        commodities: List[str],\n591\t        *,\n592\t        domain_analysis: Optional[Mapping[str, Any]] = None,\n593\t    ) -> \"RoutingSubproblem\":\n594\t        return cls(\n595\t            RoutingGrid.from_placement_core(placement_core, port_specs),\n596\t            commodities,\n597\t            domain_analysis=domain_analysis,\n598\t        )\n599\t\n600\t    def _index_port_fronts(self) -> None:\n601\t        for ps in self.grid.port_specs:\n602\t            px = int(ps[\"x\"])\n603\t            py = int(ps[\"y\"])\n604\t            direction = str(ps[\"dir\"])\n605\t            commodity = str(ps[\"commodity\"])\n606\t            dx, dy = DIR_DELTA[direction]\n607\t            fx, fy = px + dx, py + dy\n608\t            if str(ps[\"type\"]) == \"out\":\n609\t                recv_dir = DIR_OPP[direction]\n610\t                self._source_port_fronts[(fx, fy, recv_dir, commodity)] += 1\n611\t            else:\n612\t                self._sink_port_fronts[(fx, fy, direction, commodity)] += 1\n613\t\n614\t    def build(self, time_limit: float = 60.0):\n615\t        del time_limit\n616\t        t0 = time.time()\n617\t        analysis = (\n618\t            dict(self._domain_analysis)\n619\t            if self._domain_analysis is not None"}]},"uuid":"2a4a3415-b1bf-4dfa-bcca-3322cad74733","timestamp":"2026-05-07T20:32:19.287Z","sourceToolAssistantUUID":"92a36233-0793-4f72-8525-61bfd690d105","userType":"external","entrypoint":"cli","cwd":"D:\\claude pj\\zmd","sessionId":"7db7f276-a2bf-4762-b9b8-bb35f8cf3fb9","version":"2.1.128","gitBranch":"master","slug":"squishy-zooming-sphinx"}
