{"parentUuid":"3572c3d3-1298-4663-9a83-69f6d4a0e791","isSidechain":true,"promptId":"8dfd7d49-883e-40c9-8948-d7864c6a5fee","agentId":"a89b891b3e3123556","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NnPd71mwbU71qWhavTgm2w","type":"tool_result","content":"1\t\"\"\"\n2\tExact grid-routing subproblem.\n3\t\n4\tThis version keeps the exact state semantics, but shrinks the routing core to the\n5\tcommodity-scoped terminal-connected domain before building CP-SAT variables.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport time\n11\tfrom collections import defaultdict, deque\n12\tfrom dataclasses import dataclass\n13\tfrom itertools import combinations\n14\tfrom typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Set, Tuple\n15\t\n16\tfrom ortools.sat.python import cp_model\n17\t\n18\tfrom src.models.cp_sat_worker_config import (\n19\t    DEFAULT_ROUTING_CP_SAT_WORKERS,\n20\t    resolve_cp_sat_worker_count,\n21\t)\n22\t\n23\tGRID_W = 70\n24\tGRID_H = 70\n25\tDIRECTIONS = [\"N\", \"S\", \"E\", \"W\"]\n26\tDIR_DELTA = {\"N\": (0, 1), \"S\": (0, -1), \"E\": (1, 0), \"W\": (-1, 0)}\n27\tDIR_OPP = {\"N\": \"S\", \"S\": \"N\", \"E\": \"W\", \"W\": \"E\"}\n28\tLAYERS = [0, 1]\n29\tGROUND_LAYER = 0\n30\tELEVATED_LAYER = 1\n31\t\n32\t\n33\tRouteStateKey = Tuple[int, int, int, Tuple[str, ...], Tuple[str, ...], str]\n34\t\n35\t\n36\t@dataclass\n37\tclass RoutingPlacementCore:\n38\t    occupied_cells: Set[Tuple[int, int]]\n39\t    occupied_owner_by_cell: Dict[Tuple[int, int], str]\n40\t    free_cells: Set[Tuple[int, int]]\n41\t    free_neighbors_by_cell: Dict[Tuple[int, int], Tuple[Tuple[int, int], ...]]\n42\t    component_by_cell: Dict[Tuple[int, int], int]\n43\t    cells_by_component: Dict[int, Set[Tuple[int, int]]]\n44\t\n45\t    @classmethod\n46\t    def from_occupied_cells(\n47\t        cls,\n48\t        occupied_cells: Set[Tuple[int, int]],\n49\t        *,\n50\t        occupied_owner_by_cell: Optional[Mapping[Tuple[int, int], str]] = None,\n51\t    ) -> \"RoutingPlacementCore\":\n52\t        occupied = {(int(x), int(y)) for x, y in occupied_cells}\n53\t        owner_map = {\n54\t            (int(cell[0]), int(cell[1])): str(owner)\n55\t            for cell, owner in dict(occupied_owner_by_cell or {}).items()\n56\t        }\n57\t        free_cells: Set[Tuple[int, int]] = set()\n58\t        for x in range(GRID_W):\n59\t            for y in range(GRID_H):\n60\t                if (x, y) not in occupied:\n61\t                    free_cells.add((x, y))\n62\t\n63\t        free_neighbors_by_cell = {\n64\t            cell: tuple(\n65\t                sorted(\n66\t                    neighbor\n67\t                    for neighbor in _cell_neighbors(cell)\n68\t                    if neighbor in free_cells\n69\t                )\n70\t            )\n71\t            for cell in free_cells\n72\t        }\n73\t        component_by_cell, cells_by_component = _compute_free_components(\n74\t            free_cells,\n75\t            free_neighbors_by_cell=free_neighbors_by_cell,\n76\t        )\n77\t        return cls(\n78\t            occupied_cells=occupied,\n79\t            occupied_owner_by_cell=owner_map,\n80\t            free_cells=free_cells,\n81\t            free_neighbors_by_cell=free_neighbors_by_cell,\n82\t            component_by_cell=component_by_cell,\n83\t            cells_by_component=cells_by_component,\n84\t        )\n85\t\n86\t\n87\tdef _dirs_tag(dirs: Iterable[str]) -> str:\n88\t    ordered = list(dirs)\n89\t    return \"\".join(ordered) if ordered else \"none\"\n90\t\n91\t\n92\tdef _is_straight_state(flow_in: Tuple[str, ...], flow_out: Tuple[str, ...]) -> bool:\n93\t    return (\n94\t        len(flow_in) == 1\n95\t        and len(flow_out) == 1\n96\t        and DIR_OPP[flow_in[0]] == flow_out[0]\n97\t    )\n98\t\n99\t\n100\tdef _sorted_cells(cells: Iterable[Tuple[int, int]]) -> List[List[int]]:"}]},"uuid":"4d51e636-a325-442a-b8f8-806531e41493","timestamp":"2026-05-07T20:32:0