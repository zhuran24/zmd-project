+        return memory_text[:start].rstrip() + "\n\n" + block.rstrip() + "\n\n" + memory_text[end:].lstrip()
+    marker = "## 当前状态 / 交接"
+    idx = memory_text.find(marker)
+    if idx != -1:
+        return memory_text[:idx].rstrip() + "\n\n" + block.rstrip() + "\n\n" + memory_text[idx:]
+    title = "# Memory Index"
+    idx = memory_text.find(title)
+    if idx != -1:
