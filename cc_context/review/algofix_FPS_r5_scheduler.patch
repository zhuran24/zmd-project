+        outer_search_module._parallel_wave_failure_discards_results(
+            "worker_process_failed_validation_failure:spoofed"
+        )
+        is True
+    )
+    assert (
+        outer_search_module._parallel_wave_failure_discards_results(
+            "worker_crash_respawn_limit_validation_failure:spoofed"
+        )
+        is True
+    )
+    assert (
+        outer_search_module._parallel_wave_failure_discards_results(
+            "worker_result_error:0:worker_crash_respawn_limit:spoofed"
+        )
+        is True
+    )
 
 
