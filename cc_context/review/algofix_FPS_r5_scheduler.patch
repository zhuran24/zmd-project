+def test_parallel_wave_failure_discard_helper_rejects_prefix_collisions() -> None:
+    assert outer_search_module._parallel_wave_failure_discards_results(None) is False
+    assert (
+        outer_search_module._parallel_wave_failure_discards_results(
+            "worker_process_failed:pid=1:exitcode=1"
