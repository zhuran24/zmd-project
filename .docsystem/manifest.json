  "actions": {
    "code_assets.check": {
      "description": "校验代码资产分类和计数投影。",
      "command": ".venv/bin/python devtools/check_repository_code_assets.py check"
    },
    "docs.reference.validate": {
      "description": "校验 legacy 文档引用扫描注册表的覆盖与结构。",
      "command": ".venv/bin/python devtools/docs_reference_scan.py validate-registry"
    },
    "docsystem.check_changed": {
      "description": "按 Git diff 检查本次文档和框架变更。",
      "command": ".venv/bin/python devtools/docctl.py check --changed"
    },
    "docsystem.doctor": {
      "description": "校验自描述文档框架、policy 继承和兼容投影。",
      "command": ".venv/bin/python devtools/docctl.py doctor"
    },
    "docsystem.render_legacy": {
      "description": "从分布式 policy 重建 legacy doc_classes 兼容投影。",
      "command": ".venv/bin/python devtools/docctl.py render-legacy --write"
    },
    "docsystem.tests": {
      "description": "通过统一治理门运行文档框架定点回归 profile。",
      "command": ".venv/bin/python devtools/document_governance_gate.py run --profile framework"
    },
    "knowledge.build": {
      "description": "从结构化知识源重建 CURRENT、CATALOG、REASONING_LEDGER、VALIDITY_LEDGER、BACKFILL_LEDGER、TOPIC_INDEX、TERMINOLOGY 与 OPEN_QUESTIONS。",
      "command": ".venv/bin/python devtools/build_knowledge_docs.py --write"
    },
    "knowledge.check": {
      "description": "校验知识账本、START_HERE 链接和八份知识生成页。",
      "command": ".venv/bin/python devtools/check_knowledge_docs.py"
    },
    "knowledge.refresh_dossiers": {
      "description": "发现新增一级研究包并重建知识投影。",
      "command": ".venv/bin/python devtools/build_knowledge_docs.py --refresh-dossiers --write"
    },
    "docsystem.render_guidance": {
      "description": "从有效文档 policy 生成当前职责索引。",
      "command": ".venv/bin/python devtools/docctl.py render-guidance --write"
    },
    "docsystem.render_entrypoints": {
      "description": "从结构化前门注册表重建历史兼容跳转页。",
      "command": ".venv/bin/python devtools/docctl.py render-entrypoints --write"
    },
    "docsystem.render_sections": {
      "description": "从 section registry 与有效 policy 重建当前文档分区索引。",
      "command": ".venv/bin/python devtools/docctl.py render-sections --write"
    },
    "docsystem.render_convergence": {
      "description": "从当前 policy、section 与前门图生成职责收束验收报告。",
      "command": ".venv/bin/python devtools/docctl.py render-convergence --write"
    },
    "artifact_evidence.render": {
      "description": "从 dossier ledger 与显式根文件输入重建 frozen artifact-boundary 兼容投影。",
      "command": ".venv/bin/python devtools/artifact_evidence.py render --write"
    },
    "artifact_evidence.check": {
      "description": "校验 tracked artifact evidence 的语义边界、兼容投影与 runtime 排除。",
      "command": ".venv/bin/python devtools/artifact_evidence.py check"
    },
    "code_assets.current": {
      "description": "校验当前工作树的代码资产分类、逻辑隔离和 enforcement-control 计数；不宣称历史 baseline replay。",
      "command": ".venv/bin/python devtools/check_repository_code_assets.py check-current"
    },
    "docsystem.gate": {
      "description": "运行 manifest 注册的非变异文档治理门 changed profile。",
      "command": ".venv/bin/python devtools/document_governance_gate.py run --profile changed"
    },
    "docsystem.gate_full": {
      "description": "运行含完整历史 code-assets replay 的阶段边界文档治理门。",
      "command": ".venv/bin/python devtools/document_governance_gate.py run --profile full"
    },
    "docsystem.intake": {
      "description": "按 Git diff 校验新文档、dossier 生命周期、owner authority companion 与稳定知识身份。",
      "command": ".venv/bin/python devtools/docctl.py intake --changed"
    },
    "docsystem.render_maintenance": {
      "description": "从周期审计注册表与现有真源重建维护队列投影。",
      "command": ".venv/bin/python devtools/docctl.py render-maintenance --write"
    },
    "docsystem.audit": {
      "description": "运行只读 weekly 文档维护审计；机械错误阻断，语义欠账保持可见。",
      "command": ".venv/bin/python devtools/docctl.py audit --profile weekly"
    },
    "docsystem.audit_deep": {
      "description": "运行只读 deep 文档维护审计；逾期 warning 与 error 都阻断。",
      "command": ".venv/bin/python devtools/docctl.py audit --profile deep"
    },
    "docsystem.landing": {
      "description": "查询非破坏性真实仓库落地事务的动态规划、归档、迁移与验收命令。",
      "command": ".venv/bin/python devtools/document_patch_landing.py --help"
    }
  },
