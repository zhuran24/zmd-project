{
  "schema_version": "zmd_doc_policy_v1",
  "policy_id": "data",
  "description": "Machine data, generated reports and governance subtrees.",
  "defaults": {},
  "rules": [
    {
      "id": "generated_examples",
      "match": {
        "prefix": "examples/"
      },
      "set": {
        "document_class": "historical_evidence",
        "authority_role": "evidence_only",
        "mutation": "governed",
        "context_level": "L1",
        "purpose": "Checked-in generated delivery surfaces and release evidence. Use the owning runbook/producer; do not treat them as current project authority.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-004",
          "DOC-INV-009"
        ],
        "after_change": [
          "docsystem.doctor"
        ],
        "review_policy": {
          "at_phase_boundary": false,
          "max_interval_days": null
        },
        "required_reads": [
          "data/examples/industrial_planner/README.md",
          "docs/industrial_planner_single_base_runbook.md"
        ]
      },
      "rationale": "This legacy delivery tree is generated by several producers; its local README and runbook are the stable producer entrypoints."
    },
    {
      "id": "generated_exports",
      "match": {
        "prefix": "exports/"
      },
      "set": {
        "document_class": "historical_evidence",
        "authority_role": "evidence_only",
        "mutation": "governed",
        "context_level": "L1",
        "purpose": "Checked-in export examples. Regenerate through the owning export workflow rather than editing emitted payloads.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-004",
          "DOC-INV-009"
        ],
        "after_change": [
          "docsystem.doctor"
        ],
        "review_policy": {
          "at_phase_boundary": false,
          "max_interval_days": null
        },
        "required_reads": [
          "data/exports/industrial_planner/README.md"
        ]
      },
      "rationale": "Export examples are producer-owned evidence, but the directory also contains its human-maintained producer guide."
    },
    {
      "id": "generated_solutions",
      "match": {
        "prefix": "solutions/"
      },
      "set": {
        "document_class": "historical_evidence",
        "authority_role": "evidence_only",
        "mutation": "governed",
        "context_level": "L1",
        "purpose": "Checked-in solver, parity and diff outputs. Change through the responsible producer and review the emitted diff.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-004",
          "DOC-INV-009"
        ],
        "after_change": [
          "docsystem.doctor"
        ],
        "review_policy": {
          "at_phase_boundary": false,
          "max_interval_days": null
        },
        "required_reads": [
          "docs/CURRENT.md"
        ]
      },
      "rationale": "The directory mixes outputs from several producers; exact current authority is declared by narrower machine-source rules."
    },
    {
      "id": "proof_obligations_authority",
      "match": {
        "prefix": "proof_obligations/"
      },
      "set": {
        "document_class": "locked_authority",
        "authority_role": "machine_authority",
        "mutation": "owner_only",
        "context_level": "L1",
        "purpose": "Machine proof obligations and schemas frozen under the project authority process.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-009",
          "DOC-INV-018"
        ],
        "required_reads": [
          "PROJECT_LOCK.md",
          "docs/CURRENT.md"
        ],
        "after_change": [
          "docsystem.intake",
          "knowledge.build",
          "knowledge.check",
          "docsystem.doctor"
        ],
        "review_policy": {
          "at_phase_boundary": true,
          "max_interval_days": null
        },
        "adr_refs": [
          "DOC-ADR-014"
        ]
      },
      "rationale": "Proof obligations are authority inputs, not explanatory documents to synchronize by hand."
    },
    {
      "id": "owner_review_gates",
      "match": {
        "prefix": "review_gates/"
      },
      "set": {
        "document_class": "locked_authority",
        "authority_role": "machine_authority",
        "mutation": "owner_only",
        "context_level": "L1",
        "purpose": "Owner-only phase-gate state and schemas.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-009",
          "DOC-INV-018"
        ],
        "after_change": [
          "docsystem.intake",
          "knowledge.build",
          "knowledge.check",
          "docsystem.doctor"
        ],
        "review_policy": {
          "at_phase_boundary": true,
          "max_interval_days": null
        },
        "adr_refs": [
          "DOC-ADR-014"
        ]
      },
      "rationale": "Gate files are owner authorities, not ordinary documentation."
    },
    {
      "id": "exact_status_machine_source",
      "match": {
        "path": "solutions/exact_full_scale_status.json"
      },
      "set": {
        "document_class": "structured_knowledge",
        "authority_role": "machine_authority",
        "mutation": "governed",
        "context_level": "L1",
        "purpose": "Checked-in durable exact-status machine source consumed by the knowledge projection.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-001",
          "DOC-INV-004",
          "DOC-INV-009"
        ],
        "required_reads": [
          "data/knowledge/current_state.json",
          "docs/CURRENT.md"
        ],
        "after_change": [
          "knowledge.build",
          "knowledge.check",
          "docsystem.doctor"
        ]
      },
      "rationale": "This JSON is a declared machine source for CURRENT, unlike neighboring diagnostic artifacts."
    },
    {
      "id": "exact_status_markdown_companion",
      "match": {
        "path": "solutions/exact_full_scale_status.md"
      },
      "set": {
        "document_class": "historical_evidence",
        "authority_role": "evidence_only",
        "mutation": "governed",
        "context_level": "L1",
        "purpose": "Human-readable companion to the durable exact-status machine source; it does not outrank the JSON source.",
        "volatile_facts": "reference_only",
        "invariant_refs": [
          "DOC-INV-001",
          "DOC-INV-004",
          "DOC-INV-009"
        ],
        "required_reads": [
          "data/solutions/exact_full_scale_status.json",
          "docs/CURRENT.md"
        ],
        "after_change": [
          "knowledge.build",
          "knowledge.check",
          "docsystem.doctor"
        ]
      },
      "rationale": "The Markdown companion is explanatory evidence; the JSON source remains authoritative."
    },
    {
      "id": "artifact_boundary_compatibility_projection",
      "match": {
        "path": "artifact_boundaries.json"
      },
      "set": {
        "document_class": "generated_projection",
        "authority_role": "projection_only",
        "mutation": "generator_only",
        "context_level": "L2",
        "purpose": "Generated schema-v1 compatibility projection consumed by the frozen artifact-boundary checker and semantic code-asset governance.",
        "volatile_facts": "source_allowed",
        "invariant_refs": [
          "DOC-INV-004",
          "DOC-INV-006",
          "DOC-INV-009"
        ],
        "source_paths": [
          "data/knowledge/dossiers.json",
          "data/repository_governance/artifact_evidence_inputs.json",
          "data/repository_governance/artifact_evidence_inputs.schema.json",
          "data/repository_governance/artifact_boundaries.schema.json",
          "devtools/artifact_evidence.py"
        ],
        "generator_action": "artifact_evidence.render",
        "required_reads": [
          "docs/项目说明/24_repository_asset_governance.md"
        ],
        "after_change": [
          "artifact_evidence.check",
          "code_assets.check",
          "docsystem.doctor"
        ],
        "review_policy": {
          "at_phase_boundary": true,
          "max_interval_days": 60
        },
        "section_refs": [
          "repository-governance"
        ]
      },
      "rationale": "The frozen checker keeps a stable v1 input path, while dossier-derived semantic inputs remain the only mutable source."
    }
  ],
  "legacy_projection": {
    "rules": [
      {
        "id": "review_gate_registry",
        "match": {
          "prefix": "data/review_gates/"
        },
        "document_class": "locked",
        "rationale": "Owner manual gate state; only a real owner action may change it."
      }
    ],
    "out_of_scope_notes": [
      {
        "pattern": "data/examples/**",
        "rationale": "Generated delivery-surface reports; regenerated by tooling, not authored prose."
      },
      {
        "pattern": "data/exports/**",
        "rationale": "Generated export surface documentation; regenerated by tooling."
      },
      {
        "pattern": "data/solutions/**",
        "rationale": "Generated solver/diff output; regenerated by tooling."
      }
    ]
  }
}
