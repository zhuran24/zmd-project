{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zmd-document-landing-ack-v1",
  "title": "ZMD real-repository landing migration acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "landing_id", "records"],
  "properties": {
    "schema_version": {"const": "zmd_document_landing_ack_v1"},
    "landing_id": {"type": "string", "minLength": 1},
    "records": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "relpath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_path", "record_ids", "required_strings"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "target_path": {"$ref": "#/$defs/relpath"},
        "record_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_strings": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_sha256", "archive_path", "obligations"],
      "properties": {
        "source_path": {"$ref": "#/$defs/relpath"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive_path": {"$ref": "#/$defs/relpath"},
        "obligations": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/obligation"}
        }
      }
    }
  }
}
