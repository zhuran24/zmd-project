{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zmd-document-entrypoints-v1",
  "title": "ZMD canonical documentation entrypoints and compatibility redirects",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system_version",
    "common_forbidden_patterns",
    "surfaces",
    "generated_redirects",
    "guarded_documents"
  ],
  "properties": {
    "schema_version": {
      "const": "zmd_document_entrypoints_v1"
    },
    "system_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "common_forbidden_patterns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "generated_redirects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/redirect"
      }
    },
    "guarded_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guarded_document"
      }
    }
  },
  "$defs": {
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "mode",
        "purpose",
        "required_targets",
        "enforce_common_forbidden_patterns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "mode": {
          "enum": [
            "manual",
            "generated",
            "authority"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relpath"
          }
        },
        "enforce_common_forbidden_patterns": {
          "type": "boolean"
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "manual"
              }
            }
          },
          "then": {
            "required": [
              "max_lines",
              "max_bytes"
            ]
          }
        }
      ]
    },
    "redirect_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path",
        "description"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "summary",
        "targets",
        "boundary_notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/redirect_target"
          }
        },
        "archive_path": {
          "$ref": "#/$defs/relpath"
        },
        "boundary_notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "guarded_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "required_targets",
        "enforce_common_forbidden_patterns",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "required_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relpath"
          }
        },
        "enforce_common_forbidden_patterns": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
