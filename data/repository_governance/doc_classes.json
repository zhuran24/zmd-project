{
  "schema_version": "repository_doc_classes_v1",
  "authority": {
    "role": "descriptive_governance_projection",
    "higher_authorities": [
      "PROJECT_LOCK.md",
      "rules/canonical_rules.json",
      "data/preprocessed/mandatory_exact_instances.json",
      "data/proof_obligations/p1_2_proof_obligations.json",
      "data/review_gates/phase_1_2_spike_close.json",
      "data/solutions/exact_full_scale_status.json"
    ],
    "cannot_grant": [
      "permission to edit, delete, rewrite or historicize any registered document",
      "release closure, owner manual gate satisfaction, or any certification claim",
      "promotion of an advisory scan finding into an applied change"
    ]
  },
  "document_classes": [
    "locked",
    "historical",
    "living"
  ],
  "scan_scope": {
    "include_globs": [
      "*.md",
      ".docsystem/*.md",
      "data/repository_governance/*.md",
      "docs/governance/document-system/**/*.md",
      "docs/research/**/*.md",
      "docs/项目说明/*.md"
    ],
    "exclude_globs": [],
    "out_of_scope_notes": [
      {
        "pattern": ".artifacts/**",
        "rationale": "Read-only or local historical evidence roots; never a prune subject."
      },
      {
        "pattern": "P1_2_TECHNICAL_CLOSE_PACKET/**",
        "rationale": "Sealed P1.2 close packet; not a legacy prune-scan subject."
      },
      {
        "pattern": "certside/**",
        "rationale": "Certification-side note family; governed outside the legacy prune scanner."
      },
      {
        "pattern": "data/examples/**",
        "rationale": "Generated delivery-surface reports; regenerated by tooling, not authored prose."
      },
      {
        "pattern": "data/exports/**",
        "rationale": "Generated export surface documentation; regenerated by tooling."
      },
      {
        "pattern": "data/knowledge/README.md",
        "rationale": "Structured knowledge-ledger operating guide; integrity is enforced by knowledge and document-system checkers."
      },
      {
        "pattern": "data/solutions/**",
        "rationale": "Generated solver/diff output; regenerated by tooling."
      },
      {
        "pattern": "docs/*.md",
        "rationale": "Depth-1 docs are explicitly classified here; generation and lifecycle are checked by docctl and knowledge checkers."
      },
      {
        "pattern": "docs/benchmarks/**",
        "rationale": "Benchmark records retained as evidence; legacy reference classification remains outside the prune scanner."
      },
      {
        "pattern": "docs/history/**",
        "rationale": "Immutable pre-knowledge-spine snapshots retained for provenance; never current-state projections or prune candidates."
      },
      {
        "pattern": "docs/subjects/**",
        "rationale": "Manually maintained thematic reading aids; current state must come from the knowledge spine and machine authorities."
      },
      {
        "pattern": "formal/**",
        "rationale": "Formal verification workspace; governed outside the legacy prune scanner."
      },
      {
        "pattern": "paths/**",
        "rationale": "Frozen candidate-path phase verdicts; retained outside the legacy prune scanner."
      },
      {
        "pattern": "scripts/**",
        "rationale": "Tooling directory READMEs; governed outside the legacy prune scanner."
      },
      {
        "pattern": "specs/**",
        "rationale": "Normative specification family; governed outside the legacy prune scanner."
      },
      {
        "pattern": "src/**",
        "rationale": "In-tree module READMEs; governed outside the legacy prune scanner."
      },
      {
        "pattern": "third_party_snapshots/**",
        "rationale": "Vendored upstream snapshots; never edited in this repository."
      }
    ]
  },
  "rules": [
    {
      "id": "canonical_rules_registry",
      "match": {
        "prefix": "rules/"
      },
      "document_class": "locked",
      "rationale": "Frozen canonical proof inputs; any change is a freeze ritual, never a prune suggestion."
    },
    {
      "id": "changelog",
      "match": {
        "path": "CHANGELOG.md"
      },
      "document_class": "locked",
      "rationale": "Append-only release ledger; stale-looking entries are the record, not drift."
    },
    {
      "id": "docs_depth1_current",
      "match": {
        "paths": [
          "docs/BACKFILL_LEDGER.md",
          "docs/CATALOG.md",
          "docs/CURRENT.md",
          "docs/DOC_TREE_COMPLETENESS.md",
          "docs/GUIDANCE_INDEX.md",
          "docs/OPEN_QUESTIONS.md",
          "docs/PHASE_1_2_CLOSE_GATE.md",
          "docs/README.md",
          "docs/REASONING_LEDGER.md",
          "docs/START_HERE.md",
          "docs/SUBJECT_TREE.md",
          "docs/TERMINOLOGY.md",
          "docs/TOPIC_INDEX.md",
          "docs/VALIDITY_LEDGER.md",
          "docs/compatibility_matrix.md",
          "docs/env_variable_index.md",
          "docs/exact_campaign_operations.md",
          "docs/frontier_probe_strategy.md",
          "docs/parallel_configuration.md",
          "docs/specs_index.md"
        ]
      },
      "document_class": "living",
      "rationale": "Explicit current front doors, generated projections, contracts and active guides."
    },
    {
      "id": "docs_depth1_frozen_industrial",
      "match": {
        "paths": [
          "docs/industrial_planner_recipe_capacity_audit.md",
          "docs/industrial_planner_single_base_delivery_entrypoints.md",
          "docs/industrial_planner_single_base_delivery_frontdoor.md",
          "docs/industrial_planner_single_base_delivery_landing.md",
          "docs/industrial_planner_single_base_delivery_release.md",
          "docs/industrial_planner_single_base_delivery_surface_alignment.md",
          "docs/industrial_planner_single_base_delivery_surface_health.md",
          "docs/industrial_planner_single_base_delivery_viewer.md",
          "docs/industrial_planner_single_base_runbook.md"
        ]
      },
      "document_class": "locked",
      "rationale": "Frozen IndustrialPlanner delivery contracts; immutable and not solver-state copies."
    },
    {
      "id": "docs_depth1_historical",
      "match": {
        "paths": [
          "docs/certified_proof_chain_analysis.md",
          "docs/cleanup_session_20260516.md",
          "docs/lever_verdicts.md",
          "docs/phase3b_exact_endgame_execution_plan.md",
          "docs/phase3b_gpt54pro_help_request_20260422.md",
          "docs/phase3b_module_index.md",
          "docs/phase3b_operating_profile.md",
          "docs/phase3b_repair5_acceleration_tuning_ai_plan.md",
          "docs/phase3c_master_ram_findings_20260515.md",
          "docs/phase3c_optimization_full_stack_roadmap_DRAFT_v0.md",
          "docs/phase3c_optimization_roadmap_v1.md"
        ]
      },
      "document_class": "historical",
      "rationale": "Closed analyses, requests, plans and findings retained as evidence."
    },
    {
      "id": "docsystem_bootstrap",
      "match": {
        "prefix": ".docsystem/"
      },
      "document_class": "locked",
      "rationale": "Document-system bootstrap and recovery surface; governed by the framework protocol."
    },
    {
      "id": "document_system_framework_guides",
      "match": {
        "prefix": "docs/governance/document-system/"
      },
      "document_class": "locked",
      "rationale": "Document-system architecture, maintenance protocol and ADRs; governed framework core, never a prune subject."
    },
    {
      "id": "project_lock",
      "match": {
        "path": "PROJECT_LOCK.md"
      },
      "document_class": "locked",
      "rationale": "Highest release-boundary authority; owner-governed and never a prune subject."
    },
    {
      "id": "project_manual_current",
      "match": {
        "paths": [
          "docs/项目说明/00_master_roadmap.md",
          "docs/项目说明/01_overview.md",
          "docs/项目说明/02_mathematical_foundations.md",
          "docs/项目说明/04_design_invariants.md",
          "docs/项目说明/05_open_questions.md",
          "docs/项目说明/06_current_status.md",
          "docs/项目说明/11_dependency_graph.md",
          "docs/项目说明/12_go_criteria.md",
          "docs/项目说明/14_risk_rollout.md",
          "docs/项目说明/15_workflow_testing.md",
          "docs/项目说明/16_workflow_review.md",
          "docs/项目说明/17_workflow_telemetry.md",
          "docs/项目说明/18_workflow_env_config.md",
          "docs/项目说明/19_implementation_rhythm.md",
          "docs/项目说明/21_glossary.md",
          "docs/项目说明/23_rule_cut_evolution_protocol.md",
          "docs/项目说明/24_repository_asset_governance.md",
          "docs/项目说明/26_rules_handbook.md",
          "docs/项目说明/27_status_dashboard.md",
          "docs/项目说明/28_pitfalls_and_sop.md",
          "docs/项目说明/29_solving_methodology_skill.md",
          "docs/项目说明/README.md",
          "docs/项目说明/REASONING_METHOD.md",
          "docs/项目说明/ROADMAP.md"
        ]
      },
      "document_class": "living",
      "rationale": "Explicit compatibility, future-only, normative and current explanatory manual pages."
    },
    {
      "id": "project_manual_historical",
      "match": {
        "paths": [
          "docs/项目说明/03_paradigm_death_baseline.md",
          "docs/项目说明/07_historical_review.md",
          "docs/项目说明/08_phase_1_2_plan.md",
          "docs/项目说明/09_phase_1_3_plan.md",
          "docs/项目说明/10_phase_1_5_plan.md",
          "docs/项目说明/13_schedule_estimate.md",
          "docs/项目说明/20_skip_directions.md",
          "docs/项目说明/22_project_journey_plain_language.md",
          "docs/项目说明/25_autonomy_campaign_plan_20260720.md",
          "docs/项目说明/HISTORY.md",
          "docs/项目说明/p1_2_supervisor_detailed_design.md",
          "docs/项目说明/p1_2_supervisor_redesign_draft.md",
          "docs/项目说明/soundness_gap_roadmap.md"
        ]
      },
      "document_class": "historical",
      "rationale": "Closed plans, snapshots and append-only chronology retained as evidence."
    },
    {
      "id": "project_status_report",
      "match": {
        "path": "README.md"
      },
      "document_class": "living",
      "rationale": "Stable repository front door; volatile state is linked rather than copied."
    },
    {
      "id": "repository_governance_registry",
      "match": {
        "prefix": "data/repository_governance/"
      },
      "document_class": "locked",
      "rationale": "Governance ledger family including generated compatibility projections; never a prune subject."
    },
    {
      "id": "research_dossiers",
      "match": {
        "glob": "docs/research/**"
      },
      "document_class": "historical",
      "rationale": "Dated research dossiers are evidence; stale references describe their historical context."
    },
    {
      "id": "review_gate_registry",
      "match": {
        "prefix": "data/review_gates/"
      },
      "document_class": "locked",
      "rationale": "Owner manual gate state; only a real owner action may change it."
    },
    {
      "id": "root_living_guides",
      "match": {
        "paths": [
          "BORROWED_COMPONENTS.md",
          "FILE_STATUS.md",
          "NAV_MAP.md"
        ]
      },
      "document_class": "living",
      "rationale": "Current operating guidance and compatibility entrypoints."
    }
  ],
  "reference_scan": {
    "symbol_source_globs": [
      "devtools/**/*.py",
      "main.py",
      "scripts/**/*.py",
      "src/**/*.py"
    ],
    "context_suppression_markers": [
      "CLOSED",
      "DONE",
      "deleted",
      "deprecated",
      "former",
      "historical",
      "history",
      "obsolete",
      "removed",
      "retired",
      "superseded",
      "不可解析",
      "不存在",
      "历史",
      "史料",
      "已修复",
      "已删",
      "废弃",
      "旧名",
      "曾经",
      "移除",
      "退役"
    ],
    "external_artifact_manifest": "data/external_artifacts.json",
    "absent_by_design_prefixes": [
      {
        "prefix": ".artifacts/",
        "rationale": "Read-only historical evidence roots are untracked; whether a given run directory is present in a given checkout is a property of that machine, not of the document citing it."
      },
      {
        "prefix": ".prune/",
        "rationale": "Generated prune scan reports; git-ignored, absent on a clean checkout."
      },
      {
        "prefix": "data/blueprints/",
        "rationale": "Generated proof output; docs/AGENT_OPERATIONS.md forbids committing it."
      },
      {
        "prefix": "data/checkpoints/",
        "rationale": "Generated campaign checkpoints; docs/AGENT_OPERATIONS.md forbids committing them."
      },
      {
        "prefix": "data/solutions/certified_delivery_manifest.json",
        "rationale": "Generated delivery manifest; docs/AGENT_OPERATIONS.md forbids committing it."
      },
      {
        "prefix": "data/solutions/final_solution.json",
        "rationale": "Generated solver output; docs/AGENT_OPERATIONS.md forbids committing it."
      }
    ],
    "symbol_reference_ignore": [],
    "known_historical_commit_hashes": [
      {
        "hash": "099f5a3",
        "cited_in": "docs/research/project_bottleneck_audit_20260702/bottlenecks.md",
        "rationale": "Delivery-copy history was rebuilt, so this hash is unresolvable by design. Cited by the 2026-07-02 bottleneck audit (bottlenecks.md and dims.md); it was also cited by the old handoff README until that file was replaced on 2026-08-09."
      },
      {
        "hash": "9bbb3a6",
        "cited_in": "docs/research/project_bottleneck_audit_20260702/bottlenecks.md",
        "rationale": "Delivery-copy history was rebuilt, so this hash is unresolvable by design. Cited by the 2026-07-02 bottleneck audit (bottlenecks.md and dims.md); it was also cited by the old handoff README until that file was replaced on 2026-08-09."
      },
      {
        "hash": "b35e5f9",
        "cited_in": "docs/research/project_bottleneck_audit_20260702/bottlenecks.md",
        "rationale": "Delivery-copy history was rebuilt, so this hash is unresolvable by design. Cited by the 2026-07-02 bottleneck audit (bottlenecks.md and dims.md); it was also cited by the old handoff README until that file was replaced on 2026-08-09."
      }
    ]
  }
}
