{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zmd-artifact-evidence-inputs-v2",
  "title": "ZMD repository evidence topology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "root_prefix",
    "git_tracked",
    "workspace_untracked",
    "external_root",
    "ignored_runtime_artifact_prefixes"
  ],
  "properties": {
    "schema_version": {"const": "artifact_evidence_inputs_v2"},
    "description": {"type": "string", "minLength": 1},
    "root_prefix": {"const": ".artifacts/"},
    "git_tracked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_files", "path_prefixes", "files", "expected_path_count"],
      "properties": {
        "root_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\.artifacts/[^/]+$"}
        },
        "path_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\.artifacts/.+/$"}
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\.artifacts/.+[^/]$"}
        },
        "expected_path_count": {"type": "integer", "minimum": 1}
      }
    },
    "workspace_untracked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dossier_registry", "required_dossier_tracked_state", "root_files"],
      "properties": {
        "dossier_registry": {"const": "data/knowledge/dossiers.json"},
        "required_dossier_tracked_state": {"const": "local_optional"},
        "root_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\.artifacts/[^/]+$"}
        }
      }
    },
    "external_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry"],
      "properties": {
        "registry": {"const": "data/external_artifacts.json"}
      }
    },
    "ignored_runtime_artifact_prefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "pattern": "/$"}
    }
  }
}
