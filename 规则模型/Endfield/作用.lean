      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := «换» s.«仓库» x (s.«仓库» x + n)    -- 据：求解任务「外部过程」
    }
  | .«出库» x n => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
