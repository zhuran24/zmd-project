      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«收货» g => some {
      «历史» := s.«历史»    -- 无关
      «货» := «换» s.«货» g []    -- 没测：玩家把一格里的货整格拿走
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 无关
