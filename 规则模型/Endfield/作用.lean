      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«入库» x n => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
