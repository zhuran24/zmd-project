import Endfield.«走步不改历史»

/-!
# 作用：每种操作发生以后，状态的每一样怎样变

`作用` 里每种操作都把状态的每个字段写一遍，不用「其余不变」的省略写法（少写一个字段编译不过），
所以「每样东西 × 每种事」的每一格都必须有着落。着落写在那一格第一行的行尾，有七种：

- 据：规则文件或求解任务的某一行写明了；
- 实测：某次实测；
- 没测：没有哪一行写，照最自然的做法写了；
- 未定：规则没写、也没测过，有不止一种说得通的做法，值取自 `未定`；
- 待写：规则有，模型里还没写到，值取自 `待写`；
- 约定：只是模型里的记法，和游戏怎么做无关；
- 无关：这件事碰不到这样东西，原样不变。

`python3 查格子.py` 把这些格子排成一张表（格子表.md），并核对每一格都有着落。
「没测」「未定」的格子就是还没抓到的边界，在 边界清单.md 里各有一条。
-/

namespace Endfield

namespace «状态»

/-- 据：物品格

单位 u 的各个物品格里一共有几件 x。 -/
def «单位里的件数» (s : «状态») (u : «单位号») (x : «物品») : Nat :=
  match s.«布局».«种类» u with
  | some k =>
    (k.«物品格».map fun n =>
      ((s.«货» ⟨u, n⟩).filter (·.«物» == x)).foldl (fun acc p => acc + p.«件数») 0).foldl (· + ·) 0
  | none => 0

end «状态»

namespace «操作»

/-- 框架：游戏让不让做这件事。做不了的操作没有结果（`作用` 给 `none`）。

现在只写了不用格子就能说的条件；位置、朝向、放不放得下这些，等格子和物品格写出来以后再加。 -/
def «做得了» (s : «状态») : «操作» → Bool
  | .«走一步» => true
  | .«改布局» e =>
    -- 建成、接通、重接、拆除各自的条件在 `布局.容得下` 里
    s.«布局».«容得下» e
  | .«设准入口» u x a b =>
    -- 物品准入口：设了放行的物品才能设两项上限；累计 1～5000，每 5 tick 0～5
    s.«布局».«种类» u == some .«物品准入口»
      && (x.isSome || (a.isNone && b.isNone))
      && (match a with
          | some n => 1 ≤ n && n ≤ 5000
          | none => true)
      && (match b with
          | some n => n ≤ 5
          | none => true)
  | .«重置计数» u =>
    -- 设了累计上限，面板上才有重置按钮
    s.«布局».«种类» u == some .«物品准入口» && (s.«准入口» u).«累计上限».isSome
  | .«设储存箱模式» u _ => s.«布局».«种类» u == some .«协议储存箱»
  | .«设取货指向» u i _ =>
    -- 协议核心有 6 个取货端口，仓库取货口有 1 个
    (s.«布局».«种类» u == some .«协议核心» && i < 6)
      || (s.«布局».«种类» u == some .«仓库取货口» && i == 0)
  | .«拨开关» us _ =>
    -- 需电功能：制造、传输
    us.all fun u =>
      match s.«布局».«种类» u with
      | some (.«制造» _) | some .«协议储存箱» => true
      | _ => false
  | .«放货» u _ n =>
    n > 0 && (match s.«布局».«种类» u with
      | some (.«制造» _) | some .«协议储存箱» => true
      | _ => false)
  | .«收货» g =>
    !(s.«货» g).isEmpty && g.«名» != .«缓存» && s.«布局».«是非运输单位» g.«单位»
  | .«入库» x n => s.«仓库» x + n ≤ 80000
  | .«出库» x n => n ≤ s.«仓库» x
  | .«离线» H =>
    -- 求解任务「离线」：单位和通道还是那些，只是建成、接通的先后变了；重建也是一件件照规矩建的
    let L := s.«布局»
    let L' := H.«布局于» H.length
    H.«合规» && L'.«单位表».length == L.«单位表».length && L.«单位表».all (L'.«单位表».contains ·)
      && L'.«通道表».length == L.«通道表».length
      && L.«通道表».all (fun p => L'.«通道表».any (·.1 == p.1))

end «操作»

/-- 框架：每种操作发生以后的状态；游戏不让做的操作是 `none`。

每种操作把状态的 13 个字段各写一遍，行尾是那一格的着落（七种写法见文件头）。 -/
def «作用» (un : «未定») (todo : «待写») (s : «状态») (o : «操作») : Option «状态» :=
  if !o.«做得了» s then none else
  let L := s.«布局»
  let now := s.«历史».length + 1
  match o with
  | .«走一步» => some («一步» un todo s)
  | .«改布局» (.«建成» u k) => some {
      «历史» := s.«历史» ++ [.«建成» u k]    -- 据：接通
      «货» := fun g => if g.«单位» = u then [] else s.«货» g    -- 没测：新建的单位里没有货
      «已停» := fun g => if g.«单位» = u then 0 else s.«已停» g    -- 没测：新建的单位里没有货
      «来处» := fun g => if g.«单位» = u then none else s.«来处» g    -- 没测：新建的单位里没有货
      «分流器上次» := «换» s.«分流器上次» u none    -- 据：元件轮询（新建的单位没移动过物品）
      «进货上次» := «换» s.«进货上次» u 0    -- 据：元件轮询（新建的单位没移动过物品）
      «出货已移动» := «换» s.«出货已移动» u []    -- 据：非运输单位轮询（新建的单位没移动过物品）
      «制造中» := «换» s.«制造中» u none    -- 没测：新建的制造单位没在制造
      «准入口» := «换» s.«准入口» u {}    -- 没测：新建的物品准入口没设放行的物品，计数是零
      «储存箱» := «换» s.«储存箱» u    -- 实测：新建的箱子开始运行以后第 39 步头一次传输（玩家在整秒上建，传输落在整秒后的第 3 步；整秒上看是 10 秒以后），以后每 40 步一次（实测-2026-11-25；新建是无线传输模式，据「传输」）
        { «仓储模式» := false
          «冷却还剩» := 5 * «tick» - 2 }
      «开关» := «换» s.«开关» u true    -- 没测：新建的需电单位开关开着
      «取货指向» := «换» s.«取货指向» u (fun _ => none)    -- 没测：新建的取货端口没设物品
      «仓库» := s.«仓库»    -- 无关
    }
  | .«改布局» (.«接通» c) =>
    let L' := L.«加» now (.«接通» c)
    some {
      «历史» := s.«历史» ++ [.«接通» c]    -- 据：接通
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» :=    -- 实测：实测-2026-11-09 分流器出口变动八组（出口有增减就当成未移动过物品）
        if L.«种类» c.«起» == some .«分流器» then «换» s.«分流器上次» c.«起» none
        else s.«分流器上次»
      «进货上次» := s.«进货上次»    -- 实测：汇流器记的是第几条，新接上一条进口不动这个数（实测-2026-11-26 第二节；几条带子进同一个别的单位时没测，照同样写）
      «出货已移动» :=    -- 实测：协议储存箱新接上一条出口，它排到这一组的最后，别的照旧（实测-2026-11-26 第三节：箱子三轮）；制造单位新接的出口照规则算没移动过物品的、排在移动过的前面，不动这张表（同一份记录第八节第 1 轮开头漏出去的那一件，只这一回；这一回分不开「不动这张表」和「整组重排」）；协议核心等别的非运输单位没测，也照规则字面不动这张表
        if L'.«算出货» c && L'.«种类» c.«起» == some .«协议储存箱» && !(s.«出货已移动» c.«起»).isEmpty then
          «换» s.«出货已移动» c.«起» (s.«出货已移动» c.«起» ++ [c])
        else s.«出货已移动»
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«改布局» (.«重接» c) => some {
      «历史» := s.«历史» ++ [.«重接» c]    -- 实测：改一条带子的任何一格，这条带子两头的通道都排到最后（实测-2026-11-25、实测-2026-11-26）
      «货» := s.«货»    -- 实测：改带子的一格以后，带子上原有的货只少一件、别的照常送出去（实测-2026-11-26 第五节；少的是不是被换掉、收掉的那一格里的那件，读数分不出，模型里那一格走的是拆除）
      «已停» := s.«已停»    -- 没测：带子重新接通时，带子上的货已经停了多久、刚从哪来，照原样留着
      «来处» := s.«来处»    -- 没测：带子重新接通时，带子上的货已经停了多久、刚从哪来，照原样留着
      «分流器上次» :=    -- 实测：分流器走过货以后改它的一条出口带，这条排到最后、整组当成未移动过物品（实测-2026-11-26 分流器三轮；没走过货时改是实测-2026-11-25）
        if L.«种类» c.«起» == some .«分流器» then «换» s.«分流器上次» c.«起» none else s.«分流器上次»
      «进货上次» := s.«进货上次»    -- 实测：汇流器记的是第几条，进口重排以后这个数不变（实测-2026-11-26 第二节；几条带子进同一个别的单位时没测，照同样写）
      «出货已移动» :=    -- 实测：箱子、精炼炉的一条出口带重新接通以后，这一组照新的接通先后从头来（实测-2026-11-26 第三、八节；写成整组当成没移动过物品）
        if L.«算出货» c then «换» s.«出货已移动» c.«起» [] else s.«出货已移动»
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«改布局» (.«拆除» u) =>
    let L' := L.«加» now (.«拆除» u)
    some {
      «历史» := s.«历史» ++ [.«拆除» u]    -- 据：接通
      «货» := fun g => if g.«单位» = u then [] else s.«货» g    -- 实测：拆掉的单位里的货进背包，离开基地（实测-2026-11-25，只测了协议储存箱）；收掉一格带子以后带上原有的货少一件（实测-2026-11-26 第五节），是不是这一格里的那件、去了哪没看，照这一格里的清掉写
      «已停» := fun g => if g.«单位» = u then 0 else s.«已停» g    -- 约定：拆掉的单位名下各项回到没建时的样子
      «来处» := fun g =>    -- 没测：刚离开的那个单位被拆掉以后，不再记着它
        if g.«单位» = u then none
        else match s.«来处» g with
          | some p => if p.«单位» = u then none else some p
          | none => none
      «分流器上次» := fun v =>    -- 实测：实测-2026-11-09 分流器出口变动八组（出口有增减就当成未移动过物品）
        if v = u then none
        else if L.«种类» v == some .«分流器»
            && L.«通道表».any (fun p => p.1.«起» == v && p.1.«止» == u) then none
        else s.«分流器上次» v
      «进货上次» := fun v =>    -- 实测：汇流器记的是第几条，收掉一条进口不动这个数；三条进口全收掉再接回以后从第 2 条开始（实测-2026-11-26 第二节）。回到 0 是怎么回的没分开（剩一条时就回、一条不剩时才回、每新接一条就对条数取余，都对得上），照「进货表空了」写；进货表不算分流器直接接来的进口；几条带子进同一个别的单位时没测，照同样写
        if v = u then 0
        else if (L'.«进货表» v).isEmpty then 0
        else s.«进货上次» v
      «出货已移动» := fun v =>    -- 实测：协议储存箱收掉一条出口，这一组从头来（实测-2026-11-26 第三节：箱子两轮；两轮里剩下的最早接通的和最靠左的是同一条，写成照接通先后）；制造单位没测，照同样写
        if v = u then []
        else if L.«通道表».any (fun p => p.1.«起» == v && p.1.«止» == u && L.«算出货» p.1) then []
        else s.«出货已移动» v
      «制造中» := «换» s.«制造中» u none    -- 约定：拆掉的单位名下各项回到没建时的样子
      «准入口» := «换» s.«准入口» u {}    -- 约定：拆掉的单位名下各项回到没建时的样子
      «储存箱» := «换» s.«储存箱» u {}    -- 约定：拆掉的单位名下各项回到没建时的样子
      «开关» := «换» s.«开关» u true    -- 约定：拆掉的单位名下各项回到没建时的样子
      «取货指向» := «换» s.«取货指向» u (fun _ => none)    -- 约定：拆掉的单位名下各项回到没建时的样子
      «仓库» := s.«仓库»    -- 实测：拆掉的单位里的货进背包，不回仓库（实测-2026-11-25，只测了协议储存箱）
    }
  | .«设准入口» u x a b =>
    let old := s.«准入口» u
    let cnt := un.«改设定后的计数» old x a b
    some {
      «历史» := s.«历史»    -- 据：物品准入口（物品不符或上限用尽时只是不收货，通道还在）
      «货» := s.«货»    -- 据：物品准入口（不收货只管进来的，已经在里面的那件照常走）
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 实测：改贴着分流器出口的物品准入口的设定（上限、放行的物品、重置），分流器接着轮（实测-2026-11-25）
      «进货上次» := s.«进货上次»    -- 没测：改物品准入口的设定不算通道有增减（改汇流器进口带上准入口的设定，进口的先后不变，是实测-2026-11-26；汇流器记的位置接着用没有单独测）
      «出货已移动» := s.«出货已移动»    -- 没测：改物品准入口的设定不算通道有增减
      «制造中» := s.«制造中»    -- 无关
      «准入口» := «换» s.«准入口» u    -- 未定：改设定后的计数（每 5 tick 上限变了时的累计已收、换了放行的物品时的名额，取自参数；换放行的物品时累计已收清零、只改累计收下上限或取消后重设时不变，是据「物品准入口」；放行的物品没换时名额照原样：改上限是实测-2026-11-25，把限速关掉再打开是实测-2026-11-26，关着时收下的货不占名额）
        { «放行» := x
          «累计上限» := a
          «每5tick上限» := b
          «累计已收» :=
            if old.«放行» != x then 0
            else if old.«每5tick上限» == b then old.«累计已收»
            else cnt.1
          «名额» := if old.«放行» != x then cnt.2 else old.«名额»
          «拍» := old.«拍» }
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«重置计数» u => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 无关
      «准入口» := «换» s.«准入口» u    -- 实测：点重置以后累计通过数量归零（操控工具说明，2026-10-08）；每 5 tick 上限占着的名额不动（实测-2026-11-26，累计上限开着时测的五轮）
        { (s.«准入口» u) with «累计已收» := 0 }
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«设储存箱模式» u b => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 没测：切换模式的那一下不传输
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := «换» s.«储存箱» u    -- 实测：切换模式不动冷却，仓储模式下冷却不走，切回来接着走（实测-2026-11-25）
        { «仓储模式» := b
          «冷却还剩» := (s.«储存箱» u).«冷却还剩» }
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 没测：切换模式的那一下不传输
    }
  | .«设取货指向» u i x => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 没测：改取货端口指向的物品不算通道有增减
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := «换» s.«取货指向» u («换» (s.«取货指向» u) i x)    -- 据：设定
      «仓库» := s.«仓库»    -- 无关
    }
  | .«拨开关» us b => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 据：需电功能（不运行时进行中的进度保留）
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 实测：拨开关的那一下不动冷却，关着的那些步冷却不走，打开接着走（实测-2026-11-25）
      «开关» := fun u => if us.contains u then b else s.«开关» u    -- 据：开关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«放货» u x n => some {
      «历史» := s.«历史»    -- 无关
      «货» := fun g => todo.«放进单位» s u x n g    -- 待写：放进单位
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
