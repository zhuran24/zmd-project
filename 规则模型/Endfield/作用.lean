import Endfield.«框架»

/-!
# 作用：每种操作发生以后，状态的每一样怎样变

`作用` 里每种操作都把状态的每个字段写一遍，不用「其余不变」的省略写法（少写一个字段编译不过），
所以「每样东西 × 每种事」的每一格都必须有着落。着落写在那一格第一行的行尾，有七种：

- 据：规则文件或求解任务的某一行写明了；
- 实测：某次实测；
- 没测：没有哪一行写，照最自然的做法写了；
- 未定：规则没写、也没测过，有不止一种说得通的做法，值取自 `未定`；
- 待写：规则有，模型里还没写到，值取自 `待写`；
- 约定：只是模型里的记法，和游戏怎么做无关；
- 无关：这件事碰不到这样东西，原样不变。

`python3 查格子.py` 把这些格子排成一张表（格子表.md），并核对每一格都有着落。
「没测」「未定」的格子就是还没抓到的边界，在 边界清单.md 里各有一条。
-/

namespace Endfield

/-- 工具：把函数 f 在 a 处的值换成 b，别处不变。 -/
def «换» {α β : Type} [DecidableEq α] (f : α → β) (a : α) (b : β) : α → β :=
  fun x => if x = a then b else f x

namespace «布局»

/-- 据：组、输入判定

通道 c 是不是状态里 `进货上次` 管的那种：起点不在分流器里，并且起点在元件里（几条通道进同一个单位的那一组），
或者通往汇流器（汇流器输入判定的那一组）。 -/
def «算进货» (L : «布局») (c : «通道») : Bool :=
  L.«种类» c.«起» != some .«分流器»
    && (L.«是运输单位» c.«起» || L.«种类» c.«止» == some .«汇流器»)

/-- 据：组

通道 c 是不是状态里 `出货已移动` 管的那种：非运输单位通往非汇流器。 -/
def «算出货» (L : «布局») (c : «通道») : Bool :=
  L.«是非运输单位» c.«起» && L.«种类» c.«止» != some .«汇流器»

end «布局»

namespace «状态»

/-- 据：物品格

单位 u 的各个物品格里一共有几件 x。 -/
def «单位里的件数» (s : «状态») (u : «单位号») (x : «物品») : Nat :=
  match s.«布局».«种类» u with
  | some k =>
    (k.«物品格».map fun n =>
      ((s.«货» ⟨u, n⟩).filter (·.«物» == x)).foldl (fun acc p => acc + p.«件数») 0).foldl (· + ·) 0
  | none => 0

end «状态»

namespace «操作»

/-- 框架：游戏让不让做这件事。做不了的操作没有结果（`作用` 给 `none`）。

现在只写了不用格子就能说的条件；位置、朝向、放不放得下这些，等格子和物品格写出来以后再加。 -/
def «做得了» (s : «状态») : «操作» → Bool
  | .«走一步» => true
  | .«改布局» (.«建成» u k) =>
    -- 协议核心：基地内有且只有一个
    (s.«布局».«种类» u).isNone
      && (k != .«协议核心» || !s.«布局».«单位表».any (·.2 == .«协议核心»))
  | .«改布局» (.«接通» c) =>
    -- 通道：不同单位之间，至少一方是运输单位
    c.«起» != c.«止» && (s.«布局».«种类» c.«起»).isSome && (s.«布局».«种类» c.«止»).isSome
      && (s.«布局».«是运输单位» c.«起» || s.«布局».«是运输单位» c.«止»)
      && !s.«布局».«通道表».any (·.1 == c)
  | .«改布局» (.«拆除» u) => (s.«布局».«种类» u).isSome
  | .«设准入口» u x a b =>
    -- 物品准入口：设了放行的物品才能设两项上限；累计 1～5000，每 5 tick 0～5
    s.«布局».«种类» u == some .«物品准入口»
      && (x.isSome || (a.isNone && b.isNone))
      && (match a with
          | some n => 1 ≤ n && n ≤ 5000
          | none => true)
      && (match b with
          | some n => n ≤ 5
          | none => true)
  | .«设储存箱模式» u _ => s.«布局».«种类» u == some .«协议储存箱»
  | .«设取货指向» u i _ =>
    -- 协议核心有 6 个取货端口，仓库取货口有 1 个
    (s.«布局».«种类» u == some .«协议核心» && i < 6)
      || (s.«布局».«种类» u == some .«仓库取货口» && i == 0)
  | .«拨开关» us _ =>
    -- 需电功能：制造、传输
    us.all fun u =>
      match s.«布局».«种类» u with
      | some (.«制造» _) | some .«协议储存箱» => true
      | _ => false
  | .«放货» u _ n =>
    n > 0 && (match s.«布局».«种类» u with
      | some (.«制造» _) | some .«协议储存箱» => true
      | _ => false)
  | .«收货» g =>
    !(s.«货» g).isEmpty && g.«名» != .«缓存» && s.«布局».«是非运输单位» g.«单位»
  | .«入库» x n => s.«仓库» x + n ≤ 80000
  | .«出库» x n => n ≤ s.«仓库» x
  | .«离线» H =>
    -- 求解任务「离线」：单位和通道还是那些，只是建成、接通的先后变了
    let L := s.«布局»
    let L' := H.«布局于» H.length
    L'.«单位表».length == L.«单位表».length && L.«单位表».all (L'.«单位表».contains ·)
      && L'.«通道表».length == L.«通道表».length
      && L.«通道表».all (fun p => L'.«通道表».any (·.1 == p.1))

end «操作»

/-- 框架：每种操作发生以后的状态；游戏不让做的操作是 `none`。

每种操作把状态的 13 个字段各写一遍，行尾是那一格的着落（七种写法见文件头）。 -/
def «作用» (un : «未定») (todo : «待写») (s : «状态») (o : «操作») : Option «状态» :=
  if !o.«做得了» s then none else
  let L := s.«布局»
  let now := s.«历史».length + 1
  match o with
  | .«走一步» => some («一步» un todo s)
  | .«改布局» (.«建成» u k) => some {
      «历史» := s.«历史» ++ [.«建成» u k]    -- 据：接通
      «货» := fun g => if g.«单位» = u then [] else s.«货» g    -- 没测：新建的单位里没有货
      «已停» := fun g => if g.«单位» = u then 0 else s.«已停» g    -- 没测：新建的单位里没有货
      «来处» := fun g => if g.«单位» = u then none else s.«来处» g    -- 没测：新建的单位里没有货
      «分流器上次» := «换» s.«分流器上次» u none    -- 据：元件轮询（新建的单位没移动过物品）
      «进货上次» := «换» s.«进货上次» u none    -- 据：元件轮询（新建的单位没移动过物品）
      «出货已移动» := «换» s.«出货已移动» u []    -- 据：非运输单位轮询（新建的单位没移动过物品）
      «制造中» := «换» s.«制造中» u none    -- 没测：新建的制造单位没在制造
      «准入口» := «换» s.«准入口» u {}    -- 没测：新建的物品准入口没设放行的物品，计数是零
      «储存箱» := «换» s.«储存箱» u    -- 未定：新建储存箱的冷却（新建是无线传输模式，据「传输」）
        { «仓储模式» := false
          «冷却还剩» := un.«新建储存箱的冷却» }
      «开关» := «换» s.«开关» u true    -- 没测：新建的需电单位开关开着
      «取货指向» := «换» s.«取货指向» u (fun _ => none)    -- 没测：新建的取货端口没设物品
      «仓库» := s.«仓库»    -- 无关
    }
  | .«改布局» (.«接通» c) =>
    let L' := L.«加» now (.«接通» c)
    some {
      «历史» := s.«历史» ++ [.«接通» c]    -- 据：接通
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» :=    -- 实测：实测-2026-11-09 分流器出口变动八组（出口有增减就当成未移动过物品）
        if L.«种类» c.«起» == some .«分流器» then «换» s.«分流器上次» c.«起» none
        else s.«分流器上次»
      «进货上次» :=    -- 未定：通道增减后的进货上次
        if L'.«算进货» c then
          «换» s.«进货上次» c.«止» (un.«通道增减后的进货上次» L L' c.«止» (s.«进货上次» c.«止»))
        else s.«进货上次»
      «出货已移动» :=    -- 未定：通道增减后的出货已移动
        if L'.«算出货» c then
          «换» s.«出货已移动» c.«起» (un.«通道增减后的出货已移动» L L' c.«起» (s.«出货已移动» c.«起»))
        else s.«出货已移动»
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«改布局» (.«拆除» u) =>
    let L' := L.«加» now (.«拆除» u)
    some {
      «历史» := s.«历史» ++ [.«拆除» u]    -- 据：接通
      «货» := fun g => if g.«单位» = u then [] else s.«货» g    -- 未定：拆除时货回仓库
      «已停» := fun g => if g.«单位» = u then 0 else s.«已停» g    -- 约定：拆掉的单位名下各项回到没建时的样子
      «来处» := fun g =>    -- 没测：刚离开的那个单位被拆掉以后，不再记着它
        if g.«单位» = u then none
        else match s.«来处» g with
          | some p => if p.«单位» = u then none else some p
          | none => none
      «分流器上次» := fun v =>    -- 实测：实测-2026-11-09 分流器出口变动八组（出口有增减就当成未移动过物品）
        if v = u then none
        else if L.«种类» v == some .«分流器»
            && L.«通道表».any (fun p => p.1.«起» == v && p.1.«止» == u) then none
        else s.«分流器上次» v
      «进货上次» := fun v =>    -- 未定：通道增减后的进货上次
        if v = u then none
        else if L.«通道表».any (fun p => p.1.«起» == u && p.1.«止» == v && L.«算进货» p.1) then
          un.«通道增减后的进货上次» L L' v (s.«进货上次» v)
        else s.«进货上次» v
      «出货已移动» := fun v =>    -- 未定：通道增减后的出货已移动
        if v = u then []
        else if L.«通道表».any (fun p => p.1.«起» == v && p.1.«止» == u && L.«算出货» p.1) then
          un.«通道增减后的出货已移动» L L' v (s.«出货已移动» v)
        else s.«出货已移动» v
      «制造中» := «换» s.«制造中» u none    -- 约定：拆掉的单位名下各项回到没建时的样子
      «准入口» := «换» s.«准入口» u {}    -- 约定：拆掉的单位名下各项回到没建时的样子
      «储存箱» := «换» s.«储存箱» u {}    -- 约定：拆掉的单位名下各项回到没建时的样子
      «开关» := «换» s.«开关» u true    -- 约定：拆掉的单位名下各项回到没建时的样子
      «取货指向» := «换» s.«取货指向» u (fun _ => none)    -- 约定：拆掉的单位名下各项回到没建时的样子
      «仓库» := fun x =>    -- 未定：拆除时货回仓库
        s.«仓库» x + (if un.«拆除时货回仓库» then s.«单位里的件数» u x else 0)
    }
  | .«设准入口» u x a b =>
    let old := s.«准入口» u
    let cnt := un.«改设定后的计数» old x a b
    some {
      «历史» := s.«历史»    -- 据：物品准入口（阻断时不收货，通道还在）
      «货» := s.«货»    -- 据：物品准入口（阻断时不收货，已经在里面的那件照常走）
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 没测：改物品准入口的设定不算通道有增减
      «进货上次» := s.«进货上次»    -- 没测：改物品准入口的设定不算通道有增减
      «出货已移动» := s.«出货已移动»    -- 没测：改物品准入口的设定不算通道有增减
      «制造中» := s.«制造中»    -- 无关
      «准入口» := «换» s.«准入口» u    -- 未定：改设定后的计数（只改累计上限时累计已收不变，是实测）
        { «放行» := x
          «累计上限» := a
          «每5tick上限» := b
          «累计已收» :=
            if old.«放行» == x && old.«每5tick上限» == b then old.«累计已收» else cnt.1
          «本段已收» := cnt.2.1
          «本段还剩» := cnt.2.2 }
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«设储存箱模式» u b => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 没测：切换模式的那一下不传输
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := «换» s.«储存箱» u    -- 未定：切换模式后的冷却
        { «仓储模式» := b
          «冷却还剩» := un.«切换模式后的冷却» (s.«储存箱» u) b }
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 没测：切换模式的那一下不传输
    }
  | .«设取货指向» u i x => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 没测：改取货端口指向的物品不算通道有增减
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := «换» s.«取货指向» u («换» (s.«取货指向» u) i x)    -- 据：设定
      «仓库» := s.«仓库»    -- 无关
    }
  | .«拨开关» us b => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 据：需电功能（不运行时进行中的进度保留）
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 没测：拨开关的那一下冷却不变
      «开关» := fun u => if us.contains u then b else s.«开关» u    -- 据：开关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«放货» u x n => some {
      «历史» := s.«历史»    -- 无关
      «货» := fun g => todo.«放进单位» s u x n g    -- 待写：放进单位
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«收货» g => some {
      «历史» := s.«历史»    -- 无关
      «货» := «换» s.«货» g []    -- 没测：玩家把一格里的货整格拿走
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := s.«仓库»    -- 无关
    }
  | .«入库» x n => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := «换» s.«仓库» x (s.«仓库» x + n)    -- 据：求解任务「外部过程」
    }
  | .«出库» x n => some {
      «历史» := s.«历史»    -- 无关
      «货» := s.«货»    -- 无关
      «已停» := s.«已停»    -- 无关
      «来处» := s.«来处»    -- 无关
      «分流器上次» := s.«分流器上次»    -- 无关
      «进货上次» := s.«进货上次»    -- 无关
      «出货已移动» := s.«出货已移动»    -- 无关
      «制造中» := s.«制造中»    -- 无关
      «准入口» := s.«准入口»    -- 无关
      «储存箱» := s.«储存箱»    -- 无关
      «开关» := s.«开关»    -- 无关
      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := «换» s.«仓库» x (s.«仓库» x - n)    -- 据：求解任务「拿取成品」
    }
  | .«离线» H => some {
      «历史» := H    -- 据：求解任务「离线」（重建的先后无法确定，由操作带进来）
      «货» := s.«货»    -- 据：求解任务「离线」
      «已停» := s.«已停»    -- 据：求解任务「离线」
      «来处» := s.«来处»    -- 据：求解任务「离线」
      «分流器上次» := s.«分流器上次»    -- 据：求解任务「离线」
      «进货上次» := s.«进货上次»    -- 据：求解任务「离线」
      «出货已移动» := s.«出货已移动»    -- 据：求解任务「离线」
      «制造中» := s.«制造中»    -- 据：求解任务「离线」
      «准入口» := fun u =>    -- 未定：离线后的计数（设定照原样，是没测）
        let old := s.«准入口» u
        let cnt := un.«离线后的计数» old
        { old with «累计已收» := cnt.1, «本段已收» := cnt.2.1, «本段还剩» := cnt.2.2 }
      «储存箱» := s.«储存箱»    -- 据：求解任务「离线」（冷却写明保留；模式照原样，是没测）
      «开关» := s.«开关»    -- 没测：求解任务「离线」一行没提，照原样
      «取货指向» := s.«取货指向»    -- 没测：求解任务「离线」一行没提，照原样
      «仓库» := s.«仓库»    -- 没测：求解任务「离线」一行没提，照原样
    }

/-- 框架：游戏让做的操作都有结果，不让做的都没有。 -/
theorem «做得了才有结果» (un : «未定») (todo : «待写») (s : «状态») (o : «操作») :
    («作用» un todo s o).isSome = o.«做得了» s := by
  unfold «作用»
  cases h : o.«做得了» s <;> simp
  cases o with
  | «改布局» e => cases e <;> simp
  | _ => simp

/-- 框架：只有改布局和离线会改历史（走一步要等五条判定写出来以后再证）。

布局、建成先后、接通先后、终点的时刻、次序都是从历史算的，
所以改设定、放货收货、入库出库都不会改它们；这条对 `未定` 的每种取值都成立。 -/
theorem «只有改布局和离线改历史» (un : «未定») (todo : «待写») (s s' : «状态») (o : «操作»)
    (h : «作用» un todo s o = some s')
    (h1 : o ≠ .«走一步») (h2 : ∀ e, o ≠ .«改布局» e) (h3 : ∀ H, o ≠ .«离线» H) :
    s'.«历史» = s.«历史» := by
  unfold «作用» at h
  split at h
  · cases h
  · cases o <;> simp at h <;> first
      | (subst h; rfl)
      | (exact absurd rfl h1)
      | (exact absurd rfl (h2 _))
      | (exact absurd rfl (h3 _))

end Endfield
