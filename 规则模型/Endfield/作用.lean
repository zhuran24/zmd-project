      «取货指向» := s.«取货指向»    -- 无关
      «仓库» := «换» s.«仓库» x (s.«仓库» x - n)    -- 据：求解任务「拿取成品」
    }
  | .«离线» H => some {
      «历史» := H    -- 据：求解任务「离线」（重建的先后无法确定，由操作带进来）
      «货» := s.«货»    -- 据：求解任务「离线」
      «已停» := s.«已停»    -- 据：求解任务「离线」
      «来处» := s.«来处»    -- 据：求解任务「离线」
