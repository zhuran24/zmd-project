import Endfield.«作用»

/-!
# 合法基地：定理拿什么当前提

规则没写清的地方，有一类是「本题的基地上不会出现」。这份文件把这些条件写成能算的判断，定理拿它们当前提：

- `历史.合规`（在 `通道与移动.lean`）：每件事发生时，当时的布局都容得下它。从空基地做任何操作到达的状态都合规（已证）；
- `历史.端口数合`：任何一刻，进每个单位的通道都不多于它的存货端口、从它出去的通道都不多于它的取货端口。
  不带位置的这一层里它是前提；照位置一件件建出来的基地都满足（`命题.格子层的历史端口数合`，已证）：
  一个端口只对着一格，至多形成一条通道；
- `布局.走得通`：每个连着通道的运输单位都在某条运输带上。它从位置推不出来，照位置能建出断头带；
- `历史.合法`：上面三条合起来；
- `待写.有电只看历史`：供电状态只由基地上建了什么定，和物品格里的货、各项设定无关。
  格子层给出的供电只看场上的摆件，满足这一条。

每条定理各用到哪几条，写在 `命题.lean` 里那条命题的前提上。
-/

namespace Endfield

namespace «制造单位»

/-- 据：小制造单位、中制造单位、大制造单位、制造单位

存货端口那条边有几格（对边的取货端口也是这么多）：小制造单位 3，中制造单位 5，大制造单位的长边 6。 -/
def «端口边长» : «制造单位» → Nat
  | «粉碎机» | «精炼炉» | «配件机» | «塑形机» => 3
  | «采种机» | «种植机» => 5
  | «研磨机» | «封装机» | «灌装机» => 6

end «制造单位»

namespace «单位种类»

/-- 据：传送带、分流器、汇流器、物品准入口、桥接器、协议储存箱、制造单位、协议核心、仓库取货口

一个单位有几个存货端口。桥接器的四个物品格各记成一个单位，各有一个。 -/
def «存货端口数» : «单位种类» → Nat
  | .«传送带» | .«分流器» | .«物品准入口» | .«桥接器格» => 1
  | .«汇流器» => 3
  | .«协议储存箱» => 3
  | .«制造» k => k.«端口边长»
  | .«协议核心» => 14
  | .«仓库取货口» => 0

/-- 据：传送带、分流器、汇流器、物品准入口、桥接器、协议储存箱、制造单位、协议核心、仓库取货口

一个单位有几个取货端口。 -/
def «取货端口数» : «单位种类» → Nat
  | .«传送带» | .«汇流器» | .«物品准入口» | .«桥接器格» => 1
  | .«分流器» => 3
  | .«协议储存箱» => 3
  | .«制造» k => k.«端口边长»
  | .«协议核心» => 6
  | .«仓库取货口» => 1

end «单位种类»

namespace «布局»

/-- 据：端口、通道

端口数合：进每个单位的通道不多于它的存货端口，从它出去的通道不多于它的取货端口
（一段传送带里格与格之间的通道也算）。 -/
def «端口数合» (L : «布局») : Bool :=
  L.«单位表».all fun p =>
    decide ((L.«进» p.1).length ≤ p.2.«存货端口数») && decide ((L.«出» p.1).length ≤ p.2.«取货端口数»)

/-- 据：运输带、元件、次序

走得通：每个连着通道的运输单位都在某个元件里，而且这个元件顺着取货通道走得到某个末端元件，也就是它至少在一条运输带上。
连着通道的断头带、一圈首尾相接的传送带、只靠绕回自己的分流器出货的一圈元件都不满足（见 边界清单.md「合法基地」）。
什么通道都没连的运输单位不管（孤零零的一格传送带，桥接器没用到的那几个方向），它不在任何组里。 -/
def «走得通» (L : «布局») : Bool :=
  L.«单位表».all fun p =>
    !p.2.«是运输单位» || ((L.«进» p.1).isEmpty && (L.«出» p.1).isEmpty) ||
      match L.«所在元件» (L.«单位表».length + 1) p.1 with
      | some e => !(L.«运输带从» (L.«单位表».length + 1) e).isEmpty
      | none => false

end «布局»

namespace «历史»

/-- 据：端口、通道、接通

端口数合：从开始到现在的每一刻，布局的端口数都合。 -/
def «端口数合» (H : «历史») : Bool :=
  (List.range (H.length + 1)).all fun t => (H.«布局于» t).«端口数合»

/-- 据：运输带、端口、通道

合法基地：历史合规，每一刻端口数都合，现在的布局走得通。 -/
def «合法» (H : «历史») : Bool :=
  H.«合规» && H.«端口数合» && (H.«布局于» H.length).«走得通»

end «历史»

/-- 据：供电状态

供电状态只由基地上建了什么定：两个状态的历史相同，每个单位有没有电就相同。 -/
def «待写».«有电只看历史» (todo : «待写») : Prop :=
  ∀ (s s' : «状态») (u : «单位号»), s.«历史» = s'.«历史» → todo.«有电» s u = todo.«有电» s' u

end Endfield
