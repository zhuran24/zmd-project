import Endfield.«回放».«工具»

/-!
# 例子：照判定顺序走步

三个最小的布局，照规则文件一步一步推出每件物品在第几步到哪，再和代码走出来的对一遍。不是实测。
步从 1 数：`走几步 n` 是走完第 n 步以后的状态。
-/

namespace Endfield.«例子»

open Endfield.«回放»

/-- 例子：箱子 B（单位 0）接三格传送带（1、2、3）进箱子 Q（单位 4）；两个箱子都是仓储模式，B 的第 1 格放 50 件源矿。 -/
def «三格带» : Option «状态» :=
  («依次做» «状态».«空» [
    .«改布局» (.«建成» 0 .«协议储存箱»), .«改布局» (.«建成» 4 .«协议储存箱»),
    .«改布局» (.«建成» 1 .«传送带»), .«改布局» (.«建成» 2 .«传送带»), .«改布局» (.«建成» 3 .«传送带»),
    .«改布局» (.«接通» ⟨0, 1⟩), .«改布局» (.«接通» ⟨1, 2⟩), .«改布局» (.«接通» ⟨2, 3⟩),
    .«改布局» (.«接通» ⟨3, 4⟩),
    .«设储存箱模式» 0 true, .«设储存箱模式» 4 true]).map fun s => «装货» s 0 (.«格» 0) .«源矿» 50

-- 第 1 步 B 送出第一件（非运输单位的移动判定）；它在第 9、17 步各前移一格，第 25 步进 Q。
-- 之后每 8 步进一件：满载的传送带每 tick 前进一格、送出一件。
#guard («三格带».map fun s => «箱里几件» («走几步» 24 s) 4 .«源矿») == some 0
#guard («三格带».map fun s => «箱里几件» («走几步» 25 s) 4 .«源矿») == some 1
#guard («三格带».map fun s => «箱里几件» («走几步» 32 s) 4 .«源矿») == some 1
#guard («三格带».map fun s => «箱里几件» («走几步» 33 s) 4 .«源矿») == some 2
#guard («三格带».map fun s => «箱里几件» («走几步» 105 s) 4 .«源矿») == some 11

/-- 例子：箱子 B（单位 0）贴着分流器 S（单位 1）的进口；S 的三个出口各贴一个箱子，
按下（单位 2）、右（单位 3）、左（单位 4）的先后接上。B 里放 50 件源矿。（现象清单第 3 条的例子） -/
def «分流器三个出口» : Option «状态» :=
  («依次做» «状态».«空» [
    .«改布局» (.«建成» 0 .«协议储存箱»), .«改布局» (.«建成» 1 .«分流器»),
    .«改布局» (.«建成» 2 .«协议储存箱»), .«改布局» (.«建成» 3 .«协议储存箱»),
    .«改布局» (.«建成» 4 .«协议储存箱»),
    .«改布局» (.«接通» ⟨0, 1⟩),
    .«改布局» (.«接通» ⟨1, 2⟩), .«改布局» (.«接通» ⟨1, 3⟩), .«改布局» (.«接通» ⟨1, 4⟩),
    .«设储存箱模式» 0 true, .«设储存箱模式» 2 true, .«设储存箱模式» 3 true,
    .«设储存箱模式» 4 true]).map fun s => «装货» s 0 (.«格» 0) .«源矿» 50

/-- 例子：下、右、左三个箱子里各有几件源矿。 -/
def «下右左» (s : «状态») : List Nat := [2, 3, 4].map fun u => «箱里几件» s u .«源矿»

-- 第一件第 1 步进 S，第 9 步从第二个接上的出口（右）送出；第二件去左，第三件去下，第四件又去右。
#guard («分流器三个出口».map fun s => «下右左» («走几步» 8 s)) == some [0, 0, 0]
#guard («分流器三个出口».map fun s => «下右左» («走几步» 9 s)) == some [0, 1, 0]
#guard («分流器三个出口».map fun s => «下右左» («走几步» 17 s)) == some [0, 1, 1]
#guard («分流器三个出口».map fun s => «下右左» («走几步» 25 s)) == some [1, 1, 1]
#guard («分流器三个出口».map fun s => «下右左» («走几步» 33 s)) == some [1, 2, 1]

/-- 例子：箱子 B（单位 0）经一格带子（单位 2）进粉碎机 M（单位 1），M 经一格带子（单位 3）进箱子 Q（单位 4）。
B 里放 2 件源矿。 -/
def «一台粉碎机» : Option «状态» :=
  («依次做» «状态».«空» [
    .«改布局» (.«建成» 0 .«协议储存箱»), .«改布局» (.«建成» 1 (.«制造» .«粉碎机»)),
    .«改布局» (.«建成» 4 .«协议储存箱»),
    .«改布局» (.«建成» 2 .«传送带»), .«改布局» (.«建成» 3 .«传送带»),
    .«改布局» (.«接通» ⟨0, 2⟩), .«改布局» (.«接通» ⟨2, 1⟩),
    .«改布局» (.«接通» ⟨1, 3⟩), .«改布局» (.«接通» ⟨3, 4⟩),
    .«设储存箱模式» 0 true, .«设储存箱模式» 4 true]).map fun s => «装货» s 0 (.«格» 0) .«源矿» 2

-- 第一件源矿：第 1 步上带，第 9 步进 M、当步末开工，第 17 步开始时做好、当步送上出口的带子，第 25 步进 Q。
-- 第二件晚 8 步：第 33 步进 Q。
#guard («一台粉碎机».map fun s => «箱里几件» («走几步» 24 s) 4 .«源石粉末») == some 0
#guard («一台粉碎机».map fun s => «箱里几件» («走几步» 25 s) 4 .«源石粉末») == some 1
#guard («一台粉碎机».map fun s => «箱里几件» («走几步» 32 s) 4 .«源石粉末») == some 1
#guard («一台粉碎机».map fun s => «箱里几件» («走几步» 33 s) 4 .«源石粉末») == some 2

end Endfield.«例子»
