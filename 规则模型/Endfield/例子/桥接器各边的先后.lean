import Endfield.«回放».«格子工具»
import Endfield.«合法基地»

/-!
# 例子：同一个布局，桥接器转不转 90°，上游分流器的次序不一样

这里不是实测，是照规则和实测到的接通先后算一遍。桥接器四条边长得一样，但建成时各边接通的先后
跟着它自己的朝向走（`格子/几何与端口.lean` 的 `桥接器存货先后`，实测-2026-11-12）：
取货端口依次是它自己的下、上、右、左。这个例子说明朝向会影响结果，摆桥接器时不能当它没有朝向。

布局：分流器 S（10）分两支，都进同一座桥接器（30 起的四个单位）、各从对边出去进一个箱子。
- 长的一支：带 11、物品准入口 13、带 14–15，从桥接器左边进、右边出，进箱 X（40）；
- 短的一支：带 21–24，从桥接器上边进、下边出，进箱 Y（41）。
桥接器最后放，它的两个取货端口（右边的、下边的）同时接上 X 和 Y。

哪个先接通，哪个箱子的「终点的时刻」就早。S 在两条运输带上，次序取通往终点的时刻最早的那条：
通往 X 的那条上 S 排第 5，通往 Y 的那条上排第 3。
桥接器没转过时下边先于右边，Y 先；顺时针转过一次时，屏幕上的右边是它自己的上、下边是它自己的右，X 先。
-/

namespace Endfield.«例子».«桥接器各边的先后»

open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 例子：各摆件，照放的先后。源箱 0 经带 1 进分流器 10（上边进货）；桥接器 30 最后放，朝向是 d。
物品准入口 13 换在带 12 那一格上。 -/
def «摆件表» (d : «朝向») : Option (List «摆件») :=
  [«摆» 0 28 22 (.«协议储存箱» .«下»), «摆» 40 31 29 (.«协议储存箱» .«右»),
   «摆» 41 28 31 (.«协议储存箱» .«下»),
   «摆» 1 29 25 (.«传送带» .«上» .«下»), «摆» 10 29 26 (.«分流器» .«上»),
   «摆» 21 30 26 (.«传送带» .«左» .«下»), «摆» 22 30 27 (.«传送带» .«上» .«下»),
   «摆» 23 30 28 (.«传送带» .«上» .«下»), «摆» 24 30 29 (.«传送带» .«上» .«下»),
   «摆» 11 29 27 (.«传送带» .«上» .«下»), «摆» 12 29 28 (.«传送带» .«上» .«下»),
   «摆» 14 29 29 (.«传送带» .«上» .«下»), «摆» 15 29 30 (.«传送带» .«上» .«右»),
   «摆» 13 29 28 (.«物品准入口» .«下»), «摆» 30 30 30 (.«桥接器» d)].mapM id

/-- 例子：把布局建出来；箱子建好就切成仓储模式。 -/
def «建出来» (d : «朝向») : Option Endfield.«格子».«状态» := («摆件表» d).bind «布置»

/-- 例子：最后四条接通的通道，和分流器 S 的次序。 -/
def «先后和次序» (d : «朝向») : Option (List («单位号» × «单位号») × Option Nat) :=
  («建出来» d).map fun f =>
    let H := f.«模型».«历史»
    let cs := («接通表» H).map fun c => (c.«起», c.«止»)
    (cs.drop (cs.length - 4), H.«次序» H.length 10)

-- 桥接器建成时先接两个存货端口（上边来的带 24、左边来的带 15），再接两个取货端口。
-- 没转过：下边的取货端口（30→41）在前，S 的次序是 3；转过一次：右边的（33→40）在前，S 的次序是 5。
#guard «先后和次序» .«上» == some ([(24, 30), (15, 33), (30, 41), (33, 40)], some 3)
#guard «先后和次序» .«右» == some ([(15, 33), (24, 30), (33, 40), (30, 41)], some 5)

-- 两种朝向建出来的基地都合法（合规、每一刻端口数合、走得通），所以这不是本题不管的情形。
#guard [«朝向».«上», .«右»].all fun d => ((«建出来» d).map fun f => f.«模型».«历史».«合法») == some true

/-- 例子：准入口只放行源矿、每 5 tick 1 件，源箱放 60 件源矿，走 n 步，逐步记下
S、长支各格、短支各格和桥接器两个单位里有没有货。 -/
def «逐步» (d : «朝向») (n : Nat) : Option (List (List Bool)) := do
  let f ← «建出来» d
  let f ← «做» f (.«原样» (.«设准入口» 13 (some .«源矿») none (some 1)))
  let g ← «做» f (.«原样» (.«放货» 0 .«源矿» 60))
  let T := g.«模型».«历史».«立表»
  let todo := g.«场地».«待写» «端口先后» «无效口»
  return ((List.range n).foldl (fun (acc : Endfield.«状态» × List (List Bool)) _ =>
    let t := «走» «取一种» todo T 1 acc.1
    (t, acc.2 ++ [[10, 11, 13, 14, 15, 21, 22, 23, 24, 30, 33].map fun u => («格里» t u).isSome]))
    (g.«模型», [])).2

-- 两种朝向走出来，头 64 步各格都一样，第 65 步起不一样：S 的组排在长支那两个组之前还是之后，
-- 决定了 S 那件货判定时带 11 腾没腾出来。（这个布局里两个箱子最后收到的件数一样，差的是哪一步到。）
#guard (do
  let a ← «逐步» .«上» 80
  let b ← «逐步» .«右» 80
  return (List.range 80).find? fun i => a[i]? != b[i]?) == some (some 64)

end Endfield.«例子».«桥接器各边的先后»
