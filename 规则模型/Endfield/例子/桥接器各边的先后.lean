import Endfield.«回放».«格子工具»
import Endfield.«合法基地»

/-!
# 例子：桥接器两个取货端口谁先接通，会改上游分流器的次序

这里不是实测，是照规则算一遍。规则「接通」一行的三条管不到桥接器四条边之间的先后
（见 边界清单.md「桥接器四条边之间、协议核心各端口之间，同时接通的先后」），格子层把它做成了参数。
这个例子说明这个参数取哪种会影响结果，所以它不是可以随便取的。

布局：分流器 S（10）分两支，都进同一座桥接器（30 起的四个单位）、各从对边出去进一个箱子。
- 长的一支：带 11、物品准入口 13、带 14–15，从桥接器左边进、右边出，进箱 X（40）；
- 短的一支：带 21–24，从桥接器上边进、下边出，进箱 Y（41）。
桥接器最后放，它的两个取货端口（右边的、下边的）同时接上 X 和 Y。

哪个先接通，哪个箱子的「终点的时刻」就早。S 在两条运输带上，次序取通往终点的时刻最早的那条：
通往 X 的那条上 S 排第 5，通往 Y 的那条上排第 3。
-/

namespace Endfield.«例子».«桥接器各边的先后»

open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 例子：桥接器的取货端口先右边、后下边（X 先接上）。 -/
def «先右» : «接通先后» := «端口先后»

/-- 例子：桥接器的取货端口先下边、后右边（Y 先接上）。 -/
def «先下» : «接通先后» :=
  { «端口先后» with «桥接器取货» := fun d => match d with | .«下» => 0 | .«右» => 1 | _ => 2 }

/-- 例子：各摆件，照放的先后。源箱 0 经带 1 进分流器 10（上边进货）；桥接器 30 最后放。
物品准入口 13 换在带 12 那一格上。 -/
def «摆件表» : Option (List «摆件») :=
  [«摆» 0 28 22 (.«协议储存箱» .«下»), «摆» 40 31 29 (.«协议储存箱» .«右»),
   «摆» 41 28 31 (.«协议储存箱» .«下»),
   «摆» 1 29 25 (.«传送带» .«上» .«下»), «摆» 10 29 26 (.«分流器» .«上»),
   «摆» 21 30 26 (.«传送带» .«左» .«下»), «摆» 22 30 27 (.«传送带» .«上» .«下»),
   «摆» 23 30 28 (.«传送带» .«上» .«下»), «摆» 24 30 29 (.«传送带» .«上» .«下»),
   «摆» 11 29 27 (.«传送带» .«上» .«下»), «摆» 12 29 28 (.«传送带» .«上» .«下»),
   «摆» 14 29 29 (.«传送带» .«上» .«下»), «摆» 15 29 30 (.«传送带» .«上» .«右»),
   «摆» 13 29 28 (.«物品准入口» .«下»), «摆» 30 30 30 .«桥接器»].mapM id

/-- 例子：照接通先后 `o` 做一个格子层的操作。 -/
def «做一个» (o : «接通先后») (s : Endfield.«格子».«状态») (a : Endfield.«格子».«操作») :
    Option Endfield.«格子».«状态» :=
  Endfield.«格子».«作用» «取一种» o «无效口» s a

/-- 例子：照接通先后 `o` 把布局建出来；箱子建好就切成仓储模式。 -/
def «建出来» (o : «接通先后») : Option Endfield.«格子».«状态» := do
  let ps ← «摆件表»
  ps.foldlM (fun s p => do
    let t ← «做一个» o s (.«建» p)
    match p.«种类» with
    | .«协议储存箱» _ => «做一个» o t (.«原样» (.«设储存箱模式» p.«号» true))
    | _ => return t) Endfield.«格子».«状态».«空»

/-- 例子：最后四条接通的通道，和分流器 S 的次序。 -/
def «先后和次序» (o : «接通先后») : Option (List («单位号» × «单位号») × Option Nat) :=
  («建出来» o).map fun f =>
    let H := f.«模型».«历史»
    let cs := («接通表» H).map fun c => (c.«起», c.«止»)
    (cs.drop (cs.length - 4), H.«次序» H.length 10)

-- 桥接器建成时先接两个存货端口（上边来的带 24、左边来的带 15），再接两个取货端口。
-- 先右：33→40 在前，S 的次序是 5；先下：30→41 在前，S 的次序是 3。
#guard «先后和次序» «先右» == some ([(24, 30), (15, 33), (33, 40), (30, 41)], some 5)
#guard «先后和次序» «先下» == some ([(24, 30), (15, 33), (30, 41), (33, 40)], some 3)

-- 两种先后建出来的基地都合法（合规、每一刻端口数合、走得通），所以这不是本题不管的情形。
#guard [«先右», «先下»].all fun o => ((«建出来» o).map fun f => f.«模型».«历史».«合法») == some true

/-- 例子：准入口只放行源矿、每 5 tick 1 件，源箱放 60 件源矿，走 n 步，逐步记下
S、长支各格、短支各格和桥接器两个单位里有没有货。 -/
def «逐步» (o : «接通先后») (n : Nat) : Option (List (List Bool)) := do
  let f ← «建出来» o
  let f ← «做一个» o f (.«原样» (.«设准入口» 13 (some .«源矿») none (some 1)))
  let g ← «做一个» o f (.«原样» (.«放货» 0 .«源矿» 60))
  let T := g.«模型».«历史».«立表»
  let todo := g.«场地».«待写» o «无效口»
  return ((List.range n).foldl (fun (acc : Endfield.«状态» × List (List Bool)) _ =>
    let t := «走» «取一种» todo T 1 acc.1
    (t, acc.2 ++ [[10, 11, 13, 14, 15, 21, 22, 23, 24, 30, 33].map fun u => («格里» t u).isSome]))
    (g.«模型», [])).2

-- 两种先后走出来，头 64 步各格都一样，第 65 步起不一样：S 的组排在长支那两个组之前还是之后，
-- 决定了 S 那件货判定时带 11 腾没腾出来。（这个布局里两个箱子最后收到的件数一样，差的是哪一步到。）
#guard (do
  let a ← «逐步» «先右» 80
  let b ← «逐步» «先下» 80
  return (List.range 80).find? fun i => a[i]? != b[i]?) == some (some 64)

end Endfield.«例子».«桥接器各边的先后»
