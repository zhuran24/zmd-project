import Endfield.«拓扑与级别»

/-!
# 例子：元件、终点、终点的时刻、次序、组、级别

这里不是实测的回放，是拿几个小布局照「拓扑与级别」那几行算一遍，核对代码是照规则写的。
每个例子先列发生的事（建成、接通、拆除），行尾注明单位号或时刻。
-/

namespace Endfield.«例子»

/-- 例子：分流器 S 一个出口接协议储存箱 U，另一个出口接两格传送带进协议储存箱 V。 -/
def «半边接带子的分流器» : «历史» := [
  .«建成» 0 .«协议储存箱»,   -- 时刻 1，单位 0：U
  .«建成» 1 .«协议储存箱»,   -- 时刻 2，单位 1：V
  .«建成» 2 .«分流器»,       -- 时刻 3，单位 2：S
  .«接通» ⟨2, 0⟩,          -- 时刻 4：S → U
  .«建成» 3 .«传送带»,       -- 时刻 5，单位 3：带子第一格
  .«接通» ⟨2, 3⟩,          -- 时刻 6：S → 带子
  .«建成» 4 .«传送带»,       -- 时刻 7，单位 4：带子第二格
  .«接通» ⟨3, 4⟩,          -- 时刻 8：第一格 → 第二格
  .«接通» ⟨4, 1⟩]          -- 时刻 9：带子 → V

-- 元件是 S 和那段两格的带子（用出口格 4 指代）。
#guard («半边接带子的分流器».«布局于» 9).«元件» == [2, 4]
-- S 有一个出口接着带子，不是末端元件，也不是终点；U 只连着 S，也不是终点。
#guard !(«半边接带子的分流器».«布局于» 9).«是末端元件» 2
#guard !(«半边接带子的分流器».«布局于» 9).«是终点» 2
#guard !(«半边接带子的分流器».«布局于» 9).«是终点» 0
-- 带子是末端元件，终点是 V，终点的时刻是带子和 V 接通的那一刻。
#guard («半边接带子的分流器».«布局于» 9).«终点» 4 == some 1
#guard «半边接带子的分流器».«终点的时刻» 9 1 == some 9
-- 带子的次序是 1；S 的次序从带子那头往回数，是 2。
#guard «半边接带子的分流器».«次序» 9 4 == some 1
#guard «半边接带子的分流器».«次序» 9 2 == some 2

-- 组有两个：S 的两条取货通道；带子进 V 的那条。带子两格之间的通道不在任何组里。
#guard («半边接带子的分流器».«布局于» 9).«各组» == [.«分流器的» 2, .«进同一个的» 1]
#guard ((«半边接带子的分流器».«布局于» 9).«组的通道» (.«分流器的» 2)).map (·.1) == [⟨2, 0⟩, ⟨2, 3⟩]
#guard («半边接带子的分流器».«布局于» 9).«所在组» ⟨3, 4⟩ == none
-- S 那一组的时刻是它第一条取货通道接通的那一刻（时刻 4）；级别是（S 的次序 2，时刻 4）。
#guard «半边接带子的分流器».«组的时刻» 9 (.«分流器的» 2) == some 4
#guard «半边接带子的分流器».«级别» 9 (.«分流器的» 2) == some (2, 4)
-- 带子进 V 的那一组：级别是（带子的次序 1，时刻 9），高于 S 那一组，所以每步先判带子、再判 S。
#guard «半边接带子的分流器».«级别» 9 (.«进同一个的» 1) == some (1, 9)
#guard «历史».«级别高于» (1, 9) (2, 4)

/-- 例子：上一个布局里，再把带子第一格拆掉。 -/
def «拆掉带子那一支» : «历史» := «半边接带子的分流器» ++ [.«拆除» 3]   -- 时刻 10

-- S 剩下的出口只接着 U，成了末端元件，以它自己为终点。
#guard («拆掉带子那一支».«布局于» 10).«终点» 2 == some 2
-- S 的终点的时刻是它当初和 U 接通的那一刻（时刻 4），不是拆带子的那一刻（时刻 10）。
#guard «拆掉带子那一支».«终点的时刻» 10 2 == some 4
#guard «拆掉带子那一支».«次序» 10 2 == some 1
-- U 仍然不是终点：末端元件是分流器的运输带，以分流器为终点。
#guard !(«拆掉带子那一支».«布局于» 10).«是终点» 0

/-- 例子：分流器 S 的两支，短的一支（一格带子）后接上箱子 P，长的一支（带子、物品准入口、带子）先接上箱子 Q。 -/
def «两支先后接上» : «历史» := [
  .«建成» 0 .«协议储存箱»,   -- 时刻 1，单位 0：P
  .«建成» 1 .«协议储存箱»,   -- 时刻 2，单位 1：Q
  .«建成» 2 .«分流器»,       -- 时刻 3，单位 2：S
  .«建成» 3 .«传送带»,       -- 时刻 4，单位 3：长支最后一格
  .«接通» ⟨3, 1⟩,          -- 时刻 5：长支 → Q
  .«建成» 4 .«物品准入口»,   -- 时刻 6，单位 4
  .«接通» ⟨4, 3⟩,          -- 时刻 7：准入口 → 长支最后一格
  .«建成» 5 .«传送带»,       -- 时刻 8，单位 5：长支第一格
  .«接通» ⟨2, 5⟩,          -- 时刻 9：S → 长支第一格
  .«接通» ⟨5, 4⟩,          -- 时刻 10：长支第一格 → 准入口
  .«建成» 6 .«传送带»,       -- 时刻 11，单位 6：短支
  .«接通» ⟨2, 6⟩,          -- 时刻 12：S → 短支
  .«接通» ⟨6, 0⟩]          -- 时刻 13：短支 → P

-- S 在两条运输带上：经短支到 P（终点的时刻 13），经长支到 Q（终点的时刻 5）。
#guard («两支先后接上».«布局于» 13).«运输带从» 8 2 == [[2, 5, 4, 3], [2, 6]]
#guard «两支先后接上».«终点的时刻» 13 0 == some 13
#guard «两支先后接上».«终点的时刻» 13 1 == some 5
-- S 的次序取终点的时刻最早的那条（到 Q 的长支）：4，不是经短支数出来的 2。
#guard «两支先后接上».«次序» 13 2 == some 4

/-- 例子：协议储存箱 B 的三个出口，一个接一格带子进汇流器 J，一个直接贴着 J，一个接一格带子进箱子 Q；J 往下进箱子 R。 -/
def «箱子三个出口» : «历史» := [
  .«建成» 0 .«协议储存箱»,   -- 时刻 1，单位 0：B
  .«建成» 1 .«协议储存箱»,   -- 时刻 2，单位 1：Q
  .«建成» 2 .«协议储存箱»,   -- 时刻 3，单位 2：R
  .«建成» 3 .«汇流器»,       -- 时刻 4，单位 3：J
  .«接通» ⟨0, 3⟩,          -- 时刻 5：B → J（直接贴着）
  .«接通» ⟨3, 2⟩,          -- 时刻 6：J → R
  .«建成» 4 .«传送带»,       -- 时刻 7，单位 4：进 J 的那格带子
  .«接通» ⟨0, 4⟩,          -- 时刻 8：B → 带子
  .«接通» ⟨4, 3⟩,          -- 时刻 9：带子 → J
  .«建成» 5 .«传送带»,       -- 时刻 10，单位 5：进 Q 的那格带子
  .«接通» ⟨0, 5⟩,          -- 时刻 11：B → 带子
  .«接通» ⟨5, 1⟩]          -- 时刻 12：带子 → Q

-- B 通往汇流器的那条自成一组；通往两格带子的两条是一组。
#guard («箱子三个出口».«布局于» 12).«所在组» ⟨0, 3⟩ == some (.«进汇流器的» ⟨0, 3⟩)
#guard ((«箱子三个出口».«布局于» 12).«组的通道» (.«出货的» 0)).map (·.1) == [⟨0, 4⟩, ⟨0, 5⟩]
-- 次序：J 是 1，进 J 的带子是 2，进 Q 的带子是 1。
#guard «箱子三个出口».«次序» 12 3 == some 1
#guard «箱子三个出口».«次序» 12 4 == some 2
#guard «箱子三个出口».«次序» 12 5 == some 1
-- B 通往带子的那一组：所通元件中最大的次序是 2，组的时刻是 8。
#guard «箱子三个出口».«级别» 12 (.«出货的» 0) == some (2, 8)
-- B 通往 J 的那一组：次序是 J 的 1，组的时刻是 5。级别比上一组高，B 被选取时先判这一组。
#guard «箱子三个出口».«级别» 12 (.«进汇流器的» ⟨0, 3⟩) == some (1, 5)
-- 带子进 J、带子进 Q 各是一组（进的单位不同）。
#guard («箱子三个出口».«布局于» 12).«各组» ==
  [.«进汇流器的» ⟨0, 3⟩, .«进同一个的» 2, .«出货的» 0, .«进同一个的» 3, .«进同一个的» 1]

end Endfield.«例子»
