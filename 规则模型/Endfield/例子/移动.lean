import Endfield.«物品格»
import Endfield.«例子».«拓扑»

/-!
# 例子：可移动物品、放进哪、移一件

拿「半边接带子的分流器」那个布局（分流器 S = 单位 2，一个出口贴着箱子 U = 单位 0，另一个出口接两格带子
3、4 进箱子 V = 单位 1），照「端口与物品格」「通道与移动」那几行算一遍。不是实测。
-/

namespace Endfield.«例子»

/-- 例子：分流器 S 里停着 1 件源矿，已经停了 n 步；别处都空着。 -/
def «分流器里一件» (n : «步») : «状态» :=
  { «状态».«空» with
    «历史» := «半边接带子的分流器»
    «货» := fun g => if g = ⟨2, .«格» 0⟩ then [⟨.«源矿», 1⟩] else []
    «已停» := fun g => if g = ⟨2, .«格» 0⟩ then n else 0 }

/-- 例子：这个布局里没有协议核心和仓库取货口，通道接在第几个取货端口上用不到。 -/
def «不用口» : «通道» → Nat := fun _ => 0

-- 停了 7 步：还不是可移动物品。停满 8 步：可以经 S → U 移进 U 的第 1 格（编号 0）。
#guard («分流器里一件» 7).«能移» «不用口» ⟨2, 0⟩ == none
#guard («分流器里一件» 8).«能移» «不用口» ⟨2, 0⟩ ==
  some (.«源矿», .«格» ⟨2, .«格» 0⟩, .«格» ⟨0, .«格» 0⟩)
-- 也可以经 S → 带子第一格移过去（带子那格空着）。
#guard («分流器里一件» 8).«能移» «不用口» ⟨2, 3⟩ ==
  some (.«源矿», .«格» ⟨2, .«格» 0⟩, .«格» ⟨3, .«格» 0⟩)

/-- 例子：那件源矿经 S → 带子第一格移过去以后。 -/
def «移到带子上» : «状态» :=
  («分流器里一件» 8).«移一件» ⟨2, 3⟩ .«源矿» (.«格» ⟨2, .«格» 0⟩) (.«格» ⟨3, .«格» 0⟩)

-- S 空了，带子第一格有 1 件、从零算起；它记着刚离开的是 S 的物品格；S 记着上一次是往带子送的。
#guard «移到带子上».«货» ⟨2, .«格» 0⟩ == []
#guard «移到带子上».«货» ⟨3, .«格» 0⟩ == [⟨.«源矿», 1⟩]
#guard «移到带子上».«已停» ⟨3, .«格» 0⟩ == 0
#guard «移到带子上».«来处» ⟨3, .«格» 0⟩ == some ⟨2, .«格» 0⟩
#guard «移到带子上».«分流器上次» 2 == some ⟨2, 3⟩
-- 刚进来的那件还没停满 1 tick，带子里往下一格的通道现在不能移。
#guard «移到带子上».«能移» «不用口» ⟨3, 4⟩ == none

/-- 例子：箱子 U 的第 1 格放满 50 件源矿、第 2 格放着 3 件蓝铁矿，S 里停着 1 件源矿。 -/
def «箱子第一格满了» : «状态» :=
  { «分流器里一件» 8 with
    «货» := fun g =>
      if g = ⟨2, .«格» 0⟩ then [⟨.«源矿», 1⟩]
      else if g = ⟨0, .«格» 0⟩ then [⟨.«源矿», 50⟩]
      else if g = ⟨0, .«格» 1⟩ then [⟨.«蓝铁矿», 3⟩]
      else [] }

-- 编号最小的能放它的物品格：第 1 格满了，第 2 格是别的物品，放进第 3 格（编号 2）。
#guard «箱子第一格满了».«放进哪» ⟨2, 0⟩ .«源矿» == some (.«格» ⟨0, .«格» 2⟩)
-- 蓝铁矿放进已经有蓝铁矿的第 2 格（编号 1）。
#guard «箱子第一格满了».«放进哪» ⟨2, 0⟩ .«蓝铁矿» == some (.«格» ⟨0, .«格» 1⟩)

end Endfield.«例子»
