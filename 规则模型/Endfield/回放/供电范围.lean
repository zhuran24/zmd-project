import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-11-25.md「供电范围边界上的格算不算有电」一节。
核对的是：供电桩占 2×2、左上角那格是 (p,q) 时，范围正好是 p−5 到 p+6 列、q−5 到 q+6 行；
精炼炉占的 9 格里只要有一格（哪怕只是一个角）在范围里就有电，一格都不在就没电。

实测记录里精炼炉给的是中心那一格，这里的 `摆` 要左上角，所以各减 1。
-/

namespace Endfield.«回放».«供电范围»

open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 回放：供电桩左上角在 (p,q)，一台精炼炉中心在 (ci,cj)，这台精炼炉有没有电。 -/
def «有电吗» (p q ci cj : Nat) : Option Bool := do
  let a ← «摆» 99 p q .«供电桩»
  let m ← «摆» 1 (ci - 1) (cj - 1) (.«制造» .«精炼炉» .«下»)
  return «场地».«有电» [a, m] 1

-- 供电桩左上角 (30,21)（范围 25–36 列、16–27 行）：
-- 左、右、上三条边「贴边里」和只有一个角格在范围里的，读到「空闲中」；
#guard [(24, 20), (37, 18), (27, 15), (24, 15)].all fun c => «有电吗» 30 21 c.1 c.2 == some true
-- 各自再往外挪一格的，读到「未通电」。
#guard [(23, 24), (38, 22), (31, 14), (23, 14)].all fun c => «有电吗» 30 21 c.1 c.2 == some false
-- 供电桩左上角 (30,14)（范围 25–36 列、9–20 行）：下边「贴边里」和左下、右下两个角格在范围里的有电；
#guard [(27, 21), (24, 21), (37, 21)].all fun c => «有电吗» 30 14 c.1 c.2 == some true
-- 往外挪一格的没电。
#guard [(31, 22), (23, 22)].all fun c => «有电吗» 30 14 c.1 c.2 == some false

/-- 回放：场上没有供电桩时，一台精炼炉有没有电。 -/
def «没有供电桩» (ci cj : Nat) : Option Bool :=
  («摆» 1 (ci - 1) (cj - 1) (.«制造» .«精炼炉» .«下»)).map fun m => «场地».«有电» [m] 1

-- 对照：没放供电桩时，这些位置都读到「未通电」。
#guard [(24, 20), (23, 24), (37, 18), (38, 22), (27, 15), (31, 14), (24, 15), (27, 21), (31, 22), (24, 21), (37, 21)].all
  fun c => «没有供电桩» c.1 c.2 == some false

end Endfield.«回放».«供电范围»
