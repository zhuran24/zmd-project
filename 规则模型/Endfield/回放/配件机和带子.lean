import Endfield.«回放».«工具»

/-!
# 配件机和同样长的带子：现象清单第 27 条

来源（相对仓库根目录）：
- 求解器/规则修订/2026-10-10-交给GPT/现象.md，第 27 条。
- 求解器/规则修订/2026-10-08-现象整理/现象.md，「制造与换料 3」。

先列观察：
1. 满载稳态，两套下游各运输单位同一步的有货/无货位置一一相同，每 tick 如此。
2. 截图：普通一套前七格全有货；配件机一套前三格和后一个格全有货。
3. 截图：两套上半圈各两件、下半圈各一件，汇流器后一格各一件，位置相同。
4. 作者称加工时延 2 秒、三格带行走 6 秒，配件机流速与满带相当。

来源没有操作先后、半圈格数、启动状态或截图步号。这里固定从空装置同时供货，
每套仓库预放 1000 件钢块，取货口指向钢块，收货箱设仓储模式；全部建接完成才走步。
先等 20 tick，再逐步读 4 tick（第 160 至 191 步末），不按结果挪动窗口。
各半圈选三格：若分流器在 (0,0)、汇流器在 (2,0)，上路为 (0,-1)、(1,-1)、(2,-1)，
下路为 (0,1)、(1,1)、(2,1)；中间 (1,0) 留空，没有直连。坐标仅说明所选摆法，模型不存坐标。
截图无时刻，观察 3 只核对窗口中是否出现该帧，不断言每步上二下一。

跳过：紫晶纤维和相应零件不在规则文件配方/模型物品中；以下用现有的钢块→钢制零件，
保留 1 进 1 出、1 tick 的配件机。结论只涉及占格，不声称重现了原物料。
没有坐标，无法核验基地边界、实际端口贴合和供电范围；使用工具中的都有电。
来源时间以秒表述，模型只能核对 1 tick（8 步）加工、三格带的 3 tick，不能核对现实秒数。

未定始终用工具的取一种。计时落点、建成和接通分开、供电未建模均已列在边界清单，
本回放没有新增规则缺口。有限窗口核对，不作无限稳态定理。
-/

namespace Endfield.«回放».«配件机和带子»

/-- 回放：一套装置；m 为真时是前三带、配件机 4、后带 7，否则是带 1 至 7。
0 仓库取货口，10 分流器，11 至 13 上半圈，14 至 16 下半圈，17 汇流器，18 带，19 箱。
先建货源、收货箱和制造单位，再建输入带和半圈，最后建汇流器、分流器、出货带。
同次建成的通道按规则「接通」排：先存后取；分流器进口向西，顺时针上出口先于下出口；
汇流器出口向东，顺时针下进口先于上进口。其他带子一律先接进口、再接已存在的下游。
建成与其自动接通之间不走步。两套各用同一剧本、相同起步时刻。 -/
def «布置» (m : Bool) : List «一幕» :=
  [«建» 0 .«仓库取货口», «建» 19 .«协议储存箱», «仓储» 19]
  ++ (if m then [«建» 4 (.«制造» .«配件机»)] else [])
  ++ «一串带» 0 [1, 2, 3]
  ++ (if m then [«连» 3 4] ++ «一串带» 4 [7]
      else «一串带» 3 [4, 5, 6, 7])
  ++ [«建» 11 .«传送带»] ++ «一串带» 11 [12, 13]
  ++ [«建» 14 .«传送带»] ++ «一串带» 14 [15, 16]
  ++ [«建» 17 .«汇流器», «连» 16 17, «连» 13 17,
      «建» 10 .«分流器», «连» 7 10, «连» 10 11, «连» 10 14]
  ++ «一串带» 17 [18] ++ [«连» 18 19,
      .«做» (.«设取货指向» 0 0 (some .«钢块»)), .«做» (.«入库» .«钢块» 1000)]

/-- 回放：比较的下游运输单位，依次为分流器、上三格、下三格、汇流器、出口带。 -/
def «下游» : List «单位号» := [10, 11, 12, 13, 14, 15, 16, 17, 18]

/-- 回放：只读是否有货，两套物料不同，不能比较物品名称。 -/
def «占格» (us : List «单位号») (s : «状态») : List Bool :=
  us.map fun u => («格里» s u).isSome

/-- 回放：一步末读数为下游占格、输入段占格、上路件数、下路件数、箱中累计件数。 -/
def «读数» (m : Bool) (s : «状态») : List Bool × List Bool × Nat × Nat × Nat :=
  («占格» «下游» s, «占格» (if m then [1, 2, 3, 7] else [1, 2, 3, 4, 5, 6, 7]) s,
   ((«占格» [11, 12, 13] s).filter id).length,
   ((«占格» [14, 15, 16] s).filter id).length,
   «箱里几件» s 19 (if m then .«钢制零件» else .«钢块»))

/-- 回放：两套各从空装置放行，在事先固定的第 160 至 191 步末逐步读数。 -/
def «记录» (m : Bool) :=
  («演» «状态».«空» («布置» m)).map fun s =>
    «逐次看» («读数» m) ((List.range 32).map (160 + ·)) s

set_option maxRecDepth 8192
set_option maxHeartbeats 0

-- 观察 1：同一步比较全部九个下游运输格；32 步无一例外，且两套各自 16 步重复。
#guard match «记录» true, «记录» false with
  | some a, some b =>
    a.length == 32 && b.length == 32 && a.map (·.1) == b.map (·.1) &&
    (a.take 16).map (·.1) == (a.drop 16).map (·.1) &&
    (b.take 16).map (·.1) == (b.drop 16).map (·.1)
  | _, _ => false

-- 观察 2：整个固定窗口内，配件机前三带和后一带全有货，普通一套七格全有货。
#guard match «记录» true, «记录» false with
  | some a, some b =>
    a.all (fun r => r.2.1 == [true, true, true, true]) &&
    b.all (fun r => r.2.1 == [true, true, true, true, true, true, true])
  | _, _ => false

-- 观察 3：窗口内确有同一步两套同时上二下一、出口一，且逐格排布相同。
-- 来源未给那一帧的步号；这里只断言存在，不把截图解释成每 tick 都上二下一。
#guard match «记录» true, «记录» false with
  | some a, some b =>
    (a.zip b).any (fun (x, y) =>
      x.2.2.1 == 2 && x.2.2.2.1 == 1 && y.2.2.1 == 2 && y.2.2.2.1 == 1 &&
      x.1 == y.1 && x.1 == [true, true, false, true, false, true, false, true, true])
  | _, _ => false

-- 观察 4 的流速：以 160、168、176、184 步末的收货累计数核对，两套都是每 tick 一件。
-- 累计数差两件来自启动延迟；来源比较的是稳态占格，没有要求累计收货数相同。
#guard match «记录» true, «记录» false with
  | some a, some b =>
    ((((List.range 32).zip a).filter (fun p => p.1 % 8 == 0)).map (fun p => p.2.2.2.2.2)) == [9, 10, 11, 12] &&
    ((((List.range 32).zip b).filter (fun p => p.1 % 8 == 0)).map (fun p => p.2.2.2.2.2)) == [7, 8, 9, 10]
  | _, _ => false

/-- 回放：观察 4 的时延，记录首批开工剩余步数和后带物品。
首件第 1 步上第一格，第 25 步越过三格带到机器（3 tick），第 33 步产物上后带（再 1 tick）。
只按模型时间核对，来源的 2 秒、6 秒分别对应 1 tick、3 tick。 -/
def «加工读数» :=
  («演» «状态».«空» («布置» true)).map fun s =>
    «逐次看» (fun s => ((s.«制造中» 4).map (·.2), «格里» s 7)) [24, 25, 32, 33] s

-- 观察 4 的时延：第 25 步开工，第 32 步末计满，33 步开始时完工且送出；同一步下一批开工。
#guard «加工读数» == some [(none, none), (some 7, none), (some 0, none),
  (some 7, some .«钢制零件»)]

end Endfield.«回放».«配件机和带子»
