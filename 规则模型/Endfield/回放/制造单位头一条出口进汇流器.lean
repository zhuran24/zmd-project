import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-11-13.md，全文已读。
核对的是：制造单位头一条接通的出口通往汇流器时，「最先接通的通道排到末尾」是按组算的——
通往非汇流器的那一组里先接通的那条排到末尾，和整个单位最先接通的是哪条无关。

摆件的坐标、朝向照实测记录（MCP 的格坐标，3×3 的单位给的是左上角那一格）。
实测用物品准入口一次放行 1 件蓝铁矿；这里准入口照样摆上、不设限，改成往货源箱里一次放 1 件。
-/

namespace Endfield.«回放».«头一条出口进汇流器»

open Endfield.«格子» Endfield.«回放».«格子»

/-- 回放：每组都有的：货源箱 1、收货箱 51（左）52（中）53（右）、供电桩 99、
进料带 2 3 4、物品准入口 5（换在带 3 那格）、精炼炉 10（上边进、下边出）。 -/
def «底» : Option (List «摆件») :=
  [«摆» 1 26 13 (.«协议储存箱» .«下»), «摆» 51 22 24 (.«协议储存箱» .«下»),
   «摆» 52 26 24 (.«协议储存箱» .«下»), «摆» 53 30 24 (.«协议储存箱» .«下»),
   «摆» 99 22 20 .«供电桩»,
   «摆» 2 27 16 (.«传送带» .«上» .«下»), «摆» 3 27 17 (.«传送带» .«上» .«下»),
   «摆» 4 27 18 (.«传送带» .«上» .«下»), «摆» 5 27 17 (.«物品准入口» .«下»),
   «摆» 10 26 19 (.«制造» .«精炼炉» .«下»)].mapM id

/-- 回放：接一个出口要放的摆件，照放的先后。
`左汇`：汇流器 20 贴着炉子的左出口，出货带 21 22 23 进左箱；`右汇`：汇流器 25 贴着右出口，出货带 26 27 28 进右箱；
`左带`：带 61–64 从左出口往左绕进左箱；`中带`：带 31 32 进中箱；`右带`：带 41–44 进右箱。 -/
def «出口» : String → Option (List «摆件»)
  | "左汇" => [«摆» 20 26 22 (.«汇流器» .«下»), «摆» 21 26 23 (.«传送带» .«上» .«左»),
      «摆» 22 25 23 (.«传送带» .«右» .«左»), «摆» 23 24 23 (.«传送带» .«右» .«下»)].mapM id
  | "右汇" => [«摆» 25 28 22 (.«汇流器» .«下»), «摆» 26 28 23 (.«传送带» .«上» .«右»),
      «摆» 27 29 23 (.«传送带» .«左» .«右»), «摆» 28 30 23 (.«传送带» .«左» .«下»)].mapM id
  | "左带" => [«摆» 61 26 22 (.«传送带» .«上» .«左»), «摆» 62 25 22 (.«传送带» .«右» .«左»),
      «摆» 63 24 22 (.«传送带» .«右» .«下»), «摆» 64 24 23 (.«传送带» .«上» .«下»)].mapM id
  | "中带" => [«摆» 31 27 22 (.«传送带» .«上» .«下»), «摆» 32 27 23 (.«传送带» .«上» .«下»)].mapM id
  | "右带" => [«摆» 41 28 22 (.«传送带» .«上» .«右»), «摆» 42 29 22 (.«传送带» .«左» .«右»),
      «摆» 43 30 22 (.«传送带» .«左» .«下»), «摆» 44 30 23 (.«传送带» .«上» .«下»)].mapM id
  | _ => none

/-- 回放：炉子放好以后照 `先后` 一个一个接上三个出口，然后一件一件放蓝铁矿、每件等 160 步，
记下每一件蓝铁块进了哪个收货箱（0 左、1 中、2 右；不是正好一个箱子多一件就记 9）。 -/
def «依次去哪» («先后» : List String) (k : Nat) : Option (List Nat) := do
  let s ← «布置» (← «底»)
  let s ← «先后».foldlM (fun s o => do (← «出口» o).foldlM (fun s p => «做» s (.«建» p)) s) s
  let read := fun (t : Endfield.«格子».«状态») => [51, 52, 53].map fun u => «箱货» t u .«蓝铁块»
  let (_, out) ← (List.range k).foldlM (fun (acc : Endfield.«格子».«状态» × List Nat) _ => do
    let a := read acc.1
    let t := «等» 160 (← «做» acc.1 (.«原样» (.«放货» 1 .«蓝铁矿» 1)))
    let d := ((read t).zip a).map fun (x, y) => x - y
    let w := (List.range 3).filter fun i => d.getD i 0 > 0
    return (t, acc.2 ++ [if d.foldl (· + ·) 0 == 1 then w.getD 0 9 else 9])) (s, [])
  return out

-- 组一：汇流器（左）、中、右。头一条接通的在汇流器那一组；另一组里先接通的中排到末尾，先送右。
#guard «依次去哪» ["左汇", "中带", "右带"] 4 == some [2, 1, 2, 1]
-- 组一乙：汇流器（左）、右、中。先送中。
#guard «依次去哪» ["左汇", "右带", "中带"] 4 == some [1, 2, 1, 2]
-- 组二（对照）：三个出口都接带子，左、中、右。从第 2 条接通的开始，最先接通的左排最后。
#guard «依次去哪» ["左带", "中带", "右带"] 5 == some [1, 2, 0, 1, 2]
-- 组三：中、汇流器（左）、右。整个单位最先接通的中就在通往带子的那一组里，排到末尾，先送右。
#guard «依次去哪» ["中带", "左汇", "右带"] 4 == some [2, 1, 2, 1]
-- 组四：汇流器换到右出口先接，再接左、中。先送中。
#guard «依次去哪» ["右汇", "左带", "中带"] 4 == some [1, 0, 1, 0]

end Endfield.«回放».«头一条出口进汇流器»
