/-- 回放：准入口先替换直带，然后离线逆序重建，最后收回，原格应留空且断开两条通道。 -/
def «准入口替换» : Option Bool := do
  let ps ← [«摆» 0 20 19 (.«传送带» .«上» .«下»), «摆» 1 20 20 (.«传送带» .«上» .«下»),
    «摆» 2 20 21 (.«传送带» .«上» .«下»)].mapM id
  let s ← «布置» ps
  let p ← «摆» 1 20 20 (.«物品准入口» .«下»)
  let t ← «做» s (.«建» p)
  let es := t.«模型».«历史».drop s.«模型».«历史».length
  let replacement := match es with
    | [.«拆除» 1, .«建成» 1 .«物品准入口», .«接通» a, .«接通» b] => a == ⟨0,1⟩ && b == ⟨1,2⟩
    | _ => false
  let t ← «做» t (.«原样» (.«设准入口» 1 (some .«源矿») (some 3) (some 2)))
  let r ← «做» t (.«离线» t.«场地».reverse)
  let e ← «做» r (.«收» 1)
  return replacement && r.«模型».«历史».«合规» &&
    (r.«模型».«准入口» 1).«放行» == some .«源矿» &&
    e.«场地».length == 2 && !e.«场地».any (·.«位置» == p.«位置») &&
    e.«模型».«布局».«通道表».isEmpty

#guard «准入口替换» == some true
#guard ((«摆» 1 20 20 (.«物品准入口» .«下»)).bind fun p => «布置» [p]).isNone
#guard («两件» («摆» 1 20 20 (.«传送带» .«左» .«下»))
  («摆» 1 20 20 (.«物品准入口» .«下»))).isNone
#guard («两件» («摆» 1 20 20 (.«传送带» .«上» .«下»))
  («摆» 1 20 20 (.«物品准入口» .«上»))).isNone

