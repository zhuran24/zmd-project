  let b ← «摆» 1 21 23 (.«传送带» .«上» .«下»)
  let c ← «摆» 1 30 30 (.«传送带» .«上» .«下»)
  let s ← «做» Endfield.«格子».«状态».«空» (.«蓝图» [a,b])
  let s ← «做» s (.«原样» (.«放货» 0 .«源矿» 51))
  let t ← «做» s (.«离线» [b,a])
  return («做» Endfield.«格子».«状态».«空» (.«蓝图» [b,a])).isNone &&
    («做» s (.«离线» [a])).isNone && («做» s (.«离线» [a,a])).isNone &&
    («做» s (.«离线» [a,c])).isNone && «箱货» t 0 .«源矿» == 51 &&
    (t.«模型».«布局».«单位表».map (·.1)) == [1,0] &&
    «接通表» t.«模型».«历史» == [⟨0,1⟩]

#guard «蓝图离线» == some true

/-- 回放：四边的合法仓库取货口；从它的取货端口外接直带，编号均为零。 -/
def «边界取货口» (d : «朝向») : Option Bool := do
  let (i,j) := match d with | .«上» => (20,69) | .«右» => (0,20) | .«下» => (20,0) | .«左» => (69,20)
  let p ← «摆» 0 i j (.«仓库取货口» d)
  let a ← p.«造端口» true d 1
  let c ← a.«格».«邻格» d
  let b : «摆件» := ⟨.«传送带» d.«对边» d, c, 1⟩
  let s ← «布置» [p,b]
  return s.«场地».«口?» «端口先后» ⟨0,1⟩ == some 0

#guard «朝向».«各边».all fun d => «边界取货口» d == some true
#guard ((«摆» 1 10 10 (.«仓库取货口» .«下»)).bind fun p => «布置» [p]).isNone

/-- 回放：核心六个取货端口外各接一格直带和独立收货箱，依几何编号设不同物品。
先查可移动物品，再用真实格子层走一步操作连走16步，核对仓库减少及六箱实际收货。
端口顺序故意反向排序，口编号仍是固定的几何编号；共检查两种平行边。 -/
def «核心取货» (a : «平行边») : Option Bool := do
  let p ← «摆» 0 20 20 (.«协议核心» a)
  let ports ← p.«仓库取货端口»
  let belts ← ports.zipIdx.mapM fun (a,i) => do
    let c ← a.«格».«邻格» a.«边»
    return («摆件».mk (.«传送带» a.«边».«对边» a.«边») c (i+1))
  let boxes ← ports.zipIdx.mapM fun (a,i) =>
    let x := a.«格».i.val
    let y := a.«格».j.val
    let (x,y) := match a.«边» with
      | .«上» => (x-1,y-4) | .«右» => (x+2,y-1)
      | .«下» => (x-1,y+2) | .«左» => (x-4,y-1)
    «摆» (i+11) x y (.«协议储存箱» a.«边»)
  let o : «接通先后» := ⟨fun d n => 100-d.«编号»*9-n⟩
  let act := Endfield.«格子».«作用» «取一种» o «无效口»
  let s ← (boxes ++ belts ++ [p]).foldlM (fun s p => act s (.«建» p)) Endfield.«格子».«状态».«空»
  let s ← boxes.foldlM (fun s p => act s (.«原样» (.«设储存箱模式» p.«号» true))) s
  let xs : List «物品» := [.«源矿», .«蓝铁矿», .«蓝铁块», .«钢块», .«荞花», .«砂叶»]
  let s ← xs.zipIdx.foldlM (fun s (x,i) => do
    let s ← act s (.«原样» (.«入库» x 1))
    act s (.«原样» (.«设取货指向» 0 i (some x)))) s
  let L := s.«模型».«布局»
  let todo := s.«场地».«待写» o «无效口»
  let t ← (List.range 16).foldlM (fun s _ => act s (.«原样» .«走一步»)) s
  return xs.zipIdx.all (fun (x,i) =>
    s.«场地».«口?» o ⟨0,i+1⟩ == some i &&
    s.«模型».«可移动物品» L (todo.«口» s.«模型») ⟨0,i+1⟩ == some (x, .«仓库»)) &&
    (s.«场地».«口?» o ⟨0,100⟩).isNone &&
    xs.zipIdx.all (fun (x,i) => «箱货» t (i+11) x == 1 && t.«模型».«仓库» x == 0)

#guard «核心取货» .«上下» == some true
#guard «核心取货» .«左右» == some true

/-- 回放：供电范围四条边的内外各一格；箱子只有一角入范围也供电，拆桩后立即失电。 -/
def «供电边界» : Option Bool := do
  let p ← «摆» 99 20 20 .«供电桩»
  let near ← «摆» 0 13 13 (.«制造» .«精炼炉» .«下»)
  let far ← «摆» 1 27 27 (.«制造» .«精炼炉» .«下»)
  let s ← «布置» [p,near,far]
  let points ← [(15,15),(26,26),(14,15),(15,14),(27,26),(26,27)].mapM fun (i,j) => «格».«坐标» i j
  let t ← «做» s (.«收» 99)
  return points.map («供电范围» p) == [true,true,false,false,false,false] &&
    s.«场地».«有电» 0 && !s.«场地».«有电» 1 && !s.«场地».«有电» 99 &&
    !t.«场地».«有电» 0 && s.«模型».«历史».length == t.«模型».«历史».length

#guard «供电边界» == some true

/-- 回放：箱子先填编号最小的能放格，溢出不放；制造单位同物品不能占第二格。
研磨机存货格放满50件蓝铁粉末后，再放同种货不进第二格，砂叶粉末进第二格。 -/
def «玩家放货» : Option Bool := do
  let a ← «摆» 0 10 10 (.«协议储存箱» .«下»)
  let b ← «摆» 1 20 20 (.«制造» .«研磨机» .«下»)
  let s ← «布置» [a,b]
  let s ← «依次» s [.«原样» (.«放货» 0 .«源矿» 51),
    .«原样» (.«放货» 0 .«蓝铁矿» 1), .«原样» (.«放货» 0 .«源矿» 500),
    .«原样» (.«放货» 1 .«蓝铁粉末» 51), .«原样» (.«放货» 1 .«砂叶粉末» 50)]
  return s.«模型».«件数» ⟨0,.«格» 0⟩ .«源矿» == 50 &&
    s.«模型».«件数» ⟨0,.«格» 1⟩ .«源矿» == 50 &&
    s.«模型».«件数» ⟨0,.«格» 2⟩ .«蓝铁矿» == 1 && «箱货» s 0 .«源矿» == 250 &&
    s.«模型».«件数» ⟨1,.«存货» 0⟩ .«蓝铁粉末» == 50 &&
    s.«模型».«件数» ⟨1,.«存货» 1⟩ .«砂叶粉末» == 50 &&
    (s.«模型».«货» ⟨1,.«取货»⟩).isEmpty

#guard «玩家放货» == some true

/-- 回放：制造开工后拆供电桩，16步进度保持；重建桩再走8步，产出一件蓝铁块。 -/
def «断电制造» : Option Bool := do
  let p ← «摆» 99 20 20 .«供电桩»
  let f ← «摆» 0 23 20 (.«制造» .«精炼炉» .«下»)
  let s ← «布置» [p,f]
  let s ← «做» s (.«原样» (.«放货» 0 .«蓝铁矿» 1))
  let a ← «做» s (.«原样» .«走一步»)
  let b ← «做» a (.«收» 99)
  let c := «等» 16 b
  let d ← «做» c (.«建» p)
  let e := «等» 8 d
  return (a.«模型».«制造中» 0).isSome && a.«模型».«制造中» 0 == c.«模型».«制造中» 0 &&
    (c.«模型».«货» ⟨0,.«取货»⟩).isEmpty && e.«模型».«件数» ⟨0,.«取货»⟩ .«蓝铁块» == 1

#guard «断电制造» == some true

