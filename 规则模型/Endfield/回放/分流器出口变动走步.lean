import Endfield.«回放».«工具»

/-!
# 回放：分流器的出口有变动以后，下一件从哪个出口送（整套模型走一遍）

`分流器出口变动.lean` 只拿轮询那一条公式对了实测-2026-11-09 的八组。这里把同样的八组照实测的做法在整套模型里走一遍：
建单位、接通道、一件一件放行、拆掉或接上一个出口都经 `作用`，中间照判定顺序走步，读三个收货箱。

单位号：货源箱 0，进货带 1、物品准入口 2、带 3，分流器 4；
出口 1 的带子 10、11 进收货箱 20；出口 2 的带子 12、13、14 进收货箱 21；出口 3 的带子 15、16、17 进收货箱 22。
贴着分流器的那一格分别是 10、12、15。丁组把 15 换成物品准入口 30。
实测里的货是碳块，规则文件的物品里没有，这里用源矿。
-/

namespace Endfield.«回放».«出口变动走步»

/-- 回放：实测里的一个动作。 -/
inductive «动作» where
  /-- 接上第 i 个出口的带子 -/
  | «接» (i : Nat)
  /-- 拆掉第 i 个出口贴着分流器的那一格 -/
  | «拆» (i : Nat)
  /-- 一件一件放 n 件货，每件等它进了收货箱再放下一件 -/
  | «放» (n : Nat)
  /-- 丁组：把出口 3 贴着分流器的那一格换成物品准入口，设成不放行这种货 -/
  | «换准入口»
  /-- 丁组：把那个物品准入口改成放行 -/
  | «改放行»

/-- 回放：货源、进货带、物品准入口、分流器、三个收货箱。 -/
def «布置» : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 20 .«协议储存箱», «建» 21 .«协议储存箱», «建» 22 .«协议储存箱»,
   «仓储» 0, «仓储» 20, «仓储» 21, «仓储» 22,
   «建» 1 .«传送带», «连» 0 1, «建» 2 .«物品准入口», «连» 1 2, «建» 3 .«传送带», «连» 2 3,
   .«做» (.«设准入口» 2 (some .«钢块») none none),
   «建» 4 .«分流器», «连» 3 4] ++ «装满» 0 .«源矿»

/-- 回放：接上第 i 个出口的带子（从分流器的出口拉到收货箱）。 -/
def «接出口» : Nat → List «一幕»
  | 1 => «一串带» 4 [10, 11] ++ [«连» 11 20]
  | 2 => «一串带» 4 [12, 13, 14] ++ [«连» 14 21]
  | _ => «一串带» 4 [15, 16, 17] ++ [«连» 17 22]

/-- 回放：第 i 个出口贴着分流器的那一格（丁组的出口 3 是物品准入口 30）。 -/
def «贴着的格» («换了» : Bool) : Nat → «单位号»
  | 1 => 10
  | 2 => 12
  | _ => if «换了» then 30 else 15

/-- 回放：三个收货箱里各有几件。 -/
def «三箱» (s : «状态») : List Nat := [20, 21, 22].map fun u => «箱里几件» s u .«源矿»

/-- 回放：照动作表做下去，记下每件货进的是第几个出口的收货箱。
`n` 是已经放行的件数，`换了` 是出口 3 那格换没换成物品准入口。 -/
def «做下去» : List «动作» → «状态» → Nat → Bool → List Nat → Option (List Nat)
  | [], _, _, _, acc => some acc
  | .«接» i :: rest, s, n, g, acc => («演» s («接出口» i)).bind fun s' => «做下去» rest s' n g acc
  | .«拆» i :: rest, s, n, g, acc =>
    («演» s [.«做» (.«改布局» (.«拆除» («贴着的格» g i)))]).bind fun s' => «做下去» rest s' n g acc
  | .«换准入口» :: rest, s, n, _, acc =>
    («演» s [.«做» (.«改布局» (.«拆除» 15)), «建» 30 .«物品准入口», «连» 4 30, «连» 30 16,
      .«做» (.«设准入口» 30 (some .«钢块») none none)]).bind fun s' => «做下去» rest s' n true acc
  | .«改放行» :: rest, s, n, g, acc =>
    («演» s [.«做» (.«设准入口» 30 (some .«源矿») none none)]).bind fun s' => «做下去» rest s' n g acc
  | .«放» 0 :: rest, s, n, g, acc => «做下去» rest s n g acc
  | .«放» (k + 1) :: rest, s, n, g, acc =>
    («演» s [.«做» (.«设准入口» 2 (some .«源矿») (some (n + 1)) none), .«等» 100]).bind fun s' =>
      let d := ((«三箱» s).zip («三箱» s')).zipIdx.filterMap fun p =>
        if p.1.2 > p.1.1 then some (p.2 + 1) else none
      «做下去» (.«放» k :: rest) s' (n + 1) g (acc ++ d)

/-- 回放：一组实测从头做一遍，给出各件货依次去的出口。 -/
def «一组» (as : List «动作») : Option (List Nat) :=
  («演» «状态».«空» «布置»).bind fun s => «做下去» as s 0 false []

-- 第一节。每组先按 1、2、3 接好，放几件，拆掉一个出口，再放 2 件。看到的去向写在右边。
-- 甲：放 2 件（2、3），拆 3，再放 2 件（2、1）。
#guard «一组» [.«接» 1, .«接» 2, .«接» 3, .«放» 2, .«拆» 3, .«放» 2] == some [2, 3, 2, 1]
-- 乙：放 1 件（2），拆 2，再放 2 件（3、1）。
#guard «一组» [.«接» 1, .«接» 2, .«接» 3, .«放» 1, .«拆» 2, .«放» 2] == some [2, 3, 1]
-- 丙：放 3 件（2、3、1），拆 1，再放 2 件（3、2）。
#guard «一组» [.«接» 1, .«接» 2, .«接» 3, .«放» 3, .«拆» 1, .«放» 2] == some [2, 3, 1, 3, 2]
-- 丁：出口 3 那格换成不放行的物品准入口，放 2 件（2、1），改成放行、拆 1，再放 2 件（3、2）。
#guard «一组» [.«接» 1, .«接» 2, .«接» 3, .«换准入口», .«放» 2, .«改放行», .«拆» 1, .«放» 2] ==
  some [2, 1, 3, 2]
-- 补测。戊：放 2 件（2、3），拆 1（没送过货），再放 2 件（3、2）。
#guard «一组» [.«接» 1, .«接» 2, .«接» 3, .«放» 2, .«拆» 1, .«放» 2] == some [2, 3, 3, 2]
-- 己：放 1 件（2），拆 3（没送过货），再放 2 件（2、1）。
#guard «一组» [.«接» 1, .«接» 2, .«接» 3, .«放» 1, .«拆» 3, .«放» 2] == some [2, 2, 1]
-- 庚：放 2 件（2、3），拆 2（送过货，不是最近一次），再放 2 件（3、1）。
#guard «一组» [.«接» 1, .«接» 2, .«接» 3, .«放» 2, .«拆» 2, .«放» 2] == some [2, 3, 3, 1]
-- 辛：先只接 1、2，放 1 件（2），再接上 3，再放 2 件（2、3）。
#guard «一组» [.«接» 1, .«接» 2, .«放» 1, .«接» 3, .«放» 2] == some [2, 2, 3]

end Endfield.«回放».«出口变动走步»
