import Endfield.«作用»

/-!
# 回放用的工具

把一串操作做下去、连走很多步、读某个箱子里的货。回放和例子都用这些；它们不是规则的一部分。
-/

namespace Endfield.«回放»

/-- 回放：`未定` 各项取一种说法（照规则字面，或最省事的那种）。回放的结论不该依赖这些取法。 -/
def «取一种» : «未定» where
  «通道增减后的进货上次» := fun _ _ _ o => o
  «通道增减后的出货已移动» := fun _ _ _ l => l
  «改设定后的计数» := fun g _ _ _ => (g.«累计已收», g.«本段已收», g.«本段还剩»)
  «切换模式后的冷却» := fun b _ => b.«冷却还剩»
  «新建储存箱的冷却» := 0
  «离线后的计数» := fun g => (g.«累计已收», g.«本段已收», g.«本段还剩»)
  «传输先于移动判定» := fun _ => false
  «不运行时冷却照走» := true
  «拆除时货回仓库» := true
  «空箱也传输» := false

/-- 回放：`待写` 里的三样取最省事的：都有电；通道都接在第 1 个取货端口上（回放里没有协议核心）；
玩家放货不走这里（回放里用 `装货` 直接改箱里的货）。 -/
def «都有电» : «待写» where
  «放进单位» := fun s _ _ _ g => s.«货» g
  «有电» := fun _ _ => true
  «口» := fun _ _ => 0

/-- 回放：规则文件「配方」一块里出现的 19 种物品。 -/
def «各种物品» : List «物品» :=
  [.«源矿», .«源石粉末», .«致密源石粉末», .«蓝铁矿», .«蓝铁块», .«蓝铁粉末», .«致密蓝铁粉末»,
   .«钢块», .«钢质瓶», .«钢制零件», .«荞花种子», .«荞花», .«荞花粉末», .«细磨荞花粉末»,
   .«砂叶种子», .«砂叶», .«砂叶粉末», .«高容谷地电池», .«精选荞愈胶囊»]

/-- 回放：照一张表查值，表里没有的给 d。 -/
def «查表» {α β : Type} [BEq α] (l : List (α × β)) (d : β) : α → β :=
  fun a =>
    match l.find? (·.1 == a) with
    | some p => p.2
    | none => d

/-- 回放：把状态里一层套一层的函数换成查表，免得越走越慢。
现有单位、现有物品格上的值不变；别处回到没建时的样子。 -/
def «压平» (L : «布局») (s : «状态») : «状态» :=
  let us := L.«单位表».map (·.1)
  let cells : List «格位» := L.«单位表».flatMap fun p => p.2.«物品格».map fun n => ⟨p.1, n⟩
  let t1 := (cells.map fun g => (g, s.«货» g)).filter fun p => !p.2.isEmpty
  let t2 := (cells.map fun g => (g, s.«已停» g)).filter fun p => p.2 != 0
  let t3 := cells.map fun g => (g, s.«来处» g)
  let t4 := us.map fun u => (u, s.«分流器上次» u)
  let t5 := us.map fun u => (u, s.«进货上次» u)
  let t6 := us.map fun u => (u, s.«出货已移动» u)
  let t7 := us.map fun u => (u, s.«制造中» u)
  let t8 := us.map fun u => (u, s.«准入口» u)
  let t9 := us.map fun u => (u, s.«储存箱» u)
  let t10 := us.map fun u => (u, s.«开关» u)
  let t11 := us.map fun u => (u, (List.range 6).map fun i => s.«取货指向» u i)
  let t12 := «各种物品».map fun x => (x, s.«仓库» x)
  { «历史» := s.«历史»
    «货» := «查表» t1 []
    «已停» := «查表» t2 0
    «来处» := «查表» t3 none
    «分流器上次» := «查表» t4 none
    «进货上次» := «查表» t5 none
    «出货已移动» := «查表» t6 []
    «制造中» := «查表» t7 none
    «准入口» := «查表» t8 {}
    «储存箱» := «查表» t9 {}
    «开关» := «查表» t10 true
    «取货指向» := fun u i => ((«查表» t11 [] u)[i]?).getD none
    «仓库» := «查表» t12 0 }

/-- 回放：照同一张判定表连走 n 步（中间没有别的操作，历史不变）。 -/
def «走» (un : «未定») (todo : «待写») (T : «判定表») : Nat → «状态» → «状态»
  | 0, s => s
  | n + 1, s => «走» un todo T n («压平» T.«现布局» («一步于» T un todo s))

/-- 回放：从状态 s 起连走 n 步。 -/
def «走几步» (n : Nat) (s : «状态») : «状态» :=
  «走» «取一种» «都有电» s.«历史».«立表» n s

/-- 回放：把一串操作依次做下去；有一件做不了就是 `none`。 -/
def «依次做» (s : «状态») (os : List «操作») : Option «状态» :=
  os.foldlM (fun s o => «作用» «取一种» «都有电» s o) s

/-- 回放：直接把单位 u 的一个物品格里的货换成 n 件 x（玩家往里放货）。 -/
def «装货» (s : «状态») (u : «单位号») (name : «格名») (x : «物品») (n : Nat) : «状态» :=
  { s with «货» := «换» s.«货» ⟨u, name⟩ [⟨x, n⟩] }

/-- 回放：协议储存箱 u 的六个物品格里一共有几件 x。 -/
def «箱里几件» (s : «状态») (u : «单位号») (x : «物品») : Nat :=
  ((List.range 6).map fun i => s.«件数» ⟨u, .«格» i⟩ x).foldl (· + ·) 0

/-- 回放：协议储存箱 u 的六个物品格依次放着什么（空格不列）。 -/
def «箱里依次» (s : «状态») (u : «单位号») : List («物品» × Nat) :=
  (List.range 6).flatMap fun i => (s.«货» ⟨u, .«格» i⟩).map fun p => (p.«物», p.«件数»)

end Endfield.«回放»
