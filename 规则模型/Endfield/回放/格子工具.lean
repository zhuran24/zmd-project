import Endfield.«格子».«供电与操作»
import Endfield.«回放».«工具»

/-! 带位置回放的工具；所有建、收、放货和设定都经过格子层作用。 -/

namespace Endfield.«回放».«格子»

open Endfield.«格子»

/-- 回放：未测端口先后取固定的上右下左、格号递增；不是额外的游戏规则。 -/
def «端口先后» : «接通先后» where
  «桥接器存货» := «朝向».«编号»
  «桥接器取货» := «朝向».«编号»
  «协议核心» := fun d n => d.«编号» * 9 + n

/-- 回放：无效仓库取货通道的显式接口参数取 6（越过两种单位的有效口号）。
实际几何通道另以 `口?` 断言核对，不靠这个值冒充真实端口。 -/
def «无效口» (_ : «通道») : Nat := 6

/-- 回放：由整数坐标创建摆件；越界返回 none。 -/
def «摆» (u i j : Nat) (k : «摆件种类») : Option «摆件» :=
  («格».«坐标» i j).map fun c => ⟨k, c, u⟩

/-- 回放：一次格子层操作，未定沿用现有回放取法。 -/
def «做» (s : Endfield.«格子».«状态») (a : Endfield.«格子».«操作») :
    Option Endfield.«格子».«状态» :=
  Endfield.«格子».«作用» «取一种» «端口先后» «无效口» s a

/-- 回放：依次执行；失败保留为 none。 -/
def «依次» (s : Endfield.«格子».«状态») (os : List Endfield.«格子».«操作») :
    Option Endfield.«格子».«状态» := os.foldlM «做» s

/-- 回放：构造期间建箱后立即切仓储模式，避免读数传入仓库。 -/
def «建好» (s : Endfield.«格子».«状态») (p : «摆件») : Option Endfield.«格子».«状态» := do
  let t ← «做» s (.«建» p)
  match p.«种类» with
  | .«协议储存箱» _ => «做» t (.«原样» (.«设储存箱模式» p.«号» true))
  | _ => return t

/-- 回放：从空场地按表建造；此处为逐件手放，不冒充蓝图。 -/
def «布置» (ps : List «摆件») : Option Endfield.«格子».«状态» :=
  ps.foldlM «建好» Endfield.«格子».«状态».«空»

/-- 回放：等待期间场地和历史不变，缓存判定表并沿用现有回放的状态压平。
传入实际场地的待写，制造必须由场上的供电桩供电；一步算法就是现有作用调用的算法。 -/
def «等» (n : Nat) (s : Endfield.«格子».«状态») : Endfield.«格子».«状态» :=
  let t := «走» «取一种» (s.«场地».«待写» «端口先后» «无效口»)
    s.«模型».«历史».«立表» n s.«模型»
  { s with «模型» := t }

/-- 回放：屏幕顺时针旋转摆件朝向。 -/
def «转种类» : «摆件种类» → «摆件种类»
  | .«传送带» a b => .«传送带» a.«顺时针» b.«顺时针»
  | .«分流器» d => .«分流器» d.«顺时针»
  | .«汇流器» d => .«汇流器» d.«顺时针»
  | .«物品准入口» d => .«物品准入口» d.«顺时针»
  | .«协议储存箱» d => .«协议储存箱» d.«顺时针»
  | .«制造» k d => .«制造» k d.«顺时针»
  | .«协议核心» .«上下» => .«协议核心» .«左右»
  | .«协议核心» .«左右» => .«协议核心» .«上下»
  | .«仓库取货口» d => .«仓库取货口» d.«顺时针»
  | .«桥接器» => .«桥接器»
  | .«供电桩» => .«供电桩»

/-- 回放：整个七十格基地顺时针转九十度，矩形左上角变为 (70−j−高,i)。
这是生成另一份初始布局，不是未实现的游戏内旋转操作。 -/
def «转一次» (p : «摆件») : Option «摆件» := do
  let _ ← p.«占格»
  «摆» p.«号» (70 - p.«位置».j.val - p.«大小».2) p.«位置».i.val («转种类» p.«种类»)

/-- 回放：把完整初始布局顺时针转若干次。 -/
def «转布局» : Nat → List «摆件» → Option (List «摆件»)
  | 0, ps => some ps
  | n + 1, ps => (ps.mapM «转一次»).bind («转布局» n)

/-- 回放：从历史中提取通道的接通先后，建成与拆除不列。 -/
def «接通表» (es : «历史») : List «通道» :=
  es.filterMap fun e => match e with | .«接通» c => some c | _ => none

/-- 回放：箱子内一种货的件数。 -/
def «箱货» (s : Endfield.«格子».«状态») (u : Nat) (x : «物品») : Nat :=
  «箱里几件» s.«模型» u x

/-- 回放：按照屏幕位置或来源编号读三个箱子的货。 -/
def «三箱» (us : List Nat) (x : «物品») (s : Endfield.«格子».«状态») : List Nat :=
  us.map fun u => «箱货» s u x

end Endfield.«回放».«格子»
