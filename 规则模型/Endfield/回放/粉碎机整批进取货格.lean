import Endfield.«回放».«格子工具»

/-!
据：实测-2026-11-27.md 第八节，第 260–273 行。沿用原配方（1 砂叶 → 3 砂叶粉末）。
按占地左上格定位，单位号 1、2、3 是货源箱、粉碎机、桩，4、5 是箱下的直带与准入口，
6、7 是最后建的收货箱和出口带。调用记录.jsonl 第 419–425 行先拉两格带，再在末格换准入口。
每秒 4 步。设上限、读两格和再设上限之间已经停稳；以脚本明确等的秒数为基准，
另取包括工具操作耗时的间隔复核。模型没有面板文字和秒数的显示函数。
-/

namespace Endfield.«回放».«粉碎机整批进取货格»

open Endfield.«格子» Endfield.«回放».«格子»

/-- 回放：只改 5 号准入口的累计上限，始终放行砂叶，每 5 tick 上限关。 -/
private def «限放» (n : Nat) : «原样操作» := .«设准入口» 5 (some .«砂叶») (some n) none

/-- 回放：粉碎机出口先留空，箱里放入一整组 50 份砂叶。 -/
private def «放货» : Option Endfield.«格子».«状态» := do
  let ps ← [«摆» 1 23 13 (.«协议储存箱» .«下»), «摆» 2 23 18 (.«制造» .«粉碎机» .«下»),
    «摆» 3 27 18 .«供电桩», «摆» 4 24 16 (.«传送带» .«上» .«下»),
    «摆» 5 24 17 (.«传送带» .«上» .«下»)].mapM id
  let s ← «布置» ps
  let gate ← «摆» 5 24 17 (.«物品准入口» .«下»)
  «依次» s [.«建» gate, .«原样» («限放» 16), .«原样» (.«放货» 1 .«砂叶» 50)]

/-- 回放：核查准入口累计通过数、存货和取货。缓存件数是模型值，配合制造中为空区分阻塞与空闲。 -/
private def «核机器» (s : Endfield.«状态») (passed stock out buffered : Nat) : Bool :=
  (s.«准入口» 5).«累计已收» == passed &&
    s.«件数» ⟨2, .«存货» 0⟩ .«砂叶» == stock &&
    s.«件数» ⟨2, .«取货»⟩ .«砂叶粉末» == out &&
    s.«件数» ⟨2, .«缓存»⟩ .«砂叶粉末» == buffered && (s.«制造中» 2).isNone

/-- 回放：照第 264–267 行先后读四次，保留堵住且已收到第 18 个砂叶的现场。 -/
private def «接出口前» (a b c d : Nat) : Option Endfield.«格子».«状态» := do
  let s := «等» a (← «放货»)
  guard («核机器» s.«模型» 16 0 48 0)
  let s := «等» b (← «做» s (.«原样» («限放» 17)))
  guard («核机器» s.«模型» 17 0 48 3)
  let s := «等» c s
  guard («核机器» s.«模型» 17 0 48 3)
  let s := «等» d (← «做» s (.«原样» («限放» 18)))
  guard («核机器» s.«模型» 18 1 48 3)
  return s

-- 脚本等 50、10、6、10 秒；第 425–432 次调用涵盖的放货至首读、改设至读、
-- 两次连续读取及再次改设至读的最长间隔向上取整，各为 59、18、11、18 秒。
#guard («接出口前» 200 40 24 40).isSome
#guard («接出口前» 236 72 44 72).isSome

/-- 回放：调用 434–438 先放仓储箱，再接一格带。逐步核对收货箱的增长，再按各自的读屏时刻核对收尾。 -/
private def «收货» : Option Bool := do
  let s ← «接出口前» 200 40 24 40
  let box ← «摆» 6 23 22 (.«协议储存箱» .«下»)
  let s ← «建好» s box
  let belt ← «摆» 7 24 21 (.«传送带» .«上» .«下»)
  let s ← «做» s (.«建» belt)
  -- 调用 436 首帧 06:47:30.23 已有 4 件，31.42 首见 5 件，以后每两秒多一件，
  -- 06:49:09.40 首见 54 件。以显示 5 件的那次整秒刷新为第 44 步，则首帧读的是
  -- 前两次刷新（第 36 步）的值。接带约在 06:47:20.4，处于调用 435 窗口内。
  -- 整段都在同一刷新相位比较，读数只约束刷新时的箱数。
  let (full, rows) := «逐步读» s 436 (fun m => «箱里几件» m 6 .«砂叶粉末»)
  let cadence := (List.range 101).all fun sec =>
    rows[36 + 4 * sec]? == some (4 + sec / 2)
  let slots := (List.range 6).map fun i => full.«模型».«件数» ⟨6, .«格» i⟩ .«砂叶粉末»
  -- 调用 437 在 06:49:10.5–13.0 读粉碎机，取 11.42（末帧后约 8 步）。
  -- 调用 438 在 06:49:14.19 读货源箱，距读机器约 11 步。
  let machine := «等» 8 full
  let source := «等» 11 machine
  return cadence && slots == [50,4,0,0,0,0] && «核机器» machine.«模型» 18 0 0 0 &&
    «箱货» source 1 .«砂叶» == 31

#guard «收货» == some true

end Endfield.«回放».«粉碎机整批进取货格»
