  [.«分», .«汇下带», .«分下带», .«汇»], [.«汇», .«分下带», .«汇下带», .«分»],
  [.«分下带», .«汇», .«汇下带», .«分»], [.«分下带», .«汇下带», .«汇», .«分»],
  [.«汇下带», .«分», .«汇», .«分下带»], [.«汇下带», .«分», .«分下带», .«汇»],
