/-!
# 回放：现象清单

求解器/规则修订/2026-10-10-交给GPT/现象.md 里的现象，一条一条在模型里摆出来走，看走出来的和那一条写的一样不一样。
通道和接通的先后是照每条的条件和规则「接通」一行排的（现在还没有格子）。
标题里的号是现象清单的条号。
-/

namespace Endfield.«回放».«现象»

/-- 回放：拆掉几个单位。 -/
def «拆» (us : List «单位号») : List «一幕» := us.map fun u => .«做» (.«改布局» (.«拆除» u))

/-! ## 1　下游空出一个位置，排满的上游一段一段往前补；每隔着一个装满的协议储存箱，上游那段晚 1 步才动 -/

/-- 回放：三个装满的箱子 0、4、8 首尾相连，相邻两个之间是排满的三格带子（1–3、5–7）；
最下游的箱子 8 经物品准入口 9 进箱子 10。等带子排满以后，让准入口放行 1 件。 -/
def «一串满箱» : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 4 .«协议储存箱», «建» 8 .«协议储存箱», «建» 10 .«协议储存箱»,
   «仓储» 0, «仓储» 4, «仓储» 8, «仓储» 10]
  ++ «一串带» 0 [1, 2, 3] ++ [«连» 3 4] ++ «一串带» 4 [5, 6, 7] ++ [«连» 7 8]
  ++ [«建» 9 .«物品准入口», «连» 8 9, «连» 9 10, .«做» (.«设准入口» 9 (some .«钢块») none none)]
  ++ «装满» 0 .«源矿» ++ «装满» 4 .«源矿» ++ «装满» 8 .«源矿»
  ++ [.«等» 100, .«做» (.«设准入口» 9 (some .«源矿») (some 1) none)]

-- 放行以后：第 1 步箱子 8 送出一件（第 1 格剩 49）；第 2 步紧挨它的那段带子前移（最后一格的物品是新进来的，停了 1 步）、
-- 箱子 4 送出一件；第 3 步再上游那段带子前移。每隔着一个装满的箱子晚 1 步。
#guard («演» «状态».«空» «一串满箱»).map («逐次看» (fun s =>
    (s.«件数» ⟨8, .«格» 0⟩ .«源矿», s.«已停» ⟨7, .«格» 0⟩ == 1,
     s.«件数» ⟨4, .«格» 0⟩ .«源矿», s.«已停» ⟨3, .«格» 0⟩ == 1)) [1, 2, 3]) ==
  some [(49, false, 50, false), (50, true, 49, false), (50, false, 50, true)]

/-! ## 2　一支收不下的分流器，另一支的通过量降到满速的 8n/(8n+1) -/

/-- 回放：货源箱 0 经一格带子（1）进分流器 S（2）。S 的一支经一格带子（3）通向装满的箱子 F（4）；
另一支先隔 n 格带子（10 起）到一个 `x`（20，分流器、汇流器或桥接器），再经一格带子（21）进箱子 Q（5）。
`后放` 为真时，进 Q 的那段带子比通向 F 的那段后放。 -/
def «两支» (n : Nat) (x : «单位种类») («后放» : Bool) : List «一幕» :=
  let armA := [«建» 3 .«传送带», «连» 2 3, «连» 3 4]
  let armB := «一串带» 2 ((List.range n).map (· + 10)) ++ [«建» 20 x, «连» (10 + n - 1) 20]
    ++ [«建» 21 .«传送带», «连» 20 21, «连» 21 5]
  [«建» 0 .«协议储存箱», «建» 4 .«协议储存箱», «建» 5 .«协议储存箱», «建» 2 .«分流器»,
   «建» 1 .«传送带», «连» 0 1, «连» 1 2, «仓储» 0, «仓储» 4, «仓储» 5]
  ++ (if «后放» then armA ++ armB else armB ++ armA)
  ++ «装满» 0 .«源矿» ++ «装满» 4 .«源矿»

/-- 回放：走到第 400 步以后，再走 `窗` 步，这段时间进 Q 的件数。 -/
def «窗里进了几件» (n : Nat) (x : «单位种类») («后放» : Bool) («窗» : Nat) : Option Nat :=
  («演» «状态».«空» («两支» n x «后放»)).map fun s =>
    match «逐次看» (fun s => «箱里几件» s 5 .«源矿») [400, 400 + «窗»] s with
    | [a, b] => b - a
    | _ => 0

-- 满速是每 8 步 1 件。进 Q 的那段后放时：n 格带子，每 8n+1 步进 n 件，也就是满速的 8n/(8n+1)。
#guard «窗里进了几件» 1 .«桥接器格» true (8 * 9) == some 8
#guard «窗里进了几件» 2 .«桥接器格» true (8 * 17) == some 16
#guard «窗里进了几件» 3 .«桥接器格» true (8 * 25) == some 24
#guard «窗里进了几件» 4 .«桥接器格» true (8 * 33) == some 32
-- 中间那个单位换成汇流器、分流器也一样。
#guard «窗里进了几件» 2 .«汇流器» true (8 * 17) == some 16
#guard «窗里进了几件» 2 .«分流器» true (8 * 17) == some 16
-- 进 Q 的那段带子先放时不出现：满速。
#guard «窗里进了几件» 1 .«桥接器格» false (8 * 9) == some 9
#guard «窗里进了几件» 3 .«桥接器格» false (8 * 25) == some 25

/-- 回放：实测-2026-10-10 实验 B。货源箱 0 贴着分流器 1。通畅的一支：先拉一条 d+3 格的带子（10 起）进箱子 9，
再把第 d+1 格换成桥接器 40，带子分成 d 格和 2 格两段。收不下的一支：先拉一条 d+2 格的带子（30 起）进同一个箱子，
再把第一格换成物品准入口 41（不放行这种货）。两支通到同一个箱子，分流器那一组比桥接器前那段带子的组先有。 -/
def «准入口挡住的一支» (d : Nat) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 9 .«协议储存箱», «仓储» 0, «仓储» 9, «建» 1 .«分流器», «连» 0 1]
  ++ «一串带» 1 ((List.range (d + 3)).map (· + 10)) ++ [«连» (10 + d + 2) 9]
  ++ «拆» [10 + d] ++ [«建» 40 .«桥接器格», «连» (10 + d - 1) 40, «连» 40 (10 + d + 1)]
  ++ «一串带» 1 ((List.range (d + 2)).map (· + 30)) ++ [«连» (30 + d + 1) 9]
  ++ «拆» [30] ++ [«建» 41 .«物品准入口», «连» 1 41, «连» 41 31,
    .«做» (.«设准入口» 41 (some .«钢块») none none)]
  ++ «装满» 0 .«源矿»

-- 看到的（每件平均步数）：d = 1、2、3、4 时 8.996、8.484、8.351、8.254，也就是每 d 件多等 1 步（n = d）。
-- 模型里：每 8×(8d+1) 步正好进 8d 件。
#guard [1, 2, 3, 4].all fun d =>
  («演» «状态».«空» («准入口挡住的一支» d)).map (fun s =>
    match «逐次看» (fun s => «箱里几件» s 9 .«源矿») [400, 400 + 8 * (8 * d + 1)] s with
    | [a, b] => b - a
    | _ => 0) == some (8 * d)

/-! ## 7　同一个布局，运行前结构里有没有存货，会停在两种不同的状态 -/

/-- 回放：3×3 方阵。满载的进料带（1、2）从左进左分流器 3；左分流器上出口经左上弯带 4 进上汇流器 5，
下出口经左下弯带 6 进下分流器 7；下分流器上出口经正中竖带 8 进上汇流器，右出口经右下弯带 9 进右汇流器 10；
上汇流器经右上弯带 11 进右汇流器；右汇流器向右出料：带子 12、物品准入口 13、带子 14 进箱子 20。
`先堵着` 时出料口的物品准入口先不放行，等方阵里存满货再放行。 -/
def «方阵» («先堵着» : Bool) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 20 .«协议储存箱», «仓储» 0, «仓储» 20]
  ++ «一串带» 0 [1, 2] ++ [«建» 3 .«分流器», «连» 2 3,
   «建» 5 .«汇流器», «建» 7 .«分流器», «建» 10 .«汇流器»,
   «建» 4 .«传送带», «连» 3 4, «连» 4 5,
   «建» 6 .«传送带», «连» 3 6, «连» 6 7,
   «建» 8 .«传送带», «连» 7 8, «连» 8 5,
   «建» 9 .«传送带», «连» 7 9, «连» 9 10,
   «建» 11 .«传送带», «连» 5 11, «连» 11 10,
   «建» 12 .«传送带», «连» 10 12, «建» 13 .«物品准入口», «连» 12 13,
   «建» 14 .«传送带», «连» 13 14, «连» 14 20,
   .«做» (.«设准入口» 13 (some (if «先堵着» then .«钢块» else .«源矿»)) none none)]
  ++ «装满» 0 .«源矿»
  ++ (if «先堵着» then [.«等» 400, .«做» (.«设准入口» 13 (some .«源矿») none none)] else [])

/-- 回放：第 600 步起每 4 步看一次、看 80 次（40 tick），左上弯带、左下弯带、正中竖带上各有几次有货；
再给出这 40 tick 里进箱子的件数。 -/
def «方阵的样子» (b : Bool) : Option (List Nat × Nat) :=
  («演» «状态».«空» («方阵» b)).map fun s =>
    let l := «逐次看» (fun s => ([4, 6, 8].map fun u => («格里» s u).isSome, «箱里几件» s 20 .«源矿»))
      ((List.range 81).map fun i => 600 + 4 * i) s
    ((List.range 3).map fun j => ((l.take 80).filter fun r => r.1.getD j false).length,
      (l.getLast?.map (·.2)).getD 0 - (l.head?.map (·.2)).getD 0)

-- 空着开始：左上、左下两条弯带都有货在走（各一半时间有货），正中竖带多数时候空着（四分之一时间有货）；出料满速。
#guard «方阵的样子» false == some ([40, 40, 20], 40)
-- 有存货开始：三格一直都有货（左上弯带那件大部分时间停着，正中竖带一直有货）；出料也是满速。两种状态都稳定。
#guard «方阵的样子» true == some ([80, 80, 80], 40)

