def «五组的增量» (v : «都没货时») : Option (List (Nat × Nat)) :=
  let un : «未定» := { «取一种» with «输入判定都没货时» := v }
  let xy (s : «状态») : Nat × Nat := («箱里几件» s 20 .«源矿», «箱里几件» s 21 .«源矿»)
