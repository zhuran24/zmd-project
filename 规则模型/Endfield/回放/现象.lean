  [«建» 0 .«协议储存箱», «建» 1 .«协议储存箱», «建» 20 .«协议储存箱», «仓储» 0, «仓储» 1, «仓储» 20,
   «建» 2 (.«制造» .«粉碎机»), «建» 3 (.«制造» .«粉碎机»),
   «建» 4 .«传送带», «连» 0 4, «连» 4 2, «建» 5 .«传送带», «连» 1 5, «连» 5 3,
   «建» 10 .«汇流器», «连» 2 10, «连» 3 10]
  ++ «J后六格» ++ «装满» 0 .«源矿» ++ «装满» 1 .«蓝铁块»

-- 第 13 条：两台的产品轮流进汇流器。
#guard («演» «状态».«空» «两台贴着»).map («逐次看» «带上» [300]) == some [
  [some .«蓝铁粉末», some .«源石粉末», some .«蓝铁粉末», some .«源石粉末», some .«蓝铁粉末», some .«源石粉末»]]

/-- 回放：一直有货的箱子（0，源矿）贴着汇流器 J 的一个入口，另一个入口接满载的带子（箱子 1 的蓝铁矿经带子 5）。
`箱子先接` 是两个入口接上的先后。 -/
def «箱子贴着和满带» («箱子先接» : Bool) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 1 .«协议储存箱», «建» 20 .«协议储存箱», «仓储» 0, «仓储» 1, «仓储» 20,
   «建» 5 .«传送带», «连» 1 5, «建» 10 .«汇流器»]
  ++ (if «箱子先接» then [«连» 0 10, «连» 5 10] else [«连» 5 10, «连» 0 10])
  ++ «J后六格» ++ «装满» 0 .«源矿» ++ «装满» 1 .«蓝铁矿»

-- 第 14 条：两边一件接一件轮流进，和谁先接上无关。
#guard [true, false].all fun b =>
  («演» «状态».«空» («箱子贴着和满带» b)).map («逐次看» «带上» [300]) == some [
    [some .«源矿», some .«蓝铁矿», some .«源矿», some .«蓝铁矿», some .«源矿», some .«蓝铁矿»]]

/-! ## 19、20　制造单位和协议储存箱的出货 -/

/-- 回放：货源箱 0 经带子 1 进箱子 B（2）；B 的三个出口各接一格带子（3、4、5）进收货箱 6、7、8。
`第三路堵住` 时收货箱 8 先装满别的货。 -/
def «三个出口» («第三路堵住» : Bool) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 2 .«协议储存箱», «建» 6 .«协议储存箱», «建» 7 .«协议储存箱»,
   «建» 8 .«协议储存箱», «仓储» 0, «仓储» 2, «仓储» 6, «仓储» 7, «仓储» 8,
   «建» 1 .«传送带», «连» 0 1, «连» 1 2,
   «建» 3 .«传送带», «连» 2 3, «连» 3 6, «建» 4 .«传送带», «连» 2 4, «连» 4 7,
   «建» 5 .«传送带», «连» 2 5, «连» 5 8] ++ «装满» 0 .«源矿»
  ++ (if «第三路堵住» then «装满» 8 .«蓝铁矿» else [])

/-- 回放：三个收货箱里各有几件源矿。 -/
def «三箱» (s : «状态») : List Nat := [6, 7, 8].map fun u => «箱里几件» s u .«源矿»

-- 第 19 条：每 tick 进一件、三路均分；一路堵住时货从其余两路走，各一半。
#guard («演» «状态».«空» («三个出口» false)).map («逐次看» «三箱» [348]) == some [[14, 14, 14]]
#guard («演» «状态».«空» («三个出口» true)).map («逐次看» «三箱» [340]) == some [[20, 20, 0]]

/-- 回放：货源箱 0 经带子 1、物品准入口 9、带子 10 进单位 2（种类 k）；2 的三个出口各接一格带子（3、4、5）
进收货箱 6、7、8，按 3、4、5 的先后接上。原料是 x。 -/
def «一个个接上» (k : «单位种类») (x : «物品») : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 2 k, «建» 6 .«协议储存箱», «建» 7 .«协议储存箱», «建» 8 .«协议储存箱»,
   «仓储» 0, «仓储» 6, «仓储» 7, «仓储» 8] ++ (if k == .«协议储存箱» then [«仓储» 2] else [])
  ++ [«建» 1 .«传送带», «连» 0 1, «建» 9 .«物品准入口», «连» 1 9, «建» 10 .«传送带», «连» 9 10, «连» 10 2,
   .«做» (.«设准入口» 9 (some .«钢块») none none),
   «建» 3 .«传送带», «连» 2 3, «连» 3 6, «建» 4 .«传送带», «连» 2 4, «连» 4 7,
   «建» 5 .«传送带», «连» 2 5, «连» 5 8] ++ «装满» 0 x

/-- 回放：一件一件放货（累计上限 1、2、3），每放一件等它走完，给出三个收货箱（先、中、后接上的那路）里各有几件 y。 -/
def «放三件» (k : «单位种类») (x y : «物品») : Option (List (List Nat)) :=
  let look (s : «状态») : List Nat := [6, 7, 8].map fun u => «箱里几件» s u y
  let gate (n : Nat) : «一幕» := .«做» (.«设准入口» 9 (some x) (some n) none)
  («演» «状态».«空» («一个个接上» k x ++ [gate 1, .«等» 100])).bind fun s1 =>
  («演» s1 [gate 2, .«等» 100]).bind fun s2 =>
  («演» s2 [gate 3, .«等» 100]).map fun s3 => [look s1, look s2, look s3]

-- 第 20 条。协议储存箱：三件依次去先接上的、第二个接上的、第三个接上的（中、左、右）。
#guard «放三件» .«协议储存箱» .«源矿» .«源矿» == some [[1, 0, 0], [1, 1, 0], [1, 1, 1]]
-- 精炼炉、粉碎机、种植机：第一件去第二个接上的，第二件去第三个接上的，第三件去最先接上的。
#guard «放三件» (.«制造» .«精炼炉») .«蓝铁矿» .«蓝铁块» == some [[0, 1, 0], [0, 1, 1], [1, 1, 1]]
#guard «放三件» (.«制造» .«粉碎机») .«源矿» .«源石粉末» == some [[0, 1, 0], [0, 1, 1], [1, 1, 1]]
#guard «放三件» (.«制造» .«种植机») .«荞花种子» .«荞花» == some [[0, 1, 0], [0, 1, 1], [1, 1, 1]]
-- 采种机一批出两件：第一批去第二、三个接上的（上、下），第二批去最先接上的和第二个接上的（中、上）。
#guard «放三件» (.«制造» .«采种机») .«荞花» .«荞花种子» == some [[0, 1, 1], [1, 2, 1], [2, 2, 2]]

/-! ## 22　一个出口紧贴汇流器、另一个直接接传送带：先走直接接传送带的那一路 -/

/-- 回放：货源箱 0 经带子 1 进中转箱 B（2），每 tick 至多进一件。出口甲直接接一格带子 3 进收货箱 6；
出口乙紧贴汇流器 4，汇流器经一格带子 5 进收货箱 7（这一路多经过一个运输单位）。 -/
def «带子和汇流器两路» («汇流器先放» «甲路堵住» : Bool) : List «一幕» :=
  let a := [«建» 3 .«传送带», «连» 2 3, «连» 3 6]
  let b := [«建» 4 .«汇流器», «连» 2 4, «建» 5 .«传送带», «连» 4 5, «连» 5 7]
  [«建» 0 .«协议储存箱», «建» 2 .«协议储存箱», «建» 6 .«协议储存箱», «建» 7 .«协议储存箱»,
   «仓储» 0, «仓储» 2, «仓储» 6, «仓储» 7, «建» 1 .«传送带», «连» 0 1, «连» 1 2]
  ++ (if «汇流器先放» then b ++ a else a ++ b)
  ++ «装满» 0 .«源矿» ++ (if «甲路堵住» then «装满» 6 .«蓝铁矿» else [])

/-- 回放：甲路、乙路的收货箱里各有几件源矿。 -/
def «两箱» (s : «状态») : List Nat := [6, 7].map fun u => «箱里几件» s u .«源矿»

-- 货全走直接接带子的那一路，和两路谁先放无关；那一路堵住时才走汇流器那一路。
#guard [true, false].all fun b =>
  («演» «状态».«空» («带子和汇流器两路» b false)).map («逐次看» «两箱» [340]) == some [[41, 0]]
#guard («演» «状态».«空» («带子和汇流器两路» true true)).map («逐次看» «两箱» [340]) == some [[0, 39]]

/-! ## 24　两个出口各经一个运输单位进不同的下游箱子（实测-2026-10-10 实验 A） -/

/-- 回放：货源箱 0 经四格带子 P（1–4）进中转箱 W（5）。W 的出口一接六格带子 A（10–15）进箱子 X（20）；
出口二紧贴汇流器 M（6），M 直接进箱子 Y（21）。两路各只经过一个元件，次序都是 1。 -/
def «拉A» : List «一幕» := «一串带» 5 [10, 11, 12, 13, 14, 15] ++ [«连» 15 20]
/-- 回放：拉进货带 P。 -/
def «拉P» : List «一幕» := «一串带» 0 [1, 2, 3, 4] ++ [«连» 4 5]
/-- 回放：放汇流器 M。 -/
def «放M» : List «一幕» := [«建» 6 .«汇流器», «连» 5 6, «连» 6 21]
/-- 回放：拆掉几个单位。 -/
def «拆» (us : List «单位号») : List «一幕» := us.map fun u => .«做» (.«改布局» (.«拆除» u))

/-- 回放：实验 A 的五组，一组接一组做：一、按 A、P、M 接好；二、拆掉 P 重拉；三、拆掉 M 重放；
四、拆掉 A 重拉；五、再拆掉 M 重放。 -/
def «五组» : List (List «一幕») :=
  [«拉A» ++ «拉P» ++ «放M», «拆» [1, 2, 3, 4] ++ «拉P», «拆» [6] ++ «放M»,
   «拆» [10, 11, 12, 13, 14, 15] ++ «拉A», «拆» [6] ++ «放M»]

/-- 回放：汇流器的输入判定在起点都没有可移动物品时取 `v` 那种说法，五组依次做；
每组接好以后先走 80 步读一次、再走 320 步读一次，给出两次之间 X、Y 各多了几件。 -/
def «五组的增量» (v : «都没货时») : Option (List (Nat × Nat)) :=
  let un : «未定» := { «取一种» with «输入判定都没货时» := v }
  let xy (s : «状态») : Nat × Nat := («箱里几件» s 20 .«源矿», «箱里几件» s 21 .«源矿»)
  («演于» un «状态».«空» ([«建» 0 .«协议储存箱», «建» 5 .«协议储存箱», «建» 20 .«协议储存箱»,
      «建» 21 .«协议储存箱», «仓储» 0, «仓储» 5, «仓储» 20, «仓储» 21] ++ «装满» 0 .«源矿»)).bind fun s0 =>
    («五组».foldlM (fun (acc : «状态» × List (Nat × Nat)) st =>
      («演于» un acc.1 (st ++ [.«等» 80])).bind fun s1 =>
      («演于» un s1 [.«等» 320]).map fun s2 =>
        (s2, acc.2 ++ [((xy s2).1 - (xy s1).1, (xy s2).2 - (xy s1).2)])) (s0, [])).map (·.2)

-- 看到的（X、Y 的增量）：一 +19、0；二 +15、0；三 +18、0；四 +1、+17；五 +18、0。
-- 也就是第四组（汇流器那一路先接上）货走汇流器进 Y，其余四组走带子进 X。
-- 「轮到的那条」「都收」两种说法五组都对上：
#guard «五组的增量» .«轮到的那条» == some [(40, 0), (40, 0), (40, 0), (0, 40), (40, 0)]
#guard «五组的增量» .«都收» == some [(40, 0), (40, 0), (40, 0), (0, 40), (40, 0)]
-- 规则文件现在的字面（「不收」）第四组对不上：中转箱里的货是元件判定时才进来的，输入判定那一刻箱里是空的，
-- 汇流器这一步不收货，货就走了带子。
#guard «五组的增量» .«不收» == some [(40, 0), (40, 0), (40, 0), (40, 0), (40, 0)]

/-! ## 29　限速的物品准入口：前面的带子排满，后面按限速放行 -/

/-- 回放：货源箱 0 接三格带子（1–3）、物品准入口 4（每 5 tick 收 1 件）、十格带子（10–19）进箱子 30。 -/
def «限速» : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 30 .«协议储存箱», «仓储» 0, «仓储» 30]
  ++ «一串带» 0 [1, 2, 3] ++ [«建» 4 .«物品准入口», «连» 3 4,
    .«做» (.«设准入口» 4 (some .«源矿») none (some 1))]
  ++ «一串带» 4 ((List.range 10).map (· + 10)) ++ [«连» 19 30] ++ «装满» 0 .«源矿»

-- 准入口前面三格都有货；后面十格每五格一件；每 5 tick（40 步）进箱子 1 件。
#guard («演» «状态».«空» «限速»).map («逐次看» (fun s =>
    ([1, 2, 3].map fun u => («格里» s u).isSome, (List.range 10).map fun i => («格里» s (i + 10)).isSome,
      «箱里几件» s 30 .«源矿»)) [400, 440]) ==
  some [([true, true, true], [true, false, false, false, false, true, false, false, false, false], 8),
        ([true, true, true], [true, false, false, false, false, true, false, false, false, false], 9)]

end Endfield.«回放».«现象»
