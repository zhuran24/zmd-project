/-! ## 2　一支收不下的分流器，另一支的通过量降到满速的 8n/(8n+1) -/

/-- 回放：货源箱 0 经一格带子（1）进分流器 S（2）。S 的一支经一格带子（3）通向装满的箱子 F（4）；
另一支先隔 n 格带子（10 起）到一个 `x`（20，分流器、汇流器或桥接器），再经一格带子（21）进箱子 Q（5）。
`后放` 为真时，进 Q 的那段带子比通向 F 的那段后放。 -/
def «两支» (n : Nat) (x : «单位种类») («后放» : Bool) : List «一幕» :=
  let armA := [«建» 3 .«传送带», «连» 2 3, «连» 3 4]
  let armB := «一串带» 2 ((List.range n).map (· + 10)) ++ [«建» 20 x, «连» (10 + n - 1) 20]
    ++ [«建» 21 .«传送带», «连» 20 21, «连» 21 5]
  [«建» 0 .«协议储存箱», «建» 4 .«协议储存箱», «建» 5 .«协议储存箱», «建» 2 .«分流器»,
   «建» 1 .«传送带», «连» 0 1, «连» 1 2, «仓储» 0, «仓储» 4, «仓储» 5]
  ++ (if «后放» then armA ++ armB else armB ++ armA)
  ++ «装满» 0 .«源矿» ++ «装满» 4 .«源矿»

/-- 回放：走到第 400 步以后，再走 `窗` 步，这段时间进 Q 的件数。 -/
def «窗里进了几件» (n : Nat) (x : «单位种类») («后放» : Bool) («窗» : Nat) : Option Nat :=
  («演» «状态».«空» («两支» n x «后放»)).map fun s =>
    match «逐次看» (fun s => «箱里几件» s 5 .«源矿») [400, 400 + «窗»] s with
    | [a, b] => b - a
    | _ => 0

-- 满速是每 8 步 1 件。进 Q 的那段后放时：n 格带子，每 8n+1 步进 n 件，也就是满速的 8n/(8n+1)。
#guard «窗里进了几件» 1 .«桥接器格» true (8 * 9) == some 8
#guard «窗里进了几件» 2 .«桥接器格» true (8 * 17) == some 16
#guard «窗里进了几件» 3 .«桥接器格» true (8 * 25) == some 24
#guard «窗里进了几件» 4 .«桥接器格» true (8 * 33) == some 32
-- 中间那个单位换成汇流器、分流器也一样。
#guard «窗里进了几件» 2 .«汇流器» true (8 * 17) == some 16
#guard «窗里进了几件» 2 .«分流器» true (8 * 17) == some 16
-- 进 Q 的那段带子先放时不出现：满速。
#guard «窗里进了几件» 1 .«桥接器格» false (8 * 9) == some 9
#guard «窗里进了几件» 3 .«桥接器格» false (8 * 25) == some 25

/-! ## 8　几条传送带进同一个汇流器、汇流器收不过来时，有货的几条轮流进；某条这一刻没货就跳过它 -/

/-- 回放：汇流器 J（10）后面六格带子（11–16）进箱子 Q（20）。 -/
def «J后六格» : List «一幕» := «一串带» 10 [11, 12, 13, 14, 15, 16] ++ [«连» 16 20]

/-- 回放：六格带子上从靠 J 的一头起依次是什么物品。 -/
def «带上» (s : «状态») : List (Option «物品») := [11, 12, 13, 14, 15, 16].map («格里» s)

/-- 回放：稀疏的一条和满带进同一个汇流器。箱子 0 的源矿经分流器 1 分三路，只有一路（带子 4）进 J，每 3 tick 一件；
箱子 5 的蓝铁矿经带子 6 满载进 J。`稀疏的先接` 是两条带子接上 J 的先后。 -/
def «稀疏和满带» («稀疏的先接» : Bool) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 2 .«协议储存箱», «建» 3 .«协议储存箱», «建» 5 .«协议储存箱»,
   «建» 20 .«协议储存箱», «仓储» 0, «仓储» 2, «仓储» 3, «仓储» 5, «仓储» 20,
   «建» 1 .«分流器», «连» 0 1, «连» 1 2, «连» 1 3, «建» 4 .«传送带», «连» 1 4,
   «建» 6 .«传送带», «连» 5 6, «建» 10 .«汇流器»]
  ++ (if «稀疏的先接» then [«连» 4 10, «连» 6 10] else [«连» 6 10, «连» 4 10])
  ++ «J后六格» ++ «装满» 0 .«源矿» ++ «装满» 5 .«蓝铁矿»

-- 出口带上严格是「稀疏那种、满带那种、满带那种」反复，和两条带子谁先接上无关。
#guard («演» «状态».«空» («稀疏和满带» true)).map («逐次看» «带上» [300, 308, 316]) == some [
  [some .«源矿», some .«蓝铁矿», some .«蓝铁矿», some .«源矿», some .«蓝铁矿», some .«蓝铁矿»],
  [some .«蓝铁矿», some .«源矿», some .«蓝铁矿», some .«蓝铁矿», some .«源矿», some .«蓝铁矿»],
  [some .«蓝铁矿», some .«蓝铁矿», some .«源矿», some .«蓝铁矿», some .«蓝铁矿», some .«源矿»]]
#guard («演» «状态».«空» («稀疏和满带» false)).map («逐次看» «带上» [300]) == some [
  [some .«源矿», some .«蓝铁矿», some .«蓝铁矿», some .«源矿», some .«蓝铁矿», some .«蓝铁矿»]]

/-! ## 11　分流器、汇流器左右紧贴，各往下进一个箱子：四个单位的放置先后决定分流器的货进不进汇流器 -/

/-- 回放：最后按某种先后放的四件：分流器、汇流器、分流器下方带、汇流器下方带。 -/
inductive «件» where
  | «分» | «汇» | «分下带» | «汇下带»
deriving DecidableEq, Repr

/-- 回放：放一件。单位号：上方装满的箱子 0；左边进料带 1、2 进分流器 5；右边进料带 3、4 从上方进汇流器 6；
分流器的右出口直接进汇流器的左入口；分流器下方带 7、8 进左下箱子 9；汇流器下方带 10、11 进右下箱子 12。
`已放` 是在它之前放好的。一件建成时和已经在场的邻居接通，先后照规则「接通」一行：
分流器先接进口、再从进口那一边起顺时针接出口（右、下）；汇流器从出口那一边起顺时针接进口（左、上）、再接出口。 -/
def «放一件» («已放» : List «件») : «件» → List «一幕»
  | .«分» => [«建» 5 .«分流器», «连» 2 5] ++ (if «已放».contains .«汇» then [«连» 5 6] else [])
      ++ (if «已放».contains .«分下带» then [«连» 5 7] else [])
  | .«汇» => [«建» 6 .«汇流器»] ++ (if «已放».contains .«分» then [«连» 5 6] else []) ++ [«连» 4 6]
      ++ (if «已放».contains .«汇下带» then [«连» 6 10] else [])
  | .«分下带» => [«建» 7 .«传送带»] ++ (if «已放».contains .«分» then [«连» 5 7] else [])
      ++ [«建» 8 .«传送带», «连» 7 8, «连» 8 9]
  | .«汇下带» => [«建» 10 .«传送带»] ++ (if «已放».contains .«汇» then [«连» 6 10] else [])
      ++ [«建» 11 .«传送带», «连» 10 11, «连» 11 12]

/-- 回放：先放三个箱子和两段进料带，再照 `先后` 放那四件，上方箱子装满。 -/
def «四件的先后» («先后» : List «件») : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 9 .«协议储存箱», «建» 12 .«协议储存箱», «仓储» 0, «仓储» 9, «仓储» 12,
   «建» 1 .«传送带», «连» 0 1, «建» 2 .«传送带», «连» 1 2,
   «建» 3 .«传送带», «连» 0 3, «建» 4 .«传送带», «连» 3 4]
  ++ («先后».foldl (fun (acc : List «件» × List «一幕») p =>
      (acc.1 ++ [p], acc.2 ++ «放一件» acc.1 p)) ([], [])).2
  ++ «装满» 0 .«源矿»

/-- 回放：第 200 步到第 520 步（40 tick）之间，左下、右下两个箱子各进了几件。 -/
def «四十拍里» («先后» : List «件») : Option (Nat × Nat) :=
  («演» «状态».«空» («四件的先后» «先后»)).map fun s =>
    match «逐次看» (fun s => («箱里几件» s 9 .«源矿», «箱里几件» s 12 .«源矿»)) [200, 520] s with
    | [a, b] => (b.1 - a.1, b.2 - a.2)
    | _ => (0, 0)

/-- 回放：四件的全部 24 种先后。 -/
def «二十四种» : List (List «件») :=
  let ps : List «件» := [.«分», .«汇», .«分下带», .«汇下带»]
  ps.flatMap fun a => (ps.filter (· != a)).flatMap fun b =>
    ((ps.filter (· != a)).filter (· != b)).flatMap fun c =>
      (((ps.filter (· != a)).filter (· != b)).filter (· != c)).map fun d => [a, b, c, d]

/-- 回放：现象清单列的 9 种「分流器的货有一半进汇流器」的先后。 -/
def «进得去的九种» : List (List «件») := [
  [.«分», .«汇», .«汇下带», .«分下带»], [.«分», .«汇下带», .«汇», .«分下带»],
  [.«分», .«汇下带», .«分下带», .«汇»], [.«汇», .«分下带», .«汇下带», .«分»],
  [.«分下带», .«汇», .«汇下带», .«分»], [.«分下带», .«汇下带», .«汇», .«分»],
  [.«汇下带», .«分», .«汇», .«分下带»], [.«汇下带», .«分», .«分下带», .«汇»],
  [.«汇下带», .«分下带», .«分», .«汇»]]

-- 24 种先后：汇流器下方带每拍都有货（40 拍进 40 件）；分流器下方带，现象清单列的那 9 种隔拍有货（20 件），
-- 其余 15 种每拍有货（40 件）。24 种都对上。
#guard «二十四种».all fun o =>
  «四十拍里» o == some (if «进得去的九种».contains o then 20 else 40, 40)

/-! ## 13、14　制造单位、协议储存箱的出口贴着汇流器 -/

/-- 回放：两台粉碎机（2、3）的出口各贴着汇流器 J，一台做源石粉末、一台做蓝铁粉末，都一直有产品要出。 -/
