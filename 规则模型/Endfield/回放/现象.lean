/-! ## 25　先走哪一路，由下游几个末端接上箱子的先后决定 -/

/-- 回放：左箱 5 由货源箱 0 经带子 1 进货（每 tick 至多一件），右箱 20。 -/
def «左右箱» («右箱在场» : Bool) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 5 .«协议储存箱», «仓储» 0, «仓储» 5, «建» 1 .«传送带», «连» 0 1, «连» 1 5]
  ++ (if «右箱在场» then [«建» 20 .«协议储存箱», «仓储» 20] else [])

/-- 回放：上路除末端以外：左箱上出口紧贴汇流器 6，再接一格带子 7、桥接器 8。 -/
def «上路» : List «一幕» :=
  [«建» 6 .«汇流器», «连» 5 6, «建» 7 .«传送带», «连» 6 7, «建» 8 .«桥接器格», «连» 7 8]

/-- 回放：下路除末端以外：左箱下出口紧贴分流器 11；它向右接三格带子（12–14）；
向上接一格拐弯的带子 16，再接桥接器 17、带子 18、桥接器 19。 -/
def «下路» : List «一幕» :=
  [«建» 11 .«分流器», «连» 5 11] ++ «一串带» 11 [12, 13, 14]
  ++ [«建» 16 .«传送带», «连» 11 16, «建» 17 .«桥接器格», «连» 16 17, «建» 18 .«传送带», «连» 17 18,
      «建» 19 .«桥接器格», «连» 18 19]

/-- 回放：上面的末端（两格带子 9、10）；`r` 为真时右箱在场、建成时接上右箱。 -/
def «上末端» (r : Bool) : List «一幕» :=
  [«建» 9 .«传送带», «连» 8 9, «建» 10 .«传送带», «连» 9 10] ++ (if r then [«连» 10 20] else [])
/-- 回放：中间的末端（一格带子 21）。 -/
def «中末端» (r : Bool) : List «一幕» := [«建» 21 .«传送带», «连» 19 21] ++ (if r then [«连» 21 20] else [])
/-- 回放：下面的末端（单位 15，分流器，或换成桥接器）。 -/
def «下末端» (k : «单位种类») (r : Bool) : List «一幕» := [«建» 15 k, «连» 14 15] ++ (if r then [«连» 15 20] else [])

/-- 回放：三个末端都放好以后才放右箱：右箱建成时三个进口从下到上依次接通（规则「接通」第 2 条）。 -/
def «最后放右箱» : List «一幕» := [«建» 20 .«协议储存箱», «仓储» 20, «连» 15 20, «连» 21 20, «连» 10 20]

/-- 回放：左箱的货走哪一路。第 300 步起每 4 步看一次、看 16 次：上路的带子 7 上有过货是第一项，下路的带子 12 上有过货是第二项。 -/
def «走哪路» (sc : List «一幕») : Option (Bool × Bool) :=
  («演» «状态».«空» (sc ++ «装满» 0 .«源矿»)).map fun s =>
    let l := «逐次看» (fun s => ((«格里» s 7).isSome, («格里» s 12).isSome))
      ((List.range 16).map fun i => 300 + 4 * i) s
    (l.any (·.1), l.any (·.2))

/-- 回放：走上路、走下路。 -/
def «上» : Option (Bool × Bool) := some (true, false)
/-- 回放：走下路。 -/
def «下» : Option (Bool × Bool) := some (false, true)

/-- 回放：右箱已在场，两路铺好，三个末端按给的先后放（都是分流器末端）。 -/
def «末端的先后» (ends : List (List «一幕»)) : List «一幕» :=
  «左右箱» true ++ «上路» ++ «下路» ++ ends.flatten

-- 右箱已在场，上、中两个末端里有一个最先放：走上路。
#guard «走哪路» («末端的先后» [«上末端» true, «中末端» true, «下末端» .«分流器» true]) == «上»
#guard «走哪路» («末端的先后» [«中末端» true, «下末端» .«分流器» true, «上末端» true]) == «上»
-- 右箱已在场，下面那个末端分流器最先放：走下路。
#guard «走哪路» («末端的先后» [«下末端» .«分流器» true, «上末端» true, «中末端» true]) == «下»
-- 三个末端都放好以后才放右箱：不论三个末端的先后，走下路。
#guard «走哪路» («左右箱» false ++ «上路» ++ «下路» ++ «上末端» false ++ «中末端» false
  ++ «下末端» .«分流器» false ++ «最后放右箱») == «下»
#guard «走哪路» («左右箱» false ++ «上路» ++ «下路» ++ «下末端» .«分流器» false ++ «上末端» false
  ++ «中末端» false ++ «最后放右箱») == «下»
-- 走上路时，同时重放上、中两个末端：翻转成走下路。只重放其中一个：不变。
#guard «走哪路» («末端的先后» [«上末端» true, «中末端» true, «下末端» .«分流器» true]
  ++ «拆» [9, 10, 21] ++ «上末端» true ++ «中末端» true) == «下»
#guard «走哪路» («末端的先后» [«上末端» true, «中末端» true, «下末端» .«分流器» true]
  ++ «拆» [9, 10] ++ «上末端» true) == «上»
#guard «走哪路» («末端的先后» [«上末端» true, «中末端» true, «下末端» .«分流器» true]
  ++ «拆» [21] ++ «中末端» true) == «上»
-- 走下路时，重放下面那个末端分流器：翻转成走上路。
#guard «走哪路» («末端的先后» [«下末端» .«分流器» true, «上末端» true, «中末端» true]
  ++ «拆» [15] ++ «下末端» .«分流器» true) == «上»
-- 把下面那个末端分流器换成桥接器：不论怎么放，总走下路。
#guard «走哪路» («末端的先后» [«上末端» true, «中末端» true, «下末端» .«桥接器格» true]) == «下»
#guard «走哪路» («末端的先后» [«下末端» .«桥接器格» true, «上末端» true, «中末端» true]) == «下»

/-- 回放：实测-2026-11-10。实验 A 的布局，汇流器 M 的另一个进口再接一格什么都不送的带子 T（30）。三种摆法：
`0` 基线（没有 T）：放 W，放 M，最后拉 A；`1` 摆法甲：先拉 T，放 M，再放 W，最后拉 A；`2` 摆法乙：放 W，放 M，再拉 T，最后拉 A。 -/
def «加一条空带» (k : Nat) : List «一幕» :=
  let pre := [«建» 0 .«协议储存箱», «建» 20 .«协议储存箱», «建» 21 .«协议储存箱», «仓储» 0, «仓储» 20,
    «仓储» 21, «建» 1 .«传送带», «连» 0 1] ++ «一串带» 1 [2, 3, 4]
  let w := [«建» 5 .«协议储存箱», «连» 4 5, «仓储» 5]
  pre ++ (if k == 0 then w ++ [«建» 6 .«汇流器», «连» 5 6, «连» 6 21]
    else if k == 1 then [«建» 30 .«传送带», «建» 6 .«汇流器», «连» 30 6, «连» 6 21] ++ w ++ [«连» 5 6]
    else w ++ [«建» 6 .«汇流器», «连» 5 6, «连» 6 21, «建» 30 .«传送带», «连» 30 6])
  ++ «拉A» ++ «装满» 0 .«源矿»

/-- 回放：照说法 `v` 走 40 tick 以后 X、Y 里各有几件。 -/
def «四十拍以后» (v : «都没货时») (k : Nat) : Option (Nat × Nat) :=
  let un : «未定» := { «取一种» with «输入判定都没货时» := v }
  («演于» un «状态».«空» («加一条空带» k ++ [.«等» 320])).map fun s =>
    («箱里几件» s 20 .«源矿», «箱里几件» s 21 .«源矿»)

-- 看到的：基线一次、摆法甲两次、摆法乙两次，都是货全进 Y、X 是 0。
-- 「都收」「再判一次」三种摆法都对上（这两种要另一个布局才分得开，见 `两个中转箱.lean`）：
#guard [«都没货时».«都收», .«再判一次»].all fun v =>
  [0, 1, 2].all fun k => «四十拍以后» v k == some (0, 35)
-- 「轮到的那条」：摆法甲 Y 里只有 1 件、其余进 X，摆法乙全进 X，对不上。
#guard [0, 1, 2].map («四十拍以后» .«轮到的那条») == [some (0, 35), some (29, 1), some (30, 0)]
-- 规则文件现在的字面（「不收」）：三种摆法都全进 X，对不上。
#guard [0, 1, 2].all fun k => «四十拍以后» .«不收» k == some (30, 0)

