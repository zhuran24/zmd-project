  .«做» (.«设准入口» 11 (some .«源矿») (some 2) none), .«等» (60 + 3 * k),
  .«做» (.«设准入口» 14 (some .«蓝铁块») (some 1) none), .«等» (60 + 5 * k),
  .«做» (.«设准入口» 54 (some .«源石粉末») (some 3) none), .«等» (100 + 7 * k),
  .«做» (.«设准入口» 55 (some .«钢块») (some 1) none), .«等» (60 + 2 * k)]

/-- 回放：放行以前要成立的状态（实测里逐条开面板核对的那几条）。 -/
def «前提» (s : «状态») : Bool :=
  s.«货» ⟨50, .«格» 0⟩ == [⟨.«源石粉末», 1⟩]
    && s.«货» ⟨3, .«取货»⟩ == [⟨.«源石粉末», 1⟩] && s.«货» ⟨3, .«缓存»⟩ == [⟨.«蓝铁粉末», 1⟩]
    && s.«货» ⟨40, .«格» 0⟩ == [⟨.«源石粉末», 50⟩] && s.«货» ⟨41, .«格» 0⟩ == [⟨.«源石粉末», 50⟩]
    && s.«货» ⟨51, .«格» 0⟩ == [⟨.«源石粉末», 1⟩] && s.«货» ⟨52, .«格» 0⟩ == [⟨.«源石粉末», 1⟩]
    && s.«货» ⟨45, .«格» 0⟩ == [⟨.«源石粉末», 1⟩] && s.«货» ⟨46, .«格» 0⟩ == [⟨.«钢块», 1⟩]
    && «箱里依次» s 30 == []

/-- 回放：照摆法 `J` 备好以后，把 G0 改成放行源石粉末、累计上限 `n`，再等到货进 Q。
给出前提成不成立、Q 里依次放着什么、M 的取货物品格里放着什么。 -/
def «演一遍» (J : List «一幕») (n k : Nat) : Option (Bool × List («物品» × Nat) × List «一堆») :=
  («演» «状态».«空» («布置» ++ J ++ «备好» k)).bind fun s0 =>
    («演» s0 [.«做» (.«设准入口» 53 (some .«源石粉末») (some n) none), .«等» (200 + k)]).map fun s =>
      («前提» s0, «箱里依次» s 30, s.«货» ⟨3, .«取货»⟩)

/-! ## 模型给出的结果

下面三条是模型照现在的写法（卡住的那批在下一步开始时进取货物品格、当步送出）走出来的，
写在实测做完之前（2026-11-09）；实测的结果出来以后在这里对。 -/

-- 对照（G0 只多收 1 件）：前提都成立；只有 W 进 Q；M 的取货物品格里还是那件源石粉末（P1 没动）。
#guard «演一遍» «摆法二» 1 0 == some (true, [(.«钢块», 1)], [⟨.«源石粉末», 1⟩])
-- 摆法二（两件同一步到时 P2 先进）：Q 第 1 格是 P2。
#guard «演一遍» «摆法二» 2 0 == some (true, [(.«蓝铁粉末», 1), (.«钢块», 1)], [])
-- 摆法一（两件同一步到时 W 先进）：Q 第 1 格是 W。两种摆法第 1 格不同，说明模型里两件是同一步到 J 的。
#guard «演一遍» «摆法一» 2 0 == some (true, [(.«钢块», 1), (.«蓝铁粉末», 1)], [])

