/-- 回放：照调用 362–376 建五个仓储箱、桩、种植机和进料带，在带上放准入口；
接汇流器及其带以后，从远端逐格建 C、A、B 三条带，让贴着种植机的一格只接通一次。 -/
private def «装好种子的场地» : Option Endfield.«格子».«状态» := do
  let initial := [
    «摆» 1 23 13 (.«协议储存箱» .«右»), «摆» 51 23 24 (.«协议储存箱» .«下»),
    «摆» 52 26 24 (.«协议储存箱» .«下»), «摆» 53 29 24 (.«协议储存箱» .«下»),
    «摆» 54 32 24 (.«协议储存箱» .«下»), «摆» 99 33 16 .«供电桩», «种植机» 10,
    «带格» 2 26 14 .«左» .«右», «带格» 3 27 14 .«左» .«右»,
    «带格» 4 28 14 .«左» .«右», «带格» 5 29 14 .«左» .«下»,
    «摆» 6 27 14 (.«物品准入口» .«右»)]
  let pieces := initial ++ «汇流器到M箱» ++ «到C箱的带».reverse ++ «到A箱的带».reverse ++ «到B箱的带».reverse
  let s ← «布置» (← pieces.mapM id)
  let s ← «做» s (.«原样» (.«设准入口» 6 (some .«砂叶种子») (some 1) (some 0)))
  «做» s (.«原样» (.«放货» 1 .«砂叶种子» 50))

/-- 回放：按模型步号放行、读首箱、读末箱；在读四箱的两端都核全部箱数。
每一粒均沿用前一粒的状态。第 377 次调用关闭限速，随后每次只重置累计计数。 -/
private def «读六粒» (s : Endfield.«格子».«状态») (start : Nat)
    (times : List (Nat × Nat × Nat)) := do
  let mut state := s
  let mut now := start
  let mut rows : List (List Nat × List Nat) := []
  for (release, firstBox, lastBox) in times do
    let op := if release == 159 then
      «原样操作».«设准入口» 6 (some .«砂叶种子») (some 1) none
    else «原样操作».«重置计数» 6
    let fed ← «做» («等» (release - now) state) (.«原样» op)
    let early := «等» (firstBox - release) fed
    state := «等» (lastBox - firstBox) early
    let counts (s : Endfield.«格子».«状态») := [51, 52, 53, 54].map fun u => «箱货» s u .«砂叶»
    rows := (counts early, counts state) :: rows
    now := lastBox
  return (state, now, rows.reverse)

/-- 回放：一次收机、原处重放，两次操作之间照调用起点之差走步。 -/
private def «收机重放» (s : Endfield.«格子».«状态») (now take put old fresh : Nat) := do
  let s ← «做» («等» (take - now) s) (.«收» old)
  «做» («等» (put - take) s) (.«建» (← «种植机» fresh))

/-- 回放：从货源箱放一组种子（调用 376 的 t0）起算模型步号。
一秒四步，取最接近的步界。每 5 tick 上限为零期间让种子在进料带上等候；
关限速和收放机用调用 t0，重置用 reset_time.t0（点击，实际放行时刻未测）。
每行三数为操作步、M 箱读数步、C 箱读数步，后两数取自 box_read 返回的钟面。
脚本等 24 秒再依次读四箱。区间两端均核同一行读数，涵盖中间两箱的读时。 -/
private def «三回箱数» := do
  let (s, t, a) ← «读六粒» (← «装好种子的场地») 0
    [(159, 273, 295), (303, 411, 434), (442, 551, 573),
     (582, 691, 713), (721, 831, 853), (862, 971, 994)]
  let s ← «收机重放» s t 1029 1048 10 11
  let (s, t, b) ← «读六粒» s 1048
    [(1075, 1184, 1207), (1216, 1324, 1347), (1356, 1464, 1488),
     (1496, 1604, 1628), (1636, 1745, 1772), (1782, 1892, 1918)]
  let s ← «收机重放» s t 1923 1944 11 12
  let (_, _, c) ← «读六粒» s 1944
    [(1973, 2083, 2109), (2119, 2228, 2255), (2265, 2376, 2403),
     (2412, 2524, 2550), (2560, 2669, 2696), (2706, 2816, 2843)]
  return a ++ b ++ c

