import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-11-25.md「改带子、移动单位以后，接通先后怎么变」一节里分流器的那一半。

布局：分流器 S 三条出口带（O1 左、O2 下、O3 右）。先摆好、做一处改动，再一件一件放两件，看各进哪个箱子。
都没移动过物品时头一件走第 2 条接通的出口，第 2 件走第 3 条。

游戏里一条带子是一个整体：改它的任何一格，它两头通到别的单位的通道都算重新接通、排到最后。
格子层照这个写了（`场地.重接通道`，2026-11-26）。这以前模型里改一格只动这一格自己的通道，
下面有六条当时和游戏对不上、现在对得上了。

末尾「分流器走过货以后再改一条出口带」来自 实测-2026-11-26.md 第七节。

11-25 那一节里汇流器进口的一半读法不成立，换了读法重做的在 实测-2026-11-26.md，回放在 `带子是一个整体.lean`；
这里只留着两份回放共用的摆法（汇流器的三条进口带、收掉重拉、换准入口）。
游戏里的「移动」模型没有，带「移动」的几轮没有回放。

实测里三种货是碳块、源矿、蓝铁矿；模型的物品里没有碳块，这里 A 的货换成蓝铁矿，C 的货换成蓝铁块。
-/

namespace Endfield.«回放».«改带子以后的先后»

open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-! ## 两份回放共用的摆法：汇流器三条进口带 -/

/-- 回放：三条进口带各自的格。P1 上（11、12），P2 左（21–23），P3 右（31–33）。 -/
def «进口带» : Nat → Option (List «摆件»)
  | 1 => [«摆» 11 30 17 (.«传送带» .«上» .«下»), «摆» 12 30 18 (.«传送带» .«上» .«下»)].mapM id
  | 2 => [«摆» 21 27 19 (.«传送带» .«左» .«右»), «摆» 22 28 19 (.«传送带» .«左» .«右»),
          «摆» 23 29 19 (.«传送带» .«左» .«右»)].mapM id
  | _ => [«摆» 31 33 19 (.«传送带» .«右» .«左»), «摆» 32 32 19 (.«传送带» .«右» .«左»),
          «摆» 33 31 19 (.«传送带» .«右» .«左»)].mapM id

/-- 回放：依次建一串摆件。 -/
def «建一串» (s : Endfield.«格子».«状态») (ps : List «摆件») : Option Endfield.«格子».«状态» :=
  ps.foldlM (fun s p => «做» s (.«建» p)) s

/-- 回放：货源箱 A（1，上）、B（2，左）、C（3，右），收货箱 60，出口带 51、52、54。汇流器 40 另外建。 -/
def «汇流器底» : Option Endfield.«格子».«状态» :=
  ([«摆» 1 29 14 (.«协议储存箱» .«下»), «摆» 2 24 18 (.«协议储存箱» .«右»),
    «摆» 3 34 18 (.«协议储存箱» .«左»), «摆» 60 29 23 (.«协议储存箱» .«下»)].mapM id).bind «布置»

/-- 回放：汇流器 40，在 (30,19)，左、上、右进，下出。 -/
def «汇流器» : Option «摆件» := «摆» 40 30 19 (.«汇流器» .«下»)
/-- 回放：汇流器的出口带 (30,20)–(30,22)。 -/
def «出口带» : Option (List «摆件») :=
  [«摆» 51 30 20 (.«传送带» .«上» .«下»), «摆» 52 30 21 (.«传送带» .«上» .«下»),
   «摆» 54 30 22 (.«传送带» .«上» .«下»)].mapM id

/-- 回放：先放汇流器和出口带，再照 `序` 拉三条进口带，最后做 `改`。 -/
def «先放汇流器» («序» : List Nat) («改» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态»)
    (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := do
  let s ← «做» s (.«建» (← «汇流器»))
  let s ← «建一串» s (← «出口带»)
  let s ← «序».foldlM (fun s k => do «建一串» s (← «进口带» k)) s
  «改» s

/-- 回放：不做改动。 -/
def «不改» (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := some s
/-- 回放：在某一格带子上换一个物品准入口（d 是它的出口朝向）。 -/
def «换准入口» (id i j : Nat) (d : «朝向») (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := do
  «做» s (.«建» (← «摆» id i j (.«物品准入口» d)))
/-- 回放：把几格带子收掉，再照原样建回去。 -/
def «收掉重拉» (ps : List (Nat × Nat × Nat × «朝向» × «朝向»)) (s : Endfield.«格子».«状态») :
    Option Endfield.«格子».«状态» := do
  let s ← ps.foldlM (fun s p => «做» s (.«收» p.1)) s
  ps.foldlM (fun s p => do «做» s (.«建» (← «摆» p.1 p.2.1 p.2.2.1 (.«传送带» p.2.2.2.1 p.2.2.2.2)))) s

/-! ## 分流器三条出口带 -/

/-- 回放：三条出口带各自的格。O1 左（11–13），O2 下（21–23），O3 右（31–33）。 -/
def «出口带三条» : Nat → Option (List «摆件»)
  | 1 => [«摆» 11 29 19 (.«传送带» .«右» .«左»), «摆» 12 28 19 (.«传送带» .«右» .«左»),
          «摆» 13 27 19 (.«传送带» .«右» .«左»)].mapM id
  | 2 => [«摆» 21 30 20 (.«传送带» .«上» .«下»), «摆» 22 30 21 (.«传送带» .«上» .«下»),
          «摆» 23 30 22 (.«传送带» .«上» .«下»)].mapM id
  | _ => [«摆» 31 31 19 (.«传送带» .«左» .«右»), «摆» 32 32 19 (.«传送带» .«左» .«右»),
          «摆» 33 33 19 (.«传送带» .«左» .«右»)].mapM id

/-- 回放：货源箱 A（1）出口正对的那格直接放物品准入口 5 当阀门，一格带 6 进分流器 40；
三个收货箱：左 61、下 62、右 63。照 `摆法` 摆三条出口带（含改动），然后一件一件放行两件，
给出头一件、第二件各进了哪个箱子（1 左、2 下、3 右；0 是没进箱）。 -/
def «头两件» («摆法» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态») : Option (Nat × Nat) := do
  let s ← ([«摆» 1 29 14 (.«协议储存箱» .«下»), «摆» 61 24 18 (.«协议储存箱» .«左»),
            «摆» 62 29 23 (.«协议储存箱» .«下»), «摆» 63 34 18 (.«协议储存箱» .«右»),
            «摆» 5 30 17 (.«物品准入口» .«下»), «摆» 6 30 18 (.«传送带» .«上» .«下»),
            «摆» 40 30 19 (.«分流器» .«上»)].mapM id).bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 5 (some .«蓝铁矿») (some 1) (some 0)))
  let s ← «摆法» s
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 50))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let «哪个» (t : Endfield.«格子».«状态») (old : List Nat) : Nat :=
    let now := [61, 62, 63].map fun u => «箱里几件» t.«模型» u .«蓝铁矿»
    match ((now.zip old).map fun p => p.1 - p.2).zipIdx.filter (fun p => p.1 != 0) with
    | [] => 0
    | [(1, i)] => i + 1
    | _ => 9
  let s ← «做» s (.«原样» (.«设准入口» 5 (some .«蓝铁矿») (some 1) none))
  let s := «等» 100 s
  let a := «哪个» s [0, 0, 0]
  let c1 := [61, 62, 63].map fun u => «箱里几件» s.«模型» u .«蓝铁矿»
  let s ← «做» s (.«原样» (.«重置计数» 5))
  let s := «等» 100 s
  return (a, «哪个» s c1)

/-- 回放：照 `序` 拉三条出口带，再做 `改`。 -/
def «拉出口» («序» : List Nat) («改» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态»)
    (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := do
  let s ← «序».foldlM (fun s k => do «建一串» s (← «出口带三条» k)) s
  «改» s

-- S1、S2 对照：头一件走第 2 条接通的出口，第二件走第 3 条。
#guard «头两件» («拉出口» [1, 2, 3] «不改») == some (2, 3)
#guard «头两件» («拉出口» [2, 3, 1] «不改») == some (3, 1)
-- S4：O1 贴着分流器的那格收掉重拉，S 到 O1 的通道是新的，先后变成 O2、O3、O1：右、左。
#guard «头两件» («拉出口» [1, 2, 3] («收掉重拉» [(11, 29, 19, .«右», .«左»)])) == some (3, 1)
-- 改的不是贴着 S 的那一格，S 到这条带的通道照样排到最后（2026-11-26 以前模型在这六条上给的都是下、右）：
-- S3：O1 最后一格收掉重拉。右、左。S5 最后一格换准入口、S6 中间那格换准入口也是右、左。
#guard «头两件» («拉出口» [1, 2, 3] («收掉重拉» [(13, 27, 19, .«右», .«左»)])) == some (3, 1)
#guard «头两件» («拉出口» [1, 2, 3] («换准入口» 71 27 19 .«左»)) == some (3, 1)
#guard «头两件» («拉出口» [1, 2, 3] («换准入口» 72 28 19 .«左»)) == some (3, 1)
-- S11：O2 最后一格收掉重拉。右、下（先后变成 O1、O3、O2）。S14 O2 中间那格换准入口也是右、下。
-- 改 O1 的几条单看分不出「O1 排到最后」和「先后没变、只是换了起点」，这两条分得出。
#guard «头两件» («拉出口» [1, 2, 3] («收掉重拉» [(23, 30, 22, .«上», .«下»)])) == some (3, 2)
#guard «头两件» («拉出口» [1, 2, 3] («换准入口» 73 30 21 .«下»)) == some (3, 2)
-- S8：O1 先只拉头两格（不到箱子），拉完 O2、O3 再补上最后一格：O1 接长了，S 到它的通道重新接通。右、左。
#guard «头两件» (fun s => do
  let s ← «建一串» s ((← «出口带三条» 1).take 2)
  let s ← «建一串» s (← «出口带三条» 2)
  let s ← «建一串» s (← «出口带三条» 3)
  «建一串» s ((← «出口带三条» 1).drop 2)) == some (3, 1)
-- S12：O3 最后一格收掉重拉。O3 本来就排最后，还是下、右。
#guard «头两件» («拉出口» [1, 2, 3] («收掉重拉» [(33, 33, 19, .«左», .«右»)])) == some (2, 3)

-- S10：O1 最后一格收掉、不补（带子断头）。头一件进右边的箱子，第二件三个箱子都没进（游戏里读到的也只到这里；
-- 模型里它走进了断头的 O1，这条核对不查它在哪）。
#guard «头两件» («拉出口» [1, 2, 3] (fun s => «做» s (.«收» 13))) == some (3, 0)

/-! ## 分流器走过货以后再改一条出口带

来源：实测-2026-11-26.md 第七节。上面各条都是分流器还没走过货时改的，分不出「整组当成未移动过物品」。
这里先放几件、再在一条出口带离分流器最远的那一格换上准入口，看接下来各件去哪。 -/

/-- 回放：照 O1、O2、O3 的先后拉三条出口带，一件一件放 `前` 件，做 `改`，再放 3 件。
给出改之前、改之后各件进了哪个箱子（1 左、2 下、3 右）。 -/
def «走过货再改» («前» : Nat) («改» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态») :
    Option (List Nat × List Nat) := do
  let s ← ([«摆» 1 29 14 (.«协议储存箱» .«下»), «摆» 61 24 18 (.«协议储存箱» .«左»),
            «摆» 62 29 23 (.«协议储存箱» .«下»), «摆» 63 34 18 (.«协议储存箱» .«右»),
            «摆» 5 30 17 (.«物品准入口» .«下»), «摆» 6 30 18 (.«传送带» .«上» .«下»),
            «摆» 40 30 19 (.«分流器» .«上»)].mapM id).bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 5 (some .«蓝铁矿») (some 1) (some 0)))
  let s ← «拉出口» [1, 2, 3] «不改» s
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 50))
  let s ← «做» { s with «模型» := «压平» s.«模型».«布局» s.«模型» } (.«原样» (.«设准入口» 5 (some .«蓝铁矿») (some 1) none))
  let «三箱» (t : Endfield.«格子».«状态») : List Nat := [61, 62, 63].map fun u => «箱里几件» t.«模型» u .«蓝铁矿»
  let «哪个» (t : Endfield.«格子».«状态») (old : List Nat) : Nat :=
    match (((«三箱» t).zip old).map fun p => p.1 - p.2).zipIdx.filter (fun p => p.1 != 0) with
    | [] => 0
    | [(1, i)] => i + 1
    | _ => 9
  let «放» (t : Endfield.«格子».«状态») (k : Nat) : Option (Endfield.«格子».«状态» × List Nat) :=
    (List.range k).foldlM (fun (acc : Endfield.«格子».«状态» × List Nat) _ => do
      let old := «三箱» acc.1
      let t ← «做» acc.1 (.«原样» (.«重置计数» 5))
      let t := «等» 100 t
      return (t, acc.2 ++ [«哪个» t old])) (t, [])
  let s := «等» 100 s
  let w := «哪个» s [0, 0, 0]
  let (s, a) ← «放» s («前» - 1)
  let s ← «改» s
  let (_, b) ← «放» s 3
  return (w :: a, b)

-- 游戏里每轮改之后放了四件，其中两件是一起读到的、谁先谁后分不出（第 1 轮是左和下，第 2、3 轮是后两件），这里的先后是模型的；
-- 游戏放的第四件这里没核。能对上的是改之后的头一件（三轮都是新先后的第 2 条）和这几件各去了哪。
-- 放过两件（下、右，上一次是右）以后改左边那条：先后变成 下、右、左，从第 2 条起：右、左、下。
-- 要是接着原来的「上一次」走会是 左、下、右。
#guard «走过货再改» 2 («换准入口» 71 27 19 .«左») == some ([2, 3], [3, 1, 2])
-- 放过一件（下）以后改右边那条（它本来就排最后）：从第 2 条起：下、右、左。接着走的话是 右、左、下。
#guard «走过货再改» 1 («换准入口» 74 33 19 .«右») == some ([2], [2, 3, 1])
-- 放过两件以后改下边那条：先后变成 左、右、下，从第 2 条起：右、下、左。
#guard «走过货再改» 2 («换准入口» 73 30 22 .«下») == some ([2, 3], [3, 2, 1])

end Endfield.«回放».«改带子以后的先后»
