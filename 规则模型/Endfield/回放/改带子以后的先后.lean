import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-11-25.md「改带子、移动单位以后，接通先后怎么变」一节。

两套布局，都是先摆好、做一处改动、再看轮询从哪条走：
- 汇流器 M 三条进口带（P1 上、P2 左、P3 右）。P1 的货先进 M，之后看 P2、P3 谁的货先进（先接通的先进）。
- 分流器 S 三条出口带（O1 左、O2 下、O3 右）。都没移动过物品时头一件走第 2 条接通的出口，第 2 件走第 3 条。

模型里每格传送带是一个单位，改一格只动这一格的通道。
- 汇流器这一组（看的是带子尾端通往 M 的那条通道）：模型和实测都一样。
- 分流器这一组（看的是 S 通到带子头上的那条通道）：实测里这条带子不论改哪一格，S 到它的通道都算重新接通、排到最后；
  模型只有改贴着 S 的那一格时才这样。下面把对得上的和对不上的分开写，对不上的写明模型给的是什么、游戏里是什么。
- 游戏里的「移动」模型没有，带「移动」的几轮没有回放。

实测里三种货是碳块、源矿、蓝铁矿；模型的物品里没有碳块，这里 A 的货换成蓝铁矿，C 的货换成蓝铁块。
-/

namespace Endfield.«回放».«改带子以后的先后»

open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-! ## 汇流器三条进口带 -/

/-- 回放：三条进口带各自的格。P1 上（11、12），P2 左（21–23），P3 右（31–33）。 -/
def «进口带» : Nat → Option (List «摆件»)
  | 1 => [«摆» 11 30 17 (.«传送带» .«上» .«下»), «摆» 12 30 18 (.«传送带» .«上» .«下»)].mapM id
  | 2 => [«摆» 21 27 19 (.«传送带» .«左» .«右»), «摆» 22 28 19 (.«传送带» .«左» .«右»),
          «摆» 23 29 19 (.«传送带» .«左» .«右»)].mapM id
  | _ => [«摆» 31 33 19 (.«传送带» .«右» .«左»), «摆» 32 32 19 (.«传送带» .«右» .«左»),
          «摆» 33 31 19 (.«传送带» .«右» .«左»)].mapM id

/-- 回放：依次建一串摆件。 -/
def «建一串» (s : Endfield.«格子».«状态») (ps : List «摆件») : Option Endfield.«格子».«状态» :=
  ps.foldlM (fun s p => «做» s (.«建» p)) s

/-- 回放：货源箱 A（1，上）、B（2，左）、C（3，右），收货箱 60，出口带 51、52、54。汇流器 40 另外建。 -/
def «汇流器底» : Option Endfield.«格子».«状态» :=
  ([«摆» 1 29 14 (.«协议储存箱» .«下»), «摆» 2 24 18 (.«协议储存箱» .«右»),
    «摆» 3 34 18 (.«协议储存箱» .«左»), «摆» 60 29 23 (.«协议储存箱» .«下»)].mapM id).bind «布置»

/-- 回放：汇流器 40，在 (30,19)，左、上、右进，下出。 -/
def «汇流器» : Option «摆件» := «摆» 40 30 19 (.«汇流器» .«下»)
/-- 回放：汇流器的出口带 (30,20)–(30,22)。 -/
def «出口带» : Option (List «摆件») :=
  [«摆» 51 30 20 (.«传送带» .«上» .«下»), «摆» 52 30 21 (.«传送带» .«上» .«下»),
   «摆» 54 30 22 (.«传送带» .«上» .«下»)].mapM id

/-- 回放：照 `摆法` 把汇流器、出口带、三条进口带摆好（含改动），然后先放 A 的货（一直在流），
过 80 步同时放 B、C 的货（两路的货同一步到汇流器），再走 120 步；给出收货箱里各格依次是什么物品。
游戏里是三个货源箱一直有货、收货箱最后放（之前货在出口带末端堵着），判的是同一件事：
P1 进过货以后，P2、P3 的货都等着时谁先进。 -/
def «进口先后» («摆法» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态») : Option (List «物品») := do
  let s ← «汇流器底»
  let s ← «摆法» s
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 50))
  let s := «等» 80 { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let s ← «做» s (.«原样» (.«放货» 2 .«源矿» 50))
  let s ← «做» s (.«原样» (.«放货» 3 .«蓝铁块» 50))
  let s := «等» 120 s
  return («箱里依次» s.«模型» 60).map (·.1)

/-- 回放：先放汇流器和出口带，再照 `序` 拉三条进口带，最后做 `改`。 -/
def «先放汇流器» («序» : List Nat) («改» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态»)
    (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := do
  let s ← «做» s (.«建» (← «汇流器»))
  let s ← «建一串» s (← «出口带»)
  let s ← «序».foldlM (fun s k => do «建一串» s (← «进口带» k)) s
  «改» s

/-- 回放：不做改动。 -/
def «不改» (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := some s
/-- 回放：在某一格带子上换一个物品准入口（d 是它的出口朝向）。 -/
def «换准入口» (id i j : Nat) (d : «朝向») (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := do
  «做» s (.«建» (← «摆» id i j (.«物品准入口» d)))
/-- 回放：把几格带子收掉，再照原样建回去。 -/
def «收掉重拉» (ps : List (Nat × Nat × Nat × «朝向» × «朝向»)) (s : Endfield.«格子».«状态») :
    Option Endfield.«格子».«状态» := do
  let s ← ps.foldlM (fun s p => «做» s (.«收» p.1)) s
  ps.foldlM (fun s p => do «做» s (.«建» (← «摆» p.1 p.2.1 p.2.2.1 (.«传送带» p.2.2.2.1 p.2.2.2.2)))) s

/-- 回放：收货箱里依次是 A、B、C 的货：P2（左）的货比 P3（右）的先进。 -/
def «乙先» : Option (List «物品») := some [.«蓝铁矿», .«源矿», .«蓝铁块»]
/-- 回放：收货箱里依次是 A、C、B 的货：P3（右）的货比 P2（左）的先进。 -/
def «丙先» : Option (List «物品») := some [.«蓝铁矿», .«蓝铁块», .«源矿»]

-- 对照（R1、R2）：先拉的那条先进。
#guard «进口先后» («先放汇流器» [1, 2, 3] «不改») == «乙先»
#guard «进口先后» («先放汇流器» [1, 3, 2] «不改») == «丙先»
-- 改 P2 上游的格，P2 尾端到 M 的通道不变（R3 贴着货源的那格换准入口，R4 中间那格换准入口，R6 贴着货源的那格收掉重拉）：
#guard «进口先后» («先放汇流器» [1, 2, 3] («换准入口» 71 27 19 .«右»)) == «乙先»
#guard «进口先后» («先放汇流器» [1, 2, 3] («换准入口» 72 28 19 .«右»)) == «乙先»
#guard «进口先后» («先放汇流器» [1, 2, 3] («收掉重拉» [(21, 27, 19, .«左», .«右»)])) == «乙先»
-- 另一侧对称再做一轮（R7：先后 P1、P3、P2，P3 贴着货源的那格换准入口），P3 仍在前：
#guard «进口先后» («先放汇流器» [1, 3, 2] («换准入口» 74 33 19 .«左»)) == «丙先»
-- 动到 P2 尾端的，P2 的通道是新的、排到 P3 后面（R5 贴着 M 的那格换准入口，R18 那一格收掉重拉，R17 整条收掉重拉）：
#guard «进口先后» («先放汇流器» [1, 2, 3] («换准入口» 73 29 19 .«右»)) == «丙先»
#guard «进口先后» («先放汇流器» [1, 2, 3] («收掉重拉» [(23, 29, 19, .«左», .«右»)])) == «丙先»
#guard «进口先后» («先放汇流器» [1, 2, 3] («收掉重拉»
  [(21, 27, 19, .«左», .«右»), (22, 28, 19, .«左», .«右»), (23, 29, 19, .«左», .«右»)])) == «丙先»
-- R13：P2 先只拉两格（不到 M），拉完 P3 再补上最后一格：P2 到 M 的通道后形成，排在 P3 后面。
#guard «进口先后» (fun s => do
  let s ← «做» s (.«建» (← «汇流器»))
  let s ← «建一串» s (← «出口带»)
  let s ← «建一串» s (← «进口带» 1)
  let s ← «建一串» s ((← «进口带» 2).take 2)
  let s ← «建一串» s (← «进口带» 3)
  «建一串» s ((← «进口带» 2).drop 2)) == «丙先»

/-- 回放：汇流器最后放（或收掉重放）。三条进口通道同一刻形成，照汇流器的端口排（左、上、右）；
都没移动过物品，从第 2 条（上）起，然后右、左。货是三路一起等着的，所以这里三个货源箱先放货。 -/
def «汇流器后放» («序» : List Nat) («重放» : Bool) : Option (List «物品») := do
  let s ← «汇流器底»
  let s ← if «重放» then «做» s (.«建» (← «汇流器»)) else some s
  let s ← «序».foldlM (fun s k => do «建一串» s (← «进口带» k)) s
  let s ← if «重放» then «做» s (.«收» 40) else some s
  let s ← «做» s (.«建» (← «汇流器»))
  let s ← «建一串» s (← «出口带»)
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 50))
  let s ← «做» s (.«原样» (.«放货» 2 .«源矿» 50))
  let s ← «做» s (.«原样» (.«放货» 3 .«蓝铁块» 50))
  let s := «等» 120 { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  return («箱里依次» s.«模型» 60).map (·.1)

-- R15、R16：带子先拉（两种先后）、汇流器最后放；R20：汇流器收掉、原处重放。都是上、右、左，和带子建成的先后无关。
#guard [«汇流器后放» [1, 2, 3] false, «汇流器后放» [1, 3, 2] false, «汇流器后放» [1, 2, 3] true].all (· == «丙先»)

/-! ## 分流器三条出口带 -/

/-- 回放：三条出口带各自的格。O1 左（11–13），O2 下（21–23），O3 右（31–33）。 -/
def «出口带三条» : Nat → Option (List «摆件»)
  | 1 => [«摆» 11 29 19 (.«传送带» .«右» .«左»), «摆» 12 28 19 (.«传送带» .«右» .«左»),
          «摆» 13 27 19 (.«传送带» .«右» .«左»)].mapM id
  | 2 => [«摆» 21 30 20 (.«传送带» .«上» .«下»), «摆» 22 30 21 (.«传送带» .«上» .«下»),
          «摆» 23 30 22 (.«传送带» .«上» .«下»)].mapM id
  | _ => [«摆» 31 31 19 (.«传送带» .«左» .«右»), «摆» 32 32 19 (.«传送带» .«左» .«右»),
          «摆» 33 33 19 (.«传送带» .«左» .«右»)].mapM id

/-- 回放：货源箱 A（1）出口正对的那格直接放物品准入口 5 当阀门，一格带 6 进分流器 40；
三个收货箱：左 61、下 62、右 63。照 `摆法` 摆三条出口带（含改动），然后一件一件放行两件，
给出头一件、第二件各进了哪个箱子（1 左、2 下、3 右；0 是没进箱）。 -/
def «头两件» («摆法» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态») : Option (Nat × Nat) := do
  let s ← ([«摆» 1 29 14 (.«协议储存箱» .«下»), «摆» 61 24 18 (.«协议储存箱» .«左»),
            «摆» 62 29 23 (.«协议储存箱» .«下»), «摆» 63 34 18 (.«协议储存箱» .«右»),
            «摆» 5 30 17 (.«物品准入口» .«下»), «摆» 6 30 18 (.«传送带» .«上» .«下»),
            «摆» 40 30 19 (.«分流器» .«上»)].mapM id).bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 5 (some .«蓝铁矿») (some 1) (some 0)))
  let s ← «摆法» s
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 50))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let «哪个» (t : Endfield.«格子».«状态») (old : List Nat) : Nat :=
    let now := [61, 62, 63].map fun u => «箱里几件» t.«模型» u .«蓝铁矿»
    match (now.zip old).zipIdx.find? (fun p => p.1.1 > p.1.2) with
    | some p => p.2 + 1
    | none => 0
  let s ← «做» s (.«原样» (.«设准入口» 5 (some .«蓝铁矿») (some 1) none))
  let s := «等» 100 s
  let a := «哪个» s [0, 0, 0]
  let c1 := [61, 62, 63].map fun u => «箱里几件» s.«模型» u .«蓝铁矿»
  let s ← «做» s (.«原样» (.«重置计数» 5))
  let s := «等» 100 s
  return (a, «哪个» s c1)

/-- 回放：照 `序` 拉三条出口带，再做 `改`。 -/
def «拉出口» («序» : List Nat) («改» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态»)
    (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := do
  let s ← «序».foldlM (fun s k => do «建一串» s (← «出口带三条» k)) s
  «改» s

-- 对得上的：
-- S1、S2 对照：头一件走第 2 条接通的出口，第二件走第 3 条。
#guard «头两件» («拉出口» [1, 2, 3] «不改») == some (2, 3)
#guard «头两件» («拉出口» [2, 3, 1] «不改») == some (3, 1)
-- S4：O1 贴着分流器的那格收掉重拉，S 到 O1 的通道是新的，先后变成 O2、O3、O1。
#guard «头两件» («拉出口» [1, 2, 3] («收掉重拉» [(11, 29, 19, .«右», .«左»)])) == some (3, 1)

-- 对不上的（游戏里被改的那条带排到最后；模型里改的不是贴着 S 的那格，S 到它的通道不动）：
-- S3：O1 最后一格收掉重拉。游戏里头两件是右、左（3、1）；S5 最后一格换准入口、S6 中间那格换准入口也是右、左。
#guard «头两件» («拉出口» [1, 2, 3] («收掉重拉» [(13, 27, 19, .«右», .«左»)])) == some (2, 3)
#guard «头两件» («拉出口» [1, 2, 3] («换准入口» 71 27 19 .«左»)) == some (2, 3)
#guard «头两件» («拉出口» [1, 2, 3] («换准入口» 72 28 19 .«左»)) == some (2, 3)
-- S11：O2 最后一格收掉重拉。游戏里是右、下（3、2）；S14 O2 中间那格换准入口也是右、下。
#guard «头两件» («拉出口» [1, 2, 3] («收掉重拉» [(23, 30, 22, .«上», .«下»)])) == some (2, 3)
#guard «头两件» («拉出口» [1, 2, 3] («换准入口» 73 30 21 .«下»)) == some (2, 3)
-- S8：O1 先只拉头两格（不到箱子），拉完 O2、O3 再补上最后一格。游戏里是右、左（3、1）。
#guard «头两件» (fun s => do
  let s ← «建一串» s ((← «出口带三条» 1).take 2)
  let s ← «建一串» s (← «出口带三条» 2)
  let s ← «建一串» s (← «出口带三条» 3)
  «建一串» s ((← «出口带三条» 1).drop 2)) == some (2, 3)
-- S12：O3 最后一格收掉重拉。O3 本来就排最后，游戏里和模型里都是下、右。
#guard «头两件» («拉出口» [1, 2, 3] («收掉重拉» [(33, 33, 19, .«左», .«右»)])) == some (2, 3)

end Endfield.«回放».«改带子以后的先后»
