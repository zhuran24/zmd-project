import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理的《实测-2026-11-26》第十节「相位尺」、
第十一节「看到的四」、第十二节「看到的二、四」，以及《实测-2026-11-25》
「每件隔 9 步的货流过精炼炉、穿过协议储存箱」。核对制造以后，箱里的货在整秒上怎样变化。

11-26 的货源箱都先接一格带和一个准入口。第十节再接一格带、粉碎机、两格带和无线传输箱。
游戏用碳块做两件碳粉末，模型用荞花做两件荞花粉末。第十一节改用蓝铁矿，过四格带、
精炼炉和两格带进无线传输箱。第十二节从准入口起依次过一格带、精炼炉、四格带、粉碎机、
两格带、精炼炉。点重置的线末尾是一格带、限速准入口、仓储箱；少做一台就把那台换成三格带。
读无线传输的线末尾是两格带、传输箱。各段照实测的格数搭，包括第一台炉子后面的拐弯。

游戏挪传输箱的钟，回放让传输箱先走，再选开准入口的整秒。只用首读对齐起点，
传输晚一秒相当于开闸早四步。每档稳下来后读一轮十个整秒。精炼炉和三台串联都只实读了部分档，
十档齐全的两条核对另标为模型预计。点重置时游戏读的是两件进箱的秒数。后准入口收货、收货箱进货的步号另列为模型预计。

11-25 用放蓝铁矿的货源箱接分流器，先轮到的右支紧贴只收源矿的准入口。下支经桥接器和带进
精炼炉，左下出口接一格带、准入口、仓储箱。每种上限从首件新货对时，首次读到的相对时刻取最近的整秒。上限 2 开头的两件余货
不计入间隔。上限 3 的第 13、14 件首次读到是首件后 39.63、41.77 秒，模型算得 39、41 秒；
第 15 件又对上了（实读 44.17 秒）。这两次变化前最后一帧的时刻不详，回放只比其余件。
-/

namespace Endfield.«回放».«制造单位晚一步»

open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 回放：一格传送带，编号照位置取。 -/
private def «带» (x y : Nat) («进» «出» : «朝向») :=
  «摆» (1000 + 70 * x + y) x y (.«传送带» «进» «出»)

/-- 回放：从上往下走的一格带。 -/
private def «竖带» (x y : Nat) := «带» x y .«上» .«下»
/-- 回放：从左往右走的一格带。 -/
private def «横带» (x y : Nat) := «带» x y .«左» .«右»

/-- 回放：各条线共用的开头：货源箱 1、一格带、物品准入口 30、一格带。 -/
private def «开头» (x : Nat) := [«摆» 1 (x - 1) 13 (.«协议储存箱» .«下»),
  «竖带» x 16, «摆» 30 x 17 (.«物品准入口» .«下»), «竖带» x 18]

/-- 回放：第十节的线：开头、粉碎机 50、两格带、无线传输的箱子 60、供电桩。 -/
private def «粉碎线» :=
  («开头» 30 ++ [«摆» 50 29 19 (.«制造» .«粉碎机» .«下»), «竖带» 30 22, «竖带» 30 23,
    «摆» 60 29 24 (.«协议储存箱» .«下»), «摆» 99 33 22 .«供电桩»]).mapM id

/-- 回放：第十一节「看到的四」的线：开头、三格带、精炼炉 50、拐弯的两格带、无线传输的箱子 60、供电桩。 -/
private def «精炼线» :=
  («开头» 27 ++ ([19, 20, 21].map («竖带» 27)) ++ [«摆» 50 26 22 (.«制造» .«精炼炉» .«下»),
    «带» 26 25 .«上» .«左», «带» 25 25 .«右» .«左», «摆» 60 22 24 (.«协议储存箱» .«左»),
    «摆» 99 24 21 .«供电桩»]).mapM id

/-- 回放：第十二节的线：开头、精炼炉、四格带、粉碎机、两格带、精炼炉（少做一台就把那台换成三格带），
末尾是一格带加限速的物品准入口 45 和仓储箱 60（点重置那一组），或者两格带加无线传输的箱子 60（`传输` 为真）。 -/
private def «串联线» («台数» : Nat) («传输» : Bool) :=
  let «机位» («序号» x : Nat) («机» : «制造单位») :=
    if «序号» ≤ «台数» then [«摆» (50 + «序号») (x - 1) 22 (.«制造» «机» .«右»)]
    else [x - 1, x, x + 1].map fun i => «横带» i 23
  («开头» 24 ++ [«摆» 51 23 19 (.«制造» .«精炼炉» .«下»), «竖带» 24 22,
    «带» 24 23 .«上» .«右», «横带» 25 23, «横带» 26 23] ++ «机位» 2 28 .«粉碎机» ++
    [«横带» 30 23, «横带» 31 23] ++ «机位» 3 33 .«精炼炉» ++ [«横带» 35 23,
    if «传输» then «横带» 36 23 else «摆» 45 36 23 (.«物品准入口» .«右»),
    «摆» 60 37 22 (.«协议储存箱» .«右»), «摆» 97 27 20 .«供电桩», «摆» 98 32 20 .«供电桩»] ++
    (if «传输» then [«摆» 99 36 20 .«供电桩»] else [])).mapM id

/-- 回放：每隔指定步数读一次。场地不变，各次走步共用判定表。 -/
private def «读数» (s : Endfield.«格子».«状态») («间隔» «次数» : Nat) («读» : Endfield.«状态» → Nat) :=
  let «走到» := «走» «取一种» (s.«场地».«待写» «端口先后» «无效口») s.«模型».«历史».«立表»
  ((List.range «次数»).foldl (fun (p : Endfield.«状态» × List Nat) _ =>
    let t := «走到» «间隔» p.1
    (t, «读» t :: p.2)) (s.«模型», [])).2.reverse

/-- 回放：传输箱先开始走冷却，过 80、76、……、44 步再把准入口 30 设成每 5 tick 1 件，十档各稳下来以后每秒读一次箱里的件数，读 10 秒。 -/
private def «十档» («线» : Option (List «摆件»)) («原料» «产物» : «物品») : Option (List (List Nat)) := do
  let s ← «线».bind «布置»
  let s ← «依次» s [.«原样» (.«设准入口» 30 (some «原料») (some 5000) (some 0)),
    .«原样» (.«设储存箱模式» 60 false), .«原样» (.«放货» 1 «原料» 50)]
  (List.range 10).mapM fun «档» => do
    let t ← «做» («等» (80 - 4 * «档») s) (.«原样» (.«设准入口» 30 (some «原料») (some 5000) (some 1)))
    return «读数» («等» 200 t) 4 10 (fun m => «箱里几件» m 60 «产物»)

/-- 回放：只选一次起点，此后按累计挪动的秒数沿同一方向取档。 -/
private def «对档» [BEq α] («档» : List α) («挪» : List Nat) («实读» : List α) : Bool :=
  (List.range 10).any fun i => («挪».mapM fun n => «档»[(i + n) % 10]?) == some «实读»

/-- 回放：粉碎线十档，每档里箱内 0、1、2 件各几秒。 -/
private def «粉碎十档» := («十档» «粉碎线» .«荞花» .«荞花粉末»).map fun ls =>
  ls.map fun l => (l.count 0, l.count 1, l.count 2)

-- 第十节：每轮空箱、1 件、2 件各几秒。末两次是回到首档、次档。
#guard «粉碎十档».any fun «档» => «对档» «档» (List.range 12)
  [(3, 2, 5), (2, 2, 6), (1, 2, 7), (2, 8, 0), (1, 8, 1), (8, 2, 0), (7, 2, 1), (6, 2, 2), (5, 2, 3), (4, 2, 4), (3, 2, 5), (2, 2, 6)]

/-- 回放：十档里每档箱里看得到货的秒数。 -/
private def «可见秒数» («线» : Option (List «摆件»)) :=
  («十档» «线» .«蓝铁矿» .«蓝铁块»).map fun ls => ls.map fun l => l.countP (· > 0)

/-- 回放：精炼线的十档。 -/
private def «炉十档» := «可见秒数» «精炼线»
/-- 回放：三台串联接无线传输箱的十档。 -/
private def «三台十档» := «可见秒数» («串联线» 3 true)

-- 第十一节「看到的四」，两遍各自对齐首档。
#guard «炉十档».any fun «档» => «对档» «档» [0, 5, 6, 7, 8] [3, 8, 9, 0, 1]
#guard «炉十档».any fun «档» => «对档» «档» [0, 3, 4, 5, 6] [5, 8, 9, 0, 1]
-- 模型预计：同一条线的全部十档。
#guard «炉十档».map (·.mergeSort) == some (List.range 10)

-- 第十二节「看到的四」。第一次以后传输挪晚 2 秒，断货补货后到货从 x0 提早到 x9，
-- 两个钟合起来相差 3 秒。断货时那次没有有效读数。
#guard «三台十档».any fun «档» => «对档» «档» [0, 2 + 1, 4, 5, 6] [6, 9, 0, 1, 2]
-- 模型预计：三台串联的全部十档。
#guard «三台十档».map (·.mergeSort) == some (List.range 10)

/-- 回放：最后一台出来的是什么：两台时末台是粉碎机，出蓝铁粉末；一台、三台时是精炼炉，出蓝铁块。 -/
private def «末台产物» («台数» : Nat) : «物品» :=
  if «台数» == 2 then .«蓝铁粉末» else .«蓝铁块»

/-- 回放：准入口 30 设累计上限 2、不限速，45 设每 5 tick 1 件，放货以后等 240 步（头两件早已过完），再点一次重置计数。 -/
private def «重置后» («台数» : Nat) : Option Endfield.«格子».«状态» := do
  let s ← («串联线» «台数» false).bind «布置»
  let «货» := «末台产物» «台数»
  let s ← «依次» s [.«原样» (.«设准入口» 30 (some .«蓝铁矿») (some 2) none),
    .«原样» (.«设准入口» 45 (some «货») none (some 1)), .«原样» (.«放货» 1 .«蓝铁矿» 50)]
  «做» («等» 240 s) (.«原样» (.«重置计数» 30))

/-- 回放：第一次采样记为 1，以后每次读数增加就记下序号。 -/
private def «增加时刻» («原数» : Nat) («样本» : List Nat) :=
  ((«样本».zip («原数» :: «样本»)).zipIdx.filter fun ((a, b), _) => a > b).map fun (_, i) => i + 1

/-- 回放：点重置以后每秒读一次收货箱，两件各在第几次读数时进的箱。 -/
private def «进箱秒数» («台数» : Nat) : Option (List Nat) := do
  let s ← «重置后» «台数»
  let «货» := «末台产物» «台数»
  return «增加时刻» («箱货» s 60 «货») («读数» s 4 55 fun m => «箱里几件» m 60 «货»)

/-- 回放：点重置放的两件进箱隔几秒。 -/
private def «两件相隔» («台数» : Nat) : Option Nat := do
  let [a, b] ← «进箱秒数» «台数» | none
  return b - a

-- 第十二节「看到的二」：一、二、三台的整秒间隔。三台头批第二次读到 9.04 秒，重做十二次均为 10 秒。
#guard [1, 2, 3].mapM «两件相隔» == some [9, 9, 10]
-- 同节三台重做，以第一个准入口面板数字变成 1 的整秒 F（重置后第一个整秒）为零点。
#guard («进箱秒数» 3).map (List.map (· - 1)) == some [26, 36]

/-- 回放：三台串联，点重置以后两件各在第几步进后面那个准入口、第几步进收货箱。 -/
private def «三台步号» := do
  let s ← «重置后» 3
  let «进门» := fun m => if «格里» m 45 == some «物品».«蓝铁块» then 1 else 0
  let «进箱» := fun m => «箱里几件» m 60 .«蓝铁块»
  return («增加时刻» («进门» s.«模型») («读数» s 1 160 «进门»),
    «增加时刻» («进箱» s.«模型») («读数» s 1 160 «进箱»))

-- 第十二节的模型预计：实线路比预计脚本多四格带（32 步）。进后准入口以后还要走 8 步才进箱。
#guard «三台步号» == some ([100, 140], [108, 148])

/-- 回放：11-25 的线：货源箱 0 出满带进分流器 2，先轮到的右支紧贴只放行源矿的准入口 31（挡住），下支经桥接器和带进精炼炉 5，
炉子的出口接一格带、物品准入口 52、仓储箱 7。 -/
private def «九步货流» : Option (List «摆件») :=
  let base := [«摆» 0 26 13 (.«协议储存箱» .«下»), «摆» 5 26 22 (.«制造» .«精炼炉» .«下»),
    «摆» 6 31 16 (.«协议储存箱» .«右»), «摆» 7 22 24 (.«协议储存箱» .«左»),
    «摆» 2 27 17 (.«分流器» .«上»), «摆» 1 27 16 (.«传送带» .«上» .«下»)]
  let clear := [«摆» 20 27 19 (.«桥接器» .«上»), «摆» 10 27 18 (.«传送带» .«上» .«下»),
    «摆» 41 27 20 (.«传送带» .«上» .«下»), «摆» 42 27 21 (.«传送带» .«上» .«下»)]
  let blocked := [«摆» 30 28 17 (.«传送带» .«左» .«右»), «摆» 33 29 17 (.«传送带» .«左» .«右»),
    «摆» 32 30 17 (.«传送带» .«左» .«右»), «摆» 31 28 17 (.«物品准入口» .«右»)]
  let outb := [«摆» 51 26 25 (.«传送带» .«上» .«左»), «摆» 52 25 25 (.«物品准入口» .«左»)]
  (base ++ blocked ++ clear ++ outb ++ [«摆» 99 30 22 .«供电桩»]).mapM id

/-- 回放：准入口 52 设成给定的每 5 tick 上限，各件蓝铁块进箱的秒数（头一件记 0）。 -/
private def «各件进箱» («上限» : Option Nat) («件数» : Nat) : Option (List Nat) := do
  let s ← «九步货流».bind «布置»
  let s ← «依次» s [.«原样» (.«设准入口» 31 (some .«源矿») none none),
    .«原样» (.«设准入口» 52 (some .«蓝铁块») none «上限»), .«原样» (.«放货» 0 .«蓝铁矿» 50)]
  let «秒数» := («增加时刻» 0 («读数» s 4 80 fun m => «箱里几件» m 7 .«蓝铁块»)).take «件数»
  let «首件» ← «秒数».head?
  return «秒数».map (· - «首件»)

-- 11-25 过精炼炉。按记录的四行依次比对；上限 3 的第 13、14 件留空，上限 2 是对照行。
#guard (do
  let «不限» ← «各件进箱» none 15
  let «四» ← «各件进箱» (some 4) 20
  let «三» ← «各件进箱» (some 3) 15
  let «二» ← «各件进箱» (some 2) 10
  return [«不限», «四», «三».take 12 ++ «三».drop 14, «二»]) == some
    [[0, 2, 4, 7, 9, 11, 13, 16, 18, 20, 22, 25, 27, 29, 31],
     [0, 2, 4, 7, 9, 11, 14, 16, 19, 21, 24, 26, 29, 31, 34, 36, 39, 41, 44, 46],
     [0, 2, 4, 9, 11, 14, 19, 21, 24, 29, 31, 34, 44],
     [0, 2, 9, 11, 19, 21, 29, 31, 39, 41]]

end Endfield.«回放».«制造单位晚一步»
