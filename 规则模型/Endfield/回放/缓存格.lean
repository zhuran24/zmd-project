/-- 回放：放行 1 件源矿、等、放行 1 件蓝铁块、等（`荞花` 为真时再放行 1 件荞花、等），
然后把 Gi 改成放行源石粉末，再等到货都进了 Q。`k` 是每次多等的步数。 -/
def «放行» (k : Nat) («荞花» : Bool) : List «一幕» :=
  [.«做» (.«设准入口» 11 (some .«源矿») (some 1) none), .«等» (60 + k),
   .«做» (.«设准入口» 14 (some .«蓝铁块») (some 1) none), .«等» (60 + 3 * k)]
  ++ (if «荞花» then [.«做» (.«设准入口» 17 (some .«荞花») (some 1) none), .«等» (60 + 5 * k)] else [])
  ++ [.«做» (.«设准入口» 20 (some .«源石粉末») none none), .«等» (120 + k)]

/-- 回放：把出口那边的摆法 `出口` 接在原料和 M 后面演一遍，给出 Q 的六个物品格依次放着什么。 -/
def «演一遍» («出口» : List «一幕») («荞花» : Bool) (k : Nat) : Option (List («物品» × Nat)) :=
  («演» «状态».«空» («原料和M» ++ «出口» ++ «放行» k «荞花»)).map fun s => «箱里依次» s 30

/-- 回放：8 种间隔下演出来的结果都是 `想`。 -/
def «都是» («出口» : List «一幕») («荞花» : Bool) («想» : List («物品» × Nat)) : Bool :=
  (List.range 8).all fun k => «演一遍» «出口» «荞花» k == some «想»

/-- 回放：放行以前要成立的状态：取货物品格里 1 件源石粉末，缓存格里 1 件蓝铁粉末，没在制造。 -/
def «卡住了» («出口» : List «一幕») : Bool :=
  match «演» «状态».«空» («原料和M» ++ «出口» ++
      [.«做» (.«设准入口» 11 (some .«源矿») (some 1) none), .«等» 60,
       .«做» (.«设准入口» 14 (some .«蓝铁块») (some 1) none), .«等» 60]) with
  | some s =>
    s.«货» ⟨3, .«取货»⟩ == [⟨.«源石粉末», 1⟩] && s.«货» ⟨3, .«缓存»⟩ == [⟨.«蓝铁粉末», 1⟩]
      && (s.«制造中» 3).isNone
  | none => false

