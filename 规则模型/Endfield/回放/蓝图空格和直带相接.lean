import Endfield.«回放».«格子工具»

/-!
# 回放：蓝图的空格和两张蓝图相接的直带

据：实测-2026-11-27.md 第九节第 280、284、286 行，走货另见第二节第 55、64 行。
坐标沿用游戏格，向右、向下递增。箱子写占地左上角，钢块代碳块。一秒取四步。
-/

namespace Endfield.«回放».«蓝图空格和直带相接»
open Endfield.«格子» Endfield.«回放».«格子»

/-- 回放：先放 (33,14) 的分流器，再在 (29,13) 放摆法一的蓝图。 -/
private def «空格盖住分流器» := do
  let old ← «摆» 20 33 14 (.«分流器» .«上»)
  let s ← «布置» [old]
  let ps ← [«摆» 1 29 13 (.«协议储存箱» .«下»), «摆» 2 30 16 (.«物品准入口» .«下»),
    «摆» 3 30 18 (.«分流器» .«上»), «摆» 4 30 19 (.«物品准入口» .«下»),
    «摆» 5 29 20 (.«协议储存箱» .«下»), «摆» 6 32 20 (.«协议储存箱» .«下»),
    «摆» 7 30 17 (.«传送带» .«上» .«下»), «摆» 8 31 18 (.«传送带» .«左» .«右»),
    «摆» 9 32 18 (.«传送带» .«左» .«右»), «摆» 10 33 18 (.«传送带» .«左» .«下»),
    «摆» 11 33 19 (.«传送带» .«上» .«下»)].mapM id
  let s ← «做» s (.«蓝图» ps)
  let kept := s.«场地».contains old
  -- 蓝图摆件表只记种类。放货前补上落地时的准入口设定，箱子维持无线模式，没有供电桩。
  let s ← «依次» s [.«原样» (.«设准入口» 4 (some .«钢块») none none),
    .«原样» (.«设准入口» 2 (some .«钢块») (some 1) none), .«原样» (.«放货» 1 .«钢块» 50)]
  let a := «等» 64 s
  let b := «等» 64 (← «做» a (.«原样» (.«重置计数» 2)))
  let c := «等» 64 (← «做» b (.«原样» (.«重置计数» 2)))
  return (kept, [a,b,c].map («三箱» [5,6] .«钢块»), (← «做» c (.«收» 20)).«场地».contains old)

-- 第 280、64 行：蓝图放后第 0 步原件还在；每次放行后按脚本等 16 秒；收场能收走原件。
#guard «空格盖住分流器» == some (true, [[0,1], [1,1], [1,2]], false)

/-- 回放：把同一张向右的三格直带放在指定的起点；每格取横坐标作摆件号。 -/
private def «放三格直带» (s : Endfield.«格子».«状态») (i : Nat) := do
  let ps ← (List.range 3).mapM fun n => «摆» (i+n) (i+n) 14 (.«传送带» .«左» .«右»)
  «做» s (.«蓝图» ps)

/-- 回放：先建两个仓储箱，按调用记录第 350 行的两个落点放带，放一组货。 -/
private def «接好的两份» := do
  let ps ← [«摆» 1 22 13 (.«协议储存箱» .«右»), «摆» 2 31 13 (.«协议储存箱» .«右»)].mapM id
  let s ← «放三格直带» (← «布置» ps) 25
  let s ← «放三格直带» s 28
  «做» s (.«原样» (.«放货» 1 .«钢块» 50))

/-- 回放：同一轮面板每秒刷新一次，四次读数都取各自读屏前最后一次刷新。
以 06:27:00 为零，按记录的百分之一秒枚举刷新相位和调用 352 内可能的放货时刻。 -/
private def «两次读箱» := do
  let s ← «接好的两份»
  let (_, rows) := «逐步读» s 352 fun m => («箱里几件» m 1 .«钢块», «箱里几件» m 2 .«钢块»)
  let rows := rows.toArray
  -- 调用 352 为 21.90–33.88 秒，353、354 分别在 50.79、52.71、107.35、109.23 秒采样。
  return (List.range 100).any fun phase =>
    let refresh (readAt : Nat) := (readAt - phase) / 100 * 100 + phase
    (List.range (3388 - 2190 + 1)).any fun offset =>
      let step (readAt : Nat) := (refresh readAt - (2190 + offset)) / 25
      rows[step 5079]?.map Prod.fst == some 40 && rows[step 5271]?.map Prod.snd == some 5 &&
      rows[step 10735]?.map Prod.fst == some 12 && rows[step 10923]?.map Prod.snd == some 33

-- 第 284 行。四次读数用同一个放货时刻和刷新相位，例如 06:27:30.50 放货、每秒 .50 刷新。
#guard «两次读箱» == some true

/-- 回放：对照第 286 行。从第一份的 (26,14) 沿相接的带找两端，再核单格收回的占地变化。
这里只读几何，省去读箱后清两箱的等待；走步、清箱均不改场地。 -/
private def «收一格以后» := do
  let s ← «接好的两份»
  let q ← s.«场地».attach.find? fun (p : {p // p ∈ s.«场地»}) => p.val.«号» == 26
  let first ← s.«场地».«带端格» false s.«场地».length q
  let last ← s.«场地».«带端格» true s.«场地».length q
  let t ← «做» s (.«收» 26)
  let remaining := t.«场地».filterMap fun (p : «摆件») =>
    if p.«是传送带» then some p.«位置».i.val else none
  return (first.val.«位置».i.val, last.val.«位置».i.val, remaining)

-- 模型值。游戏工具默认收整条。调用 357 收 (26,14)，358 在 (29,14) 打不开面板，360 确认该格已空。
#guard «收一格以后» == some (25, 30, [25,27,28,29,30])

end Endfield.«回放».«蓝图空格和直带相接»
