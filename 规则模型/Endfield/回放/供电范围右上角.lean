import Endfield.«回放».«格子工具»

/-!
据：实测-2026-11-27.md 第五节，第 144–154 行。坐标取占地左上格，向右、向下递增。
供电桩占 (24,24)–(25,25)。每次收掉上一台再放下一台，故每次只需考察桩与当次单位。
准星未旋转，协议储存箱是无线传输模式。这里只读供电几何，摆好即可判定，无需走步。
-/

namespace Endfield.«回放».«供电范围右上角»

open Endfield.«格子» Endfield.«回放».«格子»

/-- 回放：从实际占格筛出落在桩范围里的格，并读取同一场地对该单位的供电判定。 -/
private def «读供电» (i j : Nat) (k : «摆件种类») : Option (List (Nat × Nat) × Bool) := do
  let p ← «摆» 0 24 24 .«供电桩»
  let m ← «摆» 1 i j k
  let cs ← m.«占格»
  return ((cs.filter («供电范围» p)).map (fun c => (c.i.val, c.j.val)), «场地».«有电» [p,m] 1)

-- 第 148–151 行：精炼炉、采种机、封装机空闲，箱子运行；唯一通电的角格为 (30,19)。
#guard «读供电» 30 17 (.«制造» .«精炼炉» .«下») == some ([(30,19)], true)
#guard «读供电» 30 17 (.«协议储存箱» .«下») == some ([(30,19)], true)
#guard «读供电» 30 15 (.«制造» .«采种机» .«下») == some ([(30,19)], true)
#guard «读供电» 30 16 (.«制造» .«封装机» .«下») == some ([(30,19)], true)
-- 第 152 行：向右、向上各挪一格的精炼炉未通电。
#guard «读供电» 31 16 (.«制造» .«精炼炉» .«下») == some ([], false)

end Endfield.«回放».«供电范围右上角»
