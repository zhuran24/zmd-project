import Endfield.«回放».«格子边界»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-10-08.md，三节均已读。
这里核对任务书的五项，即原记录第二节及第三节的同时接通实验。
第一节的碳块、源矿、电池秒表实验不在这五项中，没有冒充复现它。

所有摆件都有屏幕坐标；不手写接通事件，不直接塞货进状态。
观察窗、未记录的带长在各布局注释中给出；它们用于核对先后与独占，不是原记录的实测件数。
格子层照规则字面生成端口先后。下面 #guard 同时核对生成的接通表与走步结果。
-/

namespace Endfield.«回放».«格子»

open Endfield.«格子»

/-- 回放：汇流器朝下，中心 (30,30)；左右上三源箱分别在 (25,29)、(29,25)、(33,29)。
每路仅一格进货带，分流器贴汇流器；出货也一格带，收货箱在 (29,32)。
源箱号 1/2/3、进货带 4/5/6、分流器 7/8/9；三路编号按左、上、右。
先建箱、带和分流器，再建汇流器 10，最后建出货带 11，符合原记录。
`order` 只改变分流器施工顺序；整个布局再转 n 次，分别测试下、左、右朝向。 -/
def «汇流布局» (n : Nat) (order : List Nat) : Option (List «摆件») := do
  let boxes ← [«摆» 1 25 29 (.«协议储存箱» .«右»), «摆» 2 29 25 (.«协议储存箱» .«下»),
    «摆» 3 33 29 (.«协议储存箱» .«左»), «摆» 20 29 32 (.«协议储存箱» .«下»)].mapM id
  let belts ← [«摆» 4 28 30 (.«传送带» .«左» .«右»), «摆» 5 30 28 (.«传送带» .«上» .«下»),
    «摆» 6 32 30 (.«传送带» .«右» .«左»)].mapM id
  let splits ← [«摆» 7 29 30 (.«分流器» .«左»), «摆» 8 30 29 (.«分流器» .«上»),
    «摆» 9 31 30 (.«分流器» .«右»)].mapM id
  let ordered ← order.mapM fun u => splits.find? (·.«号» == u)
  let target ← «摆» 10 30 30 (.«汇流器» .«下»)
  let out ← «摆» 11 30 31 (.«传送带» .«上» .«下»)
  «转布局» n (boxes ++ belts ++ ordered ++ [target, out])

/-- 回放：三路货色只作来源标签；原记录第二节没有给物品名。 -/
def «来源货» : List (Nat × «物品») := [(1, .«蓝铁矿»), (2, .«源矿»), (3, .«荞花种子»)]

/-- 回放：汇流器三个朝向、每朝向两种放置先后均检查。
先走 80 步读数，收走第一源箱剩余货，再等 80 步排空管线，最后观察 80 步。
核对源箱数字和收货箱货色：最初只有第一路进入，稳定窗口只有第二路增加。 -/
def «汇流读数» (n : Nat) (order : List Nat) : Option (List (List Nat) × Bool) := do
  let ps ← «汇流布局» n order
  let s ← «布置» ps
  let s ← «依次» s («来源货».map fun (u,x) => .«原样» (.«放货» u x 50))
  let a := «等» 80 s
  let t ← «做» a (.«原样» (.«收货» ⟨1, .«格» 0⟩))
  let b := «等» 80 t
  let c := «等» 80 b
  let read := fun t => «来源货».map fun (u,x) => «箱货» t u x
  let exclusive := «箱货» a 20 .«蓝铁矿» > 0 && «箱货» a 20 .«源矿» == 0 &&
    «箱货» a 20 .«荞花种子» == 0 && «箱货» c 20 .«源矿» > «箱货» b 20 .«源矿» &&
    «箱货» c 20 .«蓝铁矿» == «箱货» b 20 .«蓝铁矿» &&
    «箱货» c 20 .«荞花种子» == «箱货» b 20 .«荞花种子»
  return ([read a, read b, read c], exclusive)

/-- 回放：最后建成目标时形成的通道，几何计算必须与原手排回放一致。 -/
def «目标接通» (ps : List «摆件») : Option (List «通道») := do
  let target ← ps.find? (·.«号» == 10)
  let before := ps.takeWhile (·.«号» != 10)
  let (_, es) ← «场地».«建» before «端口先后» target
  return «接通表» es

-- 清空用收货操作；读数和不带位置的那份回放（`同时接通的先后.lean`）一样。
-- 第1项：0/1/3次顺时针旋转，对应朝下的左上右、朝左的上右下、朝右的下左上。
#guard [0,1,3].all (fun n => [if n == 1 then [8,9,7] else [9,8,7], [7,9,8]].all fun order =>
  («汇流布局» n order).bind «目标接通» == some [⟨7,10⟩, ⟨8,10⟩, ⟨9,10⟩])
#guard [0,1,3].all (fun n => [if n == 1 then [8,9,7] else [9,8,7], [7,9,8]].all fun order =>
  «汇流读数» n order == some ([[40,48,48], [0,40,48], [0,30,48]], true))

/-- 回放：分流器中心 (30,30)，上边进货；源箱 (29,26) 经一格带到目标。
左、下、右三出口各一格带接独立收货箱，号 20/21/22 分别对应屏幕左、下、右。
箱子和全部带先放，分流器 10 最后放，端口同时接通。 -/
def «分流布局» : Option (List «摆件») :=
  [«摆» 0 29 26 (.«协议储存箱» .«下»),
   «摆» 20 26 29 (.«协议储存箱» .«左»), «摆» 21 29 32 (.«协议储存箱» .«下»),
   «摆» 22 32 29 (.«协议储存箱» .«右»),
   «摆» 1 30 29 (.«传送带» .«上» .«下»),
   «摆» 11 29 30 (.«传送带» .«右» .«左»), «摆» 12 30 31 (.«传送带» .«上» .«下»),
   «摆» 13 31 30 (.«传送带» .«左» .«右»),
   «摆» 10 30 30 (.«分流器» .«上»)].mapM id

/-- 回放：箱子或精炼炉放 (30,30)，上进下出；源箱 (30,26) 经一格带到目标。
三个出口外先有带，左路两格带向左拐接箱 (26,32)，中路一格带接箱 (30,34)，
右路两格带向右拐接箱 (34,32)，防止三只 3×3 箱重叠。供电桩 (35,28)。
所有带及箱、供电桩先放，目标 10 最后放。转两次为箱子上出货的实验。 -/
def «同边出口布局» (k : «摆件种类») (n : Nat) : Option (List «摆件») := do
  let ps ← [«摆» 0 30 26 (.«协议储存箱» .«下»),
    «摆» 20 26 32 (.«协议储存箱» .«左»), «摆» 21 30 34 (.«协议储存箱» .«下»),
    «摆» 22 34 32 (.«协议储存箱» .«右»), «摆» 99 35 28 .«供电桩»,
    «摆» 1 31 29 (.«传送带» .«上» .«下»),
    «摆» 11 30 33 (.«传送带» .«上» .«左»), «摆» 14 29 33 (.«传送带» .«右» .«左»),
    «摆» 12 31 33 (.«传送带» .«上» .«下»),
    «摆» 13 32 33 (.«传送带» .«上» .«右»), «摆» 15 33 33 (.«传送带» .«左» .«右»),
    «摆» 10 30 30 k].mapM id
  «转布局» n ps

/-- 回放：逐件放入源箱、每件等 80 步读三只收货箱。
炉放蓝铁矿、读蓝铁块，其余放和读源矿；均通过真实放货操作。 -/
def «逐件出口» (ps : List «摆件») (us : List Nat) (x y : «物品») : Option (List (List Nat)) := do
  let s ← «布置» ps
  let a ← «做» s (.«原样» (.«放货» 0 x 1))
  let a := «等» 80 a
  let b ← «做» a (.«原样» (.«放货» 0 x 1))
  let b := «等» 80 b
  let c ← «做» b (.«原样» (.«放货» 0 x 1))
  let c := «等» 80 c
  return [«三箱» us y a, «三箱» us y b, «三箱» us y c]

-- 第2项：生成先后先进口、后右下左，元件轮询首轮因此为下左右。
#guard «分流布局».bind «目标接通» == some [⟨1,10⟩, ⟨10,13⟩, ⟨10,12⟩, ⟨10,11⟩]
#guard («分流布局».bind fun ps => «逐件出口» ps [20,21,22] .«源矿» .«源矿») ==
  some [[0,1,0], [1,1,0], [1,1,1]]

-- 第3项：下出货左中右；转180°后读取屏幕左中右（收货箱号22/21/20），得到右中左。
#guard («同边出口布局» (.«协议储存箱» .«下») 0).bind «目标接通» ==
  some [⟨1,10⟩, ⟨10,11⟩, ⟨10,12⟩, ⟨10,13⟩]
#guard ((«同边出口布局» (.«协议储存箱» .«下») 0).bind fun ps =>
  «逐件出口» ps [20,21,22] .«源矿» .«源矿») == some [[1,0,0], [1,1,0], [1,1,1]]
#guard ((«同边出口布局» (.«协议储存箱» .«下») 2).bind fun ps =>
  «逐件出口» ps [22,21,20] .«源矿» .«源矿») == some [[0,0,1], [0,1,1], [1,1,1]]

-- 第4项：生成的接通顺序左中右，制造单位初次出货轮询是中右左。
#guard («同边出口布局» (.«制造» .«精炼炉» .«下») 0).bind «目标接通» ==
  some [⟨1,10⟩, ⟨10,11⟩, ⟨10,12⟩, ⟨10,13⟩]
#guard ((«同边出口布局» (.«制造» .«精炼炉» .«下») 0).bind fun ps =>
  «逐件出口» ps [20,21,22] .«蓝铁矿» .«蓝铁块») == some [[0,1,0], [0,1,1], [1,1,1]]

/-- 回放：满箱/满炉的三个存货端口贴分流器 (30,29)、(31,29)、(32,29)，均上进货。
左源箱 (26,27)、中源箱 (30,25)、右源箱 (34,27)，两翼各两格带拐弯、中间一格。
三分流器相邻边均为取货端口，互不形成通道。目标 (30,30) 最后放，下游一格带到箱 (30,34)。
供电桩在 (36,31)，炉由真实范围供电。未记载的尺寸如此选取，源箱放50件蓝铁矿。 -/
def «同边进口布局» (k : «摆件种类») : Option (List «摆件») :=
  [«摆» 1 26 27 (.«协议储存箱» .«右»), «摆» 2 30 25 (.«协议储存箱» .«下»),
   «摆» 3 34 27 (.«协议储存箱» .«左»), «摆» 20 30 34 (.«协议储存箱» .«下»),
   «摆» 99 36 31 .«供电桩»,
   «摆» 14 29 28 (.«传送带» .«左» .«右»), «摆» 4 30 28 (.«传送带» .«左» .«下»),
   «摆» 5 31 28 (.«传送带» .«上» .«下»),
   «摆» 16 33 28 (.«传送带» .«右» .«左»), «摆» 6 32 28 (.«传送带» .«右» .«下»),
   «摆» 7 30 29 (.«分流器» .«上»), «摆» 8 31 29 (.«分流器» .«上»),
   «摆» 9 32 29 (.«分流器» .«上»), «摆» 11 31 33 (.«传送带» .«上» .«下»),
   «摆» 10 30 30 k].mapM id

/-- 回放：三列读数 a/b 是暖机80步后再80步，c/d 是清空左源箱后等80步再80步。
比较稳定窗口，避开各路不同带长造成的填管线瞬态。满箱300件、满炉原料50件通过放货装入。
保留四次实际算出的数字，便于查验谁独占；数字本身不冒充实测数量。 -/
def «同边进口读数» (k : «摆件种类») (n : Nat) : Option (List (List Nat)) := do
  let ps ← «同边进口布局» k
  let s ← «布置» ps
  let s ← «做» s (.«原样» (.«放货» 10 .«蓝铁矿» n))
  let s ← «依次» s ([1,2,3].map fun u => .«原样» (.«放货» u .«蓝铁矿» 50))
  let a := «等» 80 s
  let b := «等» 80 a
  let t ← «做» b (.«原样» (.«收货» ⟨1, .«格» 0⟩))
  let c := «等» 80 t
  let d := «等» 80 c
  return [a,b,c,d].map («三箱» [1,2,3] .«蓝铁矿»)

/-- 回放：两个稳定窗口分别只有左源箱减少、只有中源箱减少；右源箱一直不再减少。 -/
def «左后中独占» (rows : List (List Nat)) : Bool :=
  match rows with
  | [[a,b,c], [d,e,f], [g,h,i], [j,k,l]] =>
    d < a && b == e && c == f && g == 0 && j == 0 && k < h && i == l && f == i
  | _ => false

-- 第5项：箱子和炉都由几何得先左中右、后出口，不看三个分流器放置先后。
#guard [«摆件种类».«协议储存箱» .«下», .«制造» .«精炼炉» .«下»].all fun k =>
  («同边进口布局» k).bind «目标接通» == some [⟨7,10⟩, ⟨8,10⟩, ⟨9,10⟩, ⟨10,11⟩]
#guard («同边进口读数» (.«协议储存箱» .«下») 300).map «左后中独占» == some true
#guard («同边进口读数» (.«制造» .«精炼炉» .«下») 50).map «左后中独占» == some true

end Endfield.«回放».«格子»
