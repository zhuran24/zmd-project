import Endfield.«回放».«工具»

/-!
# 现象清单第 12 条：一件绕回的物品卡住分流器两件

来源：求解器/规则修订/2026-10-10-交给GPT/现象.md 第 12 条；更细的记录在
求解器/规则修订/2026-10-08-现象整理/现象.md「汇流器收货 9」（视频 BV1TJQKBxEph，由 JNK 转述）。

来源写的观察：
1. 汇流器 M 下游那段传送带 B 比分流器 S 后放：每有一件绕回的物品进 M，S 就有两件进不去；
2. B 比 S 先放：S 正常分流。

来源只说「S 一个出口进 M，M 下游接传送带，M 另一个入口进的是从下游绕回来的物品」，完整结构只在视频里。
这里的布局是自己定的：货源箱 0 →带 10→ S(1)；S 一个出口紧贴 M(2)，另一个出口经一条旁路进收货箱 20；
M → B(3) → 分流器 T(5)；T 一个出口经带 6、7、8 绕回 M 的另一个入口，另一个出口经带 9 进收货箱 21。
旁路先接上自己的箱子，S 的次序跟旁路走。

照规则，这条现象只在 S 和 M 次序相同时才会随 B、S 的放置先后变：
S 的取货通道那一组、M 通往 B 的那一组，级别先按 S、M 的次序排，次序相同才比组的时刻。
- S 的那一组级别高（B 后放）：每步先判 S，这时 M 里那件绕回的物品还没送出去，S 的货进不了 M，改走旁路；
  下一 tick 轮询又轮到旁路，所以一件绕回的物品让 S 连着两件走旁路。
- M 的那一组级别高（B 先放）：每步 M 先把货送出去，S 的货再进来，S 照常一边一件。

旁路的长短定 S 的次序（M 的次序是 4）：
- `长旁路`：带、桥接器、带，S 的次序是 4，和 M 相同。走出来的和来源的两条观察一样；
- 短旁路：一格带，S 的次序是 2，比 M 小。两种放置先后走出来一样，都是卡两件。这一种是模型照规则给的，来源里没有对应的观察。
-/

namespace Endfield.«回放».«绕回卡两件»

/-- 回放：旁路。S 的另一个出口接带 4；`长旁路` 时再接桥接器 11、带 12；最后进收货箱 20。 -/
def «旁路» («长旁路» : Bool) : List «一幕» :=
  [«建» 4 .«传送带», «连» 1 4] ++
  (if «长旁路» then
    [«建» 11 .«桥接器格», «连» 4 11, «建» 12 .«传送带», «连» 11 12, «建» 20 .«协议储存箱», «连» 12 20]
   else [«建» 20 .«协议储存箱», «连» 4 20]) ++ [«仓储» 20]

/-- 回放：整个布局。M 最先放；`后放` 时先放 S、再放 B，否则先放 B、再放 S；然后是货源、旁路、T、绕回的带子、T 进收货箱的带子。 -/
def «布置» («长旁路» : Bool) («后放» : Bool) : List «一幕» :=
  [«建» 2 .«汇流器»] ++
  (if «后放» then
    [«建» 1 .«分流器», «连» 1 2, «建» 3 .«传送带», «连» 2 3]
   else
    [«建» 3 .«传送带», «连» 2 3, «建» 1 .«分流器», «连» 1 2]) ++
  [«建» 0 .«协议储存箱», «仓储» 0, «建» 10 .«传送带», «连» 0 10, «连» 10 1] ++
  «旁路» «长旁路» ++
  [«建» 5 .«分流器», «连» 3 5,
   «建» 6 .«传送带», «连» 5 6, «建» 7 .«传送带», «连» 6 7, «建» 8 .«传送带», «连» 7 8, «连» 8 2,
   «建» 9 .«传送带», «连» 5 9,
   «建» 21 .«协议储存箱», «连» 9 21, «仓储» 21] ++ «装满» 0 .«源矿»

/-- 回放：S、M 的次序。 -/
def «两个次序» («长旁路» : Bool) («后放» : Bool) : Option (Option Nat × Option Nat) :=
  («演» «状态».«空» («布置» «长旁路» «后放»)).map fun s =>
    (s.«历史».«次序» s.«历史».length 1, s.«历史».«次序» s.«历史».length 2)

/-- 回放：这一步有没有一件货从 a 进了 b（b 里的货是这一步刚到的，来处是 a）。 -/
def «刚经过» (s : «状态») (a b : «单位号») : Bool :=
  «格里» s b == some .«源矿» && s.«已停» ⟨b, .«格» 0⟩ == 1 &&
  s.«来处» ⟨b, .«格» 0⟩ == some ⟨a, .«格» 0⟩

/-- 回放：放货后 256 步，每步记三件事：S 的货进了 M、S 的货进了旁路、绕回的货进了 M。 -/
def «记录» («长旁路» : Bool) («后放» : Bool) : Option (List (Bool × Bool × Bool)) :=
  («演» «状态».«空» («布置» «长旁路» «后放»)).map fun s =>
    «逐次看» (fun s => («刚经过» s 1 2, «刚经过» s 1 4, «刚经过» s 8 2))
      ((List.range 256).map (· + 1)) s

/-- 回放：三样各发生了几次：S 进 M、S 进旁路、绕回的货进 M。 -/
def «通过量» (rows : List (Bool × Bool × Bool)) : Nat × Nat × Nat :=
  (rows.countP (·.1), rows.countP (·.2.1), rows.countP (·.2.2))

/-- 回放：每一件绕回的货进 M 的那一步和下一 tick，S 的货都走旁路、没进 M。 -/
def «回流对应两件» (rows : List (Bool × Bool × Bool)) : Bool :=
  (rows.zipIdx).all fun (r, i) =>
    !r.2.2 || ((!r.1 && r.2.1) &&
      (rows[i + 8]?).any (fun next => !next.1 && next.2.1))

/-- 回放：S 送出的货一件旁路、一件 M 地轮流。 -/
def «正常分流» (rows : List (Bool × Bool × Bool)) : Bool :=
  let sent := rows.filter (fun r => r.1 || r.2.1)
  (sent.zipIdx).all fun (r, i) => r.1 == (i % 2 == 1) && r.2.1 == (i % 2 == 0)

/-- 回放：一种摆法走出来的：三样的次数、是不是正常分流、是不是每件绕回的货都对应两件走旁路。 -/
def «结果» («长旁路» : Bool) («后放» : Bool) : Option ((Nat × Nat × Nat) × Bool × Bool) :=
  («记录» «长旁路» «后放»).map fun rows => («通过量» rows, «正常分流» rows, «回流对应两件» rows)

-- 长旁路：S 和 M 的次序都是 4。
#guard [true, false].all fun b => «两个次序» true b == some (some 4, some 4)
-- 观察 1：B 比 S 后放，每件绕回的货进 M，S 连着两件走旁路（7 件绕回的货，S 进 M 11 件、走旁路 19 件）。
#guard «结果» true true == some ((11, 19, 7), false, true)
-- 观察 2：B 比 S 先放，S 正常分流（进 M 15 件、走旁路 15 件），绕回的货照样进 M（8 件）。
#guard «结果» true false == some ((15, 15, 8), true, false)

-- 短旁路（来源里没有，模型照规则给的）：S 的次序是 2，比 M 小，两种放置先后走出来一样，都是卡两件。
#guard [true, false].all fun b => «两个次序» false b == some (some 2, some 4)
#guard «记录» false false == «记录» false true
#guard «结果» false true == some ((11, 19, 7), false, true)

end Endfield.«回放».«绕回卡两件»
