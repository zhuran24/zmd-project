import Endfield.«回放».«工具»

/-!
# 两个中转箱贴着同一个汇流器（实测-2026-11-10 第二节）

汇流器做输入判定时那一组通道的起点里都没有可移动物品，实测-2026-11-10 第一节以前的实测分不开两种说法：
- `都收`：这一步哪条通道先送来就收哪条；
- `再判一次`：元件的移动判定做完以后、非运输单位的移动判定之前，照那时的货再做一次输入判定。

分得开的情况：两个不积货的箱子同一步都有货要进同一个汇流器。`都收`：先建成的那个中转箱每 tick 都抢到 M，
另一个的货全走自己的带子；`再判一次`：两个中转箱轮流进 M，各有一半货走自己的带子。实测对上 `再判一次`。

这里有两个布局：
- 「紧贴的布局」：M 直接进箱子 Y，中转箱自己那一路是两格带子。游戏里摆不出来（箱子三个出口在同一条边上，
  M 紧贴 Y 时总有一个中转箱剩下的出口全被挡住），留着是因为它最简单。
- 「实测的布局」：M 经 7 格带子进 Y（M 的次序是 2）；中转箱自己那一路是带子、物品准入口、带子（第一格带子的次序是 3），
  这样 M 那一路级别更高，中转箱先试 M。自己那一路要是一段不断的带子（次序 1），货全走自己的带子，四种说法下 Y 都是 0。
-/

namespace Endfield.«回放».«两个中转箱»

/-- 回放：紧贴的布局。货源箱 0（一直有货）的两个出口各接两格带子（1、2 和 3、4）进中转箱 W1（5）、W2（6）；
W1、W2 各有一个出口紧贴汇流器 M（10），M 直接进箱子 Y（22）；各有另一个出口接两格带子（11、12 和 13、14）
进自己的箱子 X1（20）、X2（21），带子比 M 后接上。`W2先建`：两个中转箱里 W2 先建成；`W2先接`：M 的两个进口里 W2 那条先接通。 -/
def «布置» («W2先建» «W2先接» : Bool) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 20 .«协议储存箱», «建» 21 .«协议储存箱», «建» 22 .«协议储存箱»,
   «仓储» 0, «仓储» 20, «仓储» 21, «仓储» 22]
  ++ (if «W2先建» then [«建» 6 .«协议储存箱», «建» 5 .«协议储存箱»]
      else [«建» 5 .«协议储存箱», «建» 6 .«协议储存箱»])
  ++ [«仓储» 5, «仓储» 6, «建» 10 .«汇流器»]
  ++ (if «W2先接» then [«连» 6 10, «连» 5 10] else [«连» 5 10, «连» 6 10]) ++ [«连» 10 22]
  ++ «一串带» 5 [11, 12] ++ [«连» 12 20] ++ «一串带» 6 [13, 14] ++ [«连» 14 21]
  ++ «一串带» 0 [1, 2] ++ [«连» 2 5] ++ «一串带» 0 [3, 4] ++ [«连» 4 6]
  ++ «装满» 0 .«源矿»

/-- 回放：照说法 `v` 走 50 tick 以后 X1、X2、Y 里各有几件。 -/
def «五十拍以后» (v : «都没货时») (a b : Bool) : Option (List Nat) :=
  let un : «未定» := { «取一种» with «输入判定都没货时» := v }
  («演于» un «状态».«空» («布置» a b ++ [.«等» 400])).map fun s =>
    [20, 21, 22].map fun u => «箱里几件» s u .«源矿»

-- 「都收」：先建成的那个中转箱独占 M（它自己的箱子是 0），和 M 的两个进口谁先接通无关。
#guard [false, true].all fun b => «五十拍以后» .«都收» false b == some [0, 46, 47]
#guard [false, true].all fun b => «五十拍以后» .«都收» true b == some [46, 0, 47]
-- 「再判一次」：两个中转箱轮流进 M，X1、X2 各一半，和谁先建成、谁先接通都无关。
#guard [false, true].all fun a => [false, true].all fun b =>
  «五十拍以后» .«再判一次» a b == some [23, 23, 47]

/-- 回放：实测的布局。S=0；S→W1 的带 1–4，S→W2 的带 6–9；W1=30，W2=31；M=40；M→Y 的带 41–47；
W1→X1：带 51、物品准入口 55、带 52；W2→X2：带 53、物品准入口 56、带 54；X1=20，X2=21，Y=22。
放置的先后照实测：四个箱子，W1、W2（`W2先建` 时反过来），M（紧贴的两条通道同时接上，左边 W1 那条在先），
M→Y，W1→X1，W2→X2，两条进货带，最后放满 S。 -/
def «实测的布置» («W2先建» : Bool) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 20 .«协议储存箱», «建» 21 .«协议储存箱», «建» 22 .«协议储存箱»,
   «仓储» 0, «仓储» 20, «仓储» 21, «仓储» 22]
  ++ (if «W2先建» then [«建» 31 .«协议储存箱», «仓储» 31, «建» 30 .«协议储存箱», «仓储» 30]
      else [«建» 30 .«协议储存箱», «仓储» 30, «建» 31 .«协议储存箱», «仓储» 31])
  ++ [«建» 40 .«汇流器», «连» 30 40, «连» 31 40]
  ++ «一串带» 40 [41, 42, 43, 44, 45, 46, 47] ++ [«连» 47 22]
  ++ [«建» 51 .«传送带», «连» 30 51, «建» 55 .«物品准入口», «连» 51 55, «建» 52 .«传送带», «连» 55 52, «连» 52 20,
      .«做» (.«设准入口» 55 (some .«源矿») none none)]
  ++ [«建» 53 .«传送带», «连» 31 53, «建» 56 .«物品准入口», «连» 53 56, «建» 54 .«传送带», «连» 56 54, «连» 54 21,
      .«做» (.«设准入口» 56 (some .«源矿») none none)]
  ++ «一串带» 0 [1, 2, 3, 4] ++ [«连» 4 30] ++ «一串带» 0 [6, 7, 8, 9] ++ [«连» 9 31]
  ++ «装满» 0 .«源矿»

/-- 回放：实测的布局照说法 `v` 走 `ticks` 个 tick 以后 X1、X2、Y、W1、W2 里各有几件。 -/
def «实测的读数» (v : «都没货时») («W2先建» : Bool) (ticks : Nat) : Option (List Nat) :=
  let un : «未定» := { «取一种» with «输入判定都没货时» := v }
  («演于» un «状态».«空» («实测的布置» «W2先建» ++ [.«等» (8 * ticks)])).map fun s =>
    [20, 21, 22, 30, 31].map fun u => «箱里几件» s u .«源矿»

-- 实测（两组，W1 先建、W2 先建）：放满 S 后约 62–72 秒读到 X1 13、X2 13、Y 23，停货后 21；21；42 和 22；21；43，
-- W1、W2 一直是空的。X1、X2 一样多，Y 是两者之和，先建哪个都一样。
-- 「再判一次」：X1、X2 各一半，和先建哪个无关——对得上。
#guard [false, true].all fun a =>
  «实测的读数» .«再判一次» a 30 == some [12, 11, 18, 0, 0] && «实测的读数» .«再判一次» a 50 == some [22, 21, 38, 0, 0]
-- 「都收」：先建成的那个中转箱自己的收货箱一直是 0——对不上。
#guard «实测的读数» .«都收» false 50 == some [0, 43, 38, 0, 0] && «实测的读数» .«都收» true 50 == some [43, 0, 38, 0, 0]
-- 「不收」（字面）：Y 一直是 0——对不上。
#guard [false, true].all fun a => «实测的读数» .«不收» a 50 == some [43, 43, 0, 0, 0]

end Endfield.«回放».«两个中转箱»
