import Endfield.«判定与轮询»

/-!
# 回放：出口一个一个接上时，第一次出货从哪个开始

现象清单 `求解器/规则修订/2026-10-10-交给GPT/现象.md` 第 20 条。
单位下边三个出口各接一段带子，一个一个接上，一件一件（或一批一批）放货，各出口都收得下。
-/

namespace Endfield.«回放»

/-- 据：移动判定、非运输单位轮询

一步里一个非运输单位的一组通道出货 k 件：按轮询的先后一条一条判定，每条移走一件，
直到物品都已移出或这组通道都已判定。各出口都收得下。返回这一步各件走的通道和新的 `已移动`。 -/
def «出一批» (n : Nat) («是制造单位» : Bool) («已移动» : List (Fin n)) (k : Nat) :
    List (Fin n) × List (Fin n) :=
  let chosen := («非运输单位轮询» n «是制造单位» «已移动»).take k
  (chosen, chosen.foldl «记移动» «已移动»)

/-- 据：移动判定、非运输单位轮询

一批一批出货，`各批件数` 是每批的件数。返回每批各件走的通道。 -/
def «连出» (n : Nat) («是制造单位» : Bool) : List (Fin n) → List Nat → List (List (Fin n))
  | _, [] => []
  | moved, k :: ks =>
    let (chosen, moved') := «出一批» n «是制造单位» moved k
    chosen :: «连出» n «是制造单位» moved' ks

/-- 回放：把通道换成出口的叫法：`名` 按接通先后给出各出口的名字。 -/
def «叫» («名» : List String) {n : Nat} (xs : List (List (Fin n))) : List (List String) :=
  xs.map fun b => b.map fun i => «名».getD i.val "?"

-- 协议储存箱：出口按中、左、右接上，三件依次去中、左、右。
#guard «叫» ["中", "左", "右"] («连出» 3 false [] [1, 1, 1]) == [["中"], ["左"], ["右"]]
-- 精炼炉：出口按中、右、左接上，第一件去右，第二件去左。
#guard «叫» ["中", "右", "左"] («连出» 3 true [] [1, 1]) == [["右"], ["左"]]
-- 粉碎机、研磨机、种植机：出口按中、上、下接上，三件依次去上、下、中。
#guard «叫» ["中", "上", "下"] («连出» 3 true [] [1, 1, 1]) == [["上"], ["下"], ["中"]]
-- 采种机一批出两件：出口按中、上、下接上，第一批去上、下，第二批去中、上。
#guard «叫» ["中", "上", "下"] («连出» 3 true [] [2, 2]) == [["上", "下"], ["中", "上"]]

end Endfield.«回放»
