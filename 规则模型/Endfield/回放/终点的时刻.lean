import Endfield.«回放».«工具»

/-!
# 回放：实测-2026-10-13 讲终点的时刻和次序的几节

记录在 求解器/规则修订/2026-10-08-现象整理/实测-2026-10-13.md。各节共用一套上游：
货源箱 0 经带子 1、2 进中转箱 B0（3，每 tick 至多进一件、不积货）；B0 上出口紧贴汇流器 M（4），下出口紧贴分流器 S（5）。
上路：M 接带子 10、11、桥接器 12、带子 13–15 进箱子 T2（40），M 的次序是 4。
S 的次序比 4 小，B0 的货全走 S；比 4 大，全走 M 进 T2。所以看货进哪个箱子，就知道 S 的次序跟的是哪一支。

通道和接通的先后照记录里的放置先后和规则「接通」一行排。实测的货是碳块，这里用源矿。
每组做完以后先走 200 步、再走 200 步，看后 200 步里各个箱子多了几件。
-/

namespace Endfield.«回放».«终点的时刻»

/-- 回放：拆掉几个单位。 -/
def «拆» (us : List «单位号») : List «一幕» := us.map fun u => .«做» (.«改布局» (.«拆除» u))

/-- 回放：共用的上游和上路。 -/
def «上游» : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 3 .«协议储存箱», «建» 40 .«协议储存箱», «仓储» 0, «仓储» 3, «仓储» 40]
  ++ «一串带» 0 [1, 2] ++ [«连» 2 3, «建» 4 .«汇流器», «连» 3 4, «建» 5 .«分流器», «连» 3 5]
  ++ «一串带» 4 [10, 11] ++ [«建» 12 .«桥接器格», «连» 11 12] ++ «一串带» 12 [13, 14, 15] ++ [«连» 15 40]

/-- 回放：放一个仓储模式的箱子。 -/
def «箱» (u : «单位号») : List «一幕» := [«建» u .«协议储存箱», «仓储» u]

/-- 回放：短支：S 的一个出口接六格带子（20–25）；`r` 为真时接上箱子 T（41）。按这支 S 的次序是 2。 -/
def «短支» (r : Bool) : List «一幕» :=
  «一串带» 5 [20, 21, 22, 23, 24, 25] ++ (if r then [«连» 25 41] else [])

/-- 回放：往货源箱里放满货。 -/
def «放货» : List «一幕» := «装满» 0 .«源矿»

/-- 回放：做完 `sc` 以后先走 200 步、再走 200 步，后 200 步里 `us` 这几个箱子各多了几件。 -/
def «后二百步» (us : List «单位号») (sc : List «一幕») : Option (List Nat) :=
  let look (s : «状态») : List Nat := us.map fun u => «箱里几件» s u .«源矿»
  («演» «状态».«空» (sc ++ [.«等» 200])).bind fun s1 =>
    («演» s1 [.«等» 200]).map fun s2 => ((look s1).zip (look s2)).map fun p => p.2 - p.1

/-! ## 第一节：分流器两支通往同一个箱子，次序取最短那支，还是先接上箱子的那支 -/

/-- 回放：长支（到箱子 T）：S 的另一个出口接带子 30、31、桥接器 32、33、34。按这支 S 的次序是 6。 -/
def «长支前段» : List «一幕» :=
  «一串带» 5 [30, 31] ++ [«建» 32 .«桥接器格», «连» 31 32, «建» 33 .«桥接器格», «连» 32 33,
    «建» 34 .«桥接器格», «连» 33 34]
/-- 回放：长支末段：带子 35、36；`r` 为真时接上 T。 -/
def «长支末段» (r : Bool) : List «一幕» := «一串带» 34 [35, 36] ++ (if r then [«连» 36 41] else [])

/-- 回放：组一。除 T 外全部放好，最后放 T：左下进口（长支）先接上，再接左中进口（短支）。 -/
def «组一» : List «一幕» :=
  «上游» ++ «短支» false ++ «长支前段» ++ «长支末段» false ++ «箱» 41 ++ [«连» 36 41, «连» 25 41] ++ «放货»
/-- 回放：组二。拆掉短支整条和长支末段，重拉长支末段（只剩长支）。 -/
def «组二» : List «一幕» := «组一» ++ «拆» [20, 21, 22, 23, 24, 25, 35, 36] ++ «长支末段» true
/-- 回放：组三。接着重拉短支（长支先接上、短支后接上）。 -/
def «组三» : List «一幕» := «组二» ++ «短支» true

/-- 回放：第五组以后的长支：带子 30、31、桥接器 32、33、带子 37、38，末端是分流器 E（39），E 直接进 T。 -/
def «长支前段二» : List «一幕» :=
  «一串带» 5 [30, 31] ++ [«建» 32 .«桥接器格», «连» 31 32, «建» 33 .«桥接器格», «连» 32 33]
/-- 回放：长支末段带 37、38。 -/
def «长支末段带» : List «一幕» := «一串带» 33 [37, 38]

/-- 回放：组五。长支末端换成分流器 E，T 最后放：左下进口（E）先接上，再接左中进口（短支）。 -/
def «组五» : List «一幕» :=
  «上游» ++ «短支» false ++ «长支前段二» ++ «长支末段带» ++ [«建» 39 .«分流器», «连» 38 39]
  ++ «箱» 41 ++ [«连» 39 41, «连» 25 41] ++ «放货»

-- 看到的：组一 T +12、T2 0；组二 T +1（改接线前在路上的）、T2 +18；组三 T +13、T2 +3（在路上的）；组五 T 0、T2 +13。
-- 两支通往同一个箱子时取最短那支（组一、三进 T）；末端是分流器的那支自成终点、按自己接上的先后排（组五进 T2）。
#guard «后二百步» [41, 40] «组一» == some [24, 0]
#guard «后二百步» [41, 40] «组二» == some [0, 25]
#guard «后二百步» [41, 40] «组三» == some [26, 0]
#guard «后二百步» [41, 40] «组五» == some [0, 25]

/-! ## 第二节：末端分流器的终点的时刻，是它连上箱子的那一刻 -/

/-- 回放：组六。T 在场；先放 E（只连着 T），再拉短支（T 成为终点），最后拉长支末段带（E 接上上游）。 -/
def «组六» : List «一幕» :=
  «上游» ++ «箱» 41 ++ «长支前段二» ++ [«建» 39 .«分流器», «连» 39 41] ++ «短支» true
  ++ «长支末段带» ++ [«连» 38 39] ++ «放货»
/-- 回放：组七。拆掉 E 和长支末段带，重放 E、重拉长支末段带（短支一直在）。 -/
def «组七» : List «一幕» :=
  «组六» ++ «拆» [39, 37, 38] ++ [«建» 39 .«分流器», «连» 39 41] ++ «长支末段带» ++ [«连» 38 39]

-- 看到的：组六 T 0、T2 +13；组七 T +11、T2 0。
#guard «后二百步» [41, 40] «组六» == some [0, 25]
#guard «后二百步» [41, 40] «组七» == some [26, 0]

/-! ## 第四节和它的补测：分流器拆掉通往元件的那一支、成了末端分流器，终点的时刻算哪一刻 -/

/-- 回放：E 下出口接的那段带子（50–52），进箱子 T4（42）。 -/
def «E下面的带» : List «一幕» := «一串带» 39 [50, 51, 52] ++ [«连» 52 42]

/-- 回放：组甲。T、T4 在场；放 E（和 T 接通），接 E 下面那段带子，拉长支末段带接上 E；
拉短支（T 成为终点）；拆掉 E 下面那段带子（E 成了末端分流器）。 -/
def «组甲» : List «一幕» :=
  «上游» ++ «箱» 41 ++ «箱» 42 ++ «长支前段二» ++ [«建» 39 .«分流器», «连» 39 41] ++ «E下面的带»
  ++ «长支末段带» ++ [«连» 38 39] ++ «短支» true ++ «拆» [50, 51, 52]
/-- 回放：组乙。拆掉短支，重接 E 下面那段带子，再拆掉它，然后才拉短支。 -/
def «组乙» : List «一幕» :=
  «组甲» ++ «拆» [20, 21, 22, 23, 24, 25] ++ «E下面的带» ++ «拆» [50, 51, 52] ++ «短支» true
/-- 回放：组丙。拆掉短支和 E；E 下方放桥接器 53，从它下边拉带子 54、55 进 T4；
再放 E（先接右边的 T，后接下面的桥接器）；拉短支；拆掉桥接器。 -/
def «组丙» : List «一幕» :=
  «组乙» ++ «拆» [20, 21, 22, 23, 24, 25] ++ «拆» [39] ++ [«建» 53 .«桥接器格»] ++ «一串带» 53 [54, 55]
  ++ [«连» 55 42, «建» 39 .«分流器», «连» 38 39, «连» 39 41, «连» 39 53] ++ «短支» true ++ «拆» [53]
/-- 回放：组丁。拆掉短支和 T；再放桥接器（接上 E 的下出口和下面那段带子）；放 T（E 和 T 接通时 E 下面已有桥接器）；
拉短支；拆掉桥接器。 -/
def «组丁» : List «一幕» :=
  «组丙» ++ «拆» [20, 21, 22, 23, 24, 25] ++ «拆» [41] ++ [«建» 53 .«桥接器格», «连» 39 53, «连» 53 54]
  ++ «箱» 41 ++ [«连» 39 41] ++ «短支» true ++ «拆» [53]
/-- 回放：补测。组丁之后拆掉 S 再重放（逼它重算次序）。 -/
def «组丁再重放S» : List «一幕» :=
  «组丁» ++ «拆» [5] ++ [«建» 5 .«分流器», «连» 3 5, «连» 5 20, «连» 5 30]

-- 看到的：甲、乙、丙、丁、丁之后重放 S，都是 T 0、T2 +13。
-- 末端分流器的终点的时刻是它和箱子之间那条通道形成的那一刻，不是它变成末端的那一刻。
#guard [«组甲», «组乙», «组丙», «组丁», «组丁再重放S»].all fun g =>
  «后二百步» [41, 40] (g ++ «放货») == some [0, 25]

/-! ## 第五节：箱子作终点时，最早接上它的末端元件拆掉、别的末端还连着，终点的时刻不变 -/

/-- 回放：S 的两支进两个不同的箱子：短支进 T（41），长支（带子 30、31、桥接器 32、33、带子 37、38、43、44）进 T′（45），
按长支 S 的次序是 5。A 是一段没有上游的两格带子（60、61），进 T。先拉 A，再拉长支末段，再拉短支。 -/
def «两个箱子» : List «一幕» :=
  «上游» ++ «箱» 41 ++ «箱» 45 ++ «长支前段二»
  ++ [«建» 60 .«传送带», «建» 61 .«传送带», «连» 60 61, «连» 61 41]
  ++ «一串带» 33 [37, 38, 43, 44] ++ [«连» 44 45] ++ «短支» true ++ «放货»

/-- 回放：拆掉 S 再重放。`a`、`b` 是它两个出口外的第一格。 -/
def «重放S» (a b : «单位号») : List «一幕» := «拆» [5] ++ [«建» 5 .«分流器», «连» 3 5, «连» 5 a, «连» 5 b]

-- 看到的：对照 T +7、T′ +5、T2 0；拆掉 A 以后 T、T′ 接着涨，T2 一直 0；重放 S 以后还是这样。货一直走 S。
#guard «后二百步» [41, 45, 40] «两个箱子» == some [13, 12, 0]
#guard «后二百步» [41, 45, 40] («两个箱子» ++ [.«等» 200] ++ «拆» [60, 61]) == some [12, 13, 0]
#guard «后二百步» [41, 45, 40] («两个箱子» ++ [.«等» 200] ++ «拆» [60, 61] ++ «重放S» 20 30) == some [12, 13, 0]

/-! ## 第七节：末端分流器同时直接连着两个箱子，终点的时刻取先接通的那一条，之后不变 -/

/-- 回放：短支：S 下出口接带子 70–72 进对照箱 P（46），按这支 S 的次序是 2。
长支：S 右出口接带子 73–75、桥接器 76、带子 77、78、末端分流器 E（39），按这支 S 的次序是 5。
E 右出口直接进 T（41），下出口直接进 U（47）。先放 E（和 T 接通），再拉短支（P 成为终点），再放 U（E 和 U 接通）。 -/
def «连着两个箱子» : List «一幕» :=
  «上游» ++ «箱» 41 ++ «箱» 46 ++ «一串带» 5 [73, 74, 75] ++ [«建» 76 .«桥接器格», «连» 75 76]
  ++ «一串带» 76 [77, 78] ++ [«建» 39 .«分流器», «连» 78 39, «连» 39 41]
  ++ «一串带» 5 [70, 71, 72] ++ [«连» 72 46] ++ «箱» 47 ++ [«连» 39 47] ++ «放货»

-- 看到的：对照 T2 +14，P、T、U 都是 0；拆掉 T 以后 T2 接着涨，P、U 都是 0；重放 S 以后还是这样。货一直走 M。
#guard «后二百步» [46, 41, 47, 40] «连着两个箱子» == some [0, 0, 0, 25]
#guard «后二百步» [46, 47, 40] («连着两个箱子» ++ [.«等» 200] ++ «拆» [41]) == some [0, 0, 25]
#guard «后二百步» [46, 47, 40] («连着两个箱子» ++ [.«等» 200] ++ «拆» [41] ++ «重放S» 73 70) == some [0, 0, 25]

end Endfield.«回放».«终点的时刻»
