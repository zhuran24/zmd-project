import Endfield.«判定与轮询»

/-!
# 回放：分流器的出口有变动以后，下一件从哪个出口送

实测记录：`求解器/规则修订/2026-10-08-现象整理/实测-2026-11-09.md` 第一节（甲、乙、丙、丁）
和「补测：分流器拆掉的不是刚送过货的那个出口，或者新接上一个出口」一节（戊、己、庚、辛）。

出口按接上的先后叫 1、2、3。每组先放几件货，再拆掉或接上一个出口，再放 2 件。
这里把三种说法都写成函数，拿八组实测去对：只有「当成都未移动过物品」八组全对。
-/

namespace Endfield.«回放»

/-- 据：元件轮询、移动判定

分流器里有一件物品时的一次移动判定：按元件轮询的先后，第一条收得下的通道把它移走。
`通道` 是按接通先后排好的出口，`上次` 是上一次移动物品的出口，`堵` 是这时收不下的出口。返回去向。
`上次` 不在 `通道` 里时按都未移动过物品算；下面三种说法给出的 `上次` 都在 `通道` 里，用不到这一条。 -/
def «送一件» («通道» : List Nat) («上次» : Option Nat) («堵» : List Nat) : Option Nat :=
  let pos := «上次».bind fun l => «通道».finIdxOf? l
  ((«元件轮询» «通道».length pos).map fun i => «通道»[i]).find? fun l => !«堵».contains l

/-- 据：元件轮询、移动判定

一件一件送，`各件堵` 给出每件送的时候收不下的出口。返回各件的去向（送不出去的不记）和最后的 `上次`。 -/
def «连送» («通道» : List Nat) : Option Nat → List (List Nat) → List Nat × Option Nat
  | last, [] => ([], last)
  | last, b :: bs =>
    match «送一件» «通道» last b with
    | some l =>
      let (ds, last') := «连送» «通道» (some l) bs
      (l :: ds, last')
    | none => «连送» «通道» last bs

/-- 回放：一组实测，改动之前的出口和放货、改动之后的出口，以及看到的去向。 -/
structure «出口变动场景» where
  «组» : String
  «前通道» : List Nat
  «前各件堵» : List (List Nat)
  «后通道» : List Nat
  «实测前» : List Nat
  «实测后» : List Nat

/-- 回放：实测-2026-11-09 的八组。丁组第 2 件送的时候出口 3 上的物品准入口不放行。 -/
def «场景表» : List «出口变动场景» := [
  ⟨"甲", [1, 2, 3], [[], []], [1, 2], [2, 3], [2, 1]⟩,
  ⟨"乙", [1, 2, 3], [[]], [1, 3], [2], [3, 1]⟩,
  ⟨"丙", [1, 2, 3], [[], [], []], [2, 3], [2, 3, 1], [3, 2]⟩,
  ⟨"丁", [1, 2, 3], [[], [3]], [2, 3], [2, 1], [3, 2]⟩,
  ⟨"戊", [1, 2, 3], [[], []], [2, 3], [2, 3], [3, 2]⟩,
  ⟨"己", [1, 2, 3], [[]], [1, 2], [2], [2, 1]⟩,
  ⟨"庚", [1, 2, 3], [[], []], [1, 3], [2, 3], [3, 1]⟩,
  ⟨"辛", [1, 2], [[]], [1, 2, 3], [2], [2, 3]⟩]

/-- 回放：出口有变动以后「上一次移动物品的出口」算哪个的一种说法：
给出改动之前的出口、改动之前各件的去向、改动之后的出口，返回改动之后的 `上次`。 -/
abbrev «说法» := List Nat → List Nat → List Nat → Option Nat

/-- 据：元件轮询

当成都未移动过物品。 -/
def «重置» : «说法» := fun _ _ _ => none

/-- 回放：被实测排除的说法「顺延」。上一次送货的出口还在就照旧接着轮；它被拆掉了，就按原来的接通先后从它的下一条开始
（等于把「上次」记成原来的先后里排在它前面、还在的最近一条）。 -/
def «顺延» : «说法» := fun before history after =>
  match history.getLast? with
  | none => none
  | some last =>
    match before.idxOf? last with
    | none => none
    | some i => (before.rotateLeft (i + 1)).reverse.find? fun l => after.contains l

/-- 回放：被实测排除的说法。剩下的出口里最近送过货的那条算「上次」；剩下的都没送过货时按都未移动过物品算。 -/
def «最近送过的» : «说法» := fun _ history after =>
  history.reverse.find? fun l => after.contains l

/-- 回放：按一种说法推一组：返回改动之前各件的去向和改动之后 2 件的去向。 -/
def «推» (f : «说法») (s : «出口变动场景») : List Nat × List Nat :=
  let (before, _) := «连送» s.«前通道» none s.«前各件堵»
  let (after, _) := «连送» s.«后通道» (f s.«前通道» before s.«后通道») [[], []]
  (before, after)

/-- 回放：和实测对不上的组。 -/
def «对不上的组» (f : «说法») : List String :=
  («场景表».filter fun s => «推» f s != (s.«实测前», s.«实测后»)).map (·.«组»)

-- 八组改动之前的去向，三种说法推出来都和实测一样（改动之前用不到这三种说法）。
#guard «场景表».all fun s => («推» «重置» s).1 == s.«实测前»
-- 「当成都未移动过物品」八组全对。
#guard «对不上的组» «重置» == []
-- 「顺延」只对乙一组。
#guard «对不上的组» «顺延» == ["甲", "丙", "丁", "戊", "己", "庚", "辛"]
-- 「最近送过货的还在的那条」只对乙、丁两组。
#guard «对不上的组» «最近送过的» == ["甲", "丙", "戊", "己", "庚", "辛"]

end Endfield.«回放»
