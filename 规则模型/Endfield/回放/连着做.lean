import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-11-26.md 第十三节「连着做的时候每批是不是正好配方时长；一粒种子转圈」。
这三组都不靠限速的物品准入口、无线传输的箱子定「整秒里的第几步」，只数件数、看相邻两件隔几秒。

一、满带过精炼炉：货源箱出满带 → 一格带 → 精炼炉 → 一格带 → 收货箱。实测每 2 秒进箱一件蓝铁块，
连着 193 批（六分半钟）没有少一件，和旁边一条纯带子的参照线一样快。这里核的是每 8 步一件。
这一条改之前的模型（结束制造判定在一步的开头）也过：两种排法连着做都是每 8 步一批，它排除的是「每批 9 步」。

二、一粒种子转圈：采种机的出口接一格带、一个分流器；分流器一个出口一格带进收货箱，另一个出口 8 格带进种植机；
种植机的出口 10 格带回采种机。回路里只有一粒砂叶种子：种出一株砂叶，采出两粒种子，一粒进收货箱、一粒回去。
一圈经过 19 格带、1 个分流器和两台制造单位。实测 6 圈 267.03 秒、9 圈 401.05 秒（整秒上 45、44 秒交替），每圈 44.5 秒，
也就是 178 步。这里核的是相邻两粒进箱正好隔 178 步。结束制造判定在一步开头的排法是每圈 176 步（44 秒），这一条过不了。
实测里那一粒种子是从另一个箱子经一个累计上限 1 的物品准入口放进种植机的；这里直接放进种植机，起步的时刻不一样，每圈几步不看它。

三、封装机连着做：货源箱三个出口各两格带送致密源石粉末、另一个货源箱两个出口各两格带送钢制零件进封装机，
供料正好等于用料（每 5 tick 15 件、10 件）；出口两格带进收货箱。实测高容谷地电池每 10 秒一个：前 18 批 180.01 秒，
补了一次粉末以后又 9 批 89.98 秒，450 件粉末、300 件零件正好做了 30 个。这里核的是相邻两个进箱正好隔 40 步。
这一条改之前的模型也过；它排除的是「每批 41 步」。实测一次放 300 件粉末、中途补 150 件；这里一次放够 10 批的料。
-/

namespace Endfield.«回放».«连着做»

open Endfield Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 回放：从放完货的状态起一步一步走 `步数` 步，记下收货箱 `箱` 里 `货` 的件数变多的那些步号（放货后的第一步记 1）。 -/
def «进箱步号» (s : Endfield.«格子».«状态») («箱» : «单位号») («货» : «物品») («步数» : Nat) : List Nat :=
  let «走一步» := «走» «取一种» (s.«场地».«待写» «端口先后» «无效口») s.«模型».«历史».«立表» 1
  ((List.range «步数»).foldl (fun (p : Endfield.«状态» × List Nat) i =>
    let m := «走一步» p.1
    (m, if «箱里几件» m «箱» «货» > «箱里几件» p.1 «箱» «货» then (i + 1) :: p.2 else p.2)) (s.«模型», [])).2.reverse

/-- 回放：相邻两个数的差。 -/
def «间隔» (l : List Nat) : List Nat := (l.zip (l.drop 1)).map fun (a, b) => b - a

/-- 回放：满带过精炼炉。货源箱 1、带、精炼炉 5、带、收货箱 7、供电桩；往货源箱放 50 件蓝铁矿，走 200 步。 -/
def «过精炼炉» : Option (List Nat) := do
  let s ← ([«摆» 1 23 13 (.«协议储存箱» .«下»), «摆» 11 24 16 (.«传送带» .«上» .«下»),
    «摆» 5 23 17 (.«制造» .«精炼炉» .«下»), «摆» 12 24 20 (.«传送带» .«上» .«下»),
    «摆» 7 23 21 (.«协议储存箱» .«下»), «摆» 99 27 18 .«供电桩»]).mapM id >>= «布置»
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 50))
  return «进箱步号» s 7 .«蓝铁块» 200

/-- 回放：一粒种子转圈。采种机 1（上进下出）、种植机 2（下进上出）、收货箱 3、供电桩；
采种机下面一格带 20、分流器 21、往下一格带 22 进收货箱；分流器往右 8 格带进种植机；种植机上面 10 格带绕回采种机。
往种植机里放 1 粒砂叶种子，走 1500 步。 -/
def «种子回路» : Option (List Nat) := do
  let s ← ([«摆» 1 23 15 (.«制造» .«采种机» .«下»), «摆» 2 30 15 (.«制造» .«种植机» .«上»),
    «摆» 3 24 23 (.«协议储存箱» .«下»), «摆» 99 28 18 .«供电桩»,
    «摆» 20 25 20 (.«传送带» .«上» .«下»), «摆» 21 25 21 (.«分流器» .«上»), «摆» 22 25 22 (.«传送带» .«上» .«下»)]
    ++ ([26, 27, 28, 29, 30, 31].map fun x => «摆» (2000 + x) x 21 (.«传送带» .«左» .«右»))
    ++ [«摆» 2032 32 21 (.«传送带» .«左» .«上»), «摆» 2033 32 20 (.«传送带» .«下» .«上»),
        «摆» 3001 32 14 (.«传送带» .«下» .«上»), «摆» 3002 32 13 (.«传送带» .«下» .«左»)]
    ++ ([31, 30, 29, 28, 27, 26].map fun x => «摆» (3100 + x) x 13 (.«传送带» .«右» .«左»))
    ++ [«摆» 3003 25 13 (.«传送带» .«右» .«下»), «摆» 3004 25 14 (.«传送带» .«上» .«下»)]).mapM id >>= «布置»
  let s ← «做» s (.«原样» (.«放货» 2 .«砂叶种子» 1))
  return «进箱步号» s 3 .«砂叶种子» 1500

/-- 回放：封装机连着做。货源箱 1（致密源石粉末，三条带）、货源箱 2（钢制零件，两条带）、封装机 5（左进右出）、
出口两格带、收货箱 7、供电桩。各放够 10 批的料，走 500 步。 -/
def «封装机线» : Option (List Nat) := do
  let s ← ([«摆» 1 23 16 (.«协议储存箱» .«右»), «摆» 2 23 19 (.«协议储存箱» .«右»),
    «摆» 5 28 16 (.«制造» .«封装机» .«右»), «摆» 7 34 17 (.«协议储存箱» .«右»), «摆» 99 29 23 .«供电桩»]
    ++ ([16, 17, 18, 19, 20].flatMap fun r =>
        [«摆» (100 + r) 26 r (.«传送带» .«左» .«右»), «摆» (200 + r) 27 r (.«传送带» .«左» .«右»)])
    ++ [«摆» 301 32 18 (.«传送带» .«左» .«右»), «摆» 302 33 18 (.«传送带» .«左» .«右»)]).mapM id >>= «布置»
  let s ← «依次» s [.«原样» (.«放货» 2 .«钢制零件» 100), .«原样» (.«放货» 1 .«致密源石粉末» 150)]
  return «进箱步号» s 7 .«高容谷地电池» 500

-- 一：头 20 件蓝铁块，相邻两件都隔 8 步（实测每 2 秒一件）。
#guard «过精炼炉».map (fun l => «间隔» (l.take 20)) == some (List.replicate 19 8)

-- 二：种子相邻两次进箱都隔 178 步（实测每圈 44.5 秒）；6 圈 1068 步 = 267 秒（实测 267.03 秒）。
#guard «种子回路».map (fun l => «间隔» (l.take 7)) == some (List.replicate 6 178)

-- 三：10 个电池都做出来，相邻两个都隔 40 步（实测每 10 秒一个）。
#guard «封装机线».map «间隔» == some (List.replicate 9 40)

end Endfield.«回放».«连着做»
