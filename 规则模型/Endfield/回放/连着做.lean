import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-11-26.md 第十三节「连着做的时候每批是不是正好配方时长；一粒种子转圈」。
测前用新旧模型算过精炼炉和种子回路。封装机的 40 步是测前按配方预计的，具体线路在实测后写成回放。

满带过精炼炉，收货箱第 10 到第 58 件的 48 个间隔共 96.02 秒。其后隔一段读一次，从第 10 件起算，
386.00 秒里箱内净增 192 件。旁边五格纯带的参照线，第 59 到第 77 件的 18 个间隔共 35.99 秒。
回放各放 50 件矿，走 200 步。过炉的线收 22 件，纯带收 20 件，各自从首件起的全部间隔都是 8 步。

封装机的两段进箱读数共跨 27 个间隔。第 1 到第 19 个电池共 180.01 秒，补料后第 21 到第 30 个共 89.98 秒。
按读数表校正跳读后，两头能配上时刻的间隔共 22 个，其中第 29 个电池的位置按前后的件数推定。游戏先放 300 件粉末，后补 150 件，配上 300 件零件共做 30 批。
回放一次放够 10 批的料，走 500 步。精炼炉和封装机的收货节拍说明机器分别不比每 8 步、40 步一批慢。
供料也限制进箱速度，更快的制造节拍用这两组读数分不出来。精炼炉、纯带参照、封装机三条核对在并入前的模型里也过。

种子回路先接进收货箱的一支，再接回种植机的一支。同批两粒分开，先上带的一粒回送。实读 6 圈 267.03 秒、
9 圈 401.05 秒。第 8 粒缺进箱时刻，第 7 到第 9 粒两圈合计 88.98 秒。若每圈步数固定，每圈进箱一粒，且回送途中没有额外等待，
这两段与现模型的 178 步一圈相符。19 格带和一个分流器共 160 步，两台机器合计 18 步，比配方合计多的 2 步无法分给各台。
并入前那版在步初结束制造、当步可送，算出 176 步一圈。对调支带的接通顺序，现模型算出 186 步一圈，这个顺序没有实测。
游戏从箱子经限放一粒的准入口投种。回放直接放一粒进种植机，走 1750 步，按实测接法核全部 9 个间隔，对调时核全部 8 个。

三组桩位照 11-26 晚的截图换算，左上格在 place 给的格上一行。11-25 校准记的是左一列。
按两种换算，供电范围都够到回放用的制造单位和箱子，差一格不影响核对所需的供电。若在种子线上照 11-25 的记法摆桩，桩会与采种机重叠。
-/

namespace Endfield.«回放».«连着做»

open Endfield Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 回放：从放货后第一步起，记下每次进箱的步号。每步只许持平或加一，最后同读箱内件数。 -/
def «进箱步号» (s : Endfield.«格子».«状态») («箱» : «单位号») («货» : «物品») («步数» : Nat) :
    Option (List Nat × Nat) := do
  let «走一步» := «走» «取一种» (s.«场地».«待写» «端口先后» «无效口») s.«模型».«历史».«立表» 1
  let mut m := s.«模型»
  let mut n := «箱里几件» m «箱» «货»
  let mut ts := []
  for i in [:«步数»] do
    m := «走一步» m
    let k := «箱里几件» m «箱» «货»
    if k != n then
      guard (k == n + 1)
      ts := (i + 1) :: ts
    n := k
  return (ts.reverse, n)

/-- 回放：核最后的件数，以及从首件到末件的每一个进箱间隔。 -/
private def «核进箱» (r : Option (List Nat × Nat)) («件数» «步距» : Nat) : Bool :=
  r.any fun (ts, n) => n == «件数» && ts.length == «件数» &&
    (ts.zip (ts.drop 1)).all fun (a, b) => b == a + «步距»

/-- 回放：满带过精炼炉。货源箱 1、带、精炼炉 5、带、收货箱 7、供电桩；往货源箱放 50 件蓝铁矿，走 200 步。 -/
def «过精炼炉» : Option (List Nat × Nat) := do
  let s ← ([«摆» 1 23 13 (.«协议储存箱» .«下»), «摆» 11 24 16 (.«传送带» .«上» .«下»),
    «摆» 5 23 17 (.«制造» .«精炼炉» .«下»), «摆» 12 24 20 (.«传送带» .«上» .«下»),
    «摆» 7 23 21 (.«协议储存箱» .«下»), «摆» 99 27 17 .«供电桩»]).mapM id >>= «布置»
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 50))
  «进箱步号» s 7 .«蓝铁块» 200

/-- 回放：同场参照线的两个箱子之间接五格带，各件蓝铁矿直接进收货箱。 -/
def «纯带» : Option (List Nat × Nat) := do
  let s ← ([«摆» 1 28 13 (.«协议储存箱» .«下»), «摆» 7 28 21 (.«协议储存箱» .«下»),
    «摆» 99 27 17 .«供电桩»] ++ ([16, 17, 18, 19, 20].map fun y =>
      «摆» (100 + y) 29 y (.«传送带» .«上» .«下»))).mapM id >>= «布置»
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 50))
  «进箱步号» s 7 .«蓝铁矿» 200

/-- 回放：一粒种子转圈。采种机 1（上进下出）、种植机 2（下进上出）、收货箱 3、供电桩；
采种机下面一格带 20、分流器 21、往下一格带 22 进收货箱；分流器往右 8 格带进种植机；种植机上面 10 格带绕回采种机。
往种植机里放 1 粒砂叶种子，走 1750 步。 -/
def «种子回路» («先接进箱» : Bool) : Option (List Nat × Nat) := do
  let «进箱支带» := [«摆» 22 25 22 (.«传送带» .«上» .«下»)]
  let «回送支带» := ([26, 27, 28, 29, 30, 31].map fun x => «摆» (2000 + x) x 21 (.«传送带» .«左» .«右»))
    ++ [«摆» 2032 32 21 (.«传送带» .«左» .«上»), «摆» 2033 32 20 (.«传送带» .«下» .«上»)]
  let s ← ([«摆» 1 23 15 (.«制造» .«采种机» .«下»), «摆» 2 30 15 (.«制造» .«种植机» .«上»),
    «摆» 3 24 23 (.«协议储存箱» .«下»), «摆» 99 28 17 .«供电桩»,
    «摆» 20 25 20 (.«传送带» .«上» .«下»), «摆» 21 25 21 (.«分流器» .«上»)]
    ++ (if «先接进箱» then «进箱支带» ++ «回送支带» else «回送支带» ++ «进箱支带»)
    ++ [«摆» 3001 32 14 (.«传送带» .«下» .«上»), «摆» 3002 32 13 (.«传送带» .«下» .«左»)]
    ++ ([31, 30, 29, 28, 27, 26].map fun x => «摆» (3100 + x) x 13 (.«传送带» .«右» .«左»))
    ++ [«摆» 3003 25 13 (.«传送带» .«右» .«下»), «摆» 3004 25 14 (.«传送带» .«上» .«下»)]).mapM id >>= «布置»
  let s ← «做» s (.«原样» (.«放货» 2 .«砂叶种子» 1))
  «进箱步号» s 3 .«砂叶种子» 1750

/-- 回放：封装机连着做。货源箱 1（致密源石粉末，三条带）、货源箱 2（钢制零件，两条带）、封装机 5（左进右出）、
出口两格带、收货箱 7、供电桩。各放够 10 批的料，走 500 步。 -/
def «封装机线» : Option (List Nat × Nat) := do
  let s ← ([«摆» 1 23 16 (.«协议储存箱» .«右»), «摆» 2 23 19 (.«协议储存箱» .«右»),
    «摆» 5 28 16 (.«制造» .«封装机» .«右»), «摆» 7 34 17 (.«协议储存箱» .«右»), «摆» 99 29 22 .«供电桩»]
    ++ ([16, 17, 18, 19, 20].flatMap fun r =>
        [«摆» (100 + r) 26 r (.«传送带» .«左» .«右»), «摆» (200 + r) 27 r (.«传送带» .«左» .«右»)])
    ++ [«摆» 301 32 18 (.«传送带» .«左» .«右»), «摆» 302 33 18 (.«传送带» .«左» .«右»)]).mapM id >>= «布置»
  let s ← «依次» s [.«原样» (.«放货» 2 .«钢制零件» 100), .«原样» (.«放货» 1 .«致密源石粉末» 150)]
  «进箱步号» s 7 .«高容谷地电池» 500

-- 两条线各走 200 步，头一件到箱的步号可以不同。
#guard «核进箱» «过精炼炉» 22 8
#guard «核进箱» «纯带» 20 8

-- 照实测接支带，以及只交换两条支带接通先后的模型对照。
#guard «核进箱» («种子回路» true) 10 178
#guard «核进箱» («种子回路» false) 9 186

-- 放够十批料，核完全部九个间隔和箱内十个电池。
#guard «核进箱» «封装机线» 10 40

end Endfield.«回放».«连着做»
