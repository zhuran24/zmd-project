import Endfield.«回放».«工具»

/-!
# 桥接器

来源（仓库根目录起）：
* 求解器/规则修订/2026-10-10-交给GPT/现象.md，第 15 条。
* 求解器/规则修订/2026-10-08-现象整理/实测-2026-10-11.md：
  「桥接器建成时几条边按什么先后接通；两个相邻桥接器串在满载线上会不会掉速」、
  「owner 实测：桥接器一条轴两头同时进货」、
  「满载主线穿过一排相邻桥接器、另一条线竖着蛇形穿过同一排」。

观察逐项列在这里，下面按这些编号核对：
1. 现象 15：单轴直穿；相邻两座双向直穿，不退回上一座。
2. 现象 15、owner：无出口时左右各收一件；左带改向后右货向左出，
   再改右带，原来的左货向右出。
3. 现象 15：四方向各一件，互不影响，同种货也可以。
4. 布局 1：六次面板单格依次碳、碳、源、源、碳、碳。
5. 布局 2：八次面板单格依次源、源、碳、碳、碳、源、碳、碳。
6. 布局 3：三次面板单格依次碳、源、碳；C 预先存着源矿。
7. 布局 1—3 的修正结论：每次两边各进一件，单格读数不能说明先进哪边。
8. 布局 4：RX 6→125、RY 8→127，各 +119，分别 236.2、236.3 秒；
   每轮 RX 少 2，读取早约 2 秒；两线满速，非 8/9。
9. 蛇形 A、B、A'：M/X/C 都满速；增量分别 98/98/98、98/98/98、99/100/100。
10. 蛇形 B 首轮 S 耗尽：M/C 只 +20/+18，X +98；补满且清 RX 后不改连接恢复满速。

限制与自行补定：
* 模型没有碳块，用钢块作其货物标签；这里只运输，不做配方。碳块物品身份不核对。
* 无坐标、朝向、面板角格编号，观察 4—6 的旋转单格读数跳过，绝不解释成进货先后。
* 现象及 owner 没写带长、装货量和等候时长，最小例取每边一格带、每源 1 件，
  owner 每阶段观察连续 32 步；四向同货例在 32 步末读一次。不是实测的精确时间复刻。
  四向的「各放一件」具体化为四箱各经一格带送一件，不声称来源记了这种放货操作。
* 实测只给墙钟读数，没有建成/放货相对步相位、逐箱完整采样时间，不能复刻观察 8—10
  的绝对计数及拟合斜率。下面核对逐步到货间隔及耗尽/补货，不把窗口叫作实测 +119/+98。
* 单条带建成时按「接通」先存后取；同一座桥的不同方向一次建齐且中间不走步。
  「接通」一行不给桥接器不同边排先后（规则文件 2026-10-11 删去了「桥接器各边的先后无法确定」：桥接器每个元件只从一条边进货，
  各边先后不影响结果）；这里列左入方向再右入方向（蛇形列水平再竖向）。
* 断头线路没有次序，已有边界清单「写进合法基地条件的」明确记载；仍照原布局走，
  不加收货箱来让它动。来源说已有货的准备状态也不手填进桥格。全空断言仅记录合法基地范围外的结果，
  不作为桥接器规则矛盾：准备阶段的满带、A/C 存货条件已不能满足。
* 货源/收货箱未记放置先后时按 S、SX、RM、RX、RC；用仓储模式隔离无线传输。
  蛇形中先 X、装满、C、M 前段、M 后段，之后只拆重拉来源指定两格。
  X 接通到 M 接通约 44 秒，期间各操作时刻不详；未把 44 秒全插在某个操作后。
* 布局 1、2 共用 SL/SR（上下出口由独立通道表示），布局 3 另建 SL2/SR2。
  布局 2 文字与表第 1 行建序冲突，两种均核对；「同上」解释及跨行插入点见停货函数注释。
-/

namespace Endfield.«回放».«桥接器»

/-- 回放：拆一个单位，连着它的通道随之拆除。 -/
def «拆» (u : Nat) : «一幕» := .«做» (.«改布局» (.«拆除» u))

/-- 回放：建储存箱并隔离无线传输；编号顺序即未记录的建箱顺序。 -/
def «箱» (us : List Nat) : List «一幕» :=
  us.flatMap fun u => [«建» u .«协议储存箱», «仓储» u]

/-- 回放：owner 单轴布局；0、1 是货源，10、11 是左右带，20、21 是左入/右入桥格。
先建并放货，等带子停货后放桥；等待未记录，固定 32 步并保留整个后续窗口。 -/
def «双向准备» : List «一幕» :=
  «箱» [0, 1] ++ [.«装» 0 (.«格» 0) .«钢块» 1, .«装» 1 (.«格» 0) .«源矿» 1]
  ++ «一串带» 0 [10] ++ «一串带» 1 [11] ++ [.«等» 32,
    «建» 20 .«桥接器格», «建» 21 .«桥接器格», «连» 10 20, «连» 11 21]

/-- 回放：owner 的三阶段，每阶段逐步读两桥格和两带；不添原记录没有的出口箱。 -/
def «双向读数» : Option (List (List (Option «物品»))) := do
  let s ← «演» «状态».«空» «双向准备»
  let a := «逐次看» (fun t => [20,21,10,11].map («格里» t)) (List.range 33) s
  let t ← «演» s [.«等» 32, «拆» 10, «建» 10 .«传送带», «连» 21 10]
  let b := «逐次看» (fun v => [20,21,10,11].map («格里» v)) (List.range 33) t
  let u ← «演» («走几步» 32 t) [«拆» 11, «建» 11 .«传送带», «连» 20 11]
  return a ++ b ++ «逐次看» (fun v => [20,21,10,11].map («格里» v)) (List.range 33) u

-- 断头线路（本题不管）：观察 2 应两桥格各收一件并先后从对边出去；模型桥格、改向后带子始终为空（合法基地范围外：断头线路无次序）。
#guard «双向读数» == some (List.replicate 99 [none, none, none, none])

/-- 回放：四向同货，从四个箱各经一格带往桥内送一件源矿，无出口；桥格 20—23 互相独立。 -/
def «四向同货» : Option (List (Option «物品»)) :=
  («演» «状态».«空» («箱» [0,1,2,3]
    ++ (List.range 4).flatMap (fun i => [.«装» i (.«格» 0) .«源矿» 1] ++ «一串带» i [10+i])
    ++ [.«等» 32] ++ (List.range 4).map (fun i => «建» (20+i) .«桥接器格»)
    ++ (List.range 4).map (fun i => «连» (10+i) (20+i)) ++ [.«等» 32])).map
    fun s => [20,21,22,23].map («格里» s)

-- 断头线路（本题不管）：观察 3 四格可同时存同货；此无出口回放四格全空，属于合法基地范围外的断头线路，不是桥接器规则矛盾。
#guard «四向同货» == some [none, none, none, none]

/-- 回放：建最后放下的 B；20 左入、21 右入。邻居是桥时也接上反向通道，
A 的右入格 31，C 的左入格 32；不能把桥之间反向通道遗漏成单向带。
先接 B 的存货通道（左、右顺序未定），再接取货通道。 -/
def «放中桥» (n : Nat) : List «一幕» :=
  [«建» 20 .«桥接器格», «建» 21 .«桥接器格», «连» 11 20, «连» 13 21]
  ++ (if n >= 2 then [«连» 21 31] else [])
  ++ (if n == 3 then [«连» 20 32] else [])

/-- 回放：布局 1—3 的初次准备。左右分别 x=26、27 和 x=30、29。
布局 2 文字说先左带、替换 A、再右带，表第 1 次却说「A 比右带新」；
rightFirst 分别保存两种相矛盾的记法，不选择有利的建序。左末格先建带后替换 A；
布局 3 直接建 A、C，不把记录没写的替换加进去。文字顺序在 A 后等 32 步才建右带；
来源的等待时长未记，统一 32 步，A 本应收货但模型仍空。 -/
def «停货布局» (n : Nat) (rightFirst : Bool) : List «一幕» :=
  let left := if n == 3 then
      «一串带» 0 [10] ++ [«建» 11 .«桥接器格», «建» 31 .«桥接器格», «连» 10 11]
    else «一串带» 0 [10,11] ++ (if n == 2 then
      [«拆» 11, «建» 11 .«桥接器格», «建» 31 .«桥接器格», «连» 10 11] else [])
  let right := if n == 3 then
      «一串带» 1 [12] ++ [«建» 13 .«桥接器格», «建» 32 .«桥接器格», «连» 12 13]
    else «一串带» 1 [12,13]
  (if n == 2 && rightFirst then right ++ left
    else left ++ (if n == 2 then [.«等» 32] else []) ++ right)
  ++ [.«等» 32]

/-- 回放：三张表的重建顺序。布局 1 第 2 次重拉左带；布局 2 第 3 次重拉右带、
第 5 次重建 A；其余只拆放 B。rot 与面板角格映射跳过，不从货名倒推映射。
「同组 2」「同上」只继承条件，不重复重拉左带或重建 A；来源未明确是否重复操作。 -/
def «下一次停货» (n attempt : Nat) : List «一幕» :=
  [«拆» 20, «拆» 21]
  ++ (if n == 1 && attempt == 2 then
      [«拆» 10, «拆» 11] ++ «一串带» 0 [10,11] else [])
  ++ (if n == 2 && attempt == 3 then
      [«拆» 12, «拆» 13] ++ «一串带» 1 [12,13] else [])
  ++ (if n == 2 && attempt == 5 then
      [«拆» 11, «拆» 31, «建» 11 .«桥接器格», «建» 31 .«桥接器格», «连» 10 11] else [])
  ++ [.«等» 32] ++ «放中桥» n

/-- 回放：停货局部编号换成同一基地编号。布局 1、2 共用 SL/SR=0/1，
布局 3 的另两箱为 2/3；各行运输单位分别加 100、200、300。转换本节使用的操作。 -/
def «停货换号» (n : Nat) (script : List «一幕») : List «一幕» :=
  let f := fun u => if u < 2 then (if n == 3 then u+2 else u) else n*100+u
  script.map fun m => match m with
    | .«做» (.«改布局» (.«建成» u k)) => «建» (f u) k
    | .«做» (.«改布局» (.«拆除» u)) => «拆» (f u)
    | .«做» (.«改布局» (.«接通» c)) => «连» (f c.«起») (f c.«止»)
    | .«做» (.«设储存箱模式» u b) => .«做» (.«设储存箱模式» (f u) b)
    | .«装» u g x k => .«装» (f u) g x k
    | other => other

/-- 回放：共箱交错做三张表。布局 1 前五组之后做布局 2，最后回到布局 1 第六组。
布局 2 第 1、8 次与布局 3 第 1、3 次放 B 之间不走步，内部先后未记，列第 20 行再第 22 行。
布局 3 第二次在两次共同放置之间，具体插入点未记，列在布局 2 第七次之后。
这些未记录的跨行先后不是规则结论；读格固定等 32 步，不伪造实测时间。
每次读 A/C 与 B 两格，true 表示四格全空；两种矛盾建序分别运行。 -/
def «停货各次» (rightFirst : Bool) : Option (List Bool) := do
  let mut s ← «演» «状态».«空» («箱» [0,1] ++ «装满» 0 .«钢块» ++ «装满» 1 .«源矿»
    ++ «停货换号» 1 («停货布局» 1 rightFirst))
  let mut out := []
  let read := fun n t => [11,13,20,21].all fun u => («格里» t (n*100+u)).isNone
  for i in List.range 5 do
    s ← «演» s («停货换号» 1 (if i == 0 then «放中桥» 1 else «下一次停货» 1 (i+1)))
    s := «走几步» 32 s
    out := out ++ [read 1 s]
  s ← «演» s («停货换号» 2 («停货布局» 2 rightFirst)
    ++ «停货换号» 3 («箱» [0,1] ++ «装满» 0 .«钢块» ++ «装满» 1 .«源矿»
      ++ «停货布局» 3 rightFirst)
    ++ «停货换号» 2 («放中桥» 2) ++ «停货换号» 3 («放中桥» 3))
  s := «走几步» 32 s
  out := out ++ [read 2 s, read 3 s]
  for i in [2,3,4,5,6,7] do
    s ← «演» s («停货换号» 2 («下一次停货» 2 i))
    s := «走几步» 32 s
    out := out ++ [read 2 s]
  s ← «演» s («停货换号» 3 («下一次停货» 3 2))
  s := «走几步» 32 s
  out := out ++ [read 3 s]
  s ← «演» s («停货换号» 2 [«拆» 20, «拆» 21]
    ++ «停货换号» 3 [«拆» 20, «拆» 21] ++ [.«等» 32]
    ++ «停货换号» 2 («放中桥» 2) ++ «停货换号» 3 («放中桥» 3))
  s := «走几步» 32 s
  out := out ++ [read 2 s, read 3 s]
  s ← «演» s («停货换号» 1 («下一次停货» 1 6))
  return out ++ [read 1 («走几步» 32 s)]

-- 断头线路（本题不管）：布局 1—3 应满带、A/C 预存货、B 两边各收一件；模型 17 次四格全空（合法基地范围外）。
#guard [false,true].all fun r => «停货各次» r == some (List.replicate 17 true)

/-- 回放：观察 1 的最小完整直穿线路，分别测试左到右、右到左。
两相邻桥各建两个方向：20→22、23→21；同一轮只有一个方向接源和终点，
不在桥的一条边同时虚构两根相反的传送带。两端各一格带，源 0、收货箱 2。
single=true 时只建一座；来源没写尺寸和建序，本例固定桥从左到右建、
源放 1 件，逐步观察 64 步；箱 0、2 先建，再桥、源带、出口带，两个方向分开运行。 -/
def «直穿» (reverse : Bool) (single : Bool := false) : Option (List Nat) :=
  («演» «状态».«空» («箱» [0,2]
    ++ [«建» 20 .«桥接器格», «建» 21 .«桥接器格»]
    ++ (if single then [] else [«建» 22 .«桥接器格», «建» 23 .«桥接器格», «连» 20 22, «连» 23 21])
    ++ «一串带» 0 [10] ++ [«连» 10 (if reverse then (if single then 21 else 23) else 20)]
    ++ «一串带» (if reverse then 21 else (if single then 20 else 22)) [12] ++ [«连» 12 2,
       .«装» 0 (.«格» 0) .«钢块» 1])).map fun s =>
    «逐次看» (fun t => «箱里几件» t 2 .«钢块») (List.range 65) s

-- 观察 1：单桥一轴一头进货，两个方向分别到达对侧箱。
#guard [false,true].all fun r => («直穿» r true).map (fun xs => xs.getLast?) == some (some 1)

-- 观察 1：两个方向分别完整穿过相邻两桥，到达对侧箱子，未滞留或退回前桥。
#guard [false,true].all fun r => («直穿» r).map (fun xs => xs.getLast?) == some (some 1)

/-- 回放：布局 4，0=SL，1=RX，2=RY；上路 10—16，下路 30—36 对应 x=26—32。
反向空格 112、113 也建齐；第二桥先接存货 12→13，再接取货 113→112、13→14。
两条取货边未定，固定左再右。按记录先拉两条七格带，再把上路 x=28、29 替换成桥。建造和放货时刻未记录，固定空线建完再装满。 -/
def «七格双线» : List «一幕» :=
  «箱» [0,1,2] ++ «一串带» 0 [10,11,12,13,14,15,16] ++ [«连» 16 1]
  ++ «一串带» 0 [30,31,32,33,34,35,36] ++ [«连» 36 2,
    «拆» 12, «建» 12 .«桥接器格», «建» 112 .«桥接器格», «连» 11 12, «连» 12 13,
    «拆» 13, «建» 13 .«桥接器格», «建» 113 .«桥接器格»,
    «连» 12 13, «连» 113 112, «连» 13 14]
  ++ «装满» 0 .«钢块»

/-- 回放：从布局暖线后逐步检查 16 tick；返回相邻读数增量，检查到货间隔而非挑端点比例。
暖线步数固定为该布局最长路径格数乘 8 再加 8；不是来源墙钟的读数起点。 -/
def «增量» (us : List (Nat × «物品»)) (warm : Nat) (s : «状态») : List (List Nat) :=
  let xs := «逐次看» (fun t => us.map fun p => «箱里几件» t p.1 p.2)
    ((List.range 129).map (warm + ·)) s
  (xs.zip xs.tail).map fun p => (p.1.zip p.2).map fun q => q.2 - q.1

/-- 回放：每八步严格一件，所有箱子在 128 步内每个八步滑动窗口都如此；允许各线相位不同。 -/
def «满速» (xs : List (List Nat)) (count : Nat) : Bool :=
  xs.length == 128 && (List.range 121).all fun i =>
    let window := (xs.drop i).take 8
    (List.range count).all fun j =>
      (window.map fun row => (row[j]?).getD 0).foldl (· + ·) 0 == 1

-- 观察 8：两条线满速、相邻桥不掉到 8/9；原始绝对计数的限制见文件头。
#guard («演» «状态».«空» «七格双线»).map (fun s => «满速» («增量» [(1,.«钢块»),(2,.«钢块»)] 64 s) 2) == some true

/-- 回放：蛇形线路的初始布置。S=0、SX=1、RM=2、RX=3、RC=4。
B1—B4 的水平格 20—23，竖向格 30—33。X 按 B4→B3→B2→B1。
M 前两格 10、11，后两格 12、13；C 八格 40—47；X 十格带 50—59。
水平反向格 120—123 及相邻反向通道也保留；每座先接存货，再接取货。
所有坐标对应来源每一格；U 弯的两格也保留。桥先放，X 一笔从源到终点连接。 -/
def «蛇形布置» : List «一幕» :=
  «箱» [0,1,2,3,4]
  ++ (List.range 4).flatMap (fun i => [«建» (20+i) .«桥接器格», «建» (30+i) .«桥接器格», «建» (120+i) .«桥接器格»]
      ++ (if i == 0 then [] else [«连» (19+i) (20+i), «连» (120+i) (119+i)]))
  ++ «一串带» 1 [50,51] ++ [«连» 51 33]
  ++ «一串带» 33 [52,53] ++ [«连» 53 32]
  ++ «一串带» 32 [54,55] ++ [«连» 55 31]
  ++ «一串带» 31 [56,57] ++ [«连» 57 30]
  ++ «一串带» 30 [58,59] ++ [«连» 59 3]
  ++ «装满» 0 .«钢块» ++ «装满» 1 .«蓝铁块»
  ++ «一串带» 0 [40,41,42,43,44,45,46,47] ++ [«连» 47 4]
  ++ «一串带» 0 [10,11] ++ [«连» 11 20]
  ++ «一串带» 23 [12,13] ++ [«连» 13 2]

/-- 回放：连续做 A、B、A'；固定各阶段暖线 120 步，再检查 128 步。
