/-! ## 点重置、把限速关掉再打开

来源：实测-2026-11-26.md 第四节。准入口紧贴收货箱（收下一件 8 步以后进箱），放行蓝铁矿、累计上限 5000、每 5 tick 上限 1。
稳下来以后取一件进箱的那一步当 t，在 t 以后的某几步做操作，看后面各件进箱的时刻（相对 t，整秒）。
那一件用的名额要占到 t 以后 8 秒左右。 -/

/-- 回放：货源箱 1、两格带、限速的准入口 30（紧贴收货箱）、收货箱 60。 -/
def «丁» : Option (List «摆件») :=
  [«摆» 1 29 14 (.«协议储存箱» .«下»), «摆» 60 29 20 (.«协议储存箱» .«下»),
   «摆» 118 30 17 (.«传送带» .«上» .«下»), «摆» 119 30 18 (.«传送带» .«上» .«下»),
   «摆» 30 30 19 (.«物品准入口» .«下»)].mapM id

/-- 回放：布局丁稳下来以后（走 200 步以后头一件进箱的那一步是 t），`事` 里每一项是（t 以后第几步，做什么）；
做完再走 n 步。给出 t 以后各件进箱的秒数（相对 t）。 -/
def «紧贴着改» («事» : List (Nat × Endfield.«格子».«原样操作»)) (n : Nat) : Option (List Nat) := do
  let s ← «丁».bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») (some 5000) (some 1)))
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let T := s.«模型».«历史».«立表»
  let todo := s.«场地».«待写» «端口先后» «无效口»
  let «件» (m : Endfield.«状态») : Nat := «箱里几件» m 60 .«蓝铁矿»
  let «走着记» (m : Endfield.«状态») (k : Nat) : Endfield.«状态» × List Nat :=
    (List.range k).foldl (fun (acc : Endfield.«状态» × List Nat) _ =>
      let t := «走» «取一种» todo T 1 acc.1
      (t, acc.2 ++ [«件» t])) (m, [])
  -- 走到 200 步以后头一次进箱
  let m0 := «走» «取一种» todo T 200 s.«模型»
  let (m1, a) := (List.range 60).foldl (fun (acc : Endfield.«状态» × List Nat) _ =>
      if acc.2.length > 0 && acc.2.getLast? != some («件» m0) then acc
      else let t := «走» «取一种» todo T 1 acc.1; (t, acc.2 ++ [«件» t])) (m0, [])
  let t0 := 200 + a.length
  let (st, got, _) ← «事».foldlM (fun (acc : Endfield.«格子».«状态» × List Nat × Nat) c => do
      let (m', x) := «走着记» acc.1.«模型» (c.1 - acc.2.2)
      let s' ← «做» { acc.1 with «模型» := m' } (.«原样» c.2)
      return (s', acc.2.1 ++ x, c.1)) ({ s with «模型» := m1 }, [], 0)
  let (_, b) := «走着记» st.«模型» n
  -- 表头垫上 t 那一刻的件数，`到的步` 会把它也当成一次进箱，去掉
  let «步» := («到的步» ((«件» m1) :: (got ++ b))).drop 1
  return «步».map fun x => (t0 + x - 1 + 3) / 4 - (t0 + 3) / 4

-- 不动：每 10 秒一件。
#guard («紧贴着改» [] 130).map (·.take 3) == some [10, 20, 30]
-- 点重置（第 12—15 轮：读到进一件以后 1—3 秒开始的那次调用里点的，重置落在名额还占着的时候）：
-- 名额不动，没有多放行，后面各件还是 +10、+20、+30 秒。
#guard («紧贴着改» [(12, .«重置计数» 30)] 130).map (·.take 3) == some [10, 20, 30]
#guard («紧贴着改» [(20, .«重置计数» 30)] 130).map (·.take 3) == some [10, 20, 30]
-- 每 5 tick 上限关掉、不到 1 秒就再打开（第 16—19 轮，直接点面板上的按钮；关在 +2 秒上下，开在 +2 到 +3 秒）：
-- 重新打开时原来那个名额还占着，下一件等到 +10 秒才进箱，然后 +20、+30。名额要是在关的时候清掉了，重新打开以后
-- 下一件一到准入口就会放行（+6 秒上下进箱）。这里核的就是这一点：关在 +1 到 +4 秒之间的任何一步、过 0、1、2、4 步再开，
-- 至多多放 1 件（+10 秒以前到），之后都是 +10、+20、+30。
#guard (List.range 12).all fun a => [0, 1, 2, 4].all fun g =>
  match «紧贴着改» [(4 + a, .«设准入口» 30 (some .«蓝铁矿») (some 5000) none),
    (4 + a + g, .«设准入口» 30 (some .«蓝铁矿») (some 5000) (some 1))] 130 with
  | some l => (l.filter (· < 10)).length ≤ 1 && (l.filter (· ≥ 10)).take 3 == [10, 20, 30]
  | none => false
-- 多放不多放那一件：第 17、18 轮多进了 1 件（在读数开始以前，+6 秒上下已经在箱里），第 16、19 轮没有，这一件不占名额。
-- 模型里关、开落在同一步就不多放，隔开一步以上就多放 1 件（下面四条；在第 8 步以后关的，多放的那件模型里 +5 秒到）。
-- 游戏里四轮两下点击隔 0 到 0.9 秒，哪一轮多放和隔多久对不上（第 19 轮隔 0.9 秒没多放，第 18 轮两下几乎同时却多放了）。
-- 讲得通的一种：操作只在整秒上生效，两下落在同一个整秒里就等于没关过；四轮的「关」都点在整秒边上，落在哪一边读数分不出。
-- 后来单独验了，见文件末尾「一秒结算一回」。
#guard («紧贴着改» [(8, .«设准入口» 30 (some .«蓝铁矿») (some 5000) none),
    (8, .«设准入口» 30 (some .«蓝铁矿») (some 5000) (some 1))] 130).map (·.take 3) == some [10, 20, 30]
#guard [1, 2, 4].all fun g => («紧贴着改» [(8, .«设准入口» 30 (some .«蓝铁矿») (some 5000) none),
    (8 + g, .«设准入口» 30 (some .«蓝铁矿») (some 5000) (some 1))] 130).map (·.take 4) == some [5, 10, 20, 30]
-- 关掉、过 4 秒左右再设回 1（第 6—8 轮，用了两次改设定的调用）：关着的时候过了 2 件，设回 1 以后下一件 +10 秒进箱，然后 +20、+30。
-- 这三轮单看分不开「名额留着」和「关的时候清掉」（三轮时机差不多，后一种也给 +10），靠上面四轮才分开；这里只核模型给的也是这样
-- （关着时过的两件到的时刻游戏里没读到，+6、+8 秒是模型的值）。
#guard («紧贴着改» [(12, .«设准入口» 30 (some .«蓝铁矿») (some 5000) none),
    (28, .«设准入口» 30 (some .«蓝铁矿») (some 5000) (some 1))] 130).map (·.take 5) == some [6, 8, 10, 20, 30]

/-! ## 一秒结算一回：点重置放两件、关开限速连点两下

来源：实测-2026-11-26.md 第十二节「看到的一」「看到的三」「看到的五」「看到的六」。
游戏每到整秒时刻，先把这一秒里收到的操作生效，再连走 4 步，面板随即显示走完这 4 步的样子。
所以操作放在 4 步的整倍数上；操作以后面板第 k 次翻动时看到的，是模型里操作以后走完 4k 步的样子。
同一节里货过制造单位的两组（看到的二、四）现在的模型算不对（制造单位的产物在游戏里晚 1 步上带，见 边界清单.md），这里没有核。 -/

/-- 回放：货源箱 0、一格带、物品准入口 30（累计上限 2、不限速）、五格带、物品准入口 45（每 5 tick 上限 1）、紧贴的收货箱 7。 -/
def «直通» : Option (List «摆件») :=
  ([«摆» 0 26 13 (.«协议储存箱» .«下»), «摆» 1 27 16 (.«传送带» .«上» .«下»), «摆» 30 27 17 (.«物品准入口» .«下»)]
   ++ ([18, 19, 20, 21, 22].map fun j => «摆» (100 + j) 27 j (.«传送带» .«上» .«下»))
   ++ [«摆» 45 27 23 (.«物品准入口» .«下»), «摆» 7 26 24 (.«协议储存箱» .«下»)]).mapM id

/-- 回放：头两件走完、准入口 30 关上以后，在第 `w` 步以后点一次重置计数，再看 `n` 秒。
给出每一秒面板上看到的（准入口 30 的累计通过数量，收货箱里的件数）。 -/
def «点重置以后每秒» (w n : Nat) : Option (List (Nat × Nat)) := do
  let s ← «直通».bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») (some 2) none))
  let s ← «做» s (.«原样» (.«设准入口» 45 (some .«蓝铁矿») none (some 1)))
  let s ← «做» s (.«原样» (.«放货» 0 .«蓝铁矿» 50))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let s := «等» w s
  let s ← «做» s (.«原样» (.«重置计数» 30))
  return ((List.range n).foldl (fun (acc : Endfield.«格子».«状态» × List (Nat × Nat)) _ =>
      let t := «等» 4 acc.1
      (t, acc.2 ++ [((t.«模型».«准入口» 30).«累计已收», «箱里几件» t.«模型» 7 .«蓝铁矿»)])) (s, [])).2

-- 看到的一（6 次）：面板上的累计通过数量在点击赶上的头一个整秒时刻就是 1，再过 2 秒是 2；
-- 头一件在数字变 1 以后 14 秒进收货箱（箱里原有 2 件，变 3 件），第二件 23 秒。
#guard («点重置以后每秒» 400 26).map (·.map (·.1)) == some ([1, 1] ++ List.replicate 24 2)
#guard («点重置以后每秒» 400 26).map (·.map (·.2)) ==
  some (List.replicate 14 2 ++ List.replicate 9 3 ++ List.replicate 3 4)

/-- 回放：货源箱 1、一格带、限速的物品准入口 30（每 5 tick 上限 1、累计上限 5000）、一格带、收货箱 60。 -/
def «隔一格» : Option (List «摆件») :=
  [«摆» 1 23 13 (.«协议储存箱» .«下»), «摆» 116 24 16 (.«传送带» .«上» .«下»), «摆» 30 24 17 (.«物品准入口» .«下»),
   «摆» 118 24 18 (.«传送带» .«上» .«下»), «摆» 60 23 19 (.«协议储存箱» .«下»)].mapM id

/-- 回放：布局「隔一格」稳下来以后（走 200 步以后头一件进箱的那一步是 t），`事` 里每一项是（t 以后第几步，做什么）；
做完再走 n 步。给出 t 以后各件进箱的秒数（相对 t）。 -/
def «隔一格着改» («事» : List (Nat × Endfield.«格子».«原样操作»)) (n : Nat) : Option (List Nat) := do
  let s ← «隔一格».bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») (some 5000) (some 1)))
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let T := s.«模型».«历史».«立表»
  let todo := s.«场地».«待写» «端口先后» «无效口»
  let «件» (m : Endfield.«状态») : Nat := «箱里几件» m 60 .«蓝铁矿»
  let «走着记» (m : Endfield.«状态») (k : Nat) : Endfield.«状态» × List Nat :=
    (List.range k).foldl (fun (acc : Endfield.«状态» × List Nat) _ =>
      let t := «走» «取一种» todo T 1 acc.1
      (t, acc.2 ++ [«件» t])) (m, [])
  let m0 := «走» «取一种» todo T 200 s.«模型»
  let (m1, a) := (List.range 60).foldl (fun (acc : Endfield.«状态» × List Nat) _ =>
      if acc.2.length > 0 && acc.2.getLast? != some («件» m0) then acc
      else let t := «走» «取一种» todo T 1 acc.1; (t, acc.2 ++ [«件» t])) (m0, [])
  let t0 := 200 + a.length
  let (st, got, _) ← «事».foldlM (fun (acc : Endfield.«格子».«状态» × List Nat × Nat) c => do
      let (m', x) := «走着记» acc.1.«模型» (c.1 - acc.2.2)
      let s' ← «做» { acc.1 with «模型» := m' } (.«原样» c.2)
      return (s', acc.2.1 ++ x, c.1)) ({ s with «模型» := m1 }, [], 0)
  let (_, b) := «走着记» st.«模型» n
  let «步» := («到的步» ((«件» m1) :: (got ++ b))).drop 1
  return «步».map fun x => (t0 + x - 1 + 3) / 4 - (t0 + 3) / 4

/-- 回放：把每 5 tick 上限关掉。 -/
def «关限速» : Endfield.«格子».«原样操作» := .«设准入口» 30 (some .«蓝铁矿») (some 5000) none
