/-- 回放：准入口只放行蓝铁矿、每 5 tick 上限 k；两个货源箱各放满 300 件，走 n 步，
逐步记下收货箱里源矿、蓝铁矿各几件。 -/
def «逐步» (k n : Nat) : Option (List (Nat × Nat)) := do
  let s ← «两条带».bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») none (some k)))
  let s ← «做» s (.«原样» (.«放货» 1 .«源矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let s ← «做» s (.«原样» (.«放货» 2 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let T := s.«模型».«历史».«立表»
  let todo := s.«场地».«待写» «端口先后» «无效口»
  return ((List.range n).foldl (fun (acc : Endfield.«状态» × List (Nat × Nat)) _ =>
    let t := «走» «取一种» todo T 1 acc.1
    (t, acc.2 ++ [(«箱里几件» t 50 .«源矿», «箱里几件» t 50 .«蓝铁矿»)])) (s.«模型», [])).2

/-- 回放：限速那条的货到的步、参照那条的货到的步。 -/
def «两条各自到的步» (k n : Nat) : Option (List Nat × List Nat) :=
  («逐步» k n).map fun r => («到的步» (r.map fun p => p.2), «到的步» (r.map fun p => p.1))

