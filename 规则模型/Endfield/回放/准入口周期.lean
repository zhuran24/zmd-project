/-! ## 不放行的那件停在哪 -/

/-- 回放：布局甲，上游的准入口不设限，下游的每 5 tick 上限 0（一件都不放行）；货源箱放 300 件，走 80 步，
货源箱里还剩几件。 -/
def «关着时货源箱剩几件» : Option Nat := do
  let s ← «甲».bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») none (some 0)))
  let s ← «做» s (.«原样» (.«设准入口» 31 (some .«蓝铁矿») none none))
  let s ← «做» s (.«原样» (.«放货» 2 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let T := s.«模型».«历史».«立表»
  let todo := s.«场地».«待写» «端口先后» «无效口»
  return «箱里几件» («走» «取一种» todo T 80 s.«模型») 2 .«蓝铁矿»

-- 实测：货源箱 300 件变成 298 件。准入口上游有两格（阀门那一格和一格带子），各停一件；准入口那一格是空的。
#guard «关着时货源箱剩几件» == some 298

/-! ## 上游一直有货时改每 5 tick 上限 -/

/-- 回放：货源箱 1、一格不设限的准入口 5（实测里的阀门，开着）、带、限速的准入口 30、带、收货箱 60。
限速的准入口收下一件以后 24 步这件进收货箱。 -/
def «丙» : Option (List «摆件») :=
  [«摆» 1 29 14 (.«协议储存箱» .«下»), «摆» 60 29 23 (.«协议储存箱» .«下»),
   «摆» 5 30 17 (.«物品准入口» .«下»),
   «摆» 118 30 18 (.«传送带» .«上» .«下»), «摆» 119 30 19 (.«传送带» .«上» .«下»),
   «摆» 30 30 20 (.«物品准入口» .«下»),
   «摆» 121 30 21 (.«传送带» .«上» .«下»), «摆» 122 30 22 (.«传送带» .«上» .«下»)].mapM id

/-- 回放：上限先是 1，上游一直有货。稳下来以后把第 `零` 个整秒的那次放行当第 0 秒
（头一件在第 25 步进准入口，以后第 62、102、142 步……，也就是第 16、26、36 个整秒……各放行一件），
`改` 里每一项是（第几秒，新的上限）：在那个整秒上改。给出第 0 秒起各次放行的秒数。
（放行的那件 24 步以后进收货箱，这里是拿进箱的步数倒推的。） -/
def «改上限于» («零» : Nat) («改» : List (Nat × Nat)) (n : Nat) : Option (List Nat) := do
  let s ← «丙».bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») none (some 1)))
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let T := s.«模型».«历史».«立表»
  let todo := s.«场地».«待写» «端口先后» «无效口»
  let «走着记» (m : Endfield.«状态») (n : Nat) : Endfield.«状态» × List Nat :=
    (List.range n).foldl (fun (acc : Endfield.«状态» × List Nat) _ =>
      let t := «走» «取一种» todo T 1 acc.1
      (t, acc.2 ++ [«箱里几件» t 60 .«蓝铁矿»])) (m, [])
  let (st, got, _) ← «改».foldlM (fun (acc : Endfield.«格子».«状态» × List Nat × Nat) (c : Nat × Nat) => do
      let «到» := («零» + c.1) * 4
      let (m', a) := «走着记» acc.1.«模型» («到» - acc.2.2)
      let s' ← «做» { acc.1 with «模型» := m' } (.«原样» (.«设准入口» 30 (some .«蓝铁矿») none (some c.2)))
      return (s', acc.2.1 ++ a, «到»)) (s, [], 0)
  let (_, b) := «走着记» st.«模型» n
  let «进箱的秒» := («到的步» (got ++ b)).map fun x => (x + 3) / 4
  return («进箱的秒».filter (· ≥ «零» + 6)).map (· - («零» + 6))

/-- 回放：把第 36 个整秒的那次放行当第 0 秒。 -/
def «改上限» := «改上限于» 36

