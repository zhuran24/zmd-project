  let s ← «做» s (.«原样» (.«放货» 0 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  return «每秒看» («等» 400 s) n

-- 看到的五（先算后做，面板数字加 1 读到 5 次、进箱读到 4 次）：面板上的累计通过数量加 1，和 10 秒前放行的那一件进箱，
-- 是同一个整秒时刻——数字一直比箱里的件数多 1。面板要是只显示这一秒头几步的样子，数字会比进箱晚一秒才加。
#guard («限速放行每秒» 24).map (fun l => l.all fun p => p.1 == p.2 + 1) == some true
#guard («限速放行每秒» 24).map (fun l => (l.map (·.1)).eraseDups.length) == some 4

/-- 回放：准入口 30 累计上限 4、不限速；后门 45 每 5 tick 上限 2，紧贴收货箱。头四件走完以后第 `w` 步点重置，每秒看一回。 -/
def «点重置放四件每秒» (w n : Nat) : Option (List (Nat × Nat)) := do
  let s ← («短线» true).bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») (some 4) none))
  let s ← «做» s (.«原样» (.«设准入口» 45 (some .«蓝铁矿») none (some 2)))
  let s ← «做» s (.«原样» (.«放货» 0 .«蓝铁矿» 50))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let s ← «做» («等» w s) (.«原样» (.«重置计数» 30))
  return «每秒看» s n

-- 看到的六（先算后做，4 次）：面板数字在 F 变 1，以后每 2 秒加 1；四件在 F 以后 10、12、19、21 秒进箱（箱里原有 4 件）。
-- 四件一件跟一件、都隔 8 步：第 3、4 件各等第 1、2 件用的名额，名额都是 39 步空。
#guard («点重置放四件每秒» 400 26).map (·.map (·.1)) == some ([1, 1, 2, 2, 3, 3] ++ List.replicate 20 4)
#guard («点重置放四件每秒» 400 26).map (·.map (·.2)) ==
  some (List.replicate 10 4 ++ [5, 5] ++ List.replicate 7 6 ++ [7, 7] ++ List.replicate 5 8)

end Endfield.«回放».«准入口周期»
