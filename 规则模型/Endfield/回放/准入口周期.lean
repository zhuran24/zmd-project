import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-11-25.md「物品准入口的每 5 tick 上限」一节。
核对的是那一节看到的几件事：
- 每 5 tick 上限 1、上游一直有货等着时，稳下来以后每 40 步放行一件；停过一阵再来货，头两件隔 36 步；
- 上限不是从头一件起算的固定一段：收下的每一件各用一个名额，名额各自空出来（先放一件、隔几秒再连续来货的那几组，
  和先让模型算好预计再去做的那十次）；
- 一个名额用掉以后，整秒上看 9 秒或者 10 秒以后空出来：走过来的货（整秒后第 1 步到）用的是 9 秒，
  等着名额、名额一空出来就进去的货（整秒后第 2 步）和紧跟在它后面补上来的货用的是 10 秒
  （先连着放满名额、停一阵再来货的那四次，排除了「满过一次以后都算 10 秒」这类说法；改上限的那几组见文件末尾）；
- 不放行的那件停在准入口上游那一格，不进准入口那一格。

摆件的坐标、朝向照实测记录（MCP 的格坐标，3×3 的单位给的是左上角那一格）。
实测里送的是碳块；模型的物品里没有碳块，这里换成蓝铁矿，和物品种类无关。
游戏里看得到的时刻都落在整秒（4 步）上。这里各次操作都放在 4 步的整倍数上，货到收货箱的步数换成「第几个整秒」再比
（整秒后第 1 到 4 步发生的事，都在下一个整秒才看得到）。
-/

namespace Endfield.«回放».«准入口周期»

open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 回放：件数变多的那些步（从 1 数起）。 -/
def «到的步» (xs : List Nat) : List Nat :=
  ((xs.zip (0 :: xs)).zipIdx.filter fun ((a, b), _) => a > b).map fun (_, i) => i + 1

/-- 回放：各件到的步，都减去头一件到的那一步。 -/
def «相对头一件» (xs : List Nat) : List Nat :=
  match xs with
  | [] => []
  | a :: _ => xs.map (· - a)

/-- 回放：各件到的步换成第几个整秒（整秒后第 1 到 4 步到的，下一个整秒看得到），再都减去头一件的。 -/
def «相对头一件的秒» (xs : List Nat) : List Nat :=
  «相对头一件» (xs.map fun x => (x + 3) / 4)

/-! ## 两条带进同一个收货箱：一条不限，一条限速 -/

/-- 回放：货源箱 1（源矿）、2（限速那条的货）、收货箱 50；参照带 11–16，限速带 21–26，
物品准入口 30 换在带 22 那一格。 -/
def «两条带» : Option (List «摆件») :=
  [«摆» 1 26 15 (.«协议储存箱» .«下»), «摆» 2 32 15 (.«协议储存箱» .«下»),
   «摆» 50 29 23 (.«协议储存箱» .«下»),
   «摆» 11 28 18 (.«传送带» .«上» .«下»), «摆» 12 28 19 (.«传送带» .«上» .«下»),
   «摆» 13 28 20 (.«传送带» .«上» .«右»), «摆» 14 29 20 (.«传送带» .«左» .«下»),
   «摆» 15 29 21 (.«传送带» .«上» .«下»), «摆» 16 29 22 (.«传送带» .«上» .«下»),
   «摆» 21 32 18 (.«传送带» .«上» .«下»), «摆» 22 32 19 (.«传送带» .«上» .«下»),
   «摆» 23 32 20 (.«传送带» .«上» .«左»), «摆» 24 31 20 (.«传送带» .«右» .«下»),
   «摆» 25 31 21 (.«传送带» .«上» .«下»), «摆» 26 31 22 (.«传送带» .«上» .«下»),
   «摆» 30 32 19 (.«物品准入口» .«下»)].mapM id

/-- 回放：准入口只放行蓝铁矿、每 5 tick 上限 k；两个货源箱各放满 300 件，走 n 步，
逐步记下收货箱里源矿、蓝铁矿各几件。 -/
def «逐步» (k n : Nat) : Option (List (Nat × Nat)) := do
  let s ← «两条带».bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») none (some k)))
  let s ← «做» s (.«原样» (.«放货» 1 .«源矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let s ← «做» s (.«原样» (.«放货» 2 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let T := s.«模型».«历史».«立表»
  let todo := s.«场地».«待写» «端口先后» «无效口»
  return ((List.range n).foldl (fun (acc : Endfield.«状态» × List (Nat × Nat)) _ =>
    let t := «走» «取一种» todo T 1 acc.1
    (t, acc.2 ++ [(«箱里几件» t 50 .«源矿», «箱里几件» t 50 .«蓝铁矿»)])) (s.«模型», [])).2

/-- 回放：限速那条的货到的步、参照那条的货到的步。 -/
def «两条各自到的步» (k n : Nat) : Option (List Nat × List Nat) :=
  («逐步» k n).map fun r => («到的步» (r.map fun p => p.2), «到的步» (r.map fun p => p.1))

-- 参照那条每 8 步到一件。
#guard («两条各自到的步» 1 300).map (·.2.take 8) == some [49, 57, 65, 73, 81, 89, 97, 105]
-- 上限 1：第二件比头一件晚 9 秒（上限 1 的十次都是），以后每 10 秒一件
-- （实测连着 42 段，每两件之间正好 5 件参照的货）。模型里头一件在整秒后第 1 步进准入口，名额 37 步以后空出来，
-- 等着的第二件在那一步（整秒后第 2 步）进去，以后每 40 步一件。
-- 这里两条带同一步放货，所以两路的头一件同一步到；实测这个布局时两个准入口先后打开，头一件差 4 秒，
-- 「两路头一件同一刻到」是在同一个货源箱分出两条等长带子的布局上看到的（读箱 pair-1…3）。
#guard («两条各自到的步» 1 300).map (·.1) == some [49, 86, 126, 166, 206, 246, 286]
#guard («两条各自到的步» 1 300).map (fun p => «相对头一件的秒» p.1) == some [0, 9, 19, 29, 39, 49, 59]
-- 上限 2：实测各件相对头一件 0、1.9、8.9、10.9、18.9、20.9 秒。
#guard («两条各自到的步» 2 140).map (fun p => «相对头一件的秒» p.1) == some [0, 2, 9, 11, 19, 21]
-- 上限 4：实测 0、2、3.9、5.9、8.9、11、13、15、19 秒。
#guard («两条各自到的步» 4 130).map (fun p => «相对头一件的秒» p.1) == some [0, 2, 4, 6, 9, 11, 13, 15, 19]
-- 上限 5：限速那条每 8 步到一件，没有空档（实测时参照那条的货源已经空了，只看得到限速那条每 2 秒一件）。
#guard («两条各自到的步» 5 300).map (fun p => (p.1.zip (p.1.drop 1)).all fun (a, b) => b - a == 8) == some true

/-! ## 先放一件、隔几秒再连续来货 -/

/-- 回放：货源箱 2、收货箱 50，中间一条直带，带上换两个物品准入口：上游的 31 当阀门，下游的 30 限速。
`顶` 是货源箱左上角那一格的 j，`带` 是带子各格的 j，`阀`、`限` 是两个准入口各在哪一格。 -/
def «一条带» («顶» : Nat) («带» : List Nat) («阀» «限» : Nat) : Option (List «摆件») :=
  ([«摆» 2 32 «顶» (.«协议储存箱» .«下»), «摆» 50 32 23 (.«协议储存箱» .«下»)]
   ++ («带».map fun j => «摆» (100 + j) 32 j (.«传送带» .«上» .«下»))
   ++ [«摆» 31 32 «阀» (.«物品准入口» .«下»), «摆» 30 32 «限» (.«物品准入口» .«下»)]).mapM id

/-- 回放：下游的准入口每 5 tick 上限 k。上游的先设累计上限 m（连着放 m 件就停），货源箱放满；
走 `隔` 步以后把上游的累计上限关掉（连续来货），再走 n 步。给出各件到收货箱的秒数，相对头一件。 -/
def «放几件停一下» (ps : Option (List «摆件»)) (k m «隔» n : Nat) : Option (List Nat) := do
  let s ← ps.bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») none (some k)))
  let s ← «做» s (.«原样» (.«设准入口» 31 (some .«蓝铁矿») (some m) none))
  let s ← «做» s (.«原样» (.«放货» 2 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let T := s.«模型».«历史».«立表»
  let todo := s.«场地».«待写» «端口先后» «无效口»
  let «走着记» (m : Endfield.«状态») (n : Nat) : Endfield.«状态» × List Nat :=
    (List.range n).foldl (fun (acc : Endfield.«状态» × List Nat) _ =>
      let t := «走» «取一种» todo T 1 acc.1
      (t, acc.2 ++ [«箱里几件» t 50 .«蓝铁矿»])) (m, [])
  let (m', a) := «走着记» s.«模型» «隔»
  let s ← «做» { s with «模型» := m' } (.«原样» (.«设准入口» 31 (some .«蓝铁矿») none none))
  let (_, b) := «走着记» s.«模型» n
  return «相对头一件的秒» («到的步» (a ++ b))

/-- 回放：先放一件、隔一阵再连续来货。 -/
def «断续» (ps : Option (List «摆件»)) (k «隔» n : Nat) : Option (List Nat) := «放几件停一下» ps k 1 «隔» n

/-- 回放：实测里准入口贴着货源箱的那个布局（带 (32,18)–(32,22)，阀门在 (32,18)，限速的在 (32,20)）。 -/
def «甲» := «一条带» 15 [18, 19, 20, 21, 22] 18 20
/-- 回放：实测里带子加长的那个布局（带 (32,16)–(32,22)，阀门在 (32,17)，限速的在 (32,19)）。 -/
def «乙» := «一条带» 13 [16, 17, 18, 19, 20, 21, 22] 17 19

-- 上限 2、两件隔 3 秒，做了三次都是 0、3、9、12、19、22、29、32 秒：
-- 第 3、4 件各在第 1、2 件之后 9 秒放行，两件之间那 3 秒一直留着。
-- 要是「从头一件起算、走完清零、下一件重新起算」，第 4 件会紧跟第 3 件，是 0、3、9（或 10）、11（或 12）、……
#guard «断续» «甲» 2 12 180 == some [0, 3, 9, 12, 19, 22, 29, 32]
-- 上限 3，两件隔 6、7、8 秒各一次。这个布局里阀门上游还有一格带子，第二件已经停在那一格上等着，
-- 所以阀门打开得比头一件进阀门晚 24、28、32 步，就是头一件出货源箱以后 32、36、40 步（两件隔 6、7、8 秒）：
#guard «断续» «乙» 3 32 200 == some [0, 6, 8, 10, 15, 17, 19, 25, 27, 29, 35, 37, 39]
#guard «断续» «乙» 3 36 200 == some [0, 7, 9, 11, 16, 18, 20, 26, 28, 30, 36, 38, 40]
#guard «断续» «乙» 3 40 200 == some [0, 8, 10, 12, 17, 19, 21, 27, 29, 31, 37, 39, 41]

/-- 回放：布局乙里，头一件到下游准入口以后 g 秒，第二件（或停过以后的下一件）到；各件到收货箱的秒数。 -/
def «乙秒» (k m g n : Nat) : Option (List Nat) :=
  «放几件停一下» «乙» k m (g * 4 + 8) n

-- 先让模型算出预计、再去游戏里做的十次（读箱 blind-1…10），逐件和预计一样。括号里是读到的件数。
#guard («乙秒» 4 1 5 190).map (·.take 16) == some [0, 5, 7, 9, 11, 14, 16, 18, 20, 24, 26, 28, 30, 34, 36, 38]
#guard («乙秒» 4 1 6 190).map (·.take 16) == some [0, 6, 8, 10, 12, 15, 17, 19, 21, 25, 27, 29, 31, 35, 37, 39]
#guard («乙秒» 4 1 9 190).map (·.take 16) == some [0, 9, 11, 13, 15, 18, 20, 22, 24, 28, 30, 32, 34, 38, 40, 42]
#guard («乙秒» 2 1 6 190).map (·.take 9) == some [0, 6, 9, 15, 19, 25, 29, 35, 39]
#guard («乙秒» 2 1 9 190).map (·.take 9) == some [0, 9, 11, 18, 20, 28, 30, 38, 40]
#guard («乙秒» 4 1 4 190).map (·.take 16) == some [0, 4, 6, 8, 10, 13, 15, 17, 19, 23, 25, 27, 29, 33, 35, 37]
-- 下面两次里有一件正好在名额空出来的那一秒到（上限 4 隔 3 秒的第 5 件、上限 2 隔 7 秒的第 3 件）。
-- 它到的那一步（整秒后第 1 步）名额还占着，下一步名额空出来它才进去，所以这个名额占 40 步
-- （对应的那件在第 19 秒放行，不是第 18 秒）。
#guard («乙秒» 4 1 3 190).map (·.take 16) == some [0, 3, 5, 7, 9, 12, 14, 16, 19, 22, 24, 26, 29, 32, 34, 36]
#guard («乙秒» 2 1 7 190).map (·.take 9) == some [0, 7, 9, 16, 19, 26, 29, 36, 39]

-- 先连着放 4 件（上限 2，两个名额都用过两轮），停到头一件之后 20、21 秒才来第 5 件：这时一个名额已经空了 1、2 秒，
-- 另一个还占着或刚空出来。实测（读箱 停一下-1…4，各两次）第 7 件在第 5 件之后 9 秒放行，
-- 也就是第 5 件（走过来的货）用掉的名额 9 秒以后就又空出来了。「满过一次以后都算 10 秒」之类的说法给的是 10 秒。
#guard «乙秒» 2 4 20 150 == some [0, 2, 9, 11, 20, 22, 29, 31, 39, 41]
