import Endfield.«回放».«工具»

/-!
# 一个一直有货的箱子和一个中转箱贴着同一个汇流器（实测-2026-11-10 第三节）

到实测-2026-11-10 第二节为止，`再判一次` 和 `每步判两次` 两种说法走出来都和看到的一样：
- `再判一次`：一步开头的输入判定没有选出通道时，才在非运输单位的移动判定之前再判一次；开头选出了的，整步只认那一条；
- `每步判两次`：不管开头选没选出，非运输单位的移动判定之前都再判一次，非运输单位只认后一次的。

两种只在这样的步里不同：开头的输入判定已经选出一条从非运输单位来的通道（那个单位一直有货），
元件的移动判定期间另一个非运输单位才到货（中转箱，来一件走一件），而汇流器这一步还收得下。

布局：货源箱 S 经四格带子进中转箱 W；W 一个出口紧贴汇流器 M，另一个出口经带子、物品准入口、带子进自己的收货箱 X
（第一格带子的次序是 3，M 的次序是 2，W 先试 M）；存货箱 A 一个出口紧贴 M，没有别的出口；M 经七格带子进收货箱 Y。
S 里是源矿，A 里是蓝铁块，Y 里两种各有几件就是 M 收了谁的。

做法的先后有讲究：先让 S 的货走起来（这时 A 空着，W 的货全进 M，M 每 tick 空出来的那一步正好是 W 到货的那一步），
再往 A 里放货。反过来先放 A 的货，M 空出来的那一步由 A 定，和 W 到货的那一步多半对不上，W 的货到的时候 M 是满的，
两种说法都是 A 独占、W 的货全走自己的带子，分不开。

这份里的数是实测做之前照模型走出来的。
-/

namespace Endfield.«回放».«存货箱和中转箱»

/-- 回放：布局（S 和 A 都还没放货）。S=0，S→W 的带 1–4；W=30，A=31；M=40，M→Y 的带 41–47；
W→X：带 51、物品准入口 55、带 52；X=20，Y=22。`A先建`：W、A 两个箱子里 A 先建成；`A先接`：M 的两个进口里 A 那条先接通。 -/
def «布置» («A先建» «A先接» : Bool) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 20 .«协议储存箱», «建» 22 .«协议储存箱», «仓储» 0, «仓储» 20, «仓储» 22]
  ++ (if «A先建» then [«建» 31 .«协议储存箱», «仓储» 31, «建» 30 .«协议储存箱», «仓储» 30]
      else [«建» 30 .«协议储存箱», «仓储» 30, «建» 31 .«协议储存箱», «仓储» 31])
  ++ [«建» 40 .«汇流器»] ++ (if «A先接» then [«连» 31 40, «连» 30 40] else [«连» 30 40, «连» 31 40])
  ++ «一串带» 40 [41, 42, 43, 44, 45, 46, 47] ++ [«连» 47 22]
  ++ [«建» 51 .«传送带», «连» 30 51, «建» 55 .«物品准入口», «连» 51 55, «建» 52 .«传送带», «连» 55 52, «连» 52 20,
      .«做» (.«设准入口» 55 (some .«源矿») none none)]
  ++ «一串带» 0 [1, 2, 3, 4] ++ [«连» 4 30]

/-- 回放：读数：X 里的源矿、Y 里的源矿、Y 里的蓝铁块、W 里的源矿、A 里剩的蓝铁块。 -/
def «读» (s : «状态») : List Nat :=
  [«箱里几件» s 20 .«源矿», «箱里几件» s 22 .«源矿», «箱里几件» s 22 .«蓝铁块»,
   «箱里几件» s 30 .«源矿», «箱里几件» s 31 .«蓝铁块»]

/-- 回放：实测的做法。放满 S，走 `先走` 步，再放满 A，走 `再走` 步；照说法 `v`。 -/
def «中转箱先到» (v : «都没货时») (a b : Bool) («先走» «再走» : Nat) : Option (List Nat) :=
  let un : «未定» := { «取一种» with «输入判定都没货时» := v }
  («演于» un «状态».«空» («布置» a b ++ «装满» 0 .«源矿» ++ [.«等» «先走»]
    ++ «装满» 31 .«蓝铁块» ++ [.«等» «再走»])).map «读»

/-- 回放：反过来的做法。放满 A，走 `隔` 步，再放满 S，走 `再走` 步；照说法 `v`。 -/
def «存货箱先到» (v : «都没货时») («隔» «再走» : Nat) : Option (List Nat) :=
  let un : «未定» := { «取一种» with «输入判定都没货时» := v }
  («演于» un «状态».«空» («布置» false false ++ «装满» 31 .«蓝铁块» ++ [.«等» «隔»]
    ++ «装满» 0 .«源矿» ++ [.«等» «再走»])).map «读»

-- A 还空着的 30 tick：两种说法都是 W 的货全进 M（X 是 0），和 W、A 谁先建、谁先接通无关。
#guard [«都没货时».«再判一次», .«每步判两次»].all fun v => [false, true].all fun a => [false, true].all fun b =>
  «中转箱先到» v a b (8 * 30) 0 == some [0, 18, 0, 0, 300]

-- 放满 A 以后再走 40 tick，和谁先建、谁先接通无关：
-- 「再判一次」：M 只收 A 的（Y 里蓝铁块 32，A 少了 40），W 的货全走自己的带子（X 37，约每 tick 一件）；Y 里的源矿停在放 A 之前的 26。
#guard [false, true].all fun a => [false, true].all fun b =>
  «中转箱先到» .«再判一次» a b (8 * 30) (8 * 40) == some [37, 26, 32, 0, 260]
-- 「每步判两次」：M 轮流收 A 和 W 的（Y 里蓝铁块 16、源矿又多 16，A 只少了 20），X 是 19，约每 2 tick 一件。
#guard [false, true].all fun a => [false, true].all fun b =>
  «中转箱先到» .«每步判两次» a b (8 * 30) (8 * 40) == some [19, 42, 16, 0, 280]

-- 放 A 的货落在哪一步不要紧（玩家的操作落在一 tick 里的哪一步是控制不了的）：八种落点两种说法各自都一样。
#guard (List.range 8).all fun k =>
  («中转箱先到» .«再判一次» false false (8 * 30 + k) (8 * 40)).map (fun l => (l[0]?, l[2]?)) == some (some 37, some 32)
#guard (List.range 8).all fun k =>
  («中转箱先到» .«每步判两次» false false (8 * 30 + k) (8 * 40)).map (fun l => (l[0]?, l[2]?)) == some (some 19, some 16)

-- 反过来先放 A 的货：`再判一次` 八种落点都是 A 独占；
#guard (List.range 8).all fun k =>
  («存货箱先到» .«再判一次» k (8 * 60)).map (fun l => (l[0]?, l[1]?)) == some (some 53, some 0)
-- `每步判两次` 只有两次放货正好隔整 tick（M 空出来和 W 到货落在同一步）才轮流，其余七种落点也是 A 独占，和 `再判一次` 分不开。
#guard («存货箱先到» .«每步判两次» 0 (8 * 60)).map (fun l => (l[0]?, l[1]?)) == some (some 26, some 24)
#guard (List.range 7).all fun k =>
  («存货箱先到» .«每步判两次» (k + 1) (8 * 60)).map (fun l => (l[0]?, l[1]?)) == some (some 53, some 0)

end Endfield.«回放».«存货箱和中转箱»
