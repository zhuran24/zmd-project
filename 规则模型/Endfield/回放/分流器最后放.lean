import Endfield.«回放».«工具»

/-!
# 回放：分流器最后放、两条支路先建好时，分流器的次序跟哪条支路

来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-10-10.md 同名第一节。

先列观察，下面逐项核对：
1. 第一组放货 50 秒后：右下箱碳块 13、源矿 12，左下箱碳块 15；分流成功。
2. 第二组重建并清空下方箱子，跑 50 秒：右下箱碳块 2、源矿 23，左下箱碳块 28；分流失败。
3. 第二组那 2 件碳块在汇流器下方带拉好之前进入汇流器，属于重建期间的货。
4. 两组结果与按终点先后算一致；社区同样两种先后，第一组隔拍有货、第二组每拍有货。
   此处的隔拍/每拍读分流器下方带（两组的汇流器下方带都满速）。

单位：左上货源箱 0，右上货源箱 13；进料带 1、2 和 3、4；分流器 5，汇流器 6；
下方带 7、8 进左下箱 9，下方带 10、11 进右下箱 12。5→6 直接相连，5 左边不接通道。
模型没有碳块，以蓝铁矿标记碳块，源矿仍为源矿；没有制造，物品替名不改变运输判定。

来源没有带子格数、初始放货数量、四箱和两条进料带内部的建造先后。
这里沿用同类回放《现象》第 11 条每段两格的抽象，四箱依次为 0、13、9、12，
然后左进料带、右进料带；货源各装满六格。它们都是显式补定，不能据此核实实测的绝对件数。
两次读数均固定在放货/第二组重建结束后 200 步（50 秒；来源实验 B 写明 1 tick = 2 秒）。
不加预热，也不按实测件数调整带长或读数时刻。

接通按规则文件「接通」：分流器先存货口 2→5，再取货口顺时针右 5→6、下 5→7；
汇流器先存货口顺时针左 5→6、上 4→6，再取货口 6→10。每段带按从上游到下游建接。
第一组临时分流器确实建、接、拆；最后的分流器重新建成。所有建接操作之间不走步。
第二组从第一组的读数状态接着做，保留两个货源和进料带上的货；清空下方箱子。
来源没记各次拆建耗时、清箱在拆建之间的准确时刻：此处清箱在拆完后，重建之间零步。
因此无法回放重建中那 2 件碳块的产生；不能把零步重建的结果当作否定该观察。

跳过：两次拐弯、端口朝向、紧贴形成通道的几何验证（模型无坐标/端口）；
真实带长对应的绝对件数、重建期间货流的准确时刻无法由来源恢复。
下列绝对件数的差异只记录该显式补定下的模型值，原因不足以归到规则或模型。
边界清单已列「建一个单位拆成建成加接通」「拆除时货去哪」「通道增减后的轮询」；
这里不另定未定参数，全部使用工具的取一种，没有新发现的规则缺口。
-/

namespace Endfield.«回放».«分流器最后放»

/-- 回放：按列出的顺序拆除单位。 -/
def «拆» (us : List «单位号») : List «一幕» :=
  us.map fun u => .«做» (.«改布局» (.«拆除» u))

/-- 回放：四箱和两条进料带先放好，箱子均设仓储模式，避免收货传回仓库。 -/
def «上游» : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 13 .«协议储存箱»,
   «建» 9 .«协议储存箱», «建» 12 .«协议储存箱»,
   «仓储» 0, «仓储» 13, «仓储» 9, «仓储» 12]
  ++ «一串带» 0 [1, 2] ++ «一串带» 13 [3, 4]

/-- 回放：第一组，临时分流器拉好左下支路后拆掉，汇流器和右下支路建好，最后放分流器并放货。 -/
def «第一组» : List «一幕» :=
  «上游» ++ [«建» 5 .«分流器», «连» 2 5]
  ++ «一串带» 5 [7, 8] ++ [«连» 8 9] ++ «拆» [5]
  ++ [«建» 6 .«汇流器», «连» 4 6]
  ++ «一串带» 6 [10, 11] ++ [«连» 11 12]
  ++ [«建» 5 .«分流器», «连» 2 5, «连» 5 6, «连» 5 7]
  ++ «装满» 0 .«蓝铁矿» ++ «装满» 13 .«源矿»

/-- 回放：清空两个下方箱子的六个物品格，保留货源、进料带和轮询状态。 -/
def «清箱» (s : «状态») : «状态» :=
  ([9, 12].flatMap fun u => (List.range 6).map fun i => («格位».mk u (.«格» i))).foldl
    (fun s g => { s with «货» := «换» s.«货» g [] }) s

/-- 回放：第二组依次重放分流器、汇流器、分下带、汇下带；不重新装货。 -/
def «重建» : List «一幕» :=
  [«建» 5 .«分流器», «连» 2 5,
      «建» 6 .«汇流器», «连» 5 6, «连» 4 6]
  ++ «一串带» 5 [7, 8] ++ [«连» 8 9]
  ++ «一串带» 6 [10, 11] ++ [«连» 11 12]

/-- 回放：两个起始状态；第二组承接第一组放货后 200 步的状态。 -/
def «起点» (second : Bool) : Option «状态» :=
  («演» «状态».«空» «第一组»).bind fun s =>
    if second then
      («演» («走几步» 200 s) («拆» [5, 6, 7, 8, 10, 11])).bind fun t =>
        «演» («清箱» t) «重建»
    else some s

/-- 回放：按来源顺序读取右下碳块、右下源矿、左下碳块，并额外检查左下没有源矿。 -/
def «读箱» (s : «状态») : List Nat :=
  [«箱里几件» s 12 .«蓝铁矿», «箱里几件» s 12 .«源矿»,
   «箱里几件» s 9 .«蓝铁矿», «箱里几件» s 9 .«源矿»]

/-- 回放：在来源的 50 秒读数时刻读取，不添加预热时间。 -/
def «五十秒» (second : Bool) : Option (List Nat) :=
  («起点» second).map fun s => «读箱» («走几步» 200 s)

/-- 回放：全部 200 步里左下箱实际收到货的步号，用来核对每拍/隔拍。 -/
def «到货步» (second : Bool) : Option (List Nat) :=
  («起点» second).map fun s =>
    let ns := «逐次看» (fun s => «箱里几件» s 9 .«蓝铁矿») (List.range 201) s
    ((ns.zip ns.tail).zip (List.range 200)).filterMap fun p =>
      if p.1.2 > p.1.1 then some (p.2 + 1) else none

/-- 回放：相邻两次左下到货之间隔多少步；不跳过启动后的任何到货事件。 -/
def «到货间隔» (second : Bool) : Option (List Nat) :=
  («到货步» second).map fun ts => (ts.zip ts.tail).map fun p => p.2 - p.1

/-- 回放：两组里分流器、汇流器的次序，用以核对来源的按终点解释。 -/
def «次序» (second : Bool) : Option (List (Option Nat)) :=
  («起点» second).map fun s => [5, 6].map fun u =>
    s.«历史».«次序» s.«历史».length u

-- 观察 1 的分流成功：右下确实收到了碳块标记，左下也有碳块。
#guard («五十秒» false).map (fun ns => (ns[0]?).any (· > 0) && (ns[2]?).any (· > 0)) == some true
-- 件数：来源 50 秒时右下碳块 13、源矿 12，左下碳块 15；模型 25 tick 时是 9、11、10。带长来源没记，起步晚几件；右下两种货各一半、左下只有碳块，这两点一样。
#guard «五十秒» false == some [9, 11, 10, 0]

-- 观察 2 的分流失败：第二组重建结束后碳块不进右下；两路各自进下方箱子。
#guard («五十秒» true).map (fun ns =>
  ns[0]? == some 0 && (ns[1]?).any (· > 0) && (ns[2]?).any (· > 0)) == some true
-- 件数：来源右下碳块 2、源矿 23，左下碳块 28；模型是 0、22、22。右下那 2 件碳块来源写明是重建期间进汇流器的，模型里重建不走步，没有这 2 件。
#guard «五十秒» true == some [0, 22, 22, 0]

-- 观察 3：跳过重建期间那2件碳块的产生过程。来源没记走了几步，不能补造过程来凑2件。
-- 模型里重建不走步，重建完汇流器里是空的。
#guard («起点» true).map (fun s => «格里» s 6) == some none

-- 观察 4：两组分流器次序都是2，与汇流器同层，符合按先接上终点的左下支路算。
#guard «次序» false == some [some 2, some 2]
#guard «次序» true == some [some 2, some 2]
-- 观察 4：第一组隔拍；第二组每拍。核对全部相邻到货间隔，非空检查避免空表也通过。
#guard («到货间隔» false).map (fun ds => !ds.isEmpty && ds.all (· == 16)) == some true
#guard («到货间隔» true).map (fun ds => !ds.isEmpty && ds.all (· == 8)) == some true

end Endfield.«回放».«分流器最后放»
