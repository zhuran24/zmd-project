import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-11-12.md。
核对的是桥接器建成时四条边接通的先后：存货端口依次是它自己的上、下、左、右，
取货端口依次是下、上、右、左，都跟着桥接器转。

存货端口的四个角回放了 rot=0、1 的稳定读数和 rot=3 重放左分流器的校准，另按 rot=0
首次从空箱起读的四次 box_watch 核头 12 件。rot=2、3 的四角同时接通没有逐角走步回放。
11-12 存货端口同轴两头的屏幕上下、屏幕左右两组（各 rot=0–3 及重放校准）尚无回放。
11-27 直接放 rot=0、2 后读箱的上下布局另见「贴箱的分流器」。
取货端口已回放甲左乙右、甲左乙下和甲上乙下三组，包括各自四种朝向和校准。

坐标取固定网格，箱子给占地左上角。钢块代实测的碳块。
-/

namespace Endfield.«回放».«桥接器各边»

open Endfield.«格子» Endfield.«回放».«格子»

/-- 回放：实测里桥接器的 rot（顺时针转几次）对应的朝向。 -/
def «转几次» : Nat → «朝向»
  | 0 => .«上» | 1 => .«右» | 2 => .«下» | _ => .«左»

/-- 回放：每次放货以后压平一次，免得连着放货越来越慢。 -/
def «放» (u : Nat) (x : «物品») (k : Nat) (s : Endfield.«格子».«状态») :
    Option Endfield.«格子».«状态» :=
  (List.range k).foldlM (fun s _ =>
    («做» s (.«原样» (.«放货» u x 50))).map fun t =>
      { t with «模型» := «压平» t.«模型».«布局» t.«模型» }) s

/-! ## 存货端口：四个分流器围着桥接器，四个角轮流放汇流器 -/

/-- 回放：绕桥接器所在的 (27,20) 顺时针转一次，号加 100。 -/
def «绕一次» (p : «摆件») : Option «摆件» :=
  «摆» (p.«号» + 100) (48 - p.«位置».j.val - p.«大小».2) (p.«位置».i.val - 7) («转种类» p.«种类»)

/-- 回放：绕桥接器转 k 次。 -/
def «绕» : Nat → «摆件» → Option «摆件»
  | 0, p => some p
  | k + 1, p => («绕一次» p).bind («绕» k)

/-- 回放：上边那条臂和左上角的固定件：货源箱 1、进货带 2 3、出货带 5 6 7、收货箱 8。
另外三条臂、三个角是它绕桥接器转出来的（号各加 100、200、300）。 -/
def «臂» : Option (List «摆件») :=
  [«摆» 1 26 14 (.«协议储存箱» .«下»), «摆» 8 22 15 (.«协议储存箱» .«上»),
   «摆» 5 26 18 (.«传送带» .«下» .«左»), «摆» 6 25 18 (.«传送带» .«右» .«左»),
   «摆» 7 24 18 (.«传送带» .«右» .«上»),
   «摆» 2 27 17 (.«传送带» .«上» .«下»), «摆» 3 27 18 (.«传送带» .«上» .«下»)].mapM id

/-- 回放：上边的分流器 4（进口朝外）；另外三个是它转出来的 104、204、304。 -/
def «分流器» (k : Nat) : Option «摆件» := («摆» 4 27 19 (.«分流器» .«上»)).bind («绕» k)

/-- 回放：左上角的汇流器 9（出口朝上）；另外三个角是 109、209、309。角 k 比的是臂 k-1 和臂 k。 -/
def «汇流器» (k : Nat) : Option «摆件» := («摆» 9 26 19 (.«汇流器» .«上»)).bind («绕» k)

/-- 回放：四条臂的货，依次是上（实测碳块，这里用钢块）、右、下、左。 -/
def «臂货» : List «物品» := [.«钢块», .«蓝铁块», .«源矿», .«蓝铁矿»]

/-- 回放：先放八个箱子，再借各角临时的汇流器拉出货带。收掉四个汇流器后才拉进货带、
放四个分流器。 -/
private def «空十字» : Option Endfield.«格子».«状态» := do
  let [source, sink, c₁, c₂, c₃, b₁, b₂] ← «臂» | none
  let mut s := Endfield.«格子».«状态».«空»
  for k in [:4] do
    s ← «建好» s (← «绕» k source)
    s ← «建好» s (← «绕» ((k + 2) % 4) sink)
  for k in [:4] do
    s ← «建好» s (← «汇流器» k)
    s ← (← [c₁, c₂, c₃].mapM («绕» k)).foldlM «建好» s
  s ← «依次» s ([9, 109, 209, 309].map .«收»)
  for k in [:4] do
    s ← (← [b₁, b₂].mapM («绕» k)).foldlM «建好» s
  for k in [:4] do
    s ← «建好» s (← «分流器» k)
  return s

/-- 回放：11-12 调用 31–34 按上、右、下、左各放四组，每组 50 件。四次面板的六格
都是 50、50、50、48、空、空。四组的点击和采样都在各自调用内，没有逐次时刻。
模型连放前三组，再枚举末组放入的时刻，核对同一窗口内可读出六格。保留该场地走到
下一次调用。起点间隔和末次调用长度按每秒四步取整。 -/
def «十字» : Option Endfield.«格子».«状态» := do
  let mut s ← «空十字»
  for ((window, span), k) in [(46,57), (47,55), (40,50), (37,37)].zipIdx do
    let u := 100 * k + 1
    let x := «臂货».getD k .«源矿»
    s ← «放» u x 3 s
    let (_, states) := «逐步读» s window id
    -- 末组补到编号最小的未满格。面板可在末组放完后的同一步读到；其后仍继续进料。
    let (t, elapsed) ← states.zipIdx.findSome? fun (m, n) => do
      let filled ← «放» u x 1 {s with «模型» := m}
      let slots := (List.range 6).map fun i => filled.«模型».«件数» ⟨u, .«格» i⟩ x
      guard (slots == [50,50,50,48,0,0] && «箱货» filled u x == 198)
      return (filled, n)
    s := «等» (span - elapsed) t
  return s

#guard «十字».isSome

/-- 回放：在角 k 放汇流器，先走 96 步等带子排满，再走 64 步，读这 64 步里这个角的收货箱进的是哪条臂的货
（0 上 1 右 2 下 3 左；不是正好一条臂在进就记 9），然后收掉汇流器。 -/
def «一个角» (s : Endfield.«格子».«状态») (k : Nat) :
    Option (Endfield.«格子».«状态» × Nat) := do
  let m ← «汇流器» k
  let a := «等» 96 (← «做» s (.«建» m))
  let b := «等» 64 a
  let v := «臂货».map fun x => «箱货» b (100 * k + 8) x - «箱货» a (100 * k + 8) x
  let w := (List.range 4).filter fun i => v.getD i 0 > 0
  return (← «做» b (.«收» (100 * k + 9)), if w.length == 1 && v.getD (w.getD 0 0) 0 ≥ 6 then w.getD 0 9 else 9)

/-- 回放：四个角依次读一遍。 -/
def «四个角» (s : Endfield.«格子».«状态») : Option (List Nat) := do
  let (_, out) ← (List.range 4).foldlM (fun (acc : Endfield.«格子».«状态» × List Nat) k => do
    let (t, w) ← «一个角» acc.1 k
    return (t, acc.2 ++ [w])) (s, [])
  return out

/-- 回放：桥接器（转 r 次）最后放，四个分流器同一刻接上它，然后读四个角。 -/
def «同时接上» (r : Nat) : Option (List Nat) := do
  let s ← «十字»
  let s ← «做» s (.«建» (← «摆» 900 27 20 (.«桥接器» («转几次» r))))
  «四个角» s

-- 桥接器建成时四条存货通道的先后：没转时上、下、左、右；转一次是右、左、上、下。
#guard («十字».bind fun s => do
  let t ← «做» s (.«建» (← «摆» 900 27 20 (.«桥接器» .«上»)))
  return («接通表» (t.«模型».«历史».drop s.«模型».«历史».length)).map fun c => (c.«起», c.«止»)) ==
  some [(4, 900), (204, 902), (304, 903), (104, 901)]
#guard («十字».bind fun s => do
  let t ← «做» s (.«建» (← «摆» 900 27 20 (.«桥接器» .«右»)))
  return («接通表» (t.«模型».«历史».drop s.«模型».«历史».length)).map fun c => (c.«起», c.«止»)) ==
  some [(104, 901), (304, 903), (4, 900), (204, 902)]

-- 实测：四个角（左上、右上、右下、左下）独占的臂。rot=0、2 是上、上、下、下；rot=1、3 是左、右、右、左。
-- 这里走 rot=0、1 两种；rot=2、3 的接通先后由上面两条和 `格子边界.lean` 里的端口表管着。
#guard «同时接上» 0 == some [0, 0, 2, 2]
#guard «同时接上» 1 == some [3, 1, 1, 3]

/-- 回放：从放汇流器的第一步开始，记下首件、第 12 件的步号及收到第 12 件时的货种和数量。
到收汇流器的时刻仍未到 12 件则整轮无结果。 -/
private def «角的头十二件» (s : Endfield.«格子».«状态») (k span : Nat) := do
  let s ← «建好» s (← «汇流器» k)
  let (t, rows) := «逐步读» s span fun m => «臂货».map (fun x => «箱里几件» m (100 * k + 8) x)
  let (_, first) ← rows.zipIdx.find? fun row : List Nat × Nat => row.1.sum > 0
  let (counts, last) ← rows.zipIdx.find? fun row : List Nat × Nat => row.1.sum == 12
  return (← «做» t (.«收» (100 * k + 9)), counts, first, last)

/-- 回放：11-12 的第一遍（rot=0），四个收货箱起初都空，每次 box_watch 等到第 12 件。
本机调用时刻来自当日 15:03–15:07 的操作记录。最后一次放货结束至开始放桥约 26 秒。
放桥 15:04:21.15–23.90，放左上汇流器 15:04:26.46–29.58，调用开始相差 5.31 秒（约 21 步），
结束相差 5.68 秒（约 23 步）。两个落地点击未记时，仅由调用起止能定在约 10–34 步。
四个汇流器从放到收按调用开始之差取 145、159、145、163 步，从收到放下一个取 22、22、20 步。 -/
private def «四角头十二件» (bridge : Endfield.«格子».«状态») (wait : Nat) := do
  let mut s := «等» wait bridge
  let mut goods := #[]
  for ((span, gap), k) in [(145, 22), (159, 22), (145, 20), (163, 0)].zipIdx do
    let (t, counts) ← «角的头十二件» s k span
    goods := goods.push counts
    s := «等» gap t
  return goods.toList

/-- 回放：单独比对读屏时间。时刻以 15:04:00 起的百分之一秒计。左上首件、
第 12 件在 37.06、59.05 已经显示，从放桥调用开始算至多 15.91、37.90 秒。
四角的读数变化都出现在整秒后约 0.03–0.11 秒，以下以每秒 .00 刷新作一种对时。
若某件首次在该次刷新出现，它在模型中的到箱时刻须晚于上次刷新、至迟为这次刷新。
在放桥和放汇流器各自的调用窗口内枚举点击，同一遍始终只取一个放桥时刻。 -/
private def «四角对时» (w : Nat) (results : List (List Nat × Nat × Nat)) (corners : Nat) : Bool :=
  -- 各汇流器距左上多少步、放置窗口内的整百分秒、首件与第 12 件初见的刷新秒（调用 35–46）。
  let panels : List (Nat × Nat × Nat × Nat × Nat) := [
    (0,2647,2957,37,59), (167,6829,7175,79,101), (348,11343,11630,124,146), (513,15470,15765,165,187)]
  let atRefresh (arrival second : Nat) := arrival ≤ second * 100 && second * 100 < arrival + 100
  (List.range (2389 - 2116 + 1)).any fun offset =>
    ((panels.zip results).take corners).all fun ((delay, lo, hi, one, twelve), _, first, last) =>
      let merge := 2116 + offset + 25 * (w + delay)
      lo ≤ merge && merge ≤ hi && atRefresh (merge + 25 * first) one && atRefresh (merge + 25 * last) twelve

-- 调用窗口内挑着试：两头、各个界点的两侧，和原来混货的 21、24 步（10–34 步逐个试过都成立，全试编译要近 5 分钟）。
-- 旧模型在 21–24 步混入的一件左路蓝铁矿，在预先收货后消失。
-- 四角的货种在 10–34 步全对；左上从放桥数是 w+33、w+121 步。31–34 步时连以
-- 放桥调用开始为起点都晚于两次读数。按上述整秒刷新，左上两帧相容的是 16–30 步；
-- 沿用上述三段收放间隔，四角的八帧共用同一时钟相容的是 17–29 步。这些是模型对时范围。
#guard (do
  let s := «等» 104 (← «十字»)
  let bridge ← «建好» s (← «摆» 900 27 20 (.«桥接器» .«上»))
  for w in [10, 15, 16, 17, 21, 24, 25, 29, 30, 31, 34] do
    let rows ← «四角头十二件» bridge w
    guard (rows == [([12,0,0,0],33,121), ([12,0,0,0],33,121), ([0,0,12,0],33,121), ([0,0,12,0],33,121)])
    let (_, first, last) ← rows.head?
    guard (((w + first) * 25 ≤ 1591 && (w + last) * 25 ≤ 3790) == (w ≤ 30))
    guard («四角对时» w rows 1 == (16 ≤ w && w ≤ 30))
    guard («四角对时» w rows 4 == (17 ≤ w && w ≤ 29))
  pure true) == some true

/-- 回放：校准。桥接器（rot=3）在场，把左边的分流器收掉重放，它那条通道比别的晚；读左上、左下两个角。 -/
def «左边重放» : Option (Nat × Nat) := do
  let s ← «十字»
  let s ← «做» s (.«建» (← «摆» 900 27 20 (.«桥接器» .«左»)))
  let s ← «做» s (.«收» 304)
