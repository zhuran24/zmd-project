import Endfield.«回放».«格子工具»

/-!
来源：求解器/规则修订/2026-10-08-现象整理/实测-2026-11-12.md，全文已读。
核对的是桥接器建成时四条边接通的先后：存货端口依次是它自己的上、下、左、右，
取货端口依次是下、上、右、左，都跟着桥接器转。

摆件的坐标、朝向照实测记录（MCP 的格坐标，箱子给的是左上角那一格）。实测用的碳块不在模型的物品表里，
这里拿钢块当它的记号。模型里不在任何运输带上的元件不动，所以带子在汇流器放下以前是空的，
头几件和实测对不上；下面只核对稳定以后进的是哪一路的货。
-/

namespace Endfield.«回放».«桥接器各边»

open Endfield.«格子» Endfield.«回放».«格子»

/-- 回放：实测里桥接器的 rot（顺时针转几次）对应的朝向。 -/
def «转几次» : Nat → «朝向»
  | 0 => .«上» | 1 => .«右» | 2 => .«下» | _ => .«左»

/-- 回放：每次放货以后压平一次，免得连着放货越来越慢。 -/
def «放» (u : Nat) (x : «物品») (k : Nat) (s : Endfield.«格子».«状态») :
    Option Endfield.«格子».«状态» :=
  (List.range k).foldlM (fun s _ =>
    («做» s (.«原样» (.«放货» u x 50))).map fun t =>
      { t with «模型» := «压平» t.«模型».«布局» t.«模型» }) s

/-! ## 存货端口：四个分流器围着桥接器，四个角轮流放汇流器 -/

/-- 回放：绕桥接器所在的 (27,20) 顺时针转一次，号加 100。 -/
def «绕一次» (p : «摆件») : Option «摆件» :=
  «摆» (p.«号» + 100) (48 - p.«位置».j.val - p.«大小».2) (p.«位置».i.val - 7) («转种类» p.«种类»)

/-- 回放：绕桥接器转 k 次。 -/
def «绕» : Nat → «摆件» → Option «摆件»
  | 0, p => some p
  | k + 1, p => («绕一次» p).bind («绕» k)

/-- 回放：上边那条臂和左上角的固定件：货源箱 1、进货带 2 3、出货带 5 6 7、收货箱 8。
另外三条臂、三个角是它绕桥接器转出来的（号各加 100、200、300）。 -/
def «臂» : Option (List «摆件») :=
  [«摆» 1 26 14 (.«协议储存箱» .«下»), «摆» 8 22 15 (.«协议储存箱» .«上»),
   «摆» 5 26 18 (.«传送带» .«下» .«左»), «摆» 6 25 18 (.«传送带» .«右» .«左»),
   «摆» 7 24 18 (.«传送带» .«右» .«上»),
   «摆» 2 27 17 (.«传送带» .«上» .«下»), «摆» 3 27 18 (.«传送带» .«上» .«下»)].mapM id

/-- 回放：上边的分流器 4（进口朝外）；另外三个是它转出来的 104、204、304。 -/
def «分流器» (k : Nat) : Option «摆件» := («摆» 4 27 19 (.«分流器» .«上»)).bind («绕» k)

/-- 回放：左上角的汇流器 9（出口朝上）；另外三个角是 109、209、309。角 k 比的是臂 k-1 和臂 k。 -/
def «汇流器» (k : Nat) : Option «摆件» := («摆» 9 26 19 (.«汇流器» .«上»)).bind («绕» k)

/-- 回放：四条臂的货，依次是上（实测碳块，这里用钢块）、右、下、左。 -/
def «臂货» : List «物品» := [.«钢块», .«蓝铁块», .«源矿», .«蓝铁矿»]

/-- 回放：箱子、带子先放，四个分流器按上、右、下、左放，货源箱各放 150 件。 -/
def «十字» : Option Endfield.«格子».«状态» := do
  let b ← «臂»
  let ps ← (List.range 4).mapM fun k => b.mapM («绕» k)
  let ss ← (List.range 4).mapM «分流器»
  let s ← «布置» (ps.flatten ++ ss)
  (List.range 4).foldlM (fun s k => «放» (100 * k + 1) («臂货».getD k .«源矿») 3 s) s

/-- 回放：在角 k 放汇流器，先走 96 步等带子排满，再走 64 步，读这 64 步里这个角的收货箱进的是哪条臂的货
（0 上 1 右 2 下 3 左；不是正好一条臂在进就记 9），然后收掉汇流器。 -/
def «一个角» (s : Endfield.«格子».«状态») (k : Nat) :
    Option (Endfield.«格子».«状态» × Nat) := do
  let m ← «汇流器» k
  let a := «等» 96 (← «做» s (.«建» m))
  let b := «等» 64 a
  let v := «臂货».map fun x => «箱货» b (100 * k + 8) x - «箱货» a (100 * k + 8) x
  let w := (List.range 4).filter fun i => v.getD i 0 > 0
  return (← «做» b (.«收» (100 * k + 9)), if w.length == 1 && v.getD (w.getD 0 0) 0 ≥ 6 then w.getD 0 9 else 9)

/-- 回放：四个角依次读一遍。 -/
def «四个角» (s : Endfield.«格子».«状态») : Option (List Nat) := do
  let (_, out) ← (List.range 4).foldlM (fun (acc : Endfield.«格子».«状态» × List Nat) k => do
    let (t, w) ← «一个角» acc.1 k
    return (t, acc.2 ++ [w])) (s, [])
  return out

/-- 回放：桥接器（转 r 次）最后放，四个分流器同一刻接上它，然后读四个角。 -/
def «同时接上» (r : Nat) : Option (List Nat) := do
  let s ← «十字»
  let s ← «做» s (.«建» (← «摆» 900 27 20 (.«桥接器» («转几次» r))))
  «四个角» s

-- 桥接器建成时四条存货通道的先后：没转时上、下、左、右；转一次是右、左、上、下。
#guard («十字».bind fun s => do
  let t ← «做» s (.«建» (← «摆» 900 27 20 (.«桥接器» .«上»)))
  return («接通表» (t.«模型».«历史».drop s.«模型».«历史».length)).map fun c => (c.«起», c.«止»)) ==
  some [(4, 900), (204, 902), (304, 903), (104, 901)]
#guard («十字».bind fun s => do
  let t ← «做» s (.«建» (← «摆» 900 27 20 (.«桥接器» .«右»)))
  return («接通表» (t.«模型».«历史».drop s.«模型».«历史».length)).map fun c => (c.«起», c.«止»)) ==
  some [(104, 901), (304, 903), (4, 900), (204, 902)]

-- 实测：四个角（左上、右上、右下、左下）独占的臂。rot=0、2 是上、上、下、下；rot=1、3 是左、右、右、左。
-- 这里走 rot=0、1 两种；rot=2、3 的接通先后由上面两条和 `格子边界.lean` 里的端口表管着。
#guard «同时接上» 0 == some [0, 0, 2, 2]
#guard «同时接上» 1 == some [3, 1, 1, 3]

/-- 回放：校准。桥接器（rot=3）在场，把左边的分流器收掉重放，它那条通道比别的晚；读左上、左下两个角。 -/
def «左边重放» : Option (Nat × Nat) := do
  let s ← «十字»
  let s ← «做» s (.«建» (← «摆» 900 27 20 (.«桥接器» .«左»)))
  let s ← «做» s (.«收» 304)
  let s ← «做» s (.«建» (← «分流器» 3))
  let (s, a) ← «一个角» s 0
  let (_, b) ← «一个角» s 3
  return (a, b)

-- 实测：rot=3 时同时接上，左边的分流器独占左上、左下两个角；它重放以后，改成上边、下边的独占。
#guard «左边重放» == some (0, 2)

/-! ## 取货端口：桥接器两边各贴一个装满的箱子，用「比较器」读哪个箱子先成终点

比较器：分流器 SA 有两支，直通的一支（一格或一条带）进箱子甲，带准入口的一支进箱子乙；
SA 另一个出口贴着汇流器 M，M 的出口直接贴着收货箱 R，分流器 SB 也贴着 M。
甲先成终点：SA 的次序是 2，和 SB 一样，SA 那组的时刻早，SA 独占 M，R 里进的是 SA 的货。
乙先成终点：SA 的次序是 4，SB 独占 M。
-/

/-- 回放：比较器里两种布局都有的固定件。货源箱 1（SA 的货，实测碳块、这里钢块）、2（SB 的货，蓝铁块）；
左边的箱子 40（甲）；收货箱 50；SA 的进货带 3、SA(10)；SB 的进货带 5 6、SB(30)；
带准入口那一支的前半：带 60–64、准入口 15（换在带 65 那格）。 -/
def «比较器» : Option (List «摆件») :=
  [«摆» 1 26 14 (.«协议储存箱» .«下»), «摆» 2 31 19 (.«协议储存箱» .«左»),
   «摆» 40 24 19 (.«协议储存箱» .«左»), «摆» 50 29 16 (.«协议储存箱» .«右»),
   «摆» 3 27 17 (.«传送带» .«上» .«下»), «摆» 10 27 18 (.«分流器» .«上»),
   «摆» 5 30 19 (.«传送带» .«右» .«左»), «摆» 6 29 19 (.«传送带» .«右» .«左»),
   «摆» 30 28 19 (.«分流器» .«右»),
   «摆» 60 26 18 (.«传送带» .«右» .«左»), «摆» 61 25 18 (.«传送带» .«右» .«左»),
   «摆» 62 24 18 (.«传送带» .«右» .«左»), «摆» 63 23 18 (.«传送带» .«右» .«下»),
   «摆» 64 23 19 (.«传送带» .«上» .«下»), «摆» 65 23 20 (.«传送带» .«上» .«下»),
   «摆» 15 23 20 (.«物品准入口» .«下»)].mapM id

/-- 回放：直通的那一支只有一格，从 SA 下边出、往左进左边的箱子。 -/
def «直通支» : Option «摆件» := «摆» 11 27 19 (.«传送带» .«上» .«左»)

/-- 回放：汇流器 M，贴着 SA、SB，出口朝右直接贴着收货箱。 -/
def «汇流» : Option «摆件» := «摆» 20 28 18 (.«汇流器» .«右»)

/-- 回放：对边布局：右边的箱子 41（乙）；带准入口那一支的后半 66–70，最后一格 71 另放。 -/
def «对边件» : Option (List «摆件» × «摆件») := do
  let ps ← [«摆» 41 28 20 (.«协议储存箱» .«右»),
    «摆» 66 23 21 (.«传送带» .«上» .«下»), «摆» 67 23 22 (.«传送带» .«上» .«右»),
    «摆» 68 24 22 (.«传送带» .«左» .«右»), «摆» 69 25 22 (.«传送带» .«左» .«右»),
    «摆» 70 26 22 (.«传送带» .«左» .«右»)].mapM id
  return (ps, ← «摆» 71 27 22 (.«传送带» .«左» .«右»))

/-- 回放：邻边布局：下边的箱子 41（乙）；带准入口那一支的后半 66–80，最后一格 81 另放。 -/
def «邻边件» : Option (List «摆件» × «摆件») := do
  let ps ← ([«摆» 41 27 21 (.«协议储存箱» .«下»),
    «摆» 66 23 21 (.«传送带» .«上» .«下»), «摆» 67 23 22 (.«传送带» .«上» .«下»),
    «摆» 68 23 23 (.«传送带» .«上» .«下»), «摆» 69 23 24 (.«传送带» .«上» .«右»)] ++
    (List.range 6).map (fun n => «摆» (70 + n) (24 + n) 24 (.«传送带» .«左» .«右»)) ++
    [«摆» 76 30 24 (.«传送带» .«左» .«上»), «摆» 77 30 23 (.«传送带» .«下» .«上»),
     «摆» 78 30 22 (.«传送带» .«下» .«上»), «摆» 79 30 21 (.«传送带» .«下» .«上»),
     «摆» 80 30 20 (.«传送带» .«下» .«左»)]).mapM id
  return (ps, ← «摆» 81 29 20 (.«传送带» .«右» .«下»))

/-- 回放：比较器走一轮。`先接` 是校准用的：some true 先接直通支再放桥接器（甲先成终点），
some false 先接带准入口那一支（乙先成终点），none 是两支都在桥接器之后接（同时接通）。
返回稳定以后的 64 步里收货箱进了（SA 的货，SB 的货）各几件。 -/
def «一轮» («件» : Option (List «摆件» × «摆件»)) (r : Nat) («先接» : Option Bool) :
    Option (Nat × Nat) := do
  let (ps, last) ← «件»
  let s ← «布置» ((← «比较器») ++ ps)
  let s ← «放» 40 .«源矿» 6 s
  let s ← «放» 41 .«源矿» 6 s
  let s ← «放» 1 .«钢块» 4 s
  let s ← «放» 2 .«蓝铁块» 4 s
  let direct ← «直通支»
  let s ← match «先接» with
    | some true => «做» s (.«建» direct)
    | some false => «做» s (.«建» last)
    | none => some s
  let s ← «做» s (.«建» (← «摆» 900 27 20 (.«桥接器» («转几次» r))))
  let s ← if «先接» == some true then some s else «做» s (.«建» direct)
  let s ← if «先接» == some false then some s else «做» s (.«建» last)
  let s := «等» 160 s
  let s ← «做» s (.«建» (← «汇流»))
  let a := «等» 96 s
  let b := «等» 64 a
  return («箱货» b 50 .«钢块» - «箱货» a 50 .«钢块», «箱货» b 50 .«蓝铁块» - «箱货» a 50 .«蓝铁块»)

/-- 回放：进的只有 SA 的货（true）还是只有 SB 的货（false）；两样都有或都没有算读不出。 -/
def «谁独占» (v : Option (Nat × Nat)) : Option Bool :=
  v.bind fun (a, b) => if a ≥ 6 && b == 0 then some true else if b ≥ 6 && a == 0 then some false else none

-- 校准（两种布局各两次）：先成终点的是甲，进 SA 的货；是乙，进 SB 的货。
#guard «谁独占» («一轮» «对边件» 0 (some true)) == some true
#guard «谁独占» («一轮» «对边件» 0 (some false)) == some false
#guard «谁独占» («一轮» «邻边件» 0 (some true)) == some true
#guard «谁独占» («一轮» «邻边件» 0 (some false)) == some false

-- 实测，对边（甲在左、乙在右）：rot=0 右边先，rot=1 左边先，rot=2 左边先，rot=3 右边先。
-- 换成桥接器自己的方向：右先于左，下先于上。
#guard (List.range 4).map (fun r => «谁独占» («一轮» «对边件» r none)) ==
  [some false, some true, some true, some false]

-- 实测，邻边（甲在左、乙在下）：rot=0 下边先，rot=1 左边先，rot=2 下边先，rot=3 左边先。
-- 换成桥接器自己的方向：下、上都先于左、右。
#guard (List.range 4).map (fun r => «谁独占» («一轮» «邻边件» r none)) ==
  [some false, some true, some false, some true]

end Endfield.«回放».«桥接器各边»
