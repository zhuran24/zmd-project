import Endfield.«作用»

/-!
# 合规的历史

待证的几条定理（组的时刻、终点的时刻、级别不并列，同组各起点次序相同）不是对随便一串事件都成立，
只对游戏里做得出来的历史成立。这份文件把「做得出来」写成两个条件，定理拿它们当前提：

- `历史.合规`：历史里的每件事发生时，游戏都让做（条件就是 `操作.做得了` 里改布局的那三条）；
- `历史.端口数合`：每一刻，每个运输单位的通道条数都不超过它的端口数。现在还没有端口，
  这一条等格子写出来以后由端口数给出，先当前提带着。
-/

namespace Endfield

namespace «布局»

/-- 框架：布局 L 上游戏让不让发生这件事。条件和 `操作.做得了` 里改布局的三条相同（见 `操作.做得了改布局`）。 -/
def «让改» (L : «布局») : «事件» → Bool
  | .«建成» u k =>
    (L.«种类» u).isNone
      && (k != .«协议核心» || !L.«单位表».any (·.2 == .«协议核心»))
  | .«接通» c =>
    c.«起» != c.«止» && (L.«种类» c.«起»).isSome && (L.«种类» c.«止»).isSome
      && (L.«是运输单位» c.«起» || L.«是运输单位» c.«止»)
      && !L.«通道表».any (·.1 == c)
  | .«拆除» u => (L.«种类» u).isSome

/-- 据：传送带、物品准入口、分流器、汇流器、桥接器

每个运输单位的通道条数不超过它的端口数：存货通道至多 1 条（汇流器至多 3 条），取货通道至多 1 条（分流器至多 3 条）。 -/
def «端口数合» (L : «布局») : Bool :=
  L.«单位表».all fun p =>
    !p.2.«是运输单位» ||
      (decide ((L.«进» p.1).length ≤ (if p.2 == .«汇流器» then 3 else 1))
        && decide ((L.«出» p.1).length ≤ (if p.2 == .«分流器» then 3 else 1)))

end «布局»

namespace «历史»

/-- 框架：历史里的每件事发生时游戏都让做。第 t+1 件事发生在前 t 件事以后的布局上。 -/
def «合规» (H : «历史») : Prop :=
  ∀ (t : Nat) (h : t < H.length), (H.«布局于» t).«让改» H[t] = true

instance (H : «历史») : Decidable H.«合规» := by
  unfold «合规»; infer_instance

/-- 据：传送带、物品准入口、分流器、汇流器、桥接器

历史的每一刻，每个运输单位的通道条数都不超过它的端口数。 -/
def «端口数合» (H : «历史») : Prop :=
  ∀ (t : Nat), t ≤ H.length → (H.«布局于» t).«端口数合» = true

instance (H : «历史») : Decidable H.«端口数合» := by
  unfold «端口数合»; infer_instance

end «历史»

/-- 框架：`操作.做得了` 里改布局的条件就是 `布局.让改`。 -/
theorem «操作».«做得了改布局» (s : «状态») (e : «事件») :
    («操作».«改布局» e).«做得了» s = s.«布局».«让改» e := by
  cases e <;> rfl

end Endfield
