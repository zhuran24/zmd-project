import Endfield.«计量与基础»

/-!
# 配方

规则文件「配方」一块，加上「制造单位」一块里和配方有关的部分（每种制造单位有几个存货物品格）。
-/

namespace Endfield

/-- 规则里没有：物品

规则文件处处用到「物品」，没有「物品：」这一行。这里列的是「配方」一块里出现的 19 种。 -/
inductive «物品» where
  | «源矿» | «源石粉末» | «致密源石粉末»
  | «蓝铁矿» | «蓝铁块» | «蓝铁粉末» | «致密蓝铁粉末»
  | «钢块» | «钢质瓶» | «钢制零件»
  | «荞花种子» | «荞花» | «荞花粉末» | «细磨荞花粉末»
  | «砂叶种子» | «砂叶» | «砂叶粉末»
  | «高容谷地电池» | «精选荞愈胶囊»
deriving DecidableEq, Repr

/-- 制造单位：一条边（大制造单位为长边）全为存货端口，对边全为取货端口；均含 1 个取货物品格

这里只列出九种制造单位；端口和物品格还没写。 -/
inductive «制造单位» where
  | «粉碎机» | «精炼炉» | «配件机» | «塑形机»
  | «采种机» | «种植机»
  | «研磨机» | «封装机» | «灌装机»
deriving DecidableEq, Repr

namespace «制造单位»

/-- 据：小制造单位、中制造单位、大制造单位

存货物品格的个数：小、中制造单位 1 个，大制造单位 2 个。 -/
def «存货物品格数» : «制造单位» → Nat
  | «研磨机» | «封装机» | «灌装机» => 2
  | _ => 1

end «制造单位»

/-- 规则里没有：配方

规则文件用到「配方」（「符合某个配方」「配方时长」），没有「配方：」这一行。
这里的配方是：某种制造单位，把若干种原料各若干件，做成一种产物若干件，时长以 tick 计。 -/
structure «配方» where
  «单位» : «制造单位»
  «原料» : List («物品» × Nat)
  «产物» : «物品» × Nat
  «时长» : Nat
deriving DecidableEq, Repr

namespace «配方»

/-- 据：制造

一条配方用到的原料种类。 -/
def «原料种类» (r : «配方») : List «物品» := r.«原料».map (·.1)

end «配方»

open «物品» «制造单位»

/-- 粉碎机：1 源矿 → 1 源石粉末，1 tick；1 蓝铁块 → 1 蓝铁粉末，1 tick；1 荞花 → 2 荞花粉末，1 tick；1 砂叶 → 3 砂叶粉末，1 tick -/
def «粉碎机配方» : List «配方» := [
  ⟨«粉碎机», [(«源矿», 1)], («源石粉末», 1), 1⟩,
  ⟨«粉碎机», [(«蓝铁块», 1)], («蓝铁粉末», 1), 1⟩,
  ⟨«粉碎机», [(«荞花», 1)], («荞花粉末», 2), 1⟩,
  ⟨«粉碎机», [(«砂叶», 1)], («砂叶粉末», 3), 1⟩]

/-- 精炼炉：1 蓝铁矿 → 1 蓝铁块，1 tick；1 致密蓝铁粉末 → 1 钢块，1 tick；1 蓝铁粉末 → 1 蓝铁块，1 tick -/
def «精炼炉配方» : List «配方» := [
  ⟨«精炼炉», [(«蓝铁矿», 1)], («蓝铁块», 1), 1⟩,
  ⟨«精炼炉», [(«致密蓝铁粉末», 1)], («钢块», 1), 1⟩,
  ⟨«精炼炉», [(«蓝铁粉末», 1)], («蓝铁块», 1), 1⟩]

/-- 研磨机：2 蓝铁粉末＋1 砂叶粉末 → 1 致密蓝铁粉末，1 tick；2 源石粉末＋1 砂叶粉末 → 1 致密源石粉末，1 tick；2 荞花粉末＋1 砂叶粉末 → 1 细磨荞花粉末，1 tick -/
def «研磨机配方» : List «配方» := [
  ⟨«研磨机», [(«蓝铁粉末», 2), («砂叶粉末», 1)], («致密蓝铁粉末», 1), 1⟩,
  ⟨«研磨机», [(«源石粉末», 2), («砂叶粉末», 1)], («致密源石粉末», 1), 1⟩,
  ⟨«研磨机», [(«荞花粉末», 2), («砂叶粉末», 1)], («细磨荞花粉末», 1), 1⟩]

/-- 塑形机：2 钢块 → 1 钢质瓶，1 tick -/
def «塑形机配方» : List «配方» := [⟨«塑形机», [(«钢块», 2)], («钢质瓶», 1), 1⟩]

/-- 配件机：1 钢块 → 1 钢制零件，1 tick -/
def «配件机配方» : List «配方» := [⟨«配件机», [(«钢块», 1)], («钢制零件», 1), 1⟩]

/-- 种植机：1 荞花种子 → 1 荞花，1 tick；1 砂叶种子 → 1 砂叶，1 tick -/
def «种植机配方» : List «配方» := [
  ⟨«种植机», [(«荞花种子», 1)], («荞花», 1), 1⟩,
  ⟨«种植机», [(«砂叶种子», 1)], («砂叶», 1), 1⟩]

/-- 采种机：1 荞花 → 2 荞花种子，1 tick；1 砂叶 → 2 砂叶种子，1 tick -/
def «采种机配方» : List «配方» := [
  ⟨«采种机», [(«荞花», 1)], («荞花种子», 2), 1⟩,
  ⟨«采种机», [(«砂叶», 1)], («砂叶种子», 2), 1⟩]

/-- 封装机：10 钢制零件＋15 致密源石粉末 → 1 高容谷地电池，5 tick -/
def «封装机配方» : List «配方» := [
  ⟨«封装机», [(«钢制零件», 10), («致密源石粉末», 15)], («高容谷地电池», 1), 5⟩]

/-- 灌装机：10 钢质瓶＋10 细磨荞花粉末 → 1 精选荞愈胶囊，5 tick -/
def «灌装机配方» : List «配方» := [
  ⟨«灌装机», [(«钢质瓶», 10), («细磨荞花粉末», 10)], («精选荞愈胶囊», 1), 5⟩]

/-- 据：粉碎机、精炼炉、研磨机、塑形机、配件机、种植机、采种机、封装机、灌装机

全部 18 条配方。 -/
def «配方表» : List «配方» :=
  «粉碎机配方» ++ «精炼炉配方» ++ «研磨机配方» ++ «塑形机配方» ++ «配件机配方» ++
  «种植机配方» ++ «采种机配方» ++ «封装机配方» ++ «灌装机配方»

/-- 据：制造

每条配方都归在它自己那种制造单位名下。 -/
theorem «配方归位» :
    («粉碎机配方».all (·.«单位» == «粉碎机») && «精炼炉配方».all (·.«单位» == «精炼炉») &&
     «研磨机配方».all (·.«单位» == «研磨机») && «塑形机配方».all (·.«单位» == «塑形机») &&
     «配件机配方».all (·.«单位» == «配件机») && «种植机配方».all (·.«单位» == «种植机») &&
     «采种机配方».all (·.«单位» == «采种机») && «封装机配方».all (·.«单位» == «封装机») &&
     «灌装机配方».all (·.«单位» == «灌装机»)) = true := by decide

/-- 据：制造、存货/取货物品格

每条配方的原料种数，正好等于那种制造单位的存货物品格数；一条配方里的原料种类互不相同。
存货物品格每格只放一种物品，所以开工时每个存货物品格里正好是配方的一种原料。 -/
theorem «原料种数等于存货物品格数» :
    ∀ r ∈ «配方表», r.«原料».length = r.«单位».«存货物品格数» ∧ r.«原料种类».Nodup := by decide

/-- 据：制造

同一种制造单位的两条配方，一条的原料种类全在另一条里，它们就是同一条。
连同上一条：存货物品格里的物品至多符合一条配方，「符合某个配方」不用再规定选哪一条。 -/
theorem «符合的配方至多一条» :
    ∀ r₁ ∈ «配方表», ∀ r₂ ∈ «配方表»,
      r₁.«单位» = r₂.«单位» → (∀ k ∈ r₁.«原料种类», k ∈ r₂.«原料种类») → r₁ = r₂ := by decide

end Endfield
