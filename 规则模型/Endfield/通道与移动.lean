import Endfield.«单位»

/-!
# 通道与移动

规则文件「通道与移动」一块里的通道和接通。现在还没有格子和端口：一条通道直接记成
「从哪个单位到哪个单位」，哪条通道在哪一刻接通由写例子的人按规则「接通」一行排好给出。
滞留、可移动物品、移动还没写。
-/

namespace Endfield

/-- 据：判定顺序

单位号：一个单位是第几个建成的，从 0 起。「非运输单位按建成的先后依次选取」比的就是它。 -/
abbrev «单位号» := Nat

/-- 据：接通、步

时刻：到这一刻为止发生过几件事（建成一个单位、接通一条通道、拆除一个单位各算一件）。
两件事不会在同一刻，所以「接通的先后」「最近一次变成……的那一刻」都拿它比。 -/
abbrev «时刻» := Nat

/-- 通道：物品在两个物品格之间移动的路径；当不同单位的取货端口与存货端口正对紧贴、且至少一方是运输单位时，自动形成通道

`起` 是取货端口所在的单位，`止` 是存货端口所在的单位。 -/
structure «通道» where
  «起» : «单位号»
  «止» : «单位号»
deriving DecidableEq, Repr

/-- 据：接通、蓝图

基地上发生的一件事。拆除一个单位时，连着它的通道一起没有。 -/
inductive «事件» where
  | «建成» (k : «单位种类»)
  | «接通» (c : «通道»)
  | «拆除» (u : «单位号»)
deriving Repr

/-- 据：通道、接通

某一刻的布局：各单位号上是什么单位（拆掉的记 `none`），和现有的每条通道连同它接通的那一刻。
`通道表` 按接通先后排。 -/
structure «布局» where
  «单位表» : List (Option «单位种类») := []
  «通道表» : List («通道» × «时刻») := []
deriving Repr

namespace «布局»

/-- 据：通道

单位号 u 上的单位是什么种类；没有这个单位或已拆除是 `none`。 -/
def «种类» (L : «布局») (u : «单位号») : Option «单位种类» :=
  L.«单位表».getD u none

/-- 据：运输单位

u 是不是一个还在的运输单位。 -/
def «是运输单位» (L : «布局») (u : «单位号») : Bool :=
  match L.«种类» u with
  | some k => k.«是运输单位»
  | none => false

/-- 据：运输单位

u 是不是一个还在的非运输单位。 -/
def «是非运输单位» (L : «布局») (u : «单位号») : Bool :=
  match L.«种类» u with
  | some k => !k.«是运输单位»
  | none => false

/-- 据：通道

从单位 u 出去的通道，按接通先后。 -/
def «出» (L : «布局») (u : «单位号») : List («通道» × «时刻») :=
  L.«通道表».filter fun p => p.1.«起» == u

/-- 据：通道

进单位 u 的通道，按接通先后。 -/
def «进» (L : «布局») (u : «单位号») : List («通道» × «时刻») :=
  L.«通道表».filter fun p => p.1.«止» == u

/-- 据：接通

在时刻 t 发生一件事以后的布局。 -/
def «加» (L : «布局») (t : «时刻») : «事件» → «布局»
  | .«建成» k => { L with «单位表» := L.«单位表» ++ [some k] }
  | .«接通» c => { L with «通道表» := L.«通道表» ++ [(c, t)] }
  | .«拆除» u =>
    { «单位表» := L.«单位表».set u none
      «通道表» := L.«通道表».filter fun p => p.1.«起» != u && p.1.«止» != u }

end «布局»

/-- 据：接通

历史：基地上依次发生的事。第 i 件事（从 1 数）发生在时刻 i。 -/
abbrev «历史» := List «事件»

namespace «历史»

/-- 据：接通

时刻 t 的布局：前 t 件事发生以后的样子。 -/
def «布局于» (H : «历史») (t : «时刻») : «布局» :=
  ((H.take t).foldl (fun (acc : «布局» × «时刻») e => (acc.1.«加» (acc.2 + 1) e, acc.2 + 1))
    ({}, 0)).1

end «历史»

end Endfield
