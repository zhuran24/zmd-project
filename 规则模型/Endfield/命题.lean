import Endfield.«合法基地»
import Endfield.«物品格的规矩»

/-!
# 命题：要证的每一条，各写成一句

规则写成代码以后，有两种地方编译器拦不住：

1. 规则说「一直」「同时」，代码只能排出一个先后；
2. 规则说「取最早的」「按级别从高到低」，代码得从几个里挑一个，并列时悄悄选了排在前面的。

这两种地方代码都替规则做了决定。这里把每一处写成一条命题：换个先后结果一样，或者不会并列。
证明在 `证明/` 下，每条命题一个文件；`证明/总.lean` 把它们收在一起，并列出各自用到的公理。

这份文件只有陈述，没有证明。改这里的一个字，就是改了要证的东西。
-/

namespace Endfield.«命题»

/-! ## 轮询 -/

/-- 据：非运输单位轮询

非运输单位轮询就是一个队列：开始时照接通先后排（制造单位把最先接通的那条挪到最后），
哪条通道移动了物品，哪条就排到队尾。规则里「未移动过的优先」「已移动过的按先后」两半是它的两种状态。
`is` 是依次移动物品的通道。 -/
def «非运输单位轮询是队列» : Prop :=
  ∀ (n : Nat) (isM : Bool) (is : List (Fin n)),
    «非运输单位轮询» n isM (is.foldl «记移动» []) = is.foldl «记移动» («非运输单位轮询» n isM [])

/-! ## 「同时」「一直」落成先后的三处 -/

/-- 据：判定顺序、制造

规则说「所有单位同时进行结束制造判定／开始制造判定」，代码照一列单位的先后一个个做。
这一列换成任何一种排法，结果都一样。 -/
def «制造判定不看先后» : Prop :=
  ∀ (L : «布局») (todo : «待写») (us us' : List «单位号») (s : «状态»),
    todo.«有电只看历史» → us.Perm us' →
    s.«结束制造判定» L todo us = s.«结束制造判定» L todo us' ∧
    s.«开始制造判定» L todo us = s.«开始制造判定» L todo us'

/-- 框架：`整理` 用到的、带内通道的两条性质：
每条的两头都是传送带，而且不是同一格；任何两条的起点不同、止点也不同（一格传送带只有一个上游格、一个下游格）。 -/
def «带内整齐» (T : «判定表») : Prop :=
  (∀ c ∈ T.«带内», T.«现布局».«种类» c.«起» = some .«传送带» ∧
      T.«现布局».«种类» c.«止» = some .«传送带» ∧ c.«起» ≠ c.«止») ∧
  T.«带内».Pairwise (fun c d => c.«起» ≠ d.«起» ∧ c.«止» ≠ d.«止»)

/-- 框架：把判定表里带内通道的先后换成 `bs`、汇流器那张表的先后换成 `js`，别的不动。 -/
def «换排法» (T : «判定表») (bs : List «通道») (js : List («单位号» × List «通道»)) : «判定表» :=
  { T with «带内» := bs, «汇流器» := js }

/-- 据：移动、元件

规则说「元件内的物品一直在尝试移动」，代码照带内通道的一种先后一遍遍前移（`整理`）。
带内通道换成任何一种排法，整理出来的结果都一样。`fuel` 是最多几遍，不少于带内通道的条数就够。 -/
def «整理不看带内先后» : Prop :=
  ∀ (T : «判定表») (bs : List «通道») (port : «通道» → Nat) (fuel : Nat) (s : «状态»),
    «带内整齐» T → bs.Perm T.«带内» → T.«带内».length ≤ fuel →
    «状态».«整理» («换排法» T bs T.«汇流器») port fuel s = «状态».«整理» T port fuel s

/-- 据：输入判定、元件轮询、组

汇流器进货的那一组（不是分流器来的通道）里，谁先谁后不影响结果：只有输入判定选中的那一条能送。
`sa`、`sb` 是做两次输入判定那两刻的状态，`o₁`、`o₂` 是这一组通道的两种排法。 -/
def «汇流器那组不看先后» : Prop :=
  ∀ (T : «判定表») (port : «通道» → Nat) (un : «未定») (sa sb s : «状态») (t : «单位号»)
    (o₁ o₂ : List «通道»),
    un.«输入判定都没货时» = .«每步判两次» →
    T.«现布局».«种类» t = some .«汇流器» →
    (∀ c ∈ o₁, c.«止» = t ∧ T.«现布局».«种类» c.«起» ≠ some .«分流器») →
    o₁.Perm o₂ →
    s.«判一组» T port (fun c => sa.«汇流器收» T port un sb c) o₁ =
      s.«判一组» T port (fun c => sa.«汇流器收» T port un sb c) o₂

/-- 据：输入判定、元件轮询、组

上一条的用处：汇流器进货的那一组做移动判定时，元件轮询从哪条开始都一样，
所以这一组不用另记「上一次移动物品的通道」，状态里的 `进货上次` 对汇流器只记输入判定的。 -/
def «汇流器那组不用记上次» : Prop :=
  ∀ (T : «判定表») (port : «通道» → Nat) (un : «未定») (sa sb s : «状态») (t : «单位号»)
    (cs : List «通道») (last₁ last₂ : Option «通道»),
    un.«输入判定都没货时» = .«每步判两次» →
    T.«现布局».«种类» t = some .«汇流器» →
    (∀ c ∈ cs, c.«止» = t ∧ T.«现布局».«种类» c.«起» ≠ some .«分流器») →
    s.«判一组» T port (fun c => sa.«汇流器收» T port un sb c) («元件先后» cs last₁) =
      s.«判一组» T port (fun c => sa.«汇流器收» T port un sb c) («元件先后» cs last₂)

/-! ## 「从几个里挑一个」的几处 -/

/-- 据：终点、运输带、端口

不是分流器的末端元件正好有一条取货通道，所以 `终点` 对每个末端元件都给得出结果。 -/
def «末端元件有终点» : Prop :=
  ∀ (L : «布局») (e : «单位号»),
    L.«端口数合» = true → L.«是末端元件» e = true → (L.«终点» e).isSome = true

/-- 据：级别、次序、组

元件的一个组里，几条通道的起点所在元件次序相同。规则「级别」一行只说「起点所在元件的次序」，
起点在不同元件时没说取哪个；它们总相同，所以不用说。 -/
def «同组次序相同» : Prop :=
  ∀ (H : «历史») (g : «组»),
    (H.«布局于» H.length).«端口数合» = true → g.«是元件的» = true →
    ∀ p ∈ (H.«布局于» H.length).«组的通道» g, ∀ q ∈ (H.«布局于» H.length).«组的通道» g,
      H.«次序» H.length p.1.«起» = H.«次序» H.length q.1.«起»

/-- 据：组的时刻、组、接通

两个不同的组，组的时刻不同：一刻只接通一条通道，一条通道只在一个组里。 -/
def «组的时刻不同» : Prop :=
  ∀ (H : «历史») (g₁ g₂ : «组») (t : «时刻»),
    H.«合规» = true → g₁ ≠ g₂ →
    H.«组的时刻» H.length g₁ = some t → H.«组的时刻» H.length g₂ ≠ some t

/-- 据：级别、组的时刻

两个不同的组，级别不并列。 -/
def «级别不并列» : Prop :=
  ∀ (H : «历史») (g₁ g₂ : «组») (a : Nat × «时刻»),
    H.«合规» = true → g₁ ≠ g₂ →
    H.«级别» H.length g₁ = some a → H.«级别» H.length g₂ ≠ some a

/-- 据：判定顺序、级别

按级别从高到低排出来的结果，不看这些组原来是照什么先后列出来的。 -/
def «按级别排不看先后» : Prop :=
  ∀ (H : «历史») (gs gs' : List «组»),
    H.«合规» = true → gs.Perm gs' → H.«按级别排» gs = H.«按级别排» gs'

/-- 据：终点的时刻、次序

两个不同的终点，终点的时刻不同，所以「终点的时刻最早的运输带」通往的是同一个终点。 -/
def «终点的时刻不同» : Prop :=
  ∀ (H : «历史») (x y : «单位号») (t : «时刻»),
    H.«合规» = true → H.«端口数合» = true → x ≠ y →
    H.«终点的时刻» H.length x = some t → H.«终点的时刻» H.length y ≠ some t

/-- 据：终点的时刻、接通

规则「终点的时刻」第一条把「最近一次从不是终点变成是终点」和「末端元件与它接通」并列写成同一刻。
它们确实是同一刻：非运输单位变成终点的那一刻发生的事，正是某个末端元件和它接通。 -/
def «变成终点那一刻是接通» : Prop :=
  ∀ (H : «历史») (x : «单位号») (t : «时刻»),
    H.«合规» = true → H.«端口数合» = true →
    (H.«布局于» H.length).«是非运输单位» x = true →
    H.«终点的时刻» H.length x = some t →
    ∃ e, 1 ≤ t ∧ H[t - 1]? = some (.«接通» ⟨e, x⟩) ∧ (H.«布局于» t).«是末端元件» e = true

/-! ## 物品格的上限 -/

/-- 据：物品格、运输单位、协议储存箱、存货/取货物品格

走一步以后货仍合规矩（`状态.货合规矩`）：没有哪条路能把一格放超、放混，仓库也不超上限。
代码里好几处只看一格里的第一堆货、碰上两堆就不给结果，靠的就是这一条。 -/
def «走一步守物品格的规矩» : Prop :=
  ∀ (un : «未定») (todo : «待写») (s : «状态»),
    s.«历史».«合规» = true → s.«货合规矩» → («一步» un todo s).«货合规矩»

/-! ## 合起来 -/

/-- 据：元件、端口、通道

照合规、端口数合的历史立出来的判定表，带内通道合乎 `带内整齐`，条数不多于单位的个数
（`整理` 的遍数取的就是单位的个数）。 -/
def «立表的带内整齐» : Prop :=
  ∀ (H : «历史»),
    H.«合规» = true → (H.«布局于» H.length).«端口数合» = true →
    «带内整齐» H.«立表» ∧ H.«立表».«带内».length ≤ H.«立表».«现布局».«单位表».length

/-- 据：级别、次序、运输带

合法基地上每个组都有级别：走步时没有哪个组因为算不出级别被跳过。 -/
def «每个组都有级别» : Prop :=
  ∀ (H : «历史»),
    H.«合法» = true →
    ∀ g ∈ (H.«布局于» H.length).«各组», (H.«级别» H.length g).isSome = true

/-- 框架：规则没定先后的几处各换一种排法走的一步。
`T` 是判定表；`bs` 是带内通道的排法，`js` 是汇流器那张表的排法，
`us₁`、`us₂` 是结束制造判定、开始制造判定时一个个做的先后。别的都和 `一步于` 一样。 -/
def «一步照» (T : «判定表») (bs : List «通道») (js : List («单位号» × List «通道»))
    (us₁ us₂ : List «单位号») (un : «未定») (todo : «待写») (s : «状态») : «状态» :=
  let T := «换排法» T bs js
  let port := todo.«口» s
  let s0 := «状态».«整理» T port T.«现布局».«单位表».length s
  let s1 := s0.«结束制造判定» T.«现布局» todo us₁
  let s3 := s1.«元件的移动判定» T port (fun c => s1.«汇流器收» T port un s1 c)
  let s4 := s3.«非运输单位的移动判定» T un todo port (fun c => s1.«汇流器收» T port un s3 c)
  let s5 := s4.«开始制造判定» T.«现布局» todo us₂
  «计时» un todo s5

/-- 据：判定顺序、移动、级别

走一步的结果不看规则没定的先后：列出各组的先后、带内通道的先后、汇流器那张表的先后、
结束和开始制造判定时各单位的先后，各换成任何一种排法，走出来的状态都一样。 -/
def «一步不看没定的先后» : Prop :=
  ∀ (un : «未定») (todo : «待写») (s : «状态») (gs : List «组») (bs : List «通道»)
    (js : List («单位号» × List «通道»)) (us₁ us₂ : List «单位号»),
    todo.«有电只看历史» →
    s.«历史».«合规» = true → s.«布局».«端口数合» = true →
    gs.Perm s.«布局».«各组» →
    bs.Perm s.«历史».«立表».«带内» →
    js.Perm s.«历史».«立表».«汇流器» →
    us₁.Perm (s.«历史».«立表».«非运输单位».map (·.1)) →
    us₂.Perm (s.«历史».«立表».«非运输单位».map (·.1)) →
    «一步照» (s.«历史».«立表照» gs) bs js us₁ us₂ un todo s = «一步» un todo s

/-- 框架：从状态 `s` 起依次做一串操作；有一件做不了就没有结果。 -/
def «依次作用» (un : «未定») (todo : «待写») : «状态» → List «操作» → Option «状态»
  | s, [] => some s
  | s, o :: os => («作用» un todo s o).bind fun s' => «依次作用» un todo s' os

/-- 据：通道、接通

从什么都没建的基地起，不管依次做什么操作，到达的状态历史都合规。 -/
def «可达状态合规» : Prop :=
  ∀ (un : «未定») (todo : «待写») (os : List «操作») (s : «状态»),
    «依次作用» un todo «状态».«空» os = some s → s.«历史».«合规» = true

/-- 据：判定顺序、级别、移动

顶层：合法基地上，每种操作都有结果，走步时没有哪个组被跳过，而且走一步的结果不看规则没定的先后。 -/
def «顶层» : Prop :=
  ∀ (un : «未定») (todo : «待写») (s : «状态»),
    todo.«有电只看历史» → s.«历史».«合法» = true →
    (∀ o : «操作», («作用» un todo s o).isSome = o.«做得了» s) ∧
    (∀ g ∈ s.«布局».«各组», (s.«历史».«级别» s.«历史».length g).isSome = true) ∧
    (∀ (gs : List «组») (bs : List «通道») (js : List («单位号» × List «通道»))
        (us₁ us₂ : List «单位号»),
      gs.Perm s.«布局».«各组» →
      bs.Perm s.«历史».«立表».«带内» →
      js.Perm s.«历史».«立表».«汇流器» →
      us₁.Perm (s.«历史».«立表».«非运输单位».map (·.1)) →
      us₂.Perm (s.«历史».«立表».«非运输单位».map (·.1)) →
      «一步照» (s.«历史».«立表照» gs) bs js us₁ us₂ un todo s = «一步» un todo s)

end Endfield.«命题»
