import Endfield.«配方»

/-!
# 单位

规则文件「单位」一块里和通道、元件有关的部分：有哪些种类，哪些是运输单位。
大小、端口在哪条边、物品格还没写。
-/

namespace Endfield

/-- 据：运输单位、特别运输单位、制造单位、仓储单位、核心单位

单位的种类。桥接器的四个物品格各记成一个「桥接器格」：规则「元件」一行把它们各算一个元件，
各只连一边的存货端口和对边的取货端口，互不相干。供电桩没有端口，不在这里。 -/
inductive «单位种类» where
  | «传送带» | «分流器» | «汇流器» | «物品准入口» | «桥接器格»
  | «协议储存箱» | «制造» (k : «制造单位») | «协议核心» | «仓库取货口»
deriving DecidableEq, Repr

namespace «单位种类»

/-- 运输单位：大小均为 1×1；除桥接器外只有一个物品格，每个物品格上限 1 -/
def «是运输单位» : «单位种类» → Bool
  | «传送带» | «分流器» | «汇流器» | «物品准入口» | «桥接器格» => true
  | _ => false

/-- 特别运输单位：

运输单位里除传送带以外的。 -/
def «是特别运输单位» (k : «单位种类») : Bool :=
  k.«是运输单位» && k != «传送带»

end «单位种类»

end Endfield
