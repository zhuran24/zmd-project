import Endfield.«拓扑与级别»
import Endfield.«判定与轮询»

/-!
# 框架：游戏记着什么，什么事会改变它

这份文件立起整个模型的骨架：

- `状态`：游戏在两步之间记着的每一样东西；
- `操作`：会改变状态的每一种事（走一步、玩家的各种操作、离线）；
- `作用`：每种操作发生以后，状态的每一样怎样变。

`作用` 里每种操作都把状态的每个字段写一遍，不用「其余不变」的省略写法，
所以「每样东西 × 每种事」的每一格都必须有着落。着落写在那一格的行尾，有五种：

- 据：规则文件或求解任务的某一行；
- 实测：某次实测；
- 没测：照最自然的做法写了，没有依据；
- 未定：规则没写、也没测过，值取自 `未定`；
- 待写：规则有，模型里还没写到，值取自 `待写`。

「没测」「未定」的格子就是还没抓到的边界，在 边界清单.md 里各有一条。
-/

namespace Endfield

/-- 据：物品格、存货/取货物品格、缓存格

一个单位里的哪个物品格。运输单位只有 `格 0`；协议储存箱是 `格 0` 到 `格 5`（编号 1 到 6）；
制造单位是 `存货 i`、`取货`、`缓存`。仓库的物品格不在这里，记在状态的 `仓库` 里。 -/
inductive «格名» where
  | «格» (i : Nat) | «存货» (i : Nat) | «取货» | «缓存»
deriving DecidableEq, Repr

/-- 据：物品格

格位：哪个单位的哪个物品格。 -/
structure «格位» where
  «单位» : «单位号»
  «名» : «格名»
deriving DecidableEq, Repr

/-- 据：物品格

一格里的一种货和它的件数。缓存格可以同时有几种，所以一格的货是几堆。 -/
structure «一堆» where
  «物» : «物品»
  «件数» : Nat
deriving DecidableEq, Repr

/-- 据：物品准入口

一个物品准入口的设定和计数。`放行` 是只放行的那种物品，没设是 `none`；
两项上限没设是 `none`；`本段还剩` 是这个 5 tick 还剩几步，没在计是 `none`。 -/
structure «准入口状态» where
  «放行» : Option «物品» := none
  «累计上限» : Option Nat := none
  «每5tick上限» : Option Nat := none
  «累计已收» : Nat := 0
  «本段已收» : Nat := 0
  «本段还剩» : Option «步» := none
deriving DecidableEq, Repr

/-- 据：协议储存箱、传输

一个协议储存箱的模式和冷却。新建默认是无线传输模式。 -/
structure «储存箱状态» where
  «仓储模式» : Bool := false
  «冷却还剩» : «步» := 0
deriving DecidableEq, Repr

/-- 框架：游戏在两步之间记着的每一样东西。

布局、建成先后、接通先后、终点的时刻、组的时刻都从 `历史` 算，不另记。
供电状态由供电桩的位置定，等格子写出来以后从布局算，也不在这里。 -/
structure «状态» where
  /-- 基地上依次发生过的建成、接通、拆除 -/
  «历史» : «历史»
  /-- 每个物品格里的货 -/
  «货» : «格位» → List «一堆»
  /-- 运输单位物品格里的那件货已经停了几步（滞留） -/
  «已停» : «格位» → «步»
  /-- 运输单位物品格里的那件货刚离开的上一物品格（移动：不会移回） -/
  «来处» : «格位» → Option «格位»
  /-- 每个分流器的取货通道那一组，上一次移动物品的通道（元件轮询） -/
  «分流器上次» : «单位号» → Option «通道»
  /-- 不是分流器的元件通往同一个单位的那一组、汇流器的输入判定，上一次移动物品的通道（元件轮询） -/
  «进货上次» : «单位号» → Option «通道»
  /-- 每个非运输单位通往非汇流器的那一组，移动过物品的通道按最近一次移动的先后（非运输单位轮询） -/
  «出货已移动» : «单位号» → List «通道»
  /-- 每个制造单位正在做的配方和还差几步；没在做是 `none` -/
  «制造中» : «单位号» → Option («配方» × «步»)
  /-- 每个物品准入口的设定和计数 -/
  «准入口» : «单位号» → «准入口状态»
  /-- 每个协议储存箱的模式和冷却 -/
  «储存箱» : «单位号» → «储存箱状态»
  /-- 每个需电单位的开关 -/
  «开关» : «单位号» → Bool
  /-- 协议核心、仓库取货口的每个取货端口指向仓库里的哪种物品 -/
  «取货指向» : «单位号» → Nat → Option «物品»
  /-- 仓库里每种物品的件数 -/
  «仓库» : «物品» → Nat

namespace «状态»

/-- 框架：什么都还没建的基地。开关默认开着（没测）。 -/
def «空» : «状态» where
  «历史» := []
  «货» := fun _ => []
  «已停» := fun _ => 0
  «来处» := fun _ => none
  «分流器上次» := fun _ => none
  «进货上次» := fun _ => none
  «出货已移动» := fun _ => []
  «制造中» := fun _ => none
  «准入口» := fun _ => {}
  «储存箱» := fun _ => {}
  «开关» := fun _ => true
  «取货指向» := fun _ _ => none
  «仓库» := fun _ => 0

/-- 据：通道

现在的布局。 -/
def «布局» (s : «状态») : «布局» :=
  s.«历史».«布局于» s.«历史».length

end «状态»

/-- 框架：规则没写、也没测过的做法。

游戏在这些地方有确定的做法，只是我们不知道。模型把它们当参数带着，结论要对每种取值都成立。
每个字段是 边界清单.md 里的一条；测出来一个，就把它从这里拿掉、写成定下来的做法。 -/
structure «未定» where
  /-- 不是分流器的那些组（几条通道进同一个单位、汇流器的输入判定），通道有增减以后的「上次」。
  给出改动前、改动后的布局，是哪个单位，原来的「上次」。 -/
  «通道增减后的进货上次» : «布局» → «布局» → «单位号» → Option «通道» → Option «通道»
  /-- 非运输单位的出口有增减以后，它那一组移动过物品的通道的先后 -/
  «通道增减后的出货已移动» : «布局» → «布局» → «单位号» → List «通道» → List «通道»
  /-- 物品准入口改设定以后的累计已收、本段已收、本段还剩（规则文件写明无法确定） -/
  «改设定后的计数» : «准入口状态» → Nat × Nat × Option «步»
  /-- 协议储存箱切换模式以后的冷却；给出原来的状态和新模式是不是仓储模式 -/
  «切换模式后的冷却» : «储存箱状态» → Bool → «步»
  /-- 离线以后物品准入口的累计已收、本段已收、本段还剩（求解任务「离线」一行没有提到） -/
  «离线后的计数» : «准入口状态» → Nat × Nat × Option «步»
  /-- 协议储存箱的传输是不是排在它各组的移动判定之前（规则文件写明无法确定） -/
  «传输先于移动判定» : «单位号» → Bool
  /-- 没有供电或开关关着时，协议储存箱的冷却还走不走 -/
  «不运行时冷却照走» : Bool

/-- 框架：规则有、模型里还没写到的部分，先只定下它们各自拿什么、给什么。

写好一个，就从这里拿掉一个，换成真正的定义。 -/
structure «待写» where
  /-- 判定顺序第 1 条：所有单位同时进行结束制造判定 -/
  «结束制造判定» : «状态» → «状态»
  /-- 判定顺序第 2 条：各汇流器进行输入判定，给出每个汇流器这一步出现输入判定的通道 -/
  «输入判定» : «状态» → «单位号» → Option «通道»
  /-- 判定顺序第 3 条：元件的各组按级别从高到低依次进行移动判定 -/
  «元件的移动判定» : («单位号» → Option «通道») → «状态» → «状态»
  /-- 判定顺序第 4 条：非运输单位按建成的先后依次选取，各组按级别从高到低依次进行移动判定；传输也在这里 -/
  «非运输单位的移动判定» : «未定» → («单位号» → Option «通道») → «状态» → «状态»
  /-- 判定顺序第 5 条：所有单位同时进行开始制造判定 -/
  «开始制造判定» : «状态» → «状态»
  /-- 玩家往一个单位里放货：放进哪一格（协议储存箱是编号最小的能放它的物品格） -/
  «放进单位» : «状态» → «单位号» → «物品» → Nat → «格位» → List «一堆»

/-- 判定顺序：每步按以下顺序依次执行：

五条判定各自怎样做还在 `待写` 里，这里只定下它们的先后，和输入判定选中的通道只在这一步里用。 -/
def «一步» (un : «未定») (todo : «待写») (s : «状态») : «状态» :=
  let s1 := todo.«结束制造判定» s
  let sel := todo.«输入判定» s1
  let s3 := todo.«元件的移动判定» sel s1
  let s4 := todo.«非运输单位的移动判定» un sel s3
  todo.«开始制造判定» s4

/-- 框架：会改变状态的每一种事。

- `走一步`：过 1/8 tick；
- `改布局`：建成一个单位、接通一条通道、拆除一个单位（接通跟着建成发生，哪条先接通等格子写出来以后由「接通」一行给出）；
- `设准入口`、`设储存箱模式`、`设取货指向`、`拨开关`：改设定；
- `放货`：玩家往一个单位里放物品；`取成品`：玩家从仓库拿物品；
- `离线`：服务器把全部单位重新建造一遍，`重建` 是重建以后的历史，它的先后无法确定。 -/
inductive «操作» where
  | «走一步»
  | «改布局» (e : «事件»)
  | «设准入口» (u : «单位号») («放行» : Option «物品») («累计上限» «每5tick上限» : Option Nat)
  | «设储存箱模式» (u : «单位号») («仓储» : Bool)
  | «设取货指向» (u : «单位号») («口» : Nat) (x : Option «物品»)
  | «拨开关» (us : List «单位号») («开» : Bool)
  | «放货» (u : «单位号») (x : «物品») (n : Nat)
  | «取成品» (x : «物品») (n : Nat)
  | «离线» («重建» : «历史»)

end Endfield
