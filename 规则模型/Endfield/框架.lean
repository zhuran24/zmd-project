import Endfield.«拓扑与级别»
import Endfield.«判定与轮询»

/-!
# 框架：游戏记着什么，什么事会改变它

这份文件立起整个模型的骨架：

- `状态`：游戏在两步之间记着的每一样东西；
- `操作`：会改变状态的每一种事（走一步、玩家的各种操作、外部过程、离线）；
- `未定`：游戏有确定做法、我们不知道的地方，当参数带着；
- `待写`：规则有、模型里还没写到的部分，先定下它们拿什么、给什么；
- `计时`：规则没写的一件事，各种时长在一步里的哪一刻往前走。

一步怎么走在 `判定.lean` 里；每种操作发生以后状态的每一样怎样变，在 `作用.lean` 里。
-/

namespace Endfield

/-- 据：物品格、存货/取货物品格、缓存格

一个单位里的哪个物品格。运输单位只有 `格 0`；协议储存箱是 `格 0` 到 `格 5`（编号 1 到 6）；
制造单位是 `存货 i`、`取货`、`缓存`。仓库的物品格不在这里，记在状态的 `仓库` 里。 -/
inductive «格名» where
  | «格» (i : Nat) | «存货» (i : Nat) | «取货» | «缓存»
deriving DecidableEq, Repr

/-- 据：物品格、运输单位、协议储存箱、制造单位、仓库

一种单位有哪些物品格。协议核心、仓库取货口自己没有物品格（仓库的物品格记在状态的 `仓库` 里）。 -/
def «单位种类».«物品格» : «单位种类» → List «格名»
  | .«传送带» | .«分流器» | .«汇流器» | .«物品准入口» | .«桥接器格» => [.«格» 0]
  | .«协议储存箱» => (List.range 6).map .«格»
  | .«制造» k => (List.range k.«存货物品格数»).map .«存货» ++ [.«取货», .«缓存»]
  | .«协议核心» | .«仓库取货口» => []

/-- 据：物品格

格位：哪个单位的哪个物品格。 -/
structure «格位» where
  «单位» : «单位号»
  «名» : «格名»
deriving DecidableEq, Repr

/-- 据：物品格

一格里的一种货和它的件数。缓存格可以同时有几种，所以一格的货是几堆。 -/
structure «一堆» where
  «物» : «物品»
  «件数» : Nat
deriving DecidableEq, Repr

/-- 据：物品准入口

一个物品准入口的设定和计数。`放行` 是只放行的那种物品，没设是 `none`；
两项上限没设是 `none`；`本段还剩` 是这个 5 tick 还剩几步，没在计是 `none`。 -/
structure «准入口状态» where
  «放行» : Option «物品» := none
  «累计上限» : Option Nat := none
  «每5tick上限» : Option Nat := none
  «累计已收» : Nat := 0
  «本段已收» : Nat := 0
  «本段还剩» : Option «步» := none
deriving DecidableEq, Repr

/-- 据：协议储存箱、传输

一个协议储存箱的模式和冷却。新建默认是无线传输模式。 -/
structure «储存箱状态» where
  «仓储模式» : Bool := false
  «冷却还剩» : «步» := 0
deriving DecidableEq, Repr

/-- 框架：游戏在两步之间记着的每一样东西。

布局、建成先后、接通先后、终点的时刻、组的时刻都从 `历史` 算，不另记。
供电状态由供电桩的位置定，等格子写出来以后从布局算，也不在这里。 -/
structure «状态» where
  /-- 基地上依次发生过的建成、接通、拆除 -/
  «历史» : «历史»
  /-- 每个物品格里的货 -/
  «货» : «格位» → List «一堆»
  /-- 运输单位物品格里的那件货已经停了几步（滞留） -/
  «已停» : «格位» → «步»
  /-- 运输单位物品格里的那件货刚离开的上一物品格（移动：不会移回） -/
  «来处» : «格位» → Option «格位»
  /-- 每个分流器的取货通道那一组，上一次移动物品的通道（元件轮询） -/
  «分流器上次» : «单位号» → Option «通道»
  /-- 不是分流器的元件通往同一个单位的那一组、汇流器的输入判定，上一次移动物品的通道（元件轮询） -/
  «进货上次» : «单位号» → Option «通道»
  /-- 每个非运输单位通往非汇流器的那一组，移动过物品的通道按最近一次移动的先后（非运输单位轮询） -/
  «出货已移动» : «单位号» → List «通道»
  /-- 每个制造单位正在做的配方和还差几步；没在做是 `none` -/
  «制造中» : «单位号» → Option («配方» × «步»)
  /-- 每个物品准入口的设定和计数 -/
  «准入口» : «单位号» → «准入口状态»
  /-- 每个协议储存箱的模式和冷却 -/
  «储存箱» : «单位号» → «储存箱状态»
  /-- 每个需电单位的开关 -/
  «开关» : «单位号» → Bool
  /-- 协议核心、仓库取货口的每个取货端口指向仓库里的哪种物品 -/
  «取货指向» : «单位号» → Nat → Option «物品»
  /-- 仓库里每种物品的件数 -/
  «仓库» : «物品» → Nat

namespace «状态»

/-- 框架：什么都还没建的基地。开关默认开着（没测）。 -/
def «空» : «状态» where
  «历史» := []
  «货» := fun _ => []
  «已停» := fun _ => 0
  «来处» := fun _ => none
  «分流器上次» := fun _ => none
  «进货上次» := fun _ => none
  «出货已移动» := fun _ => []
  «制造中» := fun _ => none
  «准入口» := fun _ => {}
  «储存箱» := fun _ => {}
  «开关» := fun _ => true
  «取货指向» := fun _ _ => none
  «仓库» := fun _ => 0

/-- 据：通道

现在的布局。 -/
def «布局» (s : «状态») : «布局» :=
  s.«历史».«布局于» s.«历史».length

end «状态»

/-- 工具：把函数 f 在 a 处的值换成 b，别处不变。 -/
def «换» {α β : Type} [DecidableEq α] (f : α → β) (a : α) (b : β) : α → β :=
  fun x => if x = a then b else f x

namespace «布局»

/-- 据：组、输入判定

通道 c 是不是状态里 `进货上次` 管的那种：不是分流器的元件通往同一个单位的那一组里的，
或者非运输单位通往汇流器的（汇流器输入判定的那一组，就是这两种合起来）。 -/
def «算进货» (L : «布局») (c : «通道») : Bool :=
  match L.«所在组» c with
  | some (.«进同一个的» _) | some (.«进汇流器的» _) => true
  | _ => false

/-- 据：组

通道 c 是不是状态里 `出货已移动` 管的那种：非运输单位通往非汇流器。 -/
def «算出货» (L : «布局») (c : «通道») : Bool :=
  match L.«所在组» c with
  | some (.«出货的» _) => true
  | _ => false

end «布局»

/-- 规则里没有：都没货时

汇流器做输入判定时，那一组通道的起点里都没有可移动物品，这一步它通过哪条通道收货。三种说法：
- `不收`：规则文件现在的字面（轮询跳过没有可移动物品的通道，都跳过就没有通道出现输入判定）；
- `轮到的那条`：这一步轮询排第一的那条出现输入判定；
- `都收`：这一步哪条通道先送来就收哪条。
实测-2026-10-10 实验 A 第四组和 `不收` 对不上，实测-2026-11-10 和 `轮到的那条` 对不上，`都收` 都对得上。
另两种留着，只为在回放里核对它们确实对不上（`回放/现象.lean` 第 24 条）。规则文件那两行还没改，见 边界清单.md。 -/
inductive «都没货时» where
  | «不收» | «轮到的那条» | «都收»
deriving DecidableEq, Repr

/-- 框架：规则没写、也没测过的做法。

游戏在这些地方有确定的做法，只是我们不知道。模型把它们当参数带着，结论要对每种取值都成立。
每个字段是 边界清单.md 里的一条；测出来一个，就把它从这里拿掉、写成定下来的做法。 -/
structure «未定» where
  /-- 不是分流器的那些组（几条通道进同一个单位、汇流器的输入判定），通道有增减以后的「上次」。
  给出改动前、改动后的布局，是哪个单位，原来的「上次」。 -/
  «通道增减后的进货上次» : «布局» → «布局» → «单位号» → Option «通道» → Option «通道»
  /-- 非运输单位的出口有增减以后，它那一组移动过物品的通道的先后 -/
  «通道增减后的出货已移动» : «布局» → «布局» → «单位号» → List «通道» → List «通道»
  /-- 物品准入口改设定以后的累计已收、本段已收、本段还剩（规则文件写明无法确定）。
  给出原来的状态和新的放行物品、累计上限、每 5 tick 上限。 -/
  «改设定后的计数» : «准入口状态» → Option «物品» → Option Nat → Option Nat → Nat × Nat × Option «步»
  /-- 协议储存箱切换模式以后的冷却；给出原来的状态和新模式是不是仓储模式 -/
  «切换模式后的冷却» : «储存箱状态» → Bool → «步»
  /-- 新建的协议储存箱的冷却从多少开始 -/
  «新建储存箱的冷却» : «步»
  /-- 离线以后物品准入口的累计已收、本段已收、本段还剩（求解任务「离线」一行没有提到） -/
  «离线后的计数» : «准入口状态» → Nat × Nat × Option «步»
  /-- 协议储存箱的传输是不是排在它各组的移动判定之前（规则文件写明无法确定） -/
  «传输先于移动判定» : «单位号» → Bool
  /-- 没有供电或开关关着时，协议储存箱的冷却还走不走 -/
  «不运行时冷却照走» : Bool
  /-- 拆除一个单位时，它里面的货是不是回到仓库（不回就是离开基地） -/
  «拆除时货回仓库» : Bool
  /-- 冷却结束的协议储存箱被选取时里面没有货，算不算传输了一次（算就接着冷却 5 tick） -/
  «空箱也传输» : Bool
  /-- 汇流器做输入判定时那一组通道的起点里都没有可移动物品，这一步它通过哪条通道收货 -/
  «输入判定都没货时» : «都没货时»

/-- 框架：规则有、模型里还没写到的部分，先只定下它们各自拿什么、给什么。

写好一个，就从这里拿掉一个，换成真正的定义。五条判定已经写进 `判定.lean`，剩下的三样都要等格子。 -/
structure «待写» where
  /-- 玩家往一个单位里放货：放进哪一格（协议储存箱是编号最小的能放它的物品格） -/
  «放进单位» : «状态» → «单位号» → «物品» → Nat → «格位» → List «一堆»
  /-- 供电状态：单位有没有被供电桩供上电（等格子写出来以后从位置算） -/
  «有电» : «状态» → «单位号» → Bool
  /-- 协议核心、仓库取货口的一条取货通道接在第几个取货端口上（等格子写出来以后从位置算） -/
  «口» : «状态» → «通道» → Nat

/-- 据：需电功能

单位 u 的需电功能现在运不运行：有电，而且开关开着。 -/
def «状态».«运行» (todo : «待写») (s : «状态») (u : «单位号») : Bool :=
  todo.«有电» s u && s.«开关» u

/-- 规则里没有：计时

规则文件写了四种时长（滞留 1 tick、配方时长、物品准入口的每 5 tick、传输的冷却 5 tick），
没写它们在一步里的哪一刻往前走。这里放在一步的最后，五条判定都做完以后各走 1 步，
也就是「第 s 步里开始的事，过满 n 步是第 s+n 步」：

- 第 s 步里进到运输单位物品格的物品（不管是元件判定时进来的，还是非运输单位判定时进来的），第 s+8 步起可移动；
- 第 s 步末开工的一次制造，在第 s+8×配方时长 步开始时结束；
- 第 s 步里收下第一件的物品准入口，那 5 tick 是第 s 步到第 s+39 步，第 s+40 步收下的算下一段的第一件；
- 第 s 步里传输过的协议储存箱，第 s+40 步起能再传输。

每个字段行尾是这一格的着落，写法同 `作用.lean`。 -/
def «计时» (un : «未定») (todo : «待写») (s : «状态») : «状态» where
  «历史» := s.«历史»    -- 无关
  «货» := s.«货»    -- 无关
  «已停» :=    -- 没测：滞留从进来的那一步算起，和它是哪一条判定时进来的无关
    let L := s.«布局»
    fun g => if L.«是运输单位» g.«单位» && !(s.«货» g).isEmpty then s.«已停» g + 1 else 0
  «来处» := s.«来处»    -- 无关
  «分流器上次» := s.«分流器上次»    -- 无关
  «进货上次» := s.«进货上次»    -- 无关
  «出货已移动» := s.«出货已移动»    -- 无关
  «制造中» := fun u =>    -- 据：制造、需电功能（配方时长过后结束；不运行时进行中的进度保留）
    match s.«制造中» u with
    | some (r, n) => if s.«运行» todo u then some (r, n - 1) else some (r, n)
    | none => none
  «准入口» := fun u =>    -- 没测：那 5 tick 正好是 40 步，走完的那一步末清零
    let g := s.«准入口» u
    match g.«本段还剩» with
    | some n =>
      if n ≤ 1 then { g with «本段已收» := 0, «本段还剩» := none }
      else { g with «本段还剩» := some (n - 1) }
    | none => g
  «储存箱» := fun u =>    -- 未定：不运行时冷却照走
    let b := s.«储存箱» u
    if s.«运行» todo u || un.«不运行时冷却照走» then { b with «冷却还剩» := b.«冷却还剩» - 1 } else b
  «开关» := s.«开关»    -- 无关
  «取货指向» := s.«取货指向»    -- 无关
  «仓库» := s.«仓库»    -- 无关

/-- 框架：会改变状态的每一种事。

- `走一步`：过 1/8 tick；
- `改布局`：建成一个单位、接通一条通道、拆除一个单位。规则「接通」一行说通道是在单位建成时依次形成的，
  所以游戏里「建一个单位」是一次建成加上紧跟着的几次接通，中间不会走步；哪几条、谁先谁后，
  等格子写出来以后由位置和「接通」一行给出，那时这里换成「在哪一格、朝哪边建一个什么」；
- `设准入口`、`设储存箱模式`、`设取货指向`、`拨开关`：改设定；
- `放货`：玩家往一个单位里放物品；`收货`：玩家把一个物品格里的物品整格拿走；
- `入库`：仓库里多出物品（求解任务「外部过程」，或玩家放进去）；`出库`：仓库里拿走物品（求解任务「拿取成品」）；
- `离线`：服务器把全部单位重新建造一遍，`重建` 是重建以后的历史，它的先后无法确定。

还没列进来的：用游戏里的「移动」挪一个单位、原地旋转一个单位（见 边界清单.md）。 -/
inductive «操作» where
  | «走一步»
  | «改布局» (e : «事件»)
  | «设准入口» (u : «单位号») («放行» : Option «物品») («累计上限» «每5tick上限» : Option Nat)
  | «设储存箱模式» (u : «单位号») («仓储» : Bool)
  | «设取货指向» (u : «单位号») («口» : Nat) (x : Option «物品»)
  | «拨开关» (us : List «单位号») («开» : Bool)
  | «放货» (u : «单位号») (x : «物品») (n : Nat)
  | «收货» (g : «格位»)
  | «入库» (x : «物品») (n : Nat)
  | «出库» (x : «物品») (n : Nat)
  | «离线» («重建» : «历史»)

end Endfield
