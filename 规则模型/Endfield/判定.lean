import Endfield.«物品格»

/-!
# 判定：一步怎么走

规则文件「判定与轮询」一块的判定顺序、输入判定、移动判定，和「需电功能」一块的制造、传输。

一步里状态的变化都由五种「一件事」拼成，每种把状态的每个字段写一遍、行尾写着落（写法同 `作用.lean`）：
`移一件`（在 `物品格.lean`）、`结束一次制造`、`进取货格`、`开始一次制造`、`传输一次`；最后是 `计时`（在 `框架.lean`）。
这份文件其余的部分只管「哪件事在什么时候轮到」：判定顺序、级别、轮询。

规则文件里的「一直」「同时」各落在哪里：
- 「元件内的物品一直在尝试移动」：`整理`。一步开始时做一次，之后每移动一件物品就做一次，做到没有物品能前移为止；
- 「制造单位内的物品在通道打开时尝试移动」：存货物品格通往缓存格的通道只在开始制造时打开（见 `开始一次制造`），缓存格通往取货物品格的通道只在结束制造判定时打开（见 `进取货格`）；
- 「所有单位同时进行结束制造判定／开始制造判定」：各制造单位只改自己名下的东西，这里按建成先后一个个做，先后不影响结果（`命题.制造判定不看先后`）。
-/

namespace Endfield

/-- 框架：从历史算出来、走步时用的几张表。历史不变它们就不变，回放很多步时只算一次。

- `现布局`：现在的布局；
- `带内`：一段传送带里相邻两格之间的通道，按接通先后；
- `元件的组`：元件的各组，按级别从高到低，各带着自己的通道（按接通先后）；
- `汇流器`：每个汇流器输入判定的那一组通道（不是与分流器形成的），按接通先后；
- `非运输单位`：非运输单位按建成的先后，各带着自己的各组（按级别从高到低）和各组的通道。

没有级别的组（连着断头带之类，见 边界清单.md「合法基地」）不在表里，不做判定。 -/
structure «判定表» where
  «现布局» : «布局»
  «带内» : List «通道»
  «元件的组» : List («组» × List «通道»)
  «汇流器» : List («单位号» × List «通道»)
  «非运输单位» : List («单位号» × List («组» × List «通道»))

/-- 据：判定顺序、级别

把几个组按级别从高到低排好，各带上自己的通道（按接通先后）。没有级别的组不在里面。
两个组级别并列时照 `gs` 里的先后排；不同的组级别不会并列（`命题.级别不并列`），
所以排出来的结果不看 `gs` 的先后（`命题.按级别排不看先后`）。 -/
def «历史».«按级别排» (H : «历史») (gs : List «组») : List («组» × List «通道») :=
  let now := H.length
  let L := H.«布局于» now
  ((gs.filterMap fun g => (H.«级别» now g).map fun lv => (g, lv)).mergeSort
    fun a b => !«历史».«级别高于» b.2 a.2).map fun p => (p.1, (L.«组的通道» p.1).map (·.1))

/-- 据：判定顺序、级别、输入判定、元件

照现在的历史把判定表算出来；`gs` 是现有的各组，列出来的先后随便（各组谁先谁后由 `按级别排` 照级别定）。 -/
def «历史».«立表照» (H : «历史») (gs : List «组») : «判定表» :=
  let now := H.length
  let L := H.«布局于» now
  { «现布局» := L
    «带内» := (L.«通道表».map (·.1)).filter fun c =>
      L.«种类» c.«起» == some .«传送带» && L.«种类» c.«止» == some .«传送带»
    «元件的组» := H.«按级别排» (gs.filter (·.«是元件的»))
    «汇流器» := (L.«建成先后».filter fun u => L.«种类» u == some .«汇流器»).map fun j =>
      (j, ((L.«进» j).map (·.1)).filter fun c => L.«种类» c.«起» != some .«分流器»)
    «非运输单位» := (L.«建成先后».filter L.«是非运输单位»).map fun u =>
      (u, H.«按级别排» (gs.filter fun g =>
        match g with
        | .«出货的» v => v == u
        | .«进汇流器的» c => c.«起» == u
        | _ => false)) }

/-- 据：判定顺序、级别、输入判定、元件

照现在的历史把判定表算出来。 -/
def «历史».«立表» (H : «历史») : «判定表» :=
  H.«立表照» (H.«布局于» H.length).«各组»

/-- 据：元件轮询

一组通道 cs（按接通先后）这一回依次选取的先后；`last` 是这一组上一次移动物品的通道。
记着的那条不在这一组里时当成未移动过物品。 -/
def «元件先后» (cs : List «通道») (last : Option «通道») : List «通道» :=
  let i : Option (Fin cs.length) := last.bind fun c => cs.finIdxOf? c
  («元件轮询» cs.length i).map cs.get

/-- 据：非运输单位轮询

非运输单位通往非汇流器的那一组通道 cs（按接通先后）这一回依次选取的先后；
`moved` 是移动过物品的通道，按最近一次移动的先后。 -/
def «出货先后» (isM : Bool) (cs : List «通道») (moved : List «通道») : List «通道» :=
  («非运输单位轮询» cs.length isM (moved.filterMap fun c => cs.finIdxOf? c)).map cs.get

namespace «状态»

/-- 据：移动、元件

把每段传送带里能前移的物品各前移一格（停满 1 tick、下一格空着的）；第二项是有没有物品移动了。 -/
def «前移一遍» (T : «判定表») (port : «通道» → Nat) (s : «状态») : «状态» × Bool :=
  T.«带内».foldl (fun (acc : «状态» × Bool) c =>
    match acc.1.«能移» T.«现布局» port c with
    | some (x, a, b) => (acc.1.«移一件» T.«现布局» c x a b, true)
    | none => acc) (s, false)

/-- 据：移动

「元件内的物品一直在尝试移动」：反复前移，到没有物品能前移为止。`fuel` 是最多几遍，取单位的个数就够。 -/
def «整理» (T : «判定表») (port : «通道» → Nat) : Nat → «状态» → «状态»
  | 0, s => s
  | fuel + 1, s =>
    let r := s.«前移一遍» T port
    if r.2 then «整理» T port fuel r.1 else r.1

/-- 输入判定：汇流器的存货通道中，不是与分流器形成的归为一组，按轮询确定一条出现输入判定的通道（到下一次输入判定或这一步结束为止有效）；汇流器只通过该通道和与分流器形成的通道收货

汇流器 j 这一步出现输入判定的通道：照元件轮询的先后，第一条起点里有可移动物品的；都没有是 `none`。 -/
def «输入判定» (T : «判定表») (port : «通道» → Nat) (s : «状态») (j : «单位号») : Option «通道» :=
  match T.«汇流器».find? (·.1 == j) with
  | some p =>
    («元件先后» p.2 (s.«进货上次» j)).find? fun c => (s.«可移动物品» T.«现布局» port c).isSome
  | none => none

/-- 据：输入判定

汇流器 j 收不收从通道 c 来的货（c 不是与分流器形成的）：只收最近一次输入判定选出的那一条。
`s1` 是做第一次输入判定那一刻的状态（结束制造判定之后、移动判定之前）；
`s3` 是做第二次输入判定那一刻的状态（元件的移动判定做完以后；元件的移动判定期间传 `s1` 进来，认的就是第一次的）。
规则文件写的是 `每步判两次`。`未定.输入判定都没货时` 取别的值时走的是被实测排除的几种说法，只在回放里用来核对它们确实对不上。 -/
def «汇流器收» (T : «判定表») (port : «通道» → Nat) (un : «未定») (s1 s3 : «状态») (c : «通道») : Bool :=
  if un.«输入判定都没货时» == .«每步判两次» then s3.«输入判定» T port c.«止» == some c
  else
    match s1.«输入判定» T port c.«止» with
    | some c' => c' == c
    | none =>
      match un.«输入判定都没货时» with
      | .«不收» => false
      | .«都收» => true
      | .«再判一次» | .«每步判两次» => s3.«输入判定» T port c.«止» == some c
      | .«轮到的那条» =>
        match T.«汇流器».find? (·.1 == c.«止») with
        | some p => («元件先后» p.2 (s1.«进货上次» c.«止»)).head? == some c
        | none => false

/-- 移动判定：物品尝试通过通道从起点移到另一个物品格的过程。一组通道按轮询依次进行移动判定，直到这组通道起点中的物品都已移出，或这组通道都已判定（被轮询跳过的通道也算已判定）

一组通道照 `order` 的先后各判定一次：能移就移一件，然后整理。
通往汇流器、又不是从分流器来的通道，要汇流器这一步收它才能移（`sel` 给出收不收，见 `汇流器收`）。 -/
def «判一组» (T : «判定表») (port : «通道» → Nat) (sel : «通道» → Bool)
    (order : List «通道») (s : «状态») : «状态» :=
  let L := T.«现布局»
  order.foldl (fun s c =>
    if L.«种类» c.«止» == some .«汇流器» && L.«种类» c.«起» != some .«分流器» && !sel c then s
    else
      match s.«能移» L port c with
      | some (x, a, b) => «整理» T port L.«单位表».length (s.«移一件» L c x a b)
      | none => s) s

/-- 据：判定顺序

判定顺序第 3 条：元件的各组按级别从高到低依次进行移动判定。 -/
def «元件的移动判定» (T : «判定表») (port : «通道» → Nat) (sel : «通道» → Bool)
    (s : «状态») : «状态» :=
  T.«元件的组».foldl (fun s p =>
    let last :=
      match p.1 with
      | .«分流器的» u => s.«分流器上次» u
      | .«进同一个的» t => s.«进货上次» t
      | _ => none
    s.«判一组» T port sel («元件先后» p.2 last)) s

/-- 据：传输、协议核心

协议储存箱 u 传输一次以后，箱里各格剩下的货和仓库里各种物品的件数。
「能送多少送多少」：仓库里一种物品到 80000 件就不再收；按物品格编号从小到大送（没测）。 -/
def «传输结果» (s : «状态») (u : «单位号») : (Nat → List «一堆») × («物品» → Nat) :=
  (List.range 6).foldl (fun acc i =>
    match s.«货» ⟨u, .«格» i⟩ with
    | [p] =>
      let k := min p.«件数» (80000 - acc.2 p.«物»)
      («换» acc.1 i (if k == p.«件数» then [] else [⟨p.«物», p.«件数» - k⟩]),
        «换» acc.2 p.«物» (acc.2 p.«物» + k))
    | _ => acc) (fun i => s.«货» ⟨u, .«格» i⟩, s.«仓库»)

/-- 框架：协议储存箱 u 传输一次以后的状态。每个字段行尾是这一格的着落。 -/
def «传输一次» (s : «状态») (u : «单位号») : «状态» where
  «历史» := s.«历史»    -- 无关
  «货» := fun g =>    -- 据：传输（把自身物品格内的所有物品无线传输到仓库中，能送多少送多少）
    if g.«单位» = u then
      match g.«名» with
      | .«格» i => (s.«传输结果» u).1 i
      | _ => s.«货» g
    else s.«货» g
  «已停» := s.«已停»    -- 无关
  «来处» := s.«来处»    -- 无关
  «分流器上次» := s.«分流器上次»    -- 无关
  «进货上次» := s.«进货上次»    -- 无关
  «出货已移动» := s.«出货已移动»    -- 没测：传输不算这个箱子的哪条通道移动了物品
  «制造中» := s.«制造中»    -- 无关
  «准入口» := s.«准入口»    -- 无关
  «储存箱» := «换» s.«储存箱» u    -- 据：传输（然后冷却 5 tick）
    { «仓储模式» := (s.«储存箱» u).«仓储模式»
      «冷却还剩» := 5 * «tick» }
  «开关» := s.«开关»    -- 无关
  «取货指向» := s.«取货指向»    -- 无关
  «仓库» := (s.«传输结果» u).2    -- 据：传输、协议核心（每格上限 80000）

/-- 据：传输

协议储存箱 u 被选取时该不该传输：无线传输模式、在运行、冷却已结束；里面没有货时算不算，取自 `未定`。 -/
def «该传输» (L : Endfield.«布局») (un : «未定») (todo : «待写») (s : «状态») (u : «单位号») : Bool :=
  L.«种类» u == some .«协议储存箱» && !(s.«储存箱» u).«仓储模式» && s.«运行» todo u
    && (s.«储存箱» u).«冷却还剩» == 0
    && (un.«空箱也传输» || (List.range 6).any fun i => !(s.«货» ⟨u, .«格» i⟩).isEmpty)

/-- 据：判定顺序、传输、非运输单位轮询

非运输单位 u 被选取：它的各组按级别从高到低依次进行移动判定；是协议储存箱时还有传输，
传输排在各组的移动判定之前还是之后，取自 `未定`。 -/
def «选取» (T : «判定表») (un : «未定») (todo : «待写») (port : «通道» → Nat)
    (sel : «通道» → Bool) (s : «状态»)
    (p : «单位号» × List («组» × List «通道»)) : «状态» :=
  let u := p.1
  let isM :=
    match T.«现布局».«种类» u with
    | some (.«制造» _) => true
    | _ => false
  let trans (s : «状态») : «状态» :=
    if s.«该传输» T.«现布局» un todo u then s.«传输一次» u else s
  let moves (s : «状态») : «状态» :=
    p.2.foldl (fun s g =>
      let order :=
        match g.1 with
        | .«出货的» _ => «出货先后» isM g.2 (s.«出货已移动» u)
        | _ => g.2
      s.«判一组» T port sel order) s
  if un.«传输先于移动判定» u then moves (trans s) else trans (moves s)

/-- 据：判定顺序

判定顺序第 4 条：非运输单位按建成的先后依次选取，每个非运输单位的各组按级别从高到低依次进行移动判定。 -/
def «非运输单位的移动判定» (T : «判定表») (un : «未定») (todo : «待写») (port : «通道» → Nat)
    (sel : «通道» → Bool) (s : «状态») : «状态» :=
  T.«非运输单位».foldl (fun s p => s.«选取» T un todo port sel p) s

/-- 据：制造、存货/取货物品格

制造单位 u（种类 k）的各个存货物品格里一共有几件 x。 -/
def «存货件数» (s : «状态») (k : «制造单位») (u : «单位号») (x : «物品») : Nat :=
  ((List.range k.«存货物品格数»).map fun i => s.«件数» ⟨u, .«存货» i⟩ x).foldl (· + ·) 0

/-- 据：制造

存货物品格中的物品符合的那条配方：这种制造单位的配方里，每种原料都够一次用量的。
没有时是 `none`；不止一条时也是 `none`（不会不止一条，见 `配方.lean` 的定理和 边界清单.md）。 -/
def «符合的配方» (s : «状态») (k : «制造单位») (u : «单位号») : Option «配方» :=
  match «配方表».filter fun r =>
      r.«单位» == k && r.«原料».all fun p => s.«存货件数» k u p.1 ≥ p.2 with
  | [r] => some r
  | _ => none

/-- 框架：制造单位 u 照配方 r 开始一次制造以后的状态。每个字段行尾是这一格的着落。 -/
def «开始一次制造» (s : «状态») (u : «单位号») (r : «配方») : «状态» where
  «历史» := s.«历史»    -- 无关
  «货» := fun g =>    -- 据：缓存格、制造（开始时一次制造的用量进入缓存格）
    if g.«单位» = u then
      match g.«名» with
      | .«缓存» => r.«原料».map fun p => ⟨p.1, p.2⟩
      | .«存货» _ => r.«原料».foldl (fun l p => «拿几件» l p.1 p.2) (s.«货» g)
      | _ => s.«货» g
    else s.«货» g
  «已停» := s.«已停»    -- 无关
  «来处» := s.«来处»    -- 无关
  «分流器上次» := s.«分流器上次»    -- 无关
  «进货上次» := s.«进货上次»    -- 无关
  «出货已移动» := s.«出货已移动»    -- 无关
  «制造中» := «换» s.«制造中» u (some (r, r.«时长» * «tick»))    -- 据：制造（配方时长过后结束）
  «准入口» := s.«准入口»    -- 无关
  «储存箱» := s.«储存箱»    -- 无关
  «开关» := s.«开关»    -- 无关
  «取货指向» := s.«取货指向»    -- 无关
  «仓库» := s.«仓库»    -- 无关

/-- 框架：制造单位 u 照配方 r 的一次制造结束以后的状态。每个字段行尾是这一格的着落。 -/
def «结束一次制造» (s : «状态») (u : «单位号») (r : «配方») : «状态» where
  «历史» := s.«历史»    -- 无关
  «货» := fun g =>    -- 据：制造（配方时长过后结束，制造好的物品进入缓存格）
    if g = ⟨u, .«缓存»⟩ then [⟨r.«产物».1, r.«产物».2⟩] else s.«货» g
  «已停» := s.«已停»    -- 无关
  «来处» := s.«来处»    -- 无关
  «分流器上次» := s.«分流器上次»    -- 无关
  «进货上次» := s.«进货上次»    -- 无关
  «出货已移动» := s.«出货已移动»    -- 无关
  «制造中» := «换» s.«制造中» u none    -- 据：制造
  «准入口» := s.«准入口»    -- 无关
  «储存箱» := s.«储存箱»    -- 无关
  «开关» := s.«开关»    -- 无关
  «取货指向» := s.«取货指向»    -- 无关
  «仓库» := s.«仓库»    -- 无关

/-- 据：缓存格、存货/取货物品格

制造单位 u 的缓存格里制造好的那批，这时能不能整批进取货物品格：没在制造，缓存格里是一种物品，
取货物品格空着、或放着同一种物品而且加起来不超过 50 件。 -/
def «进得去» (s : «状态») (u : «单位号») : Bool :=
  (s.«制造中» u).isNone &&
    match s.«货» ⟨u, .«缓存»⟩, s.«货» ⟨u, .«取货»⟩ with
    | [p], [] => p.«件数» ≤ 50
    | [p], [q] => p.«物» == q.«物» && p.«件数» + q.«件数» ≤ 50
    | _, _ => false

/-- 框架：制造单位 u 缓存格里制造好的那批整批进取货物品格以后的状态。每个字段行尾是这一格的着落。 -/
def «进取货格» (s : «状态») (u : «单位号») : «状态» where
  «历史» := s.«历史»    -- 无关
  «货» := fun g =>    -- 据：缓存格（它通往取货物品格的通道只让制造好的一批物品整批通过）
    if g = ⟨u, .«取货»⟩ then
      (s.«货» ⟨u, .«缓存»⟩).foldl (fun l p => «添几件» l p.«物» p.«件数») (s.«货» g)
    else if g = ⟨u, .«缓存»⟩ then []
    else s.«货» g
  «已停» := s.«已停»    -- 无关
  «来处» := s.«来处»    -- 无关
  «分流器上次» := s.«分流器上次»    -- 无关
  «进货上次» := s.«进货上次»    -- 无关
  «出货已移动» := s.«出货已移动»    -- 无关
  «制造中» := s.«制造中»    -- 无关
  «准入口» := s.«准入口»    -- 无关
  «储存箱» := s.«储存箱»    -- 无关
  «开关» := s.«开关»    -- 无关
  «取货指向» := s.«取货指向»    -- 无关
  «仓库» := s.«仓库»    -- 无关

/-- 据：判定顺序、制造、缓存格

判定顺序第 1 条：每步开始时，所有单位同时进行结束制造判定。`us` 里的每个制造单位：
- 在运行、配方时长已过的，结束这一次制造（没测：不在运行时不结束）；
- 然后，缓存格里制造好的那批进得去取货物品格就整批进去（规则「缓存格」一行：它通往取货物品格的通道只在结束制造判定时打开）。

规则说「同时」，这里照 `us` 的先后一个个做；各制造单位只改自己名下的东西，换个先后结果一样（`命题.制造判定不看先后`）。 -/
def «结束制造判定» (L : Endfield.«布局») (todo : «待写») (us : List «单位号») (s : «状态») : «状态» :=
  us.foldl (fun s u =>
    match L.«种类» u with
    | some (.«制造» _) =>
      let s1 :=
        match s.«制造中» u with
        | some (r, n) => if n == 0 && s.«运行» todo u then s.«结束一次制造» u r else s
        | none => s
      if s1.«进得去» u then s1.«进取货格» u else s1
    | _ => s) s

/-- 据：判定顺序、制造

判定顺序第 6 条：所有移动判定结束后，所有单位同时进行开始制造判定。`us` 里的每个制造单位：
在运行、没在制造、上一次开工的那批已全部进入取货物品格（缓存格空着）、存货物品格中的物品符合某个配方时，开始制造。
先后的事同 `结束制造判定`。 -/
def «开始制造判定» (L : Endfield.«布局») (todo : «待写») (us : List «单位号») (s : «状态») : «状态» :=
  us.foldl (fun s u =>
    match L.«种类» u with
    | some (.«制造» k) =>
      if s.«运行» todo u && (s.«制造中» u).isNone && (s.«货» ⟨u, .«缓存»⟩).isEmpty then
        match s.«符合的配方» k u with
        | some r => s.«开始一次制造» u r
        | none => s
      else s
    | _ => s) s

end «状态»

/-- 判定顺序：每步按以下顺序依次执行：

  1. 每步开始时，所有单位同时进行结束制造判定；
  2. 各汇流器进行输入判定；
  3. 元件的各组按级别从高到低依次进行移动判定；
  4. 各汇流器再进行一次输入判定；
  5. 非运输单位按建成的先后依次选取，每个非运输单位的各组按级别从高到低依次进行移动判定；
  6. 所有移动判定结束后，所有单位同时进行开始制造判定，随后这一步结束

`T` 是照现在的历史立好的判定表。六条之前先整理一次（上一步末计时以后停满 1 tick 的物品在这里前移），
六条之后计时。两次输入判定不改状态，结果由 `汇流器收` 现算：第 3 条用照 `s1` 判出来的，第 5 条用照 `s3` 判出来的。 -/
def «一步于» (T : «判定表») (un : «未定») (todo : «待写») (s : «状态») : «状态» :=
  let port := todo.«口» s
  let us := T.«非运输单位».map (·.1)
  let s0 := «状态».«整理» T port T.«现布局».«单位表».length s
  let s1 := s0.«结束制造判定» T.«现布局» todo us
  let s3 := s1.«元件的移动判定» T port (fun c => s1.«汇流器收» T port un s1 c)
  let s4 := s3.«非运输单位的移动判定» T un todo port (fun c => s1.«汇流器收» T port un s3 c)
  let s5 := s4.«开始制造判定» T.«现布局» todo us
  «计时» un todo s5

/-- 据：判定顺序

走一步：照现在的历史立表，再照判定顺序走。 -/
def «一步» (un : «未定») (todo : «待写») (s : «状态») : «状态» :=
  «一步于» s.«历史».«立表» un todo s

end Endfield
