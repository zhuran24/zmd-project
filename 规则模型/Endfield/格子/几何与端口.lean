import Endfield.«通道与移动»

/-!
基地坐标、摆件与端口。坐标向右、向下增加；端口的几何编号与接通先后分开。
端口生成返回 `Option`：矩形越界、传送带两端同边时拒绝，不截掉越界部分。
桥接器各边的接通先后照 2026-11-12 的实测写（跟着桥接器自己的朝向）；核心各端口的先后没测，由 `接通先后` 显式给出。
-/

namespace Endfield.«格子»

/-- 格：基地划分成的方格，每个单位都正好占满若干格 -/
structure «格» where
  i : Fin 70
  j : Fin 70
deriving DecidableEq, Repr

/-- 据：格、基地
从屏幕坐标造一格；边界以外没有格。 -/
def «格».«坐标» (i j : Nat) : Option «格» :=
  if hi : i < 70 then
    if hj : j < 70 then some ⟨⟨i, hi⟩, ⟨j, hj⟩⟩ else none
  else none

/-- 据：旋转、端口
屏幕方向；顺时针是上、右、下、左。 -/
inductive «朝向» where
  | «上» | «右» | «下» | «左»
deriving DecidableEq, Repr

/-- 据：旋转
四个方向的固定枚举，仅用于几何编号及未定顺序的同号破同。 -/
def «朝向».«各边» : List «朝向» := [.«上», .«右», .«下», .«左»]

/-- 据：旋转
屏幕顺时针转九十度。 -/
def «朝向».«顺时针» : «朝向» → «朝向»
  | .«上» => .«右» | .«右» => .«下» | .«下» => .«左» | .«左» => .«上»

/-- 据：旋转
相对的一条边。 -/
def «朝向».«对边» (d : «朝向») : «朝向» := d.«顺时针».«顺时针»

/-- 据：旋转
上、右、下、左编号零到三；桥接器单位号也用这个编号。 -/
def «朝向».«编号» : «朝向» → Nat
  | .«上» => 0 | .«右» => 1 | .«下» => 2 | .«左» => 3

/-- 据：基地、通道
沿一条边走到邻格，越过基地边界时返回 none；减法前检查零。 -/
def «格».«邻格» (c : «格») : «朝向» → Option «格»
  | .«上» => if c.j.val == 0 then none else «格».«坐标» c.i.val (c.j.val - 1)
  | .«右» => «格».«坐标» (c.i.val + 1) c.j.val
  | .«下» => «格».«坐标» c.i.val (c.j.val + 1)
  | .«左» => if c.i.val == 0 then none else «格».«坐标» (c.i.val - 1) c.j.val

/-- 据：协议核心
协议核心哪一对边取货。 -/
inductive «平行边» where
  | «上下» | «左右»
deriving DecidableEq, Repr

/-- 据：协议核心
方向是否在这一对平行边中。 -/
def «平行边».«包含» (a : «平行边») (d : «朝向») : Bool :=
  match a with
  | .«上下» => d == .«上» || d == .«下»
  | .«左右» => d == .«左» || d == .«右»

/-- 据：运输单位、传送带、分流器、汇流器、桥接器、制造单位、协议核心、供电桩
摆件种类及朝向；传送带依次给存货边、取货边，分流器给存货边，其余单向摆件给取货边。
桥接器给的是它自己的「上」边现在朝屏幕哪边：建造时不转是上，每顺时针转一次依次是右、下、左；
四条边长得一样，这个朝向只管各边接通的先后（`桥接器存货先后`）。
传送带的两条边须不同，在生成端口及建造时检查。 -/
inductive «摆件种类» where
  | «传送带» (a b : «朝向»)
  | «分流器» (d : «朝向»)
  | «汇流器» (d : «朝向»)
  | «物品准入口» (d : «朝向»)
  | «桥接器» (d : «朝向»)
  | «协议储存箱» (d : «朝向»)
  | «制造» (k : «制造单位») (d : «朝向»)
  | «协议核心» (a : «平行边»)
  | «仓库取货口» (d : «朝向»)
  | «供电桩»
deriving DecidableEq, Repr

/-- 据：运输单位、格、旋转
一次摆放的物件；位置是所占矩形左上角。桥接器占号到号加三；供电桩的号仅作摆件标识。
场地中摆件标识唯一，且与别的摆件所占单位号不重用。 -/
structure «摆件» where
  «种类» : «摆件种类»
  «位置» : «格»
  «号» : «单位号»
deriving DecidableEq, Repr

/-- 据：小制造单位、中制造单位、大制造单位
制造单位宽、高；大制造单位的六格长边朝取货方向。 -/
def «制造大小» (k : «制造单位») (d : «朝向») : Nat × Nat :=
  match k with
  | .«粉碎机» | .«精炼炉» | .«配件机» | .«塑形机» => (3, 3)
  | .«采种机» | .«种植机» => (5, 5)
  | .«研磨机» | .«封装机» | .«灌装机» =>
    if d == .«上» || d == .«下» then (6, 4) else (4, 6)

/-- 据：运输单位、协议储存箱、制造单位、协议核心、仓库取货口、供电桩
矩形的宽、高。 -/
def «摆件».«大小» (p : «摆件») : Nat × Nat :=
  match p.«种类» with
  | .«协议储存箱» _ => (3, 3)
  | .«制造» k d => «制造大小» k d
  | .«协议核心» _ => (9, 9)
  | .«仓库取货口» d => if d == .«上» || d == .«下» then (3, 1) else (1, 3)
  | .«供电桩» => (2, 2)
  | _ => (1, 1)

/-- 据：基地、格
完整占格；矩形有任一格越界则失败，不作裁切。 -/
def «摆件».«占格» (p : «摆件») : Option (List «格») :=
  ((List.range p.«大小».1).flatMap fun i =>
    (List.range p.«大小».2).map fun j => (i, j)).mapM fun (i, j) =>
      «格».«坐标» (p.«位置».i.val + i) (p.«位置».j.val + j)

/-- 据：运输单位、桥接器、供电桩
摆件对应的单位，桥接器按存货边上、右、下、左；供电桩没有单位。 -/
def «摆件».«单位» (p : «摆件») : List («单位号» × «单位种类») :=
  match p.«种类» with
  | .«传送带» _ _ => [(p.«号», .«传送带»)]
  | .«分流器» _ => [(p.«号», .«分流器»)]
  | .«汇流器» _ => [(p.«号», .«汇流器»)]
  | .«物品准入口» _ => [(p.«号», .«物品准入口»)]
  | .«桥接器» _ => «朝向».«各边».map fun d => (p.«号» + d.«编号», .«桥接器格»)
  | .«协议储存箱» _ => [(p.«号», .«协议储存箱»)]
  | .«制造» k _ => [(p.«号», .«制造» k)]
  | .«协议核心» _ => [(p.«号», .«协议核心»)]
  | .«仓库取货口» _ => [(p.«号», .«仓库取货口»)]
  | .«供电桩» => []

/-- 据：桥接器
是否为桥接器（不论朝向）。 -/
def «摆件».«是桥接器» (p : «摆件») : Bool :=
  match p.«种类» with
  | .«桥接器» _ => true
  | _ => false

/-- 据：运输单位
是否为运输摆件。 -/
def «摆件».«是运输单位» (p : «摆件») : Bool :=
  p.«单位».any fun (_, k) => k.«是运输单位»

/-- 端口：部分单位的部分边，每个端口为边上属于某一格的那段边
取货为 true、存货为 false；桥接器同一条边的存、取端口分属不同单位号。 -/
structure «端口» where
  «单位» : «单位号»
  «格» : «格»
  «边» : «朝向»
  «取货» : Bool
deriving DecidableEq, Repr

/-- 框架：规则没规定、也还没测的协议核心各端口的接通先后。
数越小越早；同号按上右下左、边上格号递增破同。存货始终先于取货。 -/
structure «接通先后» where
  «协议核心» : «朝向» → Nat → Nat

/-- 规则里没有：桥接器各边的接通先后
桥接器（它自己的「上」边朝屏幕的 d）建成时，四条边上的存货端口谁先接通：数越小越早。
实测是它自己的上、下、左、右，也就是屏幕上的 d、d 的对边、d 逆时针转一次的那边、d 顺时针转一次的那边；
跟着桥接器转；四种朝向下每两条边都直接比过（求解器/规则修订/2026-10-08-现象整理/实测-2026-11-12.md）。 -/
def «桥接器存货先后» (d e : «朝向») : Nat :=
  if e == d then 0 else if e == d.«对边» then 1 else if e == d.«对边».«顺时针» then 2 else 3

/-- 规则里没有：桥接器各边的接通先后
四条边上的取货端口谁先接通：和存货端口同一个先后排物品格，每个物品格的取货端口在它存货端口的对边，
所以实测是它自己的下、上、右、左。同一条轴的两头四种朝向下都直接比过；两条轴之间的四对各只在一种朝向下比过，
别的朝向是照「整个跟着转」换算的（边界清单.md「桥接器各边的接通先后」）。
存货端口仍然全部先于取货端口（规则「接通」第 1 条，桥接器上没有单独测）。 -/
def «桥接器取货先后» (d e : «朝向») : Nat := «桥接器存货先后» d e.«对边»

/-- 据：端口
边上第 n 格，n 从零起；水平边自左向右、竖直边自上向下编号。 -/
def «摆件».«边格» (p : «摆件») (d : «朝向») (n : Nat) : Option «格» :=
  let (w, h) := p.«大小»
  let i := p.«位置».i.val
  let j := p.«位置».j.val
  match d with
  | .«上» => if n < w then «格».«坐标» (i + n) j else none
  | .«右» => if n < h then «格».«坐标» (i + w - 1) (j + n) else none
  | .«下» => if n < w then «格».«坐标» (i + n) (j + h - 1) else none
  | .«左» => if n < h then «格».«坐标» i (j + n) else none

/-- 据：端口、桥接器
按局部边号生成端口；桥接器取货边的单位号来自它对边的存货边。 -/
def «摆件».«造端口» (p : «摆件») (b : Bool) (d : «朝向») (n : Nat) : Option «端口» :=
  (p.«边格» d n).map fun c =>
    let u := if p.«是桥接器» then
      p.«号» + (if b then d.«对边» else d).«编号» else p.«号»
    ⟨u, c, d, b⟩

/-- 据：接通
按参数及上右下左、格号递增的固定先后排序，参数并列也不漏端口。 -/
def «排端口» (f : «朝向» → Nat → Nat) (ps : List («朝向» × Nat)) : List («朝向» × Nat) :=
  ps.mergeSort fun (a, i) (b, j) =>
    if f a i == f b j then
      if a.«编号» == b.«编号» then i ≤ j else a.«编号» ≤ b.«编号»
    else f a i ≤ f b j

/-- 据：接通、协议核心
核心某类端口的固定几何枚举；位置为零起的 1、4、7 或 1 到 7。 -/
def «核心边格» (a : «平行边») (b : Bool) : List («朝向» × Nat) :=
  («朝向».«各边».filter fun d => a.«包含» d == b).flatMap fun d =>
    (if b then [1, 4, 7] else (List.range 7).map (· + 1)).map fun n => (d, n)

/-- 据：接通
同一边按面朝取货方向的右手到左手：朝下、左时格号递增；朝上、右时递减。
此处的方向是取货方向，进口和出口共用它，不沿矩形周长绕行。 -/
def «同边先后» (d : «朝向») (n : Nat) : List Nat :=
  if d == .«下» || d == .«左» then List.range n else (List.range n).reverse

/-- 据：端口、接通、传送带、分流器、汇流器、桥接器、物品准入口、协议储存箱、制造单位、协议核心、仓库取货口、供电桩
完整有序端口：先存后取，再应用同边先后或顺时针；桥接器照实测的先后，核心使用显式参数。 -/
def «摆件».«端口» (p : «摆件») (o : «接通先后») : Option (List «端口») := do
  let _ ← p.«占格»
  let one := fun b d => p.«造端口» b d 0
  let ring := fun (d : «朝向») => [d.«顺时针», d.«对边», d.«对边».«顺时针»]
  let sides := fun (d : «朝向») => do
    let n := if d == .«上» || d == .«下» then p.«大小».1 else p.«大小».2
    let ns := «同边先后» d n
    let a ← ns.mapM (p.«造端口» false d.«对边»)
    let b ← ns.mapM (p.«造端口» true d)
    pure (a ++ b)
  match p.«种类» with
  | .«传送带» a b =>
    if a == b then none else return [← one false a, ← one true b]
  | .«分流器» d => return (← one false d) :: (← (ring d).mapM (one true))
  | .«汇流器» d => return (← (ring d).mapM (one false)) ++ [← one true d]
  | .«物品准入口» d => return [← one false d.«对边», ← one true d]
  | .«桥接器» d =>
    let ps := «朝向».«各边».map fun e => (e, 0)
    let a ← («排端口» (fun e _ => «桥接器存货先后» d e) ps).mapM fun (e,n) => p.«造端口» false e n
    let b ← («排端口» (fun e _ => «桥接器取货先后» d e) ps).mapM fun (e,n) => p.«造端口» true e n
    return a ++ b
  | .«协议储存箱» d | .«制造» _ d => sides d
  | .«协议核心» a =>
    let ins ← («排端口» o.«协议核心» («核心边格» a false)).mapM fun (d,n) => p.«造端口» false d n
    let outs ← («排端口» o.«协议核心» («核心边格» a true)).mapM fun (d,n) => p.«造端口» true d n
    return ins ++ outs
  | .«仓库取货口» d => return [← p.«造端口» true d 1]
  | .«供电桩» => return []

/-- 据：通道
取货端口正对紧贴存货端口。这里检查单位不同；摆件不同及运输条件在形成通道时检查。 -/
def «端口».«正对紧贴» (a b : «端口») : Bool :=
  a.«取货» && !b.«取货» && a.«单位» != b.«单位» &&
    a.«边».«对边» == b.«边» && a.«格».«邻格» a.«边» == some b.«格»

/-- 据：通道
两个不同摆件的两个端口形成的有向通道；任一方可为新建摆件。 -/
def «形成通道» (p q : «摆件») (a b : «端口») : Option «通道» :=
  if p.«号» == q.«号» || !(p.«是运输单位» || q.«是运输单位») then none
  else if a.«正对紧贴» b then some ⟨a.«单位», b.«单位»⟩
  else if b.«正对紧贴» a then some ⟨b.«单位», a.«单位»⟩
  else none

end Endfield.«格子»
