{
  "schema_version": "zmd_doc_policy_v1",
  "policy_id": "devtools",
  "description": "Developer tooling with explicit framework-core entrypoints.",
  "defaults": {},
  "rules": [
    {
      "id": "document_framework_tools",
      "match": {
        "paths": [
          "docctl.py",
          "build_knowledge_docs.py",
          "check_knowledge_docs.py",
          "document_governance_gate.py",
          "tests/test_document_governance_gate.py",
          "document_maintenance_audit.py",
          "tests/test_document_maintenance_audit.py",
          "document_patch_landing.py",
          "tests/test_document_patch_landing.py"
        ]
      },
      "set": {
        "document_class": "framework_core",
        "authority_role": "framework_definition",
        "mutation": "governed",
        "context_level": "L3",
        "purpose": "Document-system resolver, non-mutating governance gate, periodic audit, real-repository landing, knowledge projection/checking tools and focused regressions.",
        "volatile_facts": "forbidden",
        "invariant_refs": [
          "DOC-INV-004",
          "DOC-INV-005",
          "DOC-INV-006",
          "DOC-INV-007",
          "DOC-INV-008",
          "DOC-INV-014",
          "DOC-INV-017",
          "DOC-INV-019",
          "DOC-INV-020",
          "DOC-INV-021",
          "DOC-INV-022"
        ],
        "adr_refs": [
          "DOC-ADR-001",
          "DOC-ADR-002",
          "DOC-ADR-003",
          "DOC-ADR-004",
          "DOC-ADR-005",
          "DOC-ADR-006",
          "DOC-ADR-007",
          "DOC-ADR-013",
          "DOC-ADR-015",
          "DOC-ADR-016",
          "DOC-ADR-017",
          "DOC-ADR-018"
        ],
        "required_reads": [
          "docs/governance/document-system/ARCHITECTURE.md",
          "docs/governance/document-system/MAINTAINING.md"
        ],
        "after_change": [
          "docsystem.doctor",
          "docsystem.render_maintenance",
          "docsystem.audit",
          "docsystem.tests",
          "docsystem.gate"
        ],
        "section_refs": [
          "documentation-framework"
        ]
      },
      "rationale": "These tools define how policy and knowledge projections behave."
    },
    {
      "id": "legacy_docs_scanner",
      "match": {
        "path": "docs_reference_scan.py"
      },
      "set": {
        "document_class": "governance_control",
        "authority_role": "governance_control",
        "mutation": "governed",
        "context_level": "L2",
        "purpose": "Legacy reference-integrity scanner consuming generated doc_classes projection.",
        "volatile_facts": "forbidden",
        "invariant_refs": [
          "DOC-INV-004",
          "DOC-INV-006"
        ],
        "adr_refs": [
          "DOC-ADR-003"
        ],
        "after_change": [
          "docs.reference.validate",
          "docsystem.doctor"
        ],
        "section_refs": [
          "repository-governance"
        ]
      },
      "rationale": "The scanner remains a compatibility consumer, not the document-system source of truth."
    },
    {
      "id": "repository_asset_governance_tools",
      "match": {
        "paths": [
          "artifact_evidence.py",
          "check_repository_code_assets.py",
          "tests/test_repository_code_assets.py"
        ]
      },
      "set": {
        "document_class": "governance_control",
        "authority_role": "governance_control",
        "mutation": "governed",
        "context_level": "L2",
        "purpose": "Artifact-evidence projection, code-asset inventory enforcement and their fail-closed regression suite.",
        "volatile_facts": "forbidden",
        "invariant_refs": [
          "DOC-INV-004",
          "DOC-INV-006",
          "DOC-INV-009",
          "DOC-INV-017"
        ],
        "required_reads": [
          "docs/项目说明/24_repository_asset_governance.md"
        ],
        "after_change": [
          "artifact_evidence.render",
          "artifact_evidence.check",
          "code_assets.current",
          "code_assets.check",
          "docsystem.doctor",
          "docsystem.gate"
        ],
        "section_refs": [
          "repository-governance"
        ],
        "adr_refs": [
          "DOC-ADR-013"
        ]
      },
      "rationale": "These tools define how evidence is excluded from current code inventory without weakening historical replay or the frozen certified checker."
    }
  ],
  "legacy_projection": {
    "rules": [],
    "out_of_scope_notes": []
  }
}
