e.direction_effect": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：保留桥接器历史定向／新先接序的后效待审，必须核库存通路与端口相遇。据：离线、桥接器、通道")], "status": String("specified"), "value": Object {"policy": String("stop"), "trigger": String("离线需更新桥方向")}}, "offline.events": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：可发生阶段、次数和切换时刻族；任意切换是待证覆盖模型非条文定理。据：离线、目标、零干预运行")], "status": String("specified"), "value": Object {"policy": String("stop"), "trigger": String("出现任何离线/上线事件")}}, "offline.gate_total_effect": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：累计已收计数在离线前后的关系；保持/重置均须审查累计上限，沉默不授权清零。据：离线、物品准入口、约束·准入累计")], "status": String("specified"), "value": Object {"policy": String("stop"), "trigger": String("离线需更新累计计数")}}, "offline.gate_window_effect": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：当前窗口已收计数在离线前后的关系，与累计计数分开；保持/重置待审。据：离线、物品准入口")], "status": String("specified"), "value": Object {"policy": String("stop"), "trigger": String("离线需更新窗口计数")}}, "offline.gate_window_start_effect": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：窗口起点或尚未开窗标记的离线接续，须与时间推进和首件起算联合审查。据：离线、物品准入口")], "status": String("specified"), "value": Object {"policy": String("stop"), "trigger": String("离线需更新窗口起点")}}, "offline.inventory_effect": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：保持／重置候选均需全规则审查；沉默不授权删货或任意注入。据：离线、物品格、仓库物品")], "status": String("specified"), "value": Object {"policy": String("stop"), "trigger": String("离线需更新库存")}}, "offline.progress_effect": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：保持／按离线时间推进的关系待审；不能据接通重排推出进度清零。据：离线、需电功能")], "status": String("specified"), "value": Object {"policy": String("stop"), "trigger": String("离线需更新进度/时钟")}}, "polling.both_failure": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：advance_authorized（一次失败判定仅前移已给该边权限的侧）／no_attempt_hold（不足双方权限时不判定、均保持）／advance_both（两侧均前移，须说明无权限侧为何可前移）；后两项有规则29的字面冲突，待审不可默认执行。实际发生的失败尝试不前移已排除。据：轮询、判定；T3")], "status": String("specified"), "value": String("advance_authorized")}, "polling.dual_permission": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：both（成功需双方许可，单侧许可仍可触发失败判定）／either_trigger（任侧触发且另核对端规则）／协调请求过程；both的失败后效由polling.both_failure另定，不将成功合取等同于尝试合取。据：轮询、优先级、判定")], "status": String("specified"), "value": String("both")}, "polling.eligibility_stage": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：判前筛选／逐次探测；探测不得给低级抢过当前可动高级。据：优先级、判定")], "status": String("specified"), "value": String("pre_filter")}, "polling.initial_cursor": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：首接、末接、由建成历史确定的合法成员起点；分汇流受下一行制约。据：轮询、接通")], "status": String("specified"), "value": String("first_connected")}, "polling.internal_scope": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：external_only（BC不入分级）／include_buffer_levels（BC纳入通道分级，具体级归属须另给）；两者均不把BC放入规则29的端口轮询。后者仅登记方向，缺级归属时不可执行。据：缓存格、轮询、取货优先级、存货优先级")], "status": String("specified"), "value": String("external_only")}, "polling.level_tie": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：equal_levels／fixed_arbitration；只在正式级排序键全等时使用，固定仲裁序由输入给，不用id默认排序。与connection.tie的通道并列仲裁分开。据：取货优先级、存货优先级、接通")], "status": String("specified"), "value": String("fixed_arbitration")}, "polling.membership_change": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：保留存活通道身份／按新环投影／重新起轮；断开的边不得继续成功移动；映射的图变更事务粒度见gate.concurrent_expiry，不得把未排序的逐边操作当唯一后继。据：通道、物品准入口、轮询、离线")], "status": String("specified"), "value": String("retain_survivors")}, "polling.memory_scope": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：per_side／per_level；它是状态表示轴，后继还由续接轴给出；状态编码见[内核输入](内核输入.md)§6.3的poll-memory-v1，据：轮询、优先级")], "status": String("specified"), "value": String("per_level")}, "polling.resume": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：保留级内位置／回级重置／从全局位置投影；在轮询均分全部前件成立时仍须满足其结论，不能增加“始终最高”前件。据：轮询、优先级、约束·轮询均分")], "status": String("specified"), "value": String("retain_position")}, "polling.split_merge_scope": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：whole_side（在全侧计第二条，再向各级投影）／per_level（每级各计第二条）；仅分流器取货侧和汇流器存货侧适用，与起轮三读法正交。据：轮询、优先级、存货优先级、分流器、汇流器")], "status": String("specified"), "value": String("per_level")}, "polling.split_merge_singleton": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：sole_member（只有一条时从唯一成员起）／defer_multi_poll（不启动多口轮询但单通道尝试照常）；不能把无第二条解释为永久禁运，据：轮询、移动")], "status": String("specified"), "value": String("sole_member")}, "polling.split_merge_start": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：exclude_first／second_cursor／start_on_second；分别限制集合、起点、启动条件。第一条通道的权限不能被空白吞掉。三者完整取据见 T3；据：轮询")], "status": String("specified"), "value": String("second_cursor")}, "polling.ungraded_blocked": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：skip／empty_turn；仅用于不分级侧，空过后前移，是否同刻重试由 T1 决定。据：轮询、优先级、取货优先级")], "status": String("specified"), "value": String("empty_turn")}, "power.cell_rule": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：positive_area／closed_touch；二者保留。达标供电义务按positive_area核，closed_touch多覆盖者不计；最严读法仅用于单调合法性条件，不用于行为轴。据：供电桩、供电状态、约束·不得依赖的量；受限模型声明§3")], "status": String("specified"), "value": String("positive_area")}, "residence.nontransport": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：zero／按格角色有额外停留 d，d 合法域未定；不得违反“立刻开始”或用规则23强行推1 tick。据：滞留、制造、缓存格")], "status": String("specified"), "value": String("zero")}, "time.boundary": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：真实时间差到阈值即可、边界事件先后另定；不足 1 tick 的运输离开已排除，不能用跨格点冒充足时长。据：滞留、配方、传输、物品准入口")], "status": String("specified"), "value": String("elapsed_inclusive")}, "time.domain": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：整数时刻、有限细分格点、含非整数相位事件时刻；tick 是单位不定义格点。据：时间单位、判定、传输、操作精度")], "status": String("specified"), "value": String("integer_ticks")}, "time.instant_end": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：事件额度耗尽、全状态不动点、无成功调度状态重复后归约；只看库存不变不够，失败会移指针。据：判定、移动、轮询")], "status": String("specified"), "value": String("repeat_scheduler_state")}, "time.instant_order": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：chronological_phases（真实时间递增，同标签先边界完成、外部历史、窗口批维护，再判定闭包）／同标签外部事件与判定显式交织；不得反排 t<t'，制造完成不属于规则25的判定。据：滞留、制造、判定；细化见受限转移定义§2")], "status": String("specified"), "value": String("chronological_phases")}, "time.manufacture_events": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：completion_before_closure／completion_interleaved；均在工作时长耗足时完成，不将完成冒称判定；齐料且功能运行时立即开始，不允许延迟开工。据：制造、需电功能、配方、判定")], "status": String("specified"), "value": String("completion_before_closure")}, "time.retry_schedule": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：每事件一次扫描、固定多轮、状态改变触发重试、闭包；次数与“一直尝试”和尝试后前移联合审查，不预设一次扫描足够。据：移动、轮询")], "status": String("specified"), "value": String("ordered_sweeps")}, "transfer.cooldown_scope": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：box／slot；单一单位判定不等于单一冷却，六格冷却相位与到期掩码另记录。据：传输、协议储存箱")], "status": String("specified"), "value": String("box")}, "transfer.failure_cooldown": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：每次尝试（含空/失败）起冷却／仅满足某成功条件时起冷却；空格仍须尝试，不可无视。据：传输、物品格")], "status": String("specified"), "value": String("every_attempt")}, "transfer.partial_acceptance": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：全箱全部能收才转移／一次单位判定内可收部分；按格或按物种/件的部分还需定义，不能穿插六个外部判定。据：传输、协议核心、物品格")], "status": String("specified"), "value": String("all_or_nothing")}, "transfer.pause": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：冷却属于停用进度而暂停／冷却按墙钟继续；制造进度保留已定，不允许停用清零。据：需电功能、传输")], "status": String("specified"), "value": String("pause_with_function")}, "transfer.phase": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：服从5 tick的到期时刻/残余量，按箱或六格记录；不能未证即量化为五整数相位。据：传输、约束·传输相位")], "status": String("specified"), "value": Object {"kind": String("explicit_residuals"), "values": Array []}}, "transfer.resume_event": Object {"basis": Array [String("受限模型声明；内核输入 §5.2–5.4；open：恢复且到期即尝试／按后续日程尝试，须满足持续尝试，初次到期另据建造史。据：需电功能、传输")], "status": String("specified"), "value": String("ready_in_closure")}, "warehouse.ac