import Endfield.«回放».«现象»
namespace Endfield.«回放».«现象»

/-- 四件照先后放好（这时没有货）；然后直接往分流器、两段进料带各格里放一件货，过 k 步再往汇流器里放一件，
同时把上方箱子装满。这样分流器里的货比汇流器里的货早 k 步进格。 -/
def «错开» («先后» : List «件») (k : Nat) : List «一幕» :=
  [«建» 0 .«协议储存箱», «建» 9 .«协议储存箱», «建» 12 .«协议储存箱», «仓储» 0, «仓储» 9, «仓储» 12,
   «建» 1 .«传送带», «连» 0 1, «建» 2 .«传送带», «连» 1 2,
   «建» 3 .«传送带», «连» 0 3, «建» 4 .«传送带», «连» 3 4]
  ++ («先后».foldl (fun (acc : List «件» × List «一幕») p =>
      (acc.1 ++ [p], acc.2 ++ «放一件» acc.1 p)) ([], [])).2
  ++ [.«装» 5 (.«格» 0) .«源矿» 1, .«装» 1 (.«格» 0) .«源矿» 1, .«装» 2 (.«格» 0) .«源矿» 1,
      .«装» 3 (.«格» 0) .«源矿» 1, .«装» 4 (.«格» 0) .«源矿» 1]
  ++ «装满» 0 .«源矿» ++ [.«等» k, .«装» 6 (.«格» 0) .«源矿» 1]

def «错开的结果» («先后» : List «件») (k : Nat) : Option (Nat × Nat) :=
  («演» «状态».«空» («错开» «先后» k)).map fun s =>
    match «逐次看» (fun s => («箱里几件» s 9 .«源矿», «箱里几件» s 12 .«源矿»)) [200, 520] s with
    | [a, b] => (b.1 - a.1, b.2 - a.2)
    | _ => (0, 0)

def «名» : «件» → String
  | .«分» => "S" | .«汇» => "M" | .«分下带» => "L" | .«汇下带» => "R"

#eval «二十四种».map fun o =>
  (String.join (o.map «名»), «进得去的九种».contains o, (List.range 8).map fun k => ((«错开的结果» o k).map (·.1)).getD 999)
end Endfield.«回放».«现象»
