import Endfield.«回放».«格子工具»
namespace Endfield.«回放».«试E12»
open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 三条进口带各自的格：P1 上（11、12），P2 左（21–23），P3 右（31–33）。 -/
def «带» : Nat → Option (List «摆件»)
  | 1 => [«摆» 11 30 17 (.«传送带» .«上» .«下»), «摆» 12 30 18 (.«传送带» .«上» .«下»)].mapM id
  | 2 => [«摆» 21 27 19 (.«传送带» .«左» .«右»), «摆» 22 28 19 (.«传送带» .«左» .«右»),
          «摆» 23 29 19 (.«传送带» .«左» .«右»)].mapM id
  | _ => [«摆» 31 33 19 (.«传送带» .«右» .«左»), «摆» 32 32 19 (.«传送带» .«右» .«左»),
          «摆» 33 31 19 (.«传送带» .«右» .«左»)].mapM id

def «底» : Option Endfield.«格子».«状态» := do
  let s ← ([«摆» 1 29 14 (.«协议储存箱» .«下»), «摆» 2 24 18 (.«协议储存箱» .«右»),
            «摆» 3 34 18 (.«协议储存箱» .«左»), «摆» 60 29 23 (.«协议储存箱» .«下»),
            «摆» 40 30 19 (.«汇流器» .«下»),
            «摆» 51 30 20 (.«传送带» .«上» .«下»), «摆» 52 30 21 (.«传送带» .«上» .«下»),
            «摆» 54 30 22 (.«传送带» .«上» .«下»)].mapM id).bind «布置»
  return s

/-- 照 `序` 拉三条带，做 `改`，然后先放 A 的货（一直在流），过 80 步同时放 B、C 的货（同一步到汇流器），给出收货箱里各格依次是什么。 -/
def «跑» («序» : List Nat) («改» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态») :
    Option (List («物品» × Nat)) := do
  let s ← «底»
  let s ← «序».foldlM (fun s k => do (← «带» k).foldlM (fun s p => «做» s (.«建» p)) s) s
  let s ← «改» s
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 50))
  let s := «等» 80 { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let s ← «做» s (.«原样» (.«放货» 2 .«源矿» 50))
  let s ← «做» s (.«原样» (.«放货» 3 .«蓝铁块» 50))
  let s := «等» 120 s
  return («箱里依次» s.«模型» 60).map fun p => (p.1, p.2)

def «不改» (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := some s
def «换准入口» (id i j : Nat) (d : «朝向») (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := do
  «做» s (.«建» (← «摆» id i j (.«物品准入口» d)))
/-- 把某条带剩下的格收掉重建（模拟「带子一改动，整条算重新接通」）。 -/
def «重建» (ps : List (Nat × Nat × Nat × «朝向» × «朝向»)) (s : Endfield.«格子».«状态») : Option Endfield.«格子».«状态» := do
  let s ← ps.foldlM (fun s p => «做» s (.«收» p.1)) s
  ps.foldlM (fun s p => do «做» s (.«建» (← «摆» p.1 p.2.1 p.2.2.1 (.«传送带» p.2.2.2.1 p.2.2.2.2)))) s

#eval ("R1 上左右 不改", «跑» [1, 2, 3] «不改»)
#eval ("R2 上右左 不改", «跑» [1, 3, 2] «不改»)
#eval ("R3 上左右 (27,19) 换准入口 逐格读法", «跑» [1, 2, 3] («换准入口» 71 27 19 .«右»))
#eval ("R3 整条重新接通读法", «跑» [1, 2, 3] (fun s => do
  let s ← «换准入口» 71 27 19 .«右» s
  «重建» [(22, 28, 19, .«左», .«右»), (23, 29, 19, .«左», .«右»)] s))
#eval ("R4 上左右 (28,19) 换准入口 逐格读法", «跑» [1, 2, 3] («换准入口» 72 28 19 .«右»))
#eval ("R5 上左右 (29,19) 换准入口", «跑» [1, 2, 3] («换准入口» 73 29 19 .«右»))
#eval ("R6 上左右 (27,19) 收掉重拉 逐格读法", «跑» [1, 2, 3] («重建» [(21, 27, 19, .«左», .«右»)]))
#eval ("R7 上右左 (33,19) 换准入口 逐格读法", «跑» [1, 3, 2] («换准入口» 74 33 19 .«左»))
#eval ("R7 整条重新接通读法", «跑» [1, 3, 2] (fun s => do
  let s ← «换准入口» 74 33 19 .«左» s
  «重建» [(32, 32, 19, .«右», .«左»), (33, 31, 19, .«右», .«左»)] s))
end Endfield.«回放».«试E12»
