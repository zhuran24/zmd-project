import Endfield.«回放».«格子工具»

open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 中 = 0 直通（三格带），1 精炼炉，2 仓储模式的箱子，3 分流器，4 汇流器，5 桥接器。 -/
def «底» («中» : Nat) : Option (List «摆件») :=
  ([«摆» 1 29 13 (.«协议储存箱» .«下»)]
   ++ ([16, 17, 18].map fun j => «摆» (100 + j) 30 j (.«传送带» .«上» .«下»))
   ++ [«摆» 30 30 17 (.«物品准入口» .«下»)]
   ++ (match «中» with
       | 0 => [19, 20, 21].map fun j => «摆» (100 + j) 30 j (.«传送带» .«上» .«下»)
       | 1 => [«摆» 50 29 19 (.«制造» .«精炼炉» .«下»)]
       | 2 => [«摆» 50 29 19 (.«协议储存箱» .«下»)]
       | 3 => [«摆» 119 30 19 (.«传送带» .«上» .«下»), «摆» 50 30 20 (.«分流器» .«上»), «摆» 121 30 21 (.«传送带» .«上» .«下»)]
       | 4 => [«摆» 119 30 19 (.«传送带» .«上» .«下»), «摆» 50 30 20 (.«汇流器» .«下»), «摆» 121 30 21 (.«传送带» .«上» .«下»)]
       | _ => [«摆» 119 30 19 (.«传送带» .«上» .«下»), «摆» 50 30 20 (.«桥接器» .«下»), «摆» 121 30 21 (.«传送带» .«上» .«下»)])
   ++ [«摆» 122 30 22 (.«传送带» .«上» .«下»), «摆» 99 33 21 .«供电桩»,
       «摆» 60 29 23 (.«协议储存箱» .«下»)]).mapM id

/-- 阀门先关着，传输箱第 0 步就在；走 w 步以后把阀门设成每 5 tick 1 件；再走 n 步。
给出整秒上看到的传输箱里的件数（从打开阀门以后算起，每秒一个）。 -/
def «看» («中» w n : Nat) : Option (List Nat) := do
  let s ← («底» «中»).bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») none (some 0)))
  let s ← if «中» == 2 then «做» s (.«原样» (.«设储存箱模式» 50 true)) else pure s
  let s ← «做» s (.«原样» (.«设储存箱模式» 60 false))    -- 「布置」建的箱子是仓储模式；传输箱切成无线传输，冷却从这时起走
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let T := s.«模型».«历史».«立表»
  let todo := s.«场地».«待写» «端口先后» «无效口»
  let m := «走» «取一种» todo T w s.«模型»
  let s ← «做» { s with «模型» := m } (.«原样» (.«设准入口» 30 (some .«蓝铁矿») none (some 1)))
  let r := ((List.range n).foldl (fun (acc : Endfield.«状态» × List Nat) _ =>
      let t := «走» «取一种» todo T 1 acc.1
      (t, acc.2 ++ [«箱里几件» t 60 .«蓝铁矿» + «箱里几件» t 60 .«蓝铁块»])) (s.«模型», [])).2
  return (r.zipIdx.filter fun p => (p.2 + 1) % 4 == 0).map (·.1)

def «名» : Nat → String
  | 0 => "直通" | 1 => "精炼炉" | 2 => "仓储箱" | 3 => "分流器" | 4 => "汇流器" | _ => "桥接器"

#eval do
  for «中» in [0, 1, 2, 3, 4, 5] do
    IO.println s!"== {«名» «中»}"
    for k in List.range 10 do
      let w := 40 + 4 * k
      match «看» «中» w 400 with
      | some l =>
        let tail := l.drop 40
        let d := (tail.take 40).foldl (· + ·) 0
        IO.println s!"  w={w}: 每轮看得到货 {d / 4} 秒  {String.join ((tail.take 40).map toString)}"
      | none => IO.println s!"  w={w}: 搭不出来"
