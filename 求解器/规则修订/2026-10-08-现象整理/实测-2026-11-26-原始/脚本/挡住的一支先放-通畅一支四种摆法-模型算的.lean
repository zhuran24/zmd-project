import Endfield.«回放».«格子工具»
namespace T
open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 挡住的一支先放（准入口贴着分流器）；通畅的一支几种摆法。收货箱都是 5。 -/
def «件» («哪种» : Nat) : Option (List «摆件») :=
  let base := [«摆» 0 26 13 (.«协议储存箱» .«下»), «摆» 6 31 16 (.«协议储存箱» .«右»),
    «摆» 2 27 17 (.«分流器» .«上»), «摆» 1 27 16 (.«传送带» .«上» .«下»)]
  let blocked := [«摆» 30 28 17 (.«传送带» .«左» .«右»), «摆» 33 29 17 (.«传送带» .«左» .«右»),
    «摆» 32 30 17 (.«传送带» .«左» .«右»), «摆» 31 28 17 (.«物品准入口» .«右»)]
  let clear := match «哪种» with
    | 0 => -- 原来的：一格带、桥接器、两格带进箱
      [«摆» 5 26 22 (.«协议储存箱» .«下»), «摆» 20 27 19 (.«桥接器» .«上»), «摆» 10 27 18 (.«传送带» .«上» .«下»),
       «摆» 41 27 20 (.«传送带» .«上» .«下»), «摆» 42 27 21 (.«传送带» .«上» .«下»)]
    | 1 => -- 这次：两格带直接进箱
      [«摆» 5 26 20 (.«协议储存箱» .«下»), «摆» 10 27 18 (.«传送带» .«上» .«下»), «摆» 11 27 19 (.«传送带» .«上» .«下»)]
    | 2 => -- 一格带直接进箱
      [«摆» 5 26 19 (.«协议储存箱» .«下»), «摆» 10 27 18 (.«传送带» .«上» .«下»)]
    | _ => -- 两格带、桥接器、一格带进箱
      [«摆» 5 26 22 (.«协议储存箱» .«下»), «摆» 20 27 20 (.«桥接器» .«上»), «摆» 10 27 18 (.«传送带» .«上» .«下»),
       «摆» 11 27 19 (.«传送带» .«上» .«下»), «摆» 42 27 21 (.«传送带» .«上» .«下»)]
  (base ++ blocked ++ clear).mapM id

def «间隔» («哪种» : Nat) : Option (List Nat) := do
  let s ← («件» «哪种»).bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 31 (some .«源矿») none none))
  let s ← «做» s (.«原样» (.«放货» 0 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let T := s.«模型».«历史».«立表»
  let todo := s.«场地».«待写» «端口先后» «无效口»
  let r := ((List.range 420).foldl (fun (acc : Endfield.«状态» × List Nat) _ =>
      let t := «走» «取一种» todo T 1 acc.1
      (t, acc.2 ++ [«箱里几件» t 5 .«蓝铁矿»])) (s.«模型», [])).2
  let ts := ((r.zip (0 :: r)).zipIdx.filter fun ((a, b), _) => a > b).map fun (_, i) => i + 1
  let ds := (ts.zip (ts.drop 1)).map fun (a, b) => b - a
  return (ds.drop 20).take 12

#eval «间隔» 0
#eval «间隔» 1
#eval «间隔» 2
#eval «间隔» 3
end T
