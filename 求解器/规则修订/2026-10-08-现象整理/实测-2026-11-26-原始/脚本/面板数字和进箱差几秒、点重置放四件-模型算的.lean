import Endfield.«回放».«格子工具»
namespace T
open Endfield Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子»

/-- 货源箱 0、带 (24,16)、准入口 30 (24,17)、三格带 (24,18)—(24,20)、位置 (24,21)（`后门` 为真放准入口 45，为假放带）、收货箱 7（中心 (24,23)）。 -/
def «件» («后门» : Bool) : Option (List «摆件») :=
  ([«摆» 0 23 13 (.«协议储存箱» .«下»), «摆» 1 24 16 (.«传送带» .«上» .«下»), «摆» 30 24 17 (.«物品准入口» .«下»)]
   ++ ([18, 19, 20].map fun j => «摆» (100 + j) 24 j (.«传送带» .«上» .«下»))
   ++ [if «后门» then «摆» 45 24 21 (.«物品准入口» .«下») else «摆» 121 24 21 (.«传送带» .«上» .«下»),
       «摆» 7 23 22 (.«协议储存箱» .«下»)]).mapM id

/-- 甲：前门每 5 tick 上限 1（累计上限 5000），后面全是带。稳下来以后每秒看（前门的累计通过数量，收货箱件数），看 n 秒。 -/
def «甲» (n : Nat) : Option (List (Nat × Nat)) := do
  let s ← («件» false).bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») (some 5000) (some 1)))
  let s ← «做» s (.«原样» (.«放货» 0 .«蓝铁矿» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let s := «等» 400 s
  return ((List.range n).foldl (fun (acc : Endfield.«格子».«状态» × List (Nat × Nat)) _ =>
      let t := «等» 4 acc.1
      (t, acc.2 ++ [((t.«模型».«准入口» 30).«累计已收», «箱里几件» t.«模型» 7 .«蓝铁矿»)])) (s, [])).2

/-- 乙：前门累计上限 4、不限速；后门每 5 tick 上限 2。头四件走完以后第 w 步点重置，每秒看（前门的累计通过数量，收货箱件数）。 -/
def «乙» (w n : Nat) : Option (List (Nat × Nat)) := do
  let s ← («件» true).bind «布置»
  let s ← «做» s (.«原样» (.«设准入口» 30 (some .«蓝铁矿») (some 4) none))
  let s ← «做» s (.«原样» (.«设准入口» 45 (some .«蓝铁矿») none (some 2)))
  let s ← «做» s (.«原样» (.«放货» 0 .«蓝铁矿» 50))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let s := «等» w s
  let s ← «做» s (.«原样» (.«重置计数» 30))
  return ((List.range n).foldl (fun (acc : Endfield.«格子».«状态» × List (Nat × Nat)) _ =>
      let t := «等» 4 acc.1
      (t, acc.2 ++ [((t.«模型».«准入口» 30).«累计已收», «箱里几件» t.«模型» 7 .«蓝铁矿»)])) (s, [])).2

#eval «甲» 24
#eval «乙» 400 26
end T
