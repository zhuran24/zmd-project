import Endfield.«回放».«改带子以后的先后»
namespace Endfield.«回放».«试轮着收»
open Endfield.«格子» Endfield.«回放» Endfield.«回放».«格子» Endfield.«回放».«改带子以后的先后»

/-- 走 n 步，每步看收货箱 60 里三种货各多了几件，给出各件到货的先后（1 是 A 的货，2 是 B 的，3 是 C 的）。 -/
def «到货先后» (s : Endfield.«格子».«状态») (n : Nat) : Endfield.«格子».«状态» × List Nat :=
  (List.range n).foldl (fun (acc : Endfield.«格子».«状态» × List Nat) _ =>
     let a := acc.1
     let b := «等» 1 a
     let d (it : «物品») : Nat := «箱里几件» b.«模型» 60 it - «箱里几件» a.«模型» 60 it
     (b, acc.2 ++ (if d .«蓝铁矿» > 0 then [1] else []) ++ (if d .«源矿» > 0 then [2] else [])
        ++ (if d .«蓝铁块» > 0 then [3] else []))) (s, [])

/-- 三个货源箱一直有货，汇流器、出口带、收货箱都在；照 `序` 拉三条进口带，走 200 步（稳了），做 `改`，再走 240 步。
给出改之前最后 9 件、改之后最后 9 件各是哪一路的货。 -/
def «轮着收» («序» : List Nat) («改» : Endfield.«格子».«状态» → Option Endfield.«格子».«状态») :
    Option (List Nat × List Nat) := do
  let s ← «汇流器底»
  let s ← «先放汇流器» «序» «不改» s
  let s ← «做» s (.«原样» (.«放货» 1 .«蓝铁矿» 300))
  let s ← «做» s (.«原样» (.«放货» 2 .«源矿» 300))
  let s ← «做» s (.«原样» (.«放货» 3 .«蓝铁块» 300))
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let (s, a) := «到货先后» s 200
  let s ← «改» s
  let s := { s with «模型» := «压平» s.«模型».«布局» s.«模型» }
  let (_, b) := «到货先后» s 240
  return (a.drop (a.length - 9), b.drop (b.length - 9))

#eval «轮着收» [1, 2, 3] «不改»
#eval «轮着收» [1, 3, 2] «不改»
-- 改 P2（列表里排中间的那条）：贴着货源的格、中间的格、贴着汇流器的格换准入口
#eval «轮着收» [1, 2, 3] («换准入口» 71 27 19 .«右»)
#eval «轮着收» [1, 2, 3] («换准入口» 72 28 19 .«右»)
#eval «轮着收» [1, 2, 3] («换准入口» 73 29 19 .«右»)
-- 贴着货源的格、贴着汇流器的格收掉重拉；整条收掉重拉
#eval «轮着收» [1, 2, 3] («收掉重拉» [(21, 27, 19, .«左», .«右»)])
#eval «轮着收» [1, 2, 3] («收掉重拉» [(23, 29, 19, .«左», .«右»)])
#eval «轮着收» [1, 2, 3] («收掉重拉» [(21, 27, 19, .«左», .«右»), (22, 28, 19, .«左», .«右»), (23, 29, 19, .«左», .«右»)])
-- 汇流器收掉、原处重放
#eval «轮着收» [1, 2, 3] (fun s => do let s ← «做» s (.«收» 40); «做» s (.«建» (← «汇流器»)))
#eval «轮着收» [1, 3, 2] (fun s => do let s ← «做» s (.«收» 40); «做» s (.«建» (← «汇流器»)))
-- 改 P1（排第一的）、P3（排最后的）贴着汇流器的格
#eval «轮着收» [1, 2, 3] («换准入口» 75 30 18 .«下»)
#eval «轮着收» [1, 2, 3] («换准入口» 76 31 19 .«左»)
end Endfield.«回放».«试轮着收»
