  "parameters": {
    "axis_registry": {
      "path": "../../规格/选择点参数轴.md",
      "sha256": "aacade17b417a65e1b7d7846615978defcd510bf3f490ae8fdb9e86ce36bd7a9"
    },
    "profile_id": null,
    "fixed": {
      "polling.direct_peer": {
        "status": "specified",
        "value": "physical_peer",
        "basis": [
          "选择点参数轴.md §2 polling.direct_peer；known：physical_peer；直接接指PC另一端即相应分流器或汇流器。隔传送带才遇到该单位不是同一PC的直接端点，已排除。据：通道、端口、取货优先级、存货优先级"
        ]
      },
      "connection.build_order": {
        "status": "derived",
        "value": "construction.selected_order",
        "basis": [
          "选择点参数轴.md §2 connection.build_order；open：非传送带全先于传送带的逐个建成历史；所有满足条文的相对次序待覆盖。据：蓝图、建造方式"
        ]
      },
      "connection.port_meeting": {
        "status": "specified",
        "value": "shared_edge_opposite",
        "basis": [
          "选择点参数轴.md §2 connection.port_meeting；known：shared_edge_opposite；格正交相邻、两一格宽端口重合于同一格边且法向相反、存取互补、至少一端运输。角触/隔格/同类端口/两非运输端口成PC均排除，证明见T5。据：端口、通道、约束·端口对接、约束·四通结点、约束·边带排布、约束·核心邻格"
        ]
      },
      "transfer.judgment": {
        "status": "specified",
        "value": "unit",
        "basis": [
          "选择点参数轴.md §2 transfer.judgment；known：unit；不能六格各一独立判定，据：判定（一个单位一次）、传输（自身所有格所有物品）"
        ]
      },
      "manufacturing.port_slot_relation": {
        "status": "specified",
        "value": "distributed",
        "basis": [
          "选择点参数轴.md §2 manufacturing.port_slot_relation；known：distributed；存货端口对应存货格、取货端口对应取货格，论证见 T7；据：存货/取货端口、通道、存货/取货物品格"
        ]
      },
      "manufacturing.output_blocked": {
        "status": "specified",
        "value": "retain_whole_batch",
        "basis": [
          "选择点参数轴.md §2 manufacturing.output_blocked；known：不满足整批兼容容量或拟提交后违反本单位非缓存普通格同种单格时不能整批通过；缓存保留，不得分拆或无据销毁。是否重新尝试由 T1 决定。据：缓存格、物品格"
        ]
      },
      "gate.window_recovery": {
        "status": "specified",
        "value": "on_expiry_if_other_guards",
        "basis": [
          "选择点参数轴.md §2 gate.window_recovery；known：on_expiry_if_other_guards；窗口耗尽的阻断随窗口满5 tick解除，仍受身份及累计原因制约；窗口原因永久锁闭已排除，不保证成功收货或达到k/5。据：物品准入口、约束·准入累计、约束·来源定序"
        ]
      },
      "gate.limit_requires_identity": {
        "status": "specified",
        "value": true,
        "basis": [
          "选择点参数轴.md §2 gate.limit_requires_identity；known：先设放行种类才有“设定后可再”设限的明文授权；无身份限流没有正面授权，不能默认存在。据：物品准入口"
        ]
      },
      "initialization.rotation_stage": {
        "status": "specified",
        "value": "build_and_debug",
        "basis": [
          "选择点参数轴.md §2 initialization.rotation_stage；known：build_and_debug；建造选朝向，调试可旋转，零干预后无玩家旋转；库存与接通后效仍须定义，不因动作获准而自动获准任意后效。据：旋转、调试期、零干预运行"
        ]
      },
      "warehouse.capacity": {
        "status": "specified",
        "value": {
          "value": "80000",
          "category": "条文直引"
        },
        "basis": [
          "选择点参数轴.md §2 warehouse.capacity；known：每种单格80000；初始六种在锚点各满80000，其他空。据：物品格、协议核心、仓库物品"
        ]
      },
      "warehouse.delivery_count": {
        "status": "specified",
        "value": "actual_inbound",
        "basis": [
          "选择点参数轴.md §2 warehouse.delivery_count；known：实际入库件数；不是玩家拿走件数。据：目标、约束·入库途径"
        ]
