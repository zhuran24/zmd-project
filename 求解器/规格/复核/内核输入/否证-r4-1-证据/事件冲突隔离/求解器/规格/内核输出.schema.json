{
  "type": "object",
  "properties": {
    "schema": {
      "const": "kernel-output-v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "kernel",
            "bounded_reference_checker",
            "manual_expected"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "path",
        "claim"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "completed",
        "invalid_input",
        "unsupported",
        "unresolved",
        "inconclusive"
      ]
    },
    "fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "input",
              "catalog",
              "axis_registry",
              "profile",
              "parameter_projection",
              "formal_source",
              "golden",
              "checker",
              "semantics",
              "schema"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/Hash"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "parameter_assignment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Parameters"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_history": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "timeline": {
              "type": "object"
            },
            "construction": {
              "type": "object"
            },
            "debug_operations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "environment": {
              "type": "object"
            },
            "reachability": {
              "$ref": "#/$defs/Decision"
            }
          },
          "required": [
            "timeline",
            "construction",
            "debug_operations",
            "environment",
            "reachability"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "uncovered_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "axis": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "minLength": 1
          },
          "coverage_status": {
            "enum": [
              "exercised",
              "input_checked",
              "not_exercised",
              "stop_not_triggered",
              "proof_pending"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "other_values": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "axis",
          "reason",
          "disposition",
          "coverage_status",
          "evidence",
          "other_values"
        ],
        "additionalProperties": false
      }
    },
    "trace": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start_state": {
              "$ref": "#/$defs/StateSeed"
            },
            "ticks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Tick"
              }
            },
            "end_time": {
              "$ref": "#/$defs/Time"
            },
            "format": {
              "const": "full_state_each_instant"
            }
          },
          "required": [
            "start_state",
            "ticks",
            "end_time",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "validation_scope": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "finite_trace"
            },
            "from": {
              "$ref": "#/$defs/Time"
            },
            "through": {
              "$ref": "#/$defs/Time"
            },
            "golden_match": {
              "type": "boolean"
            },
            "initial_history": {
              "const": "conditional_witness"
            },
            "universal_parameters": {
              "const": false
            },
            "all_reachable_cycles": {
              "const": false
            },
            "target_certified": {
              "const": false
            },
            "manufacturing_cycles_completed": {
              "$ref": "#/$defs/Quantity"
            }
          },
          "required": [
            "kind",
            "from",
            "through",
            "golden_match",
            "initial_history",
            "universal_parameters",
            "all_reachable_cycles",
            "target_certified",
            "manufacturing_cycles_completed"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "run_id",
    "profile_id",
    "producer",
    "status",
    "fingerprints",
    "parameter_assignment",
    "input_history",
    "uncovered_axes",
    "trace",
    "validation_scope",
    "open_items"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {
        "const": "completed"
      }
    }
  },
  "then": {
    "properties": {
      "parameter_assignment": {
        "$ref": "#/$defs/Parameters"
      },
      "input_history": {
        "type": "object",
        "properties": {
          "timeline": {
            "type": "object"
          },
          "construction": {
            "type": "object"
          },
          "debug_operations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "environment": {
            "type": "object"
          },
          "reachability": {
            "$ref": "#/$defs/Decision"
          }
        },
        "required": [
          "timeline",
          "construction",
          "debug_operations",
          "environment",
          "reachability"
        ],
        "additionalProperties": false
      },
      "trace": {
        "type": "object",
        "properties": {
          "start_state": {
            "$ref": "#/$defs/StateSeed"
          },
          "ticks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Tick"
            }
          },
          "end_time": {
            "$ref": "#/$defs/Time"
          },
          "format": {
            "const": "full_state_each_instant"
          }
        },
        "required": [
          "start_state",
          "ticks",
          "end_time",
          "format"
        ],
        "additionalProperties": false
      },
      "validation_scope": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "finite_trace"
          },
          "from": {
            "$ref": "#/$defs/Time"
          },
          "through": {
            "$ref": "#/$defs/Time"
          },
          "golden_match": {
            "type": "boolean"
          },
          "initial_history": {
            "const": "conditional_witness"
          },
          "universal_parameters": {
            "const": false
          },
          "all_reachable_cycles": {
            "const": false
          },
          "target_certified": {
            "const": false
          },
          "manufacturing_cycles_completed": {
            "$ref": "#/$defs/Quantity"
          }
        },
        "required": [
          "kind",
          "from",
          "through",
          "golden_match",
          "initial_history",
          "universal_parameters",
          "all_reachable_cycles",
          "target_certified",
          "manufacturing_cycles_completed"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zmd:kernel-output-v2",
  "$defs": {
    "Quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?\\d+(?:/[1-9]\\d*)?$"
        },
        "category": {
          "enum": [
            "条文直引",
            "算术推论",
            "候选",
            "启发式",
            "实测"
          ]
        }
      },
      "required": [
        "value",
        "category"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "specified",
            "derived",
            "unresolved",
            "not_applicable"
          ]
        },
        "value": {},
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "value",
        "basis"
      ],
      "additionalProperties": false
    },
    "Time": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "rational"
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Warehouse": {
      "type": "object",
      "properties": {
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "item": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quantity": {
                "$ref": "#/$defs/Quantity"
              },
              "empty_identity": {
                "$ref": "#/$defs/Decision"
              }
            },
            "required": [
              "slot",
              "item",
              "quantity",
              "empty_identity"
            ],
            "additionalProperties": false
          }
        },
        "unlisted": {
          "const": "empty"
        }
      },
      "required": [
        "slots",
        "unlisted"
      ],
      "additionalProperties": false
    },
    "Content": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "entered_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "item",
        "quantity",
        "entered_at"
      ],
      "additionalProperties": false
    },
    "Progress": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "idle",
            "intake",
            "working",
            "completed"
          ]
        },
        "recipe": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_recipes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "locked_recipe": {
          "type": [
            "string",
            "null"
          ]
        },
        "remaining": {
          "anyOf": [
            {
              "$ref": "#/$defs/Time"
            },
            {
              "type": "null"
            }
          ]
        },
        "cooldowns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remaining": {
                "$ref": "#/$defs/Time"
              }
            },
            "required": [
              "slot",
              "remaining"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "unit",
        "phase",
        "recipe",
        "candidate_recipes",
        "locked_recipe",
        "remaining",
        "cooldowns"
      ],
      "additionalProperties": false
    },
    "StateSeed": {
      "type": "object",
      "properties": {
        "layout_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "settings_anchor": {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "minLength": 1
            },
            "side": {
              "enum": [
                "before",
                "after"
              ]
            }
          },
          "required": [
            "event",
            "side"
          ],
          "additionalProperties": false
        },
        "warehouse": {
          "$ref": "#/$defs/Warehouse"
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "contents": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Content"
                }
              }
            },
            "required": [
              "slot",
              "contents"
            ],
            "additionalProperties": false
          }
        },
        "progress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Progress"
          }
        },
        "logistics": {
          "type": "object",
          "properties": {
            "active_channels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "blocked_channels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "poll_memory": {
              "$ref": "#/$defs/Decision"
            },
            "gate_counters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blocked_reasons": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "identity_mismatch",
                        "total_exhausted",
                        "window_exhausted"
                      ]
                    }
                  },
                  "total_received": {
                    "$ref": "#/$defs/Quantity"
                  },
                  "window_received": {
                    "$ref": "#/$defs/Quantity"
                  },
                  "window_started_at": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/Time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "unit",
                  "blocked_reasons",
                  "total_received",
                  "window_received",
                  "window_started_at"
                ],
                "additionalProperties": false
              }
            },
            "connection_order": {
              "$ref": "#/$defs/Decision"
            }
          },
          "required": [
            "active_channels",
            "blocked_channels",
            "poll_memory",
            "gate_counters",
            "connection_order"
          ],
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "properties": {
            "time": {
              "$ref": "#/$defs/Time"
            },
            "stage": {
              "enum": [
                "building",
                "debug",
                "zero_intervention"
              ]
            },
            "online": {
              "type": "boolean"
            },
            "withdrawal_memory": {
              "$ref": "#/$defs/Decision"
            }
          },
          "required": [
            "time",
            "stage",
            "online",
            "withdrawal_memory"
          ],
          "additionalProperties": false
        },
        "semantic_context": {
          "type": "object",
          "properties": {
            "arbitration": {
              "type": "object",
              "properties": {
                "level_order": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "warehouse_empty_slot_order": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "level_order",
                "warehouse_empty_slot_order"
              ],
              "additionalProperties": false
            },
            "parameter_values": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "axis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "$ref": "#/$defs/Decision"
                  },
                  "lifetime": {
                    "enum": [
                      "F",
                      "O",
                      "U"
                    ]
                  }
                },
                "required": [
                  "axis",
                  "value",
                  "lifetime"
                ],
                "additionalProperties": false
              }
            },
            "judgment_context": {
              "$ref": "#/$defs/Decision"
            },
            "pending_events": {
              "$ref": "#/$defs/Decision"
            },
            "tick_context": {
              "$ref": "#/$defs/Decision"
            }
          },
          "required": [
            "arbitration",
            "parameter_values",
            "judgment_context",
            "pending_events",
            "tick_context"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "layout_snapshot",
        "settings_anchor",
        "warehouse",
        "inventory",
        "progress",
        "logistics",
        "environment",
        "semantic_context"
      ],
      "additionalProperties": false
    },
    "Parameters": {
      "type": "object",
      "properties": {
        "axis_registry": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/Hash"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "fixed": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Decision"
          }
        },
        "offline_mutable": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Decision"
          }
        },
        "fixedness_unproven": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Decision"
          }
        }
      },
      "required": [
        "axis_registry",
        "profile_id",
        "fixed",
        "offline_mutable",
        "fixedness_unproven"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "move",
            "internal_move",
            "manufacture",
            "transfer",
            "manufacture_complete",
            "time_advance",
            "ore_supply",
            "offline",
            "player_action"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "guard_false",
            "no_request"
          ]
        },
        "detail": {
          "type": "string"
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "event",
        "operation",
        "target",
        "outcome",
        "basis"
      ],
      "additionalProperties": false
    },
    "Tick": {
      "type": "object",
      "properties": {
        "time": {
          "$ref": "#/$defs/Time"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "state": {
          "$ref": "#/$defs/StateSeed"
        },
        "summary": {
          "type": "object"
        },
        "closure": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "no_success_state_repeat"
            },
            "scan_rounds": {
              "type": "integer",
              "minimum": 0
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "scan_rounds",
            "basis"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "time",
        "events",
        "state",
        "summary",
        "closure"
      ],
      "additionalProperties": false
    }
  }
}
