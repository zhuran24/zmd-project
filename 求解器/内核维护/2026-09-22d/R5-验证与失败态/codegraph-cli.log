1	//! 第五轮K5/K8：真实CLI的资源统计及装载停止仍遵守循环外壳。
2	use serde_json::{json, Value};
3	use std::{path::PathBuf, process::Command};
4	#[test]
5	fn round5_cli_resource_statistics_and_cycle_load_stop() {
6	    let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
7	        .join("../..")
8	        .canonicalize()
9	        .unwrap();
10	    let config = root.join("规格/内核配置-v1.json");
11	    let out = std::env::var_os("KERNEL_TEST_EVIDENCE_DIR")
12	        .map(PathBuf::from)
13	        .unwrap_or_else(|| root.join("crates/kernel/evidence/round5"))
14	        .join("round5_cli");
15	    std::fs::create_dir_all(&out).unwrap();
16	    let exported = out.join("relocated-seed.json");
17	    let process = Command::new(env!("CARGO_BIN_EXE_kernel"))
18	        .arg("seed")
19	        .arg(root.join("数据/样例/混做粉碎机两下游.json"))
20	        .arg("--config")
21	        .arg(&config)
22	        .arg("--out")
23	        .arg(&exported)
24	        .output()
25	        .unwrap();
26	    assert!(
27	        process.status.success(),
28	        "{}",
29	        String::from_utf8_lossy(&process.stderr)
30	    );
31	    let process = Command::new(env!("CARGO_BIN_EXE_kernel"))
32	        .arg("run")
33	        .arg(&exported)
34	        .arg("--config")
35	        .arg(&config)
36	        .args(["--ticks", "4", "--no-output"])
37	        .output()
38	        .unwrap();
39	    assert!(
40	        process.status.success(),
41	        "{}",
42	        String::from_utf8_lossy(&process.stdout)
43	    );
44	    assert_eq!(
45	        serde_json::from_slice::<Value>(&process.stdout).unwrap()["status"],
46	        "completed"
47	    );
48	    let process = Command::new(env!("CARGO_BIN_EXE_kernel"))
49	        .arg("run")
50	        .arg(root.join("数据/样例/生产循环环带.json"))
51	        .arg("--config")
52	        .arg(&config)
53	        .args(["--ticks", "2", "--max-sweeps", "1", "--no-output"])
54	        .output()
55	        .unwrap();
56	    assert_eq!(process.status.code(), Some(2));
57	    let report: Value = serde_json::from_slice(&process.stdout).unwrap();
58	    assert_eq!(report["status"], "inconclusive");
59	    assert_eq!(report["statistics"]["inconclusive"], 1);
60	    assert_eq!(report["completed_ticks"], 0);
61	    std::fs::write(
62	        out.join("resource-statistics.json"),
63	        serde_json::to_vec_pretty(&report).unwrap(),
64	    )
65	    .unwrap();
66	    let input = out.join("invalid-cycle-input.json");
67	    let record = out.join("invalid-cycle-result.json");
68	    std::fs::write(&input, json!({"schema":"kernel-input-v3"}).to_string()).unwrap();
69	    let process = Command::new(env!("CARGO_BIN_EXE_kernel"))
70	        .arg("cycle")
71	        .arg(&input)
72	        .arg("--config")
73	        .arg(&config)
74	        .args(["--max-ticks", "2", "--out"])
75	        .arg(&record)
76	        .output()
77	        .unwrap();
78	    assert_eq!(process.status.code(), Some(2));
79	    let result: Value = serde_json::from_slice(&std::fs::read(&record).unwrap()).unwrap();
80	    assert_eq!(result["schema"], "kernel-cycle-v3");
81	    assert_eq!(result["status"], "invalid_input");
82	    assert!(result["cycle"].is_null());
83	}
```

