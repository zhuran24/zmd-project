  "hook": {
    "path": "/home/zhuran24/zmd-research-fresh/.git/hooks/post-commit",
    "exists": true,
    "text": "#!/bin/bash\n# 每次提交后在后台：推送代码到 origin；同步 CC 资料到 ~/zmd-project-cc 并提交推送。日志在 .git/auto-sync.log\n# 会话记录镜像（含删除）；scratchpad 只增改不删，因为 /tmp 重启即清空。\nREPO=$(git rev-parse --show-toplevel)\nLOG=\"$REPO/.git/auto-sync.log\"\n(\n  flock 9\n  echo \"== $(date '+%F %T') $(git -C \"$REPO\" log -1 --format='%h %s')\"\n  git -C \"$REPO\" push -q origin HEAD 2>&1 || echo \"代码推送失败\"\n  CC=~/zmd-project-cc\n  P=~/.claude/projects\n  rsync -a --delete \"$P/-home-zhuran24-zmd-research-fresh\" \"$P/-home-zhuran24-zmd-research-fresh----\" \\\n    \"$P/-home-zhuran24-zmd-research-fresh-----crates-kernel---\" \"$CC/projects/\"\n  [ -d /tmp/claude-1000/-home-zhuran24-zmd-research-fresh ] && \\\n    rsync -a /tmp/claude-1000/-home-zhuran24-zmd-research-fresh/ \"$CC/scratchpad/\"\n  git -C \"$CC\" add -A\n  if ! git -C \"$CC\" diff --cached --quiet; then\n    git -C \"$CC\" commit -q -m \"同步 CC 资料（代码 $(git -C \"$REPO\" log -1 --format=%h)）\"\n    git -C \"$CC\" push -q origin HEAD 2>&1 || echo \"CC 资料推送失败\"\n  fi\n  echo \"完成 $(date '+%T')\"\n) 9>\"$REPO/.git/auto-sync.lock\" >>\"$LOG\" 2>&1 </dev/null &\ndisown\n"
  }
