576	fn restore(input: &Input, state: &State, config: &Config, sweeps: usize) -> Result<Engine> {
577	    let mut engine = Engine::new_production(checkpoint_input(input, json!(state), config)?)?;
578	    engine.max_sweeps = sweeps;
579	    engine.set_cache_enabled(true);
580	    Ok(engine)
581	}
582	/// 输出§5.2：检查点重放到摘要桶内每个候选位置；失败不判周期。
583	fn restore_position(
584	    input: &Input,
585	    checkpoints: &BTreeMap<usize, State>,
586	    position: usize,
587	    config: &Config,
588	    sweeps: usize,
589	    remaining: &mut usize,
590	) -> Result<Engine> {
591	    let (index, state) = checkpoints.range(..=position).next_back().unwrap();
592	    let mut engine = restore(input, state, config, sweeps)?;
593	    for _ in *index..position {
594	        if *remaining == 0 {
595	            return Err(Stop::new(
596	                "inconclusive",
597	                "resource.replay",
598	                "cycle.collision_replay",
599	                "检查点消歧重放预算耗尽；未判定键相等",
600	            ));
601	        }
602	        *remaining -= 1;
603	        engine.step_compact()?;
604	    }
605	    Ok(engine)
606	}
607	/// 输出§5：默认库调用不写文件，使用无记录证书；CLI可显式保存独立记录。

