665	    let mut last = seed.clone();
666	    let mut checks = engine.domain_report("static");
667	    let mut stop = engine
668	        .production_domain()
669	        .err()
670	        .map(|e| stop_value(&e, engine.t, &[]));
671	    let mut stopped_in_step = false;
672	    let mut seen = BTreeMap::<String, Vec<usize>>::new();
673	    let mut checkpoints = BTreeMap::from([(0, seed.clone())]);
674	    let mut completed = 0;
675	    let mut found = None;
676	    // 故障注入只供回归；公开预算仍恰为契约的ticks/sweeps。
677	    #[cfg(test)]
678	    let mut replay_budget = options.replay_limit;
679	    #[cfg(not(test))]
680	    let mut replay_budget = usize::MAX;
681	    if stop.is_none() && seed.semantic_context.judgment_context.value["phase"] == "after_closure" {
682	        match engine.cycle_key() {
683	            Ok(k) => {
684	                seen.insert(digest(&k, options), vec![0]);
685	            }
686	            Err(e) => stop = Some(stop_value(&e, engine.t, &[])),
687	        }
688	    }
689	    while stop.is_none() && completed < max_ticks {
690	        if let Err(e) = engine.step_compact() {
691	            stopped_in_step = true;
692	            stop = Some(stop_value(&e, engine.t, &engine.records));
693	            break;
694	        }
695	        completed += 1;
696	        last = engine.state.clone();
697	        let key = match engine.cycle_key() {
698	            Ok(k) => k,
699	            Err(e) => {
700	                stop = Some(stop_value(&e, engine.t, &[]));
701	                break;
702	            }
703	        };
704	        let hash = digest(&key, options);
705	        if let Some(positions) = seen.get(&hash) {
706	            for position in positions {
707	                let restored = match restore_position(
708	                    &input,
709	                    &checkpoints,
710	                    *position,
711	                    config,
712	                    max_sweeps,
713	                    &mut replay_budget,
714	                ) {
715	                    Ok(e) => e,
716	                    Err(e) => {
717	                        stop = Some(stop_value(&e, engine.t, &[]));
718	                        break;
719	                    }
720	                };
721	                let candidate = restored.cycle_key()?;
722	                if candidate == key {
723	                    found = Some((restored.state, *position, candidate, key.clone()));
724	                    break;
725	                }
726	            }
727	        }
728	        if stop.is_some() || found.is_some() {
729	            break;
730	        }
731	        seen.entry(hash).or_default().push(completed);
732	        if completed % options.checkpoint_interval == 0 {
733	            checkpoints.insert(completed, last.clone());
734	        }
735	    }

