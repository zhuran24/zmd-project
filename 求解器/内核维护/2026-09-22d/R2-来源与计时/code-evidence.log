524: /// 内核输出§1：装载失败不制造非法的“完整参数/轨迹”对象。
525: pub fn stopped_record(stop: &Stop) -> Value {
526:     json!({"schema":"kernel-output-v4","evidence_scope":evidence_scope("diagnostic","diagnostic", &[]),"execution_mode":"finite_concrete","port_meeting":"shared_edge_opposite","run_id":"kernel:load-stop","profile_id":"kernel_profile_v1","producer":{"kind":"kernel","path":concat!(env!("CARGO_MANIFEST_DIR"),"/src/lib.rs"),"claim":"装载停止，未形成游戏后继"},"status":stop.status,"fingerprints":[],"parameter_assignment":null,"input_history":null,"uncovered_axes":[],"trace":null,"validation_scope":null,"open_items":[stop.to_string()]})
580: pub fn verify_record_at(
581:     record: &Value,
582:     input: Input,
583:     config: &Config,
584:     config_path: &Path,
585:     base: &Path,
586: ) -> Result<()> {
587:     let record = canonical_record(record, base)?;
588:     if record["status"] != "completed" || record["producer"]["kind"] != "kernel" {
589:         return Err(Stop::invalid("record", "验收入口只接已完成内核记录"));
590:     }
591:     let trace = &record["trace"];
592:     verify_record_events(&record, &input)?;
593:     let ticks = trace["ticks"]
594:         .as_array()
595:         .ok_or_else(|| Stop::invalid("trace.ticks", "须为数组"))?
596:         .len();
597:     let format = trace["format"]
598:         .as_str()
599:         .ok_or_else(|| Stop::invalid("trace.format", "须为字符串"))?;
600:     let k = if format == "checkpoint_delta" {
601:         trace["checkpoint_interval"]
602:             .as_u64()
603:             .ok_or_else(|| Stop::invalid("checkpoint_interval", "须为正整数"))? as usize
604:     } else {
605:         1
606:     };
607:     let mut engine = if record["execution_mode"] == "production_abstraction" {
608:         Engine::new_production(input)?
609:     } else {
610:         Engine::new(input)?
611:     };
612:     engine.set_cache_enabled(true);
613:     if record["execution_mode"] == "production_abstraction" {
614:         engine.production_domain()?;
615:     }
616:     let recomputed = run_record(engine, config, config_path, ticks, format, k)?;
617:     if record != recomputed {
618:         return Err(Stop::invalid("record", "交付记录与完整重算逐字段不同"));
619:     }
620:     Ok(())

