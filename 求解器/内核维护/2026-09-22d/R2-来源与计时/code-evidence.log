58: pub(crate) fn canonical_fingerprints(value: &mut Value, base: &Path) -> Result<()> {
59:     for row in value["fingerprints"]
60:         .as_array_mut()
61:         .ok_or_else(|| Stop::invalid("fingerprints", "须为数组"))?
62:     {
63:         fields(row, "role path sha256", "fingerprints[]")?;
64:         let p = resolved(base, &row["path"], "fingerprints.path")?;
65:         if sha256(&p)? != row["sha256"] {
66:             return Err(Stop::invalid(
67:                 p.display().to_string(),
68:                 "来源指纹不符，须重验而非刷新",
69:             ));
70:         }
71:         row["path"] = json!(p);
72:     }
73:     Ok(())

