47: /// 内核输出§1：只读原始字节指纹，子进程参数不经 shell。
48: pub fn sha256(path: &Path) -> Result<String> {
49:     let out = Command::new("sha256sum")
50:         .arg("--")
51:         .arg(path)
52:         .output()
53:         .map_err(|e| Stop::invalid(path.display().to_string(), e.to_string()))?;
54:     if !out.status.success() {
55:         return Err(Stop::invalid(
56:             path.display().to_string(),
57:             "sha256sum 读取失败",
58:         ));
59:     }
60:     let s = String::from_utf8(out.stdout).map_err(|e| Stop::invalid("sha256sum", e.to_string()))?;
61:     let hash = s
62:         .split_whitespace()
63:         .next()
64:         .ok_or_else(|| Stop::invalid("sha256sum", "无输出"))?;
65:     if hash.len() != 64 || !hash.bytes().all(|b| b.is_ascii_hexdigit()) {
66:         return Err(Stop::invalid("sha256sum", "散列格式异常"));
67:     }
68:     Ok(hash.into())
