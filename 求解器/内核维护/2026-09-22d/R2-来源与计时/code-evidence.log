148: pub fn fingerprints(
149:     input: &Input,
150:     config_path: &Path,
151:     extra: &[(String, PathBuf)],
152: ) -> Result<Vec<Value>> {
153:     let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
154:         .join("../..")
155:         .canonicalize()
156:         .map_err(|e| Stop::invalid("root", e.to_string()))?;
157:     let mut paths = vec![
158:         ("input".into(), input.path.clone()),
159:         ("profile".into(), config_path.to_path_buf()),
160:     ];
161:     paths.extend(input.source_paths.clone());
162:     paths.push(("profile".into(), root.join("规格/受限模型声明.md")));
163:     for p in [
164:         "受限转移定义.md",
165:         "运行语义.md",
166:         "内核输入.md",
167:         "内核输出.md",
168:     ] {
169:         paths.push(("semantics".into(), root.join("规格").join(p)));
170:     }
171:     paths.push(("schema".into(), root.join("规格/内核输出.schema.json")));
172:     paths.push(("semantics".into(), root.join("crates/kernel/周期键读取审计.md")));
173:     for p in [
174:         "value.rs",
175:         "config.rs",
176:         "model.rs",
177:         "catalog.rs",
178:         "input.rs",
179:         "interfaces.rs",
180:         "engine.rs",
181:         "event_identity.rs",
182:         "warehouse.rs",
183:         "polling.rs",
184:         "transition.rs",
185:         "output.rs",
186:         "ledger.rs",
187:         "cycle.rs",
188:         "cycle_io.rs",
189:         "digest.rs",
190:         "seed.rs",
191:         "cache.rs",
192:         "lib.rs",
193:         "main.rs",
194:     ] {
195:         paths.push(("checker".into(), root.join("crates/kernel/src").join(p)));
196:     }
197:     for p in ["Cargo.toml", "Cargo.lock", "crates/kernel/Cargo.toml"] {
198:         paths.push(("checker".into(), root.join(p)));
199:     }
200:     paths.extend(extra.iter().cloned());
201:     let mut result = Vec::new();
202:     let mut seen = BTreeSet::new();
203:     for (role, p) in paths {
204:         let path = p
205:             .canonicalize()
206:             .map_err(|e| Stop::invalid(p.display().to_string(), e.to_string()))?;
207:         if !seen.insert((role.clone(), path.clone())) {
208:             continue;
209:         }
210:         result.push(json!({"role":role,"path":path,"sha256":sha256(&path)?}));
211:     }
212:     Ok(result)
