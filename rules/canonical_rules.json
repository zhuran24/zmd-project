{
  "$schema": "./canonical_rules.schema.json",
  "metadata": {
    "version": "1.2.0",
    "description": "Canonical static rules, preprocess recipe truth, production targets, and facility templates for Arknights: Endfield. Certified runtime still consumes frozen data/preprocessed artifacts."
  },
  "globals": {
    "grid": {
      "width": 70,
      "height": 70
    },
    "time": {
      "tick_interval_seconds": 2.0
    },
    "logistics": {
      "belt_capacity_per_tick": 1.0,
      "port_max_throughput_per_tick": 1.0,
      "machine_min_clearance_cells": 1
    },
    "empty_rectangle": {
      "objective": "max_lex_area_min_side",
      "min_side_admissibility": 6
    }
  },
  "routing_rules": {
    "layers": {
      "ground": 0,
      "elevated": 1
    },
    "bridge_mechanics": {
      "can_overlap_solid": false,
      "can_overlap_straight_belt": true,
      "can_overlap_curved_belt": false,
      "can_overlap_splitter_merger": false,
      "can_turn": false
    }
  },
  "facility_templates": {
    "manufacturing_3x3": {
      "dimensions": {
        "w": 3,
        "h": 3
      },
      "rotatable": true,
      "needs_power": true,
      "is_solid_z": true,
      "port_rule": "opposite_parallel_sides"
    },
    "manufacturing_5x5": {
      "dimensions": {
        "w": 5,
        "h": 5
      },
      "rotatable": true,
      "needs_power": true,
      "is_solid_z": true,
      "port_rule": "opposite_parallel_sides"
    },
    "manufacturing_6x4": {
      "dimensions": {
        "w": 6,
        "h": 4
      },
      "rotatable": true,
      "needs_power": true,
      "is_solid_z": true,
      "port_rule": "long_sides"
    },
    "protocol_core": {
      "dimensions": {
        "w": 9,
        "h": 9
      },
      "rotatable": true,
      "needs_power": false,
      "is_solid_z": true,
      "port_rule": "core_specific",
      "core_limits": {
        "max_outputs": 6,
        "max_inputs": 14
      }
    },
    "protocol_storage_box": {
      "dimensions": {
        "w": 3,
        "h": 3
      },
      "rotatable": true,
      "needs_power": true,
      "is_solid_z": true,
      "port_rule": "omni_wireless"
