{
  "$schema": "./canonical_rules.schema.json",
  "metadata": {
    "version": "1.1.0",
    "description": "Canonical static rules, preprocess recipe truth, production targets, and facility templates for Arknights: Endfield. Certified runtime still consumes frozen data/preprocessed artifacts."
  },
  "globals": {
    "grid": {
      "width": 70,
      "height": 70
    },
    "time": {
      "tick_interval_seconds": 2.0
    },
    "logistics": {
      "belt_capacity_per_tick": 1.0,
      "port_max_throughput_per_tick": 1.0,
      "machine_min_clearance_cells": 1
    }
  },
  "routing_rules": {
    "layers": {
      "ground": 0,
      "elevated": 1
    },
    "bridge_mechanics": {
      "can_overlap_solid": false,
      "can_overlap_straight_belt": true,
      "can_overlap_curved_belt": false,
      "can_overlap_splitter_merger": false,
      "can_turn": false
    }
  },
  "facility_templates": {
    "manufacturing_3x3": {
      "dimensions": {
        "w": 3,
        "h": 3
      },
      "rotatable": true,
      "needs_power": true,
      "is_solid_z": true,
      "port_rule": "opposite_parallel_sides"
    },
    "manufacturing_5x5": {
      "dimensions": {
        "w": 5,
        "h": 5
      },
      "rotatable": true,
      "needs_power": true,
      "is_solid_z": true,
      "port_rule": "opposite_parallel_sides"
    },
    "manufacturing_6x4": {
      "dimensions": {
        "w": 6,
        "h": 4
      },
      "rotatable": true,
      "needs_power": true,
      "is_solid_z": true,
      "port_rule": "long_sides"
    },
    "protocol_core": {
      "dimensions": {
        "w": 9,
        "h": 9
      },
      "rotatable": true,
      "needs_power": false,
      "is_solid_z": true,
      "port_rule": "core_specific",
      "core_limits": {
        "max_outputs": 6,
        "max_inputs": 14
      }
    },
    "protocol_storage_box": {
      "dimensions": {
        "w": 3,
        "h": 3
      },
      "rotatable": true,
      "needs_power": true,
      "is_solid_z": true,
      "port_rule": "omni_wireless"
    },
    "power_pole": {
      "dimensions": {
        "w": 2,
        "h": 2
      },
      "rotatable": false,
      "needs_power": false,
      "is_solid_z": true,
      "port_rule": "none",
      "power_coverage_radius": 5
    },
    "boundary_storage_port": {
      "dimensions": {
        "w": 1,
        "h": 3
      },
      "rotatable": true,
      "needs_power": false,
      "is_solid_z": true,
      "port_rule": "inward_facing",
      "placement_rule": "left_or_bottom_boundary"
    }
  },
  "recipes": {
    "packaging_battery": {
      "template": "manufacturing_6x4",
      "ticks_per_cycle": 5,
      "inputs": {
        "dense_source_powder": 15,
        "steel_part": 10
      },
      "outputs": {
        "valley_battery": 1
      }
    },
    "filling_capsule": {
      "template": "manufacturing_6x4",
      "ticks_per_cycle": 5,
      "inputs": {
        "fine_buckwheat_powder": 10,
        "steel_bottle": 10
      },
      "outputs": {
        "qiaoyu_capsule": 1
      }
    },
    "parts_maker": {
      "template": "manufacturing_3x3",
      "ticks_per_cycle": 1,
      "inputs": {
        "steel_block": 1
      },
      "outputs": {
        "steel_part": 1
      }
    },
    "molding_bottle": {
      "template": "manufacturing_3x3",
      "ticks_per_cycle": 1,
      "inputs": {
        "steel_block": 2
      },
      "outputs": {
        "steel_bottle": 1
      }
    },
    "grinder_dense_source": {
      "template": "manufacturing_6x4",
      "ticks_per_cycle": 1,
      "inputs": {
        "source_powder": 2,
        "sandleaf_powder": 1
      },
      "outputs": {
        "dense_source_powder": 1
      }
    },
    "grinder_fine_buckwheat": {
      "template": "manufacturing_6x4",
      "ticks_per_cycle": 1,
      "inputs": {
        "buckwheat_powder": 2,
        "sandleaf_powder": 1
      },
      "outputs": {
        "fine_buckwheat_powder": 1
      }
    },
    "grinder_dense_blue_iron": {
      "template": "manufacturing_6x4",
      "ticks_per_cycle": 1,
      "inputs": {
        "blue_iron_powder": 2,
        "sandleaf_powder": 1
      },
      "outputs": {
        "dense_blue_iron_powder": 1
      }
    },
    "refinery_steel": {
      "template": "manufacturing_3x3",
      "ticks_per_cycle": 1,
      "inputs": {
        "dense_blue_iron_powder": 1
      },
      "outputs": {
        "steel_block": 1
      }
    },
    "refinery_blue_iron": {
      "template": "manufacturing_3x3",
      "ticks_per_cycle": 1,
      "inputs": {
        "blue_iron_ore": 1
      },
      "outputs": {
        "blue_iron_block": 1
      }
    },
    "crusher_source": {
      "template": "manufacturing_3x3",
      "ticks_per_cycle": 1,
      "inputs": {
        "source_ore": 1
      },
      "outputs": {
        "source_powder": 1
      }
    },
    "crusher_blue_iron": {
      "template": "manufacturing_3x3",
      "ticks_per_cycle": 1,
      "inputs": {
        "blue_iron_block": 1
      },
      "outputs": {
        "blue_iron_powder": 1
      }
    },
    "crusher_buckwheat": {
      "template": "manufacturing_3x3",
      "ticks_per_cycle": 1,
      "inputs": {
        "buckwheat": 1
      },
      "outputs": {
        "buckwheat_powder": 2
      }
    },
    "crusher_sandleaf": {
      "template": "manufacturing_3x3",
      "ticks_per_cycle": 1,
      "inputs": {
        "sandleaf": 1
      },
      "outputs": {
        "sandleaf_powder": 3
      }
    },
    "seed_collector_buckwheat": {
      "template": "manufacturing_5x5",
      "ticks_per_cycle": 1,
      "inputs": {
        "buckwheat": 1
      },
      "outputs": {
        "buckwheat_seed": 2
      }
    },
    "seed_collector_sandleaf": {
      "template": "manufacturing_5x5",
      "ticks_per_cycle": 1,
      "inputs": {
        "sandleaf": 1
      },
      "outputs": {
        "sandleaf_seed": 2
      }
    },
    "planter_buckwheat": {
      "template": "manufacturing_5x5",
      "ticks_per_cycle": 1,
      "inputs": {
        "buckwheat_seed": 1
      },
      "outputs": {
        "buckwheat": 1
      }
    },
    "planter_sandleaf": {
      "template": "manufacturing_5x5",
      "ticks_per_cycle": 1,
      "inputs": {
        "sandleaf_seed": 1
      },
      "outputs": {
        "sandleaf": 1
      }
    }
  },
  "production_targets": {
    "valley_battery": {
      "mode": "equivalent_full_speed_lines",
      "value": 3.0,
      "final_recipe_id": "packaging_battery"
    },
    "qiaoyu_capsule": {
      "mode": "equivalent_full_speed_lines",
      "value": 2.75,
      "final_recipe_id": "filling_capsule"
    }
  },
  "commodity_metadata": {
    "valley_battery": {
      "source_kind": "internal_only",
      "sink_kind": "generic_input",
      "cycle_group": null
    },
    "qiaoyu_capsule": {
      "source_kind": "internal_only",
      "sink_kind": "generic_input",
      "cycle_group": null
    },
    "dense_source_powder": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "steel_part": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "fine_buckwheat_powder": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "steel_bottle": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "steel_block": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "source_powder": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "sandleaf_powder": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "buckwheat_powder": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "dense_blue_iron_powder": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "blue_iron_powder": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "source_ore": {
      "source_kind": "external_boundary",
      "sink_kind": "none",
      "cycle_group": null
    },
    "blue_iron_ore": {
      "source_kind": "external_boundary",
      "sink_kind": "none",
      "cycle_group": null
    },
    "blue_iron_block": {
      "source_kind": "internal_only",
      "sink_kind": "none",
      "cycle_group": null
    },
    "buckwheat": {
      "source_kind": "cycle_internal",
      "sink_kind": "none",
      "cycle_group": "buckwheat_cycle"
    },
    "buckwheat_seed": {
      "source_kind": "cycle_internal",
      "sink_kind": "none",
      "cycle_group": "buckwheat_cycle"
    },
    "sandleaf": {
      "source_kind": "cycle_internal",
      "sink_kind": "none",
      "cycle_group": "sandleaf_cycle"
    },
    "sandleaf_seed": {
      "source_kind": "cycle_internal",
      "sink_kind": "none",
      "cycle_group": "sandleaf_cycle"
    }
  }
}
