{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arknights: Endfield Preprocess Plan Overlay Schema",
  "description": "Build-time additive preprocess overlay for cycle groups and utility operations.",
  "type": "object",
  "required": [
    "metadata",
    "cycle_groups",
    "utility_operations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": [
        "version",
        "description"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cycle_groups": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "required": [
            "recipes",
            "internal_commodities",
            "net_export_commodities"
          ],
          "properties": {
            "recipes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "internal_commodities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "net_export_commodities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "utility_operations": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "required": [
            "facility_type",
            "generic_input_slots",
            "generic_output_slots"
          ],
          "properties": {
            "facility_type": {
              "type": "string",
              "minLength": 1
            },
            "generic_input_slots": {
              "type": "integer",
              "minimum": 0
            },
            "generic_output_slots": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
