{
  "_authority": {
    "class": "NON_FROZEN_DERIVED",
    "statement": "非冻结派生件；不属于 canonical、freeze-ritual 或 owner authority；未经审查不得承重消费。"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zmd-non-frozen-derived-rule-v1",
  "title": "ZMD non-frozen derived rule entry",
  "description": "批 1 立架的非冻结 L2 派生条目。schema 只约束形态，不证明字段内容正确，也不钉 canonical schema SHA。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_authority",
    "id",
    "level",
    "kind",
    "statement",
    "scope",
    "premises",
    "premise_fingerprint",
    "derivation",
    "crystallization",
    "direction",
    "status",
    "consumers",
    "sentinel"
  ],
  "properties": {
    "_authority": {
      "$ref": "#/$defs/authority"
    },
    "id": {
      "type": "string",
      "pattern": "^D-[A-Z0-9][A-Z0-9-]*$"
    },
    "level": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "theorem",
        "bound",
        "impossibility",
        "unreachability",
        "structural_feature",
        "parameter_derivation"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "premises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/source_value_premise"
          },
          {
            "$ref": "#/$defs/assumption_premise"
          },
          {
            "$ref": "#/$defs/derived_premise"
          }
        ]
      }
    },
    "premise_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "derivation": {
      "$ref": "#/$defs/derivation"
    },
    "crystallization": {
      "$ref": "#/$defs/crystallization"
    },
    "direction": {
      "enum": [
        "neutral",
        "stricter",
        "looser",
        "mixed",
        "unknown"
      ]
    },
    "status": {
      "enum": [
        "UNREVIEWED",
        "ACTIVE",
        "STALE",
        "RETIRED",
        "SUPERSEDED",
        "PROMOTED"
      ]
    },
    "consumers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sentinel": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "statement"
      ],
      "properties": {
        "class": {
          "const": "NON_FROZEN_DERIVED"
        },
        "statement": {
          "const": "非冻结派生件；不属于 canonical、freeze-ritual 或 owner authority；未经审查不得承重消费。"
        }
      }
    },
    "exact_rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_rational"
      ],
      "properties": {
        "exact_rational": {
          "type": "string",
          "pattern": "^-?[0-9]+/[1-9][0-9]*$"
        }
      }
    },
    "source_value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/exact_rational"
        },
        {
          "type": "array"
        },
        {
          "type": "object"
        }
      ]
    },
    "source_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "pointer"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"
        },
        "pointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "source_value_premise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "source",
        "value_at_derivation"
      ],
      "properties": {
        "kind": {
          "const": "source_value"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source_pointer"
        },
        "value_at_derivation": {
          "$ref": "#/$defs/source_value"
        }
      }
    },
    "assumption_premise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "statement",
        "assumption_version"
      ],
      "properties": {
        "kind": {
          "const": "assumption"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "assumption_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "derived_premise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "entry_id",
        "level"
      ],
      "properties": {
        "kind": {
          "const": "derived"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "entry_id": {
          "type": "string",
          "pattern": "^D-[A-Z0-9][A-Z0-9-]*$"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "receipt",
        "recompute_cmd"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        },
        "recompute_cmd": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "crystallization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free_variable",
        "collapsed_to",
        "detector"
      ],
      "properties": {
        "free_variable": {
          "type": "string",
          "minLength": 1
        },
        "collapsed_to": {
          "type": "string",
          "minLength": 1
        },
        "detector": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
