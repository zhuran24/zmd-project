+def _baseline_region_cells(region_kind: str) -> frozenset[Tuple[int, int]]:
+    if region_kind == "left_baseline":
+        return frozenset((x, 0) for x in range(_GRID_SIZE))
+    if region_kind == "bottom_baseline":
+        return frozenset((0, y) for y in range(_GRID_SIZE))
+    return frozenset()
+
+
+def _validate_region_demand_source_of_truth(
+    cert_dict: Dict[str, Any], state: BState, t0: float
+) -> Optional[ValidationResult]:
+    """Verify that ``region_demand`` is globally forced, not merely asserted.
+
+    F6's evaluator/translator is geometric and unconditional. Therefore a
+    side-specific demand is sound only when every possible pose for the group is
+    wholly inside that side's baseline region; otherwise the group can satisfy
+    some or all of its demand in a different region and a forged cert can create
+    false conflicts.
+
+    Conditional Phase 1.5+ cuts based on a current master solution must add
+    literal/proof binding for the per-region count before relaxing this gate.
+    """
+    from src.cuts.helpers.candidate_placements import find_pose
+
+    gid = cast(str, cert_dict["contributing_group"])
+    region_kind = cast(str, cert_dict["region_kind"])
+    region_demand = cast(int, cert_dict["region_demand"])
+    group_demand = state.groups[gid].demand
+    region_cells = _baseline_region_cells(region_kind)
+    if not region_cells:
+        return _vr("schema_err", t0, f"unsupported region_kind {region_kind!r}")
+    if state.candidate_placements is None:
+        return _vr(
+            "unsound",
+            t0,
+            "state.candidate_placements missing — cannot verify F6 region_demand "
+            "against pose-domain source-of-truth (fail-closed)",
+        )
+    pose_domain = state.groups[gid].pose_domain
+    if not pose_domain:
+        return _vr(
+            "unsound",
+            t0,
+            f"group {gid!r} pose_domain empty — cannot prove region_demand is forced",
+        )
+    for pose_id in pose_domain:
+        pose = find_pose(state, gid, pose_id)
+        if pose is None:
+            return _vr(
+                "unsound",
+                t0,
+                f"pose {pose_id!r} for group {gid!r} not found in candidate_placements; "
+                "cannot prove region_demand is forced",
+            )
+        occupied = pose.get("occupied_cells")
+        if not isinstance(occupied, list) or not occupied:
+            return _vr(
+                "unsound",
+                t0,
+                f"pose {pose_id!r} has no occupied_cells list; cannot prove region_demand is forced",
+            )
+        pose_cells: set[Tuple[int, int]] = set()
+        for raw in occupied:
+            if not isinstance(raw, (list, tuple)) or len(raw) != 2:
+                return _vr(
+                    "unsound",
+                    t0,
+                    f"pose {pose_id!r} occupied_cells entry malformed: {raw!r}",
+                )
+            x_raw, y_raw = raw
+            if not _is_strict_int(x_raw) or not _is_strict_int(y_raw):
+                return _vr(
+                    "unsound",
+                    t0,
+                    f"pose {pose_id!r} occupied cell coordinates must be strict int",
+                )
+            pose_cells.add((cast(int, x_raw), cast(int, y_raw)))
+        if not pose_cells <= region_cells:
+            return _vr(
+                "unsound",
+                t0,
+                f"region_demand for group {gid!r} in {region_kind!r} is not globally forced: "
+                f"pose {pose_id!r} has cells outside the region",
+            )
+    if region_demand != group_demand:
+        return _vr(
+            "unsound",
+            t0,
+            f"region_demand {region_demand} != globally forced group_demand {group_demand}; "
+            "partial per-region counts require conditional/literal proof",
+        )
+    return None
+
